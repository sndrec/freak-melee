# Ordinary fighter state owns the code sequence and modified endpoint hitbox.
# Full constructor/solver/gameplay acceptance remains pending.
state int tether_code_sequence
state float tether_target_z

func Tether_AdvanceCodeSequence():
    # Stock samples one switch case per normal update, including held inputs.
    # Completing Up/Down/Up/A persists until death or an incomplete creation.
    if state.tether_code_sequence == 0:
        if input.up_held:
            state.tether_code_sequence = 1
    elif state.tether_code_sequence == 1:
        if input.down_held:
            state.tether_code_sequence = 2
    elif state.tether_code_sequence == 2:
        if input.up_held:
            state.tether_code_sequence = 3
    elif state.tether_code_sequence == 3:
        if input.attack_pressed:
            state.tether_code_sequence = 4

func Tether_HoldHangTimer(int modified_mode):
    # fn_802B8D38 tests physical L, before its ground/attack exits and decrement.
    if modified_mode != 0 and input.l_held:
        state.tether_hang_timer = state.tether_hang_timer + 1

hitbox_definition tether_tip:
    bone 139
    damage 0
    radius 1200 * 0.003906
    angle 361
    growth 100
    item_interaction true
    element 8
    sound_severity 1
    sound_kind 2
    aerial false
    # Retail's trailing victim-only bit was undefined; choose false explicitly.
    victim_only false

func Tether_UpdateModifiedGroundAttack(int mode) -> bool:
    if not grounded or mode != 1:
        return false
    hitbox.clear_all()
    if not input.attack_pressed:
        return false
    return hitbox.create(0, tether_tip)

func Tether_ReadHomingTarget() -> bool:
    let int target = targets.nearest_available_fighter()
    return targets.read_position(target, state.tether_target_x, state.tether_target_y, state.tether_target_z)

func Tether_Create():
    if motion.id != 357 and motion.id != 358 and motion.id != 212 and motion.id != 214:
        return
    Tether_ReadInputs()
    state.tether_attachment_part = attrs.tether_attachment_joint
    bones.world_position(state.tether_attachment_part, state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z)
    # Stock passes the supplied position/facing, no center offset, zero velocity,
    # and collision flag true. Collision-group0 replaces uninitialized Spawn.x40.
    state.tether_handle = articles.create_with_velocity(It_Kind_Samus_GBeam, state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z, 0, 0, 0, facing.direction, false, 0, 0, true)
    if not articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
        state.tether_handle = -1
        return
    # Retail Samus uses raw joint51 (FtPart_ThrowN), not semantic bone slot4.
    # The owned parameter also supplies the resource links' borrowed joint.
    let bool attached = items.attach(state.tether_handle, attrs.tether_attachment_joint, false)
    if not attached:
        articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "remove", 0)
        state.tether_handle = -1
        return
    articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "scale_after_attach", 0)
    if not articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
        state.tether_handle = -1
        return
    callbacks.accessory_before(Tether_Update)
    callbacks.death1(Tether_Remove)
    callbacks.accessory_hitlag(Tether_Hitlag)


func Tether_CreateThrowAccessory(int motion, float rate):
    # Common ThrowF..ThrowLw are 219..222. This selection owns no stock handler.
    if accessory.create(4):
        accessory.set_scale(model.instance_scale_y, model.instance_scale_y, model.instance_scale_y)
        accessory.add_animation(4, -1)
        accessory.add_animation(4, motion - 219)
        # Preserve looping geometry and all material/texture clocks.
        accessory.set_geometry_animation_rate(rate, false)
        accessory.request_frame(0.0)
        accessory.evaluate()
        accessory.follow_bone(51)
