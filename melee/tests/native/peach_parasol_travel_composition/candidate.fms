export func save_held_for_parasol():
    let int previous = items.held_id
    if previous != -1:
        state.saved_handle = previous
        let bool hidden = items.set_visible(previous, false)
        let bool paused = items.set_paused(previous, true)
        let bool dropped = items.notify_drop(previous, true)

export func restore_held() -> bool:
    state.parasol_handle = -1
    callbacks.death3(None)
    callbacks.damage(None)
    if state.saved_handle != -1:
        let int previous = state.saved_handle
        let bool bound = items.bind_existing_held(previous)
        state.saved_handle = -1
        if bound:
            let bool shown = items.set_visible(previous, true)
            let bool resumed = items.set_paused(previous, false)
            if shown and resumed:
                items.notify_pickup(true)
                return true
    return false

export func forget_toad():
    if state.toad_handle != -1:
        let bool resumed = items.set_paused(state.toad_handle, false)
    state.toad_handle = -1
    callbacks.death2(None)
    callbacks.damage(None)

export func forget_vegetable():
    state.vegetable_handle = -1

func cleanup_parasol():
    if state.parasol_handle != -1:
        articles.signal(state.parasol_handle, It_Kind_Peach_Parasol, "remove_cleanup", 0)
        restore_held()

func cleanup_toad():
    if state.toad_handle != -1:
        articles.signal(state.toad_handle, It_Kind_Peach_Toad, "remove_cleanup", 0)
        forget_toad()

func cleanup_vegetable():
    if state.vegetable_handle != -1 and items.held_id == state.vegetable_handle and items.held_kind == It_Kind_Peach_Turnip:
        articles.signal(state.vegetable_handle, It_Kind_Peach_Turnip, "remove_cleanup", 0)
        forget_vegetable()

export func cleanup_resources():
    cleanup_parasol()
    cleanup_toad()
    cleanup_vegetable()

export func create_parasol():
    let bool requested = false
    if state.parasol_request_kind == It_Kind_Capsule:
        state.parasol_request_kind = It_Kind_Peach_Parasol
        requested = state.parasol_handle == -1
    if requested:
        bones.world_position(attrs.parasol_attachment_joint, state.spawn_x, state.spawn_y, state.spawn_z)
        save_held_for_parasol()
        let int created = articles.create_at_position(It_Kind_Peach_Parasol, state.spawn_x, state.spawn_y, state.spawn_z, facing.direction, false)
        let int final_handle = -1
        if created != -1:
            let bool attached = items.attach(created, attrs.parasol_attachment_joint, true)
            if attached:
                final_handle = created
            else:
                # Invalid attachment is outside the retail fixed-rig contract.
                # Discard only this creation, then restore the live saved item.
                articles.signal(created, It_Kind_Peach_Parasol, "discard_unattached", 0)
                let bool restored = restore_held()
                callbacks.accessory(None)
                callbacks.pre_hitlag(pause_parasol)
                callbacks.post_hitlag(resume_parasol)
                return
        state.parasol_handle = final_handle
        items.clear_held()
        if final_handle != -1:
            let bool bound = items.bind_held(final_handle)
            if bound:
                callbacks.death3(cleanup_resources)
                callbacks.damage(cleanup_resources)
    callbacks.accessory(None)
    callbacks.pre_hitlag(pause_parasol)
    callbacks.post_hitlag(resume_parasol)

func choose_vegetable():
    state.vegetable_kind = It_Kind_Peach_Turnip
    if random.int(attrs.rare_roll_bound) == 0:
        let int total = attrs.rare_weight_0
        if attrs.rare_count >= 2: total = total + attrs.rare_weight_1
        if attrs.rare_count >= 3: total = total + attrs.rare_weight_2
        let int draw = random.int(total)
        state.vegetable_kind = attrs.rare_kind_0
        if attrs.rare_count >= 2 and draw >= attrs.rare_weight_0:
            state.vegetable_kind = attrs.rare_kind_1
        if attrs.rare_count >= 3 and draw >= attrs.rare_weight_0 + attrs.rare_weight_1:
            state.vegetable_kind = attrs.rare_kind_2
        # Selection and RNG order match. The unused source read of the next
        # weight after a result is selected (including entry3) is omitted.

export func construct_vegetable():
    bones.world_position(attrs.spawn_position_joint, state.spawn_x, state.spawn_y, state.spawn_z)
    choose_vegetable()
    let int created_handle = -1
    if state.vegetable_kind == It_Kind_Peach_Turnip:
        # on_created performs type/lifetime/flag initialization BEFORE AB54.
        created_handle = articles.create_at_position(It_Kind_Peach_Turnip, state.spawn_x, state.spawn_y, state.spawn_z, facing.direction, false)
    else:
        # Ordinary engine callbacks/assets, not fake authored Bomb/Saturn/Sword.
        created_handle = items.create_engine(state.vegetable_kind, state.spawn_x, state.spawn_y, state.spawn_z, 0, 0, 0, facing.direction, 0, 0)
    if created_handle != -1:
        let bool attached = items.attach(created_handle, attrs.held_attachment_joint, false)
        if not attached:
            created_handle = -1
        elif state.vegetable_kind != It_Kind_Sword:
            let bool inherited = items.inherit_owner_scale(created_handle, true)
            if not inherited: created_handle = -1
    # Stock setupVeg publishes NULL on allocation failure as well as success.
    items.clear_held()
    state.vegetable_handle = created_handle
    if created_handle != -1:
        let bool bound = items.bind_held(created_handle)
        if bound:
            items.notify_pickup(false)
            effects.spawn_at_position(1234, position.x, position.y, position.z)
            callbacks.death2(cleanup_resources)
            callbacks.damage(cleanup_resources)

# Exact spawnVeg cue boundary; bound after entry and both ground/air transitions.
func spawn_vegetable_accessory():
    if cue.article.consume(): construct_vegetable()

move CompositionPolicies:
    on load:
        state.float_fall_forward_end = animation.clip_length(18)
        state.float_fall_backward_end = animation.clip_length(19)
        fighter.copy_ext_attributes()
    on load_special_attrs:
        fighter.reload_ext_attributes()
    on death:
        state.has_float = true
        state.last_smash_motion = -1
        state.toad_air_boost_used = false
        state.parasol_handle = -1
        state.saved_handle = -1
        state.toad_handle = -1
        state.vegetable_handle = -1
        visuals.set_group(0, 0)
        visuals.set_group(2, 0)
        visuals.set_group(3, -1)
        visuals.set_group(4, 0)
        if costume.index == attrs.yellow_costume_index:
            visuals.set_group(1, -1)
            visuals.set_group(5, 0)
            visuals.set_group(6, -1)
        else:
            visuals.set_group(1, 0)
            visuals.set_group(5, -1)
            visuals.set_group(6, 0)
    on death2:
        cleanup_resources()
    on pre_hitlag:
        if state.parasol_handle != -1:
            let bool paused = items.set_paused(state.parasol_handle, true)
    on post_hitlag:
        if state.parasol_handle != -1:
            let bool resumed = items.set_paused(state.parasol_handle, false)
    on item_pickup:
        fighter.item_pickup(event.flag, 1, 1)
    on item_pickup_ext:
        fighter.item_pickup(event.flag, 1, 1)
    on item_drop:
        fighter.item_drop(event.flag, 1, 1)
    on item_drop_ext:
        fighter.item_drop(event.flag, 1, 1)
    on item_invisible:
        fighter.item_invisible(1)
    on item_visible:
        fighter.item_visible(1)
    on knockback_enter:
        fighter.knockback_enter(1)
    on knockback_exit:
        fighter.knockback_exit(1)
    on aerial_jump:
        physics.ground_to_air()
        command(0) = 1
        let int jump_motion = attrs.jump_backward_motion
        if input.x * facing.direction > -controls.aerial_jump_reverse_threshold:
            jump_motion = attrs.jump_forward_motion
        jump.begin(jump_motion, input.x * air.jump_horizontal_multiplier, 0, 0, true, true, true)
    on dynamics_interaction_start:
        if event.set == event.set_count - 1: return 0
        return attrs.dynamics_first_active
    on body_rebound:
        return motion.id == attrs.rebound_ground_motion or motion.id == attrs.rebound_air_motion
    on cpu_attack_motion:
        return motion.id > attrs.cpu_attack_lower_bound
    on cpu_ranged_candidates:
        if cpu.ranged_unsafe(attrs.cpu_ranged_probe_distance):
            cpu.add_candidate(attrs.cpu_ranged_candidate)

# Complete original 349..353 phases; no down-B air pluck entry exists.
move PluckSmash:
    on forward_smash_enter:
        controls.interrupt_allowed = false
        command(0) = 0
        let int selected = random.int(attrs.smash_motion_count) + attrs.smash_first_motion
        # Original rejection sampling: every repeated choice consumes a draw.
        while selected == state.last_smash_motion:
            selected = random.int(attrs.smash_motion_count) + attrs.smash_first_motion
        state.last_smash_motion = selected
        state.enter_at_speed(selected, 0, 0, 1)
        animation.start()
    on special_lw:
        if items.held_id != -1:
            if items.held_kind == It_Kind_Peach_Turnip:
                items.throw_held(attrs.turnip_ground_throw_motion)
            return
        cue.throw.reset()
        state.enter_at_speed(attrs.pluck_ground_motion, 0, 0, 1)
        animation.start()
        callbacks.accessory(spawn_vegetable_accessory)
    on special_air_lw:
        if items.held_id != -1 and items.held_kind == It_Kind_Peach_Turnip:
            items.throw_held(attrs.turnip_air_throw_motion)
    on state_349_animation:
        if animation.finished: state.wait()
    on state_349_interrupt:
        if controls.interrupt_allowed: controls.ground_actions()
    on state_349_physics:
        physics.ground_motion()
    on state_349_collision:
        collision.ground_standard()
    on state_350_animation:
        if animation.finished: state.wait()
    on state_350_interrupt:
        if controls.interrupt_allowed: controls.ground_actions()
    on state_350_physics:
        physics.ground_motion()
    on state_350_collision:
        collision.ground_standard()
    on state_351_animation:
        if animation.finished: state.wait()
    on state_351_interrupt:
        if controls.interrupt_allowed: controls.ground_actions()
    on state_351_physics:
        physics.ground_motion()
    on state_351_collision:
        collision.ground_standard()
    on state_352_animation:
        if animation.finished:
            state.wait()
            forget_vegetable()
    on state_352_physics:
        physics.ground_friction()
    on state_352_collision:
        if collision.left_ground:
            physics.ground_to_air()
            state.enter_at_speed(attrs.pluck_air_motion, attrs.pluck_transition_flags, frame, 1)
            callbacks.accessory(spawn_vegetable_accessory)
    on state_353_animation:
        if animation.finished:
            state.fall()
            forget_vegetable()
    on state_353_physics:
        physics.air_gravity_and_friction()
    on state_353_collision:
        if collision.landed:
            physics.switch_to_ground()
            state.enter_at_speed(attrs.pluck_ground_motion, attrs.pluck_transition_flags, frame, 1)
            callbacks.accessory(spawn_vegetable_accessory)

# Callable creation composition for the later Side-B phase; not an activated move.
func create_explosion(float x, float y, float z, bool alternate) -> int:
    return articles.create_at_position(It_Kind_Peach_Explode, x, y, z, facing.direction, false, 0, float(alternate))

article It_Kind_Peach_Explode states 2:
    parameter float initial_lifetime = 60
    parameter int effect = 1040
    parameter int sound = 116
    parameter int sound_pan = 127
    parameter int sound_volume = 64
    parameter int state_update_flag = 2
    on created:
            item.life = item.attr.initial_lifetime
            item.command0 = 0
            item.hide_model()
            item.spawn_effect_at_position(item.attr.effect, position.x, position.y, position.z)
            item.play_sound(item.attr.sound, item.attr.sound_pan, item.attr.sound_volume)
            item.contact_hitlag = false
            item.use_manual_lifetime()
            item.physics_disabled = true
            # Stock common expiry overwrites the earlier 60 with itCommonData.xF8.
            item.begin_expiry()
            let int selected = 0
            if item.creation_value != 0:
                selected = 1
            item.change_state_flags(selected, item.attr.state_update_flag)
            item.inherit_owner_scale()
            item.inherit_owner_debug_display()
    on damage_dealt:
            return false
    on interaction:
            item.interact(other)
    state 0 anim 0:
        on animation:
            return item.expire_tick()
    state 1 anim 1:
        on animation:
            return item.expire_tick()

article It_Kind_Peach_Parasol states 3:
    parameter int animation_update_flags = 2
    parameter int open_length = 15
    parameter int close_length = 16
    parameter int open_sound = 247
    parameter int sound_pan = 127
    parameter int sound_volume = 64
    parameter int owned_hi_start = 361
    parameter int owned_hi_end = 364
    parameter int owned_open = 369
    parameter int owned_fall = 370
    parameter int common_open = 144
    parameter int common_fall_special = 146
    parameter int common_special_fall = 35
    parameter int common_special_fall_backward = 37
    parameter int common_special_landing = 43
    state bool retire

    func decide_expiration():
        item.state.retire = true
        if item.current_owner != 0:
            let int current_motion = holder.motion
            if current_motion >= item.attr.owned_hi_start and current_motion <= item.attr.owned_hi_end:
                item.state.retire = false
            elif current_motion >= item.attr.owned_open and current_motion <= item.attr.owned_fall:
                item.state.retire = false
            elif current_motion >= item.attr.common_open and current_motion <= item.attr.common_fall_special:
                item.state.retire = false
            elif current_motion >= item.attr.common_special_fall and current_motion <= item.attr.common_special_fall_backward:
                item.state.retire = false
            elif current_motion == item.attr.common_special_landing:
                # Actual current holder item drives this check, including a different held instance.
                item.state.retire = holder.held_motion == 2 and holder.held_frame >= item.attr.close_length
        if item.state.retire:
            let bool restored = targets.call_bool(item.current_owner, "restore_held")
            if restored:
                item.clear_current_owner()

    on signal discard_unattached:
            item.clear_current_owner()
            item.remove()
    on picked_up:
            item.animation_rate = item.attr.close_length
            item.change_state_flags(2, item.attr.animation_update_flags)
            item.track_accessory()
            item.advance_animation()
            item.animation_rate = 1
    on accessory:
            pass
    on held_status:
            if item.motion_state == 1:
                return int(4)
            if item.motion_state == 0 or item.motion_state == 2:
                return int(6)
            return int(-1)
    on held_request:
            let float rate = event.frame_rate
            if event.action == 4:
                if event.duration != 0:
                    rate = rate * (item.attr.open_length / event.duration)
                item.play_sound(item.attr.open_sound, item.attr.sound_pan, item.attr.sound_volume)
                item.animation_rate = rate
                item.change_state_flags(1, item.attr.animation_update_flags)
                item.track_accessory()
                return true
            if event.action == 6:
                if event.duration != 0:
                    rate = rate * (item.attr.close_length / event.duration)
                item.animation_rate = rate
                item.change_state_flags(2, item.attr.animation_update_flags)
                item.track_accessory()
                return true
            return false
    on holder_neutral:
            let bool restored = targets.call_bool(item.current_owner, "restore_held")
            if restored:
                item.clear_current_owner()
            item.remove()
    on signal remove_cleanup:
            let bool restored = targets.call_bool(item.current_owner, "restore_held")
            if restored:
                item.clear_current_owner()
            item.remove()
    on destroyed:
            let bool restored = targets.call_bool(item.current_owner, "restore_held")
            if restored:
                item.clear_current_owner()
    on interaction:
            item.interact(other)
    state 0 anim -1:
        on animation:
            decide_expiration()
            return item.state.retire
    state 1 anim 0:
        on animation:
            decide_expiration()
            return item.state.retire
    state 2 anim 1:
        on animation:
            decide_expiration()
            return item.state.retire

article It_Kind_Peach_Turnip states 5:
    parameter int surface_response_mask = 14
    parameter int retire_contact_mask = 3
    attribute float lifetime 0
    attribute int face_count 4
    attribute int face_weight_0 8
    attribute int face_damage_0 12
    attribute int face_weight_1 16
    attribute int face_damage_1 20
    attribute int face_weight_2 24
    attribute int face_damage_2 28
    attribute int face_weight_3 32
    attribute int face_damage_3 36
    attribute int face_weight_4 40
    attribute int face_damage_4 44
    attribute int face_weight_5 48
    attribute int face_damage_5 52
    attribute int face_weight_6 56
    attribute int face_damage_6 60
    attribute int face_weight_7 64
    attribute int face_damage_7 68
    state int face
    state int face_damage
    state bool picked_up_once
    on created:
            item.set_lifetime(item.attr.lifetime)
            let int total = item.attr.face_weight_0
            if item.attr.face_count >= 2:
                total = total + item.attr.face_weight_1
            if item.attr.face_count >= 3:
                total = total + item.attr.face_weight_2
            if item.attr.face_count >= 4:
                total = total + item.attr.face_weight_3
            if item.attr.face_count >= 5:
                total = total + item.attr.face_weight_4
            if item.attr.face_count >= 6:
                total = total + item.attr.face_weight_5
            if item.attr.face_count >= 7:
                total = total + item.attr.face_weight_6
            if item.attr.face_count >= 8:
                total = total + item.attr.face_weight_7
            let int draw = random.int(total)
            let int cumulative = item.attr.face_weight_0
            item.state.face = 0
            item.state.face_damage = item.attr.face_damage_0
            if item.attr.face_count >= 2 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_1
                item.state.face = 1
                item.state.face_damage = item.attr.face_damage_1
            if item.attr.face_count >= 3 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_2
                item.state.face = 2
                item.state.face_damage = item.attr.face_damage_2
            if item.attr.face_count >= 4 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_3
                item.state.face = 3
                item.state.face_damage = item.attr.face_damage_3
            if item.attr.face_count >= 5 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_4
                item.state.face = 4
                item.state.face_damage = item.attr.face_damage_4
            if item.attr.face_count >= 6 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_5
                item.state.face = 5
                item.state.face_damage = item.attr.face_damage_5
            if item.attr.face_count >= 7 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_6
                item.state.face = 6
                item.state.face_damage = item.attr.face_damage_6
            if item.attr.face_count >= 8 and draw >= cumulative:
                item.state.face = 7
                item.state.face_damage = item.attr.face_damage_7
            item.state.picked_up_once = false
            item.subaction_sounds_muted = true
    on picked_up:
            item.set_appearance(0, float(item.state.face))
            if item.state.picked_up_once:
                item.change_state(4)
            else:
                item.change_state(0)
                item.subaction_sounds_muted = false
            item.state.picked_up_once = true
            item.advance_animation()
    on thrown:
            item.change_state_flags(2, 6)
            item.set_appearance(0, float(item.state.face))
            hitbox.set_damage(0, item.state.face_damage)
            item.set_instance_scale(item.throw_scale)
    on dropped:
            item.change_state_flags(3, 6)
            item.set_appearance(0, float(item.state.face))
    on damage_dealt:
            item.bounce()
            item.change_state(1)
            return false
    on clanked:
            item.bounce()
            return false
    on reflected:
            item.reflect()
            return false
    on hit_shield:
            item.bounce()
            return false
    on shield_bounced:
            item.shield_bounce()
            return false
    on signal remove_cleanup:
            item.remove()
    on destroyed:
            creator.call(forget_vegetable)
    on interaction:
            if item.attachment_owner_is(other):
                item.clear_attachment_owner()
            item.interact(other)
    state 0 anim 1:
        on animation:
            return false
        on physics:
            return
    state 1 anim -1:
        on animation:
            return item.expire_tick()
        on physics:
            item.gravity(false)
    state 2 anim 2:
        on animation:
            return item.expire_tick()
        on physics:
            item.gravity()
        on collision:
            let int collision_flags = item.sweep_stage_flags()
            if collision_flags & item.attr.surface_response_mask:
                item.respond_stage_mask(collision_flags)
                item.change_state(1)
            elif collision_flags & item.attr.retire_contact_mask:
                return true
            return false
    state 3 anim 2:
        on animation:
            return item.expire_tick()
        on physics:
            item.gravity()
        on collision:
            let int collision_flags = item.sweep_stage_flags()
            if collision_flags & item.attr.surface_response_mask:
                item.respond_stage_mask(collision_flags)
                item.change_state(1)
            elif collision_flags & item.attr.retire_contact_mask:
                return true
            return false
    state 4 anim -1:
        on animation:
            return false
        on physics:
            return

func pause_toad():
    if state.toad_handle != -1:
        let bool paused = items.set_paused(state.toad_handle, true)

func resume_toad():
    if state.toad_handle != -1:
        let bool resumed = items.set_paused(state.toad_handle, false)

func install_toad_guard():
    guard.create(attrs.toad_guard_joint, attrs.toad_guard_x, attrs.toad_guard_y, attrs.toad_guard_z, attrs.toad_guard_radius, GuardHit)
    guard.front_only = true

func create_toad():
    if command(2) != 0: return
    command(2) = 1
    bones.world_position(attrs.toad_attachment_joint, state.spawn_x, state.spawn_y, state.spawn_z)
    let int created = articles.create_at_position(It_Kind_Peach_Toad, state.spawn_x, state.spawn_y, state.spawn_z, facing.direction, false)
    if created != -1:
        let bool attached = items.attach(created, attrs.toad_attachment_joint, true)
        if not attached:
            # Outside retail fixed-rig behavior: do not strand an unattached item.
            articles.signal(created, It_Kind_Peach_Toad, "discard_unattached", 0)
            created = -1
    state.toad_handle = created
    items.clear_auxiliary()
    if created != -1:
        let bool bound = items.bind_auxiliary(created)
        if bound:
            callbacks.death2(cleanup_resources)
            callbacks.damage(cleanup_resources)
    callbacks.accessory(None)
    callbacks.pre_hitlag(pause_toad)
    callbacks.post_hitlag(resume_toad)

func create_spore():
    bones.world_position(attrs.toad_attachment_joint, state.spawn_x, state.spawn_y, state.spawn_z)
    articles.create_at_position(It_Kind_Peach_ToadSpore, state.spawn_x, state.spawn_y + attrs.spore_height, 0, facing.direction, false)
    callbacks.accessory(None)

func reset_toad():
    command(0) = 0
    command(1) = 0
    command(2) = 0
    command(3) = 0
    state.toad_saved_facing = int(facing.direction)
    callbacks.accessory(create_toad)

func toad_setup_hit():
    if state.toad_handle != -1:
        callbacks.death2(cleanup_resources)
        callbacks.damage(cleanup_resources)
    callbacks.pre_hitlag(pause_toad)
    callbacks.post_hitlag(resume_toad)

func toad_setup_normal():
    if state.toad_handle != -1:
        callbacks.death2(cleanup_resources)
        callbacks.damage(cleanup_resources)
    # Source installs accessory before hitlag callbacks and guard recreation.
    callbacks.accessory(create_toad)
    callbacks.pre_hitlag(pause_toad)
    callbacks.post_hitlag(resume_toad)
    if command(1) == 2: install_toad_guard()

func toad_animation(bool air_started):
    if command(1) == 1:
        command(1) = 2
        install_toad_guard()
        guard.melee_hitlag = attrs.toad_guard_hitlag
        guard.article_hitlag = attrs.toad_guard_hitlag
    elif command(1) == 0:
        guard.active = false
    if animation.finished:
        if air_started: state.fall()
        else: state.wait()

func toad_hit_animation(bool air_started):
    if command(3) != 0:
        command(3) = 0
        callbacks.accessory(create_spore)
    if animation.finished:
        if air_started: state.fall()
        else: state.wait()

func toad_air_physics(bool hit_state):
    if hit_state:
        physics.fall(attrs.toad_gravity, attrs.toad_terminal_velocity)
    elif command(0) >= 1:
        if command(0) == 1:
            command(0) = 2
            if not state.toad_air_boost_used:
                state.toad_air_boost_used = true
                velocity.y = attrs.toad_air_initial_vertical_speed
            else:
                velocity.y = 0
        physics.fall(attrs.toad_gravity, attrs.toad_terminal_velocity)
    else:
        physics.fall_basic()
    physics.air_decel(attrs.toad_air_deceleration)
    if not hit_state: guard.update_position()

func GuardHit():
    state.toad_saved_facing = int(guard.hit_facing)
    let int hit_motion = attrs.toad_ground_hit_motion
    if airborne: hit_motion = attrs.toad_air_hit_motion
    state.enter_at_speed(hit_motion, 0, attrs.toad_hit_start_frame, 1)
    animation.start()
    if state.toad_handle != -1:
        articles.signal(state.toad_handle, It_Kind_Peach_Toad, "respond", 0)
    toad_setup_hit()

move Counter:
    on special_n:
        velocity.y = 0
        state.enter_at_speed(attrs.toad_ground_motion, 0, 0, 1)
        animation.start()
        reset_toad()
    on special_air_n:
        velocity.x = velocity.x / attrs.toad_air_horizontal_divisor
        state.enter_at_speed(attrs.toad_air_motion, 0, 0, 1)
        animation.start()
        reset_toad()
    on state_365_animation:
        toad_animation(false)
    on state_365_interrupt:
        return
    on state_365_physics:
        physics.ground_friction()
        guard.update_position()
    on state_365_collision:
        if collision.special_ground_lost:
            physics.ground_to_air()
            state.enter_at_speed(attrs.toad_air_motion, attrs.toad_collision_flags, frame, 1)
            if command(0) == 1: command(0) = 2
            toad_setup_normal()
    on state_366_animation:
        toad_hit_animation(false)
    on state_366_interrupt:
        return
    on state_366_physics:
        physics.ground_friction()
    on state_366_collision:
        if collision.special_ground_lost:
            physics.ground_to_air()
            state.enter_at_speed(attrs.toad_air_hit_motion, attrs.toad_collision_flags, frame, 1)
            toad_setup_hit()
    on state_367_animation:
        toad_animation(true)
    on state_367_interrupt:
        return
    on state_367_physics:
        toad_air_physics(false)
    on state_367_collision:
        if collision.landed:
            state.toad_air_boost_used = false
            physics.switch_to_ground()
            state.enter_at_speed(attrs.toad_ground_motion, attrs.toad_collision_flags, frame, 1)
            toad_setup_normal()
    on state_368_animation:
        toad_hit_animation(true)
    on state_368_interrupt:
        return
    on state_368_physics:
        toad_air_physics(true)
    on state_368_collision:
        if collision.landed:
            state.toad_air_boost_used = false
            physics.switch_to_ground()
            state.enter_at_speed(attrs.toad_ground_hit_motion, attrs.toad_collision_flags, frame, 1)
            toad_setup_hit()

article It_Kind_Peach_Toad states 2:
    parameter int first_counter_motion = 365
    parameter int last_counter_motion = 368
    parameter float show_frame = 7
    parameter float hide_frame = 53
    parameter float hit_hide_frame = 60
    parameter float response_animation_rate = 10
    parameter float normal_animation_rate = 1
    on signal discard_unattached:
            item.clear_current_owner()
            item.remove()
    on signal remove_cleanup:
            targets.call(item.current_owner, "forget_toad")
            item.remove()
    on destroyed:
            targets.call(item.current_owner, "forget_toad")
    on picked_up:
            item.change_state(0)
            item.advance_animation()
            item.hide_model()
            item.inherit_owner_scale()
    on signal respond:
            item.change_state(1)
            item.set_model_animation_rate(item.attr.response_animation_rate)
            item.advance_model_animation()
            item.set_model_animation_rate(item.attr.normal_animation_rate)
            item.inherit_owner_scale()
    on interaction:
            item.interact(other)
    state 0 anim 0:
        on animation:
            if item.animation_frame == item.attr.show_frame: item.show_model()
            if item.animation_frame >= item.attr.hide_frame: item.hide_model()
            if holder.motion < item.attr.first_counter_motion or holder.motion > item.attr.last_counter_motion:
                targets.call(item.current_owner, "forget_toad")
                return true
            return false
    state 1 anim 1:
        on animation:
            if item.animation_frame >= item.attr.hit_hide_frame: item.hide_model()
            # Stock hit-state expiry does not notify until destruction.
            return holder.motion < item.attr.first_counter_motion or holder.motion > item.attr.last_counter_motion

article It_Kind_Peach_ToadSpore states 1:
    attribute float minimum_speed 0
    attribute float speed_range 4
    attribute float speed_decay 8
    attribute float spread_angle 12
    parameter float initial_lifetime = 60
    parameter int root_effect = 1235
    on created:
            item.set_lifetime(item.attr.initial_lifetime)
            item.command0 = 0
            let float draw = random.float()
            let float speed = item.attr.minimum_speed + item.attr.speed_range * draw
            let float angle_draw = random.float()
            let float double_angle = float(pi) - item.attr.spread_angle
            let float angle_offset = item.attr.spread_angle * angle_draw
            let float angle = 0.5 * double_angle + angle_offset
            velocity.x = facing * (speed * sin(angle))
            velocity.y = speed * cos(angle)
            item.hide_model()
            item.use_manual_lifetime()
            item.spawn_root_effect(item.attr.root_effect)
            item.change_state(0)
            item.inherit_owner_debug_display()
    on damage_dealt:
            item.destroy_effects()
            return true
    on clanked:
            item.destroy_effects()
            return true
    on hit_shield:
            item.destroy_effects()
            return true
    on absorbed:
            item.destroy_effects()
            return true
    on shield_bounced:
            return item.shield_bounce()
    on reflected:
            let float saved_lifetime = item.life
            item.reflect()
            item.life = saved_lifetime
            return false
    on interaction:
            item.interact(other)
    state 0 anim 0:
        on animation:
            if item.command0 != 0: return true
            item.life = item.life - 1
            if item.life <= 0:
                item.life = 0
                return true
            return false
        on physics:
            velocity.x = velocity.x * item.attr.speed_decay
            velocity.y = velocity.y * item.attr.speed_decay

func continue_float_input() -> bool:
    return input.y >= controls.tap_jump_threshold or input.jump_held

func enter_float(bool reset_timer):
    # Original has no animation.start call at Float entry.
    state.enter_at_speed(attrs.float_motion, 0, 0, 1)
    state.has_float = false
    if reset_timer:
        state.float_timer = attrs.float_duration
    velocity.y = 0
    effects.active = true
    effects.spawn_async_attached(attrs.float_particle, TransN)

func leave_float_direction():
    let int destination = attrs.float_fall_backward_motion
    let float start = state.float_fall_backward_end
    if input.x * facing.direction > -controls.aerial_jump_reverse_threshold:
        destination = attrs.float_fall_forward_motion
        start = state.float_fall_forward_end
    state.enter_at_speed(destination, attrs.float_keep_graphics_flags, start - attrs.float_fall_start_offset, 1)

func begin_float_attack():
    # Called a second time after the gun test, matching original call order.
    let int selected = controls.aerial_attack_motion()
    state.float_attack_released = false
    controls.interrupt_allowed = false
    command(0) = 0
    cue.throw.reset()
    state.enter_at_speed(selected + attrs.float_attack_motion_offset, attrs.float_attack_transition_flags, 0, 1)
    animation.start()

func try_float_attack() -> bool:
    if input.attack_pressed or input.cstick_attack_edge():
        if state.float_timer > 0:
            let int selected = controls.aerial_attack_motion()
            if (selected == attrs.float_gun_forward_motion or selected == attrs.float_gun_neutral_motion) and items.held_id != -1 and items.held_use_category == attrs.float_gun_use_category:
                state.air_gun()
                return true
            begin_float_attack()
            return true
    return false

func float_landing():
    if velocity.y > collision.basic_landing_velocity_threshold:
        state.wait()
    else:
        state.basic_landing()

func float_attack_animation():
    if state.float_timer > 0:
        state.float_timer = state.float_timer - 1
    if cue.reverse.consume():
        facing.direction = -facing.direction
    if animation.finished:
        if state.float_attack_released:
            state.fall()
        else:
            enter_float(false)

func float_attack_interrupt():
    if not continue_float_input():
        state.float_attack_released = true
    if controls.interrupt_allowed and not controls.try_air_item_throw():
        if not try_float_attack():
            controls.try_aerial_jump()

func float_attack_physics():
    if state.float_attack_released:
        physics.air_drift()
    else:
        physics.air_accel_normal()

move FloatPolicies:
    on grounded_motion_setup:
        state.has_float = true
    on aerial_action_manual:
        if input.y <= -controls.aerial_action_down_threshold and input.jump_held and state.has_float:
            enter_float(true)
            return true
        return false
    on aerial_action_automatic:
        if velocity.y <= 0 and state.has_float and continue_float_input():
            enter_float(true)
            return true
        return false
    on state_341_animation:
        if state.float_timer > 0:
            state.float_timer = state.float_timer - 1
        if state.float_timer <= 0:
            leave_float_direction()
    on state_341_interrupt:
        if not controls.try_air_special() and not try_float_attack():
            if not continue_float_input():
                leave_float_direction()
    on state_341_physics:
        physics.air_accel_normal()
    on state_341_collision:
        collision.air_landing_callback(float_landing)
    on state_342_animation:
        if animation.finished:
            state.fall_aerial()
    on state_342_interrupt:
        return
    on state_342_physics:
        physics.air_accel_normal()
        physics.animation_vertical_velocity_adjusted()
    on state_342_collision:
        collision.air_landing_callback(float_landing)
    on state_343_animation:
        if animation.finished:
            state.fall_aerial()
    on state_343_interrupt:
        return
    on state_343_physics:
        physics.air_accel_normal()
        physics.animation_vertical_velocity_adjusted()
    on state_343_collision:
        collision.air_landing_callback(float_landing)
    on state_344_animation:
        float_attack_animation()
    on state_344_interrupt:
        float_attack_interrupt()
    on state_344_physics:
        float_attack_physics()
    on state_344_collision:
        # LandingAir_EnterWithLag's nonstandard-motion fallback is basic landing.
        if collision.landed:
            state.basic_landing()
    on state_345_animation:
        float_attack_animation()
    on state_345_interrupt:
        float_attack_interrupt()
    on state_345_physics:
        float_attack_physics()
    on state_345_collision:
        if collision.landed:
            state.basic_landing()
    on state_346_animation:
        float_attack_animation()
    on state_346_interrupt:
        float_attack_interrupt()
    on state_346_physics:
        float_attack_physics()
    on state_346_collision:
        if collision.landed:
            state.basic_landing()
    on state_347_animation:
        float_attack_animation()
    on state_347_interrupt:
        float_attack_interrupt()
    on state_347_physics:
        float_attack_physics()
    on state_347_collision:
        if collision.landed:
            state.basic_landing()
    on state_348_animation:
        float_attack_animation()
    on state_348_interrupt:
        float_attack_interrupt()
    on state_348_physics:
        float_attack_physics()
    on state_348_collision:
        if collision.landed:
            state.basic_landing()


func side_start_reset():
    command(0) = 0
    command(1) = 0
    command(2) = 0
    command(3) = 0
    velocity.x = 0
    animation.delta.x = 0
    if input.horizontal_smash_age < attrs.side_smash_age_limit:
        stats.count_as_thrown_item()
        state.side_smash = true
    else:
        state.side_smash = false

func side_face_velocity():
    ground.velocity = facing.direction * abs(ground.velocity)
    velocity.x = facing.direction * abs(velocity.x)

func side_reverse_velocity():
    ground.velocity = -facing.direction * abs(ground.velocity)
    velocity.x = -facing.direction * abs(velocity.x)

func side_post_end():
    if command(2) != 0:
        bones.world_position(attrs.side_explosion_joint, state.spawn_x, state.spawn_y, state.spawn_z)
        state.spawn_z = 0
        let int explosion = create_explosion(state.spawn_x, state.spawn_y, state.spawn_z, state.side_smash)
        velocity.x = attrs.side_rebound_horizontal_speed * facing.direction
        velocity.y = attrs.side_rebound_vertical_speed
    callbacks.reflect(side_reverse_velocity)

func side_ground_end():
    state.enter_at_speed(attrs.side_ground_end_motion, 0, 0, 1)
    side_post_end()

func side_air_end():
    velocity.x = velocity.x / attrs.side_end_horizontal_divisor
    velocity.y = velocity.y / attrs.side_end_vertical_divisor
    let int destination = attrs.side_air_end_motion
    if command(2) != 0:
        destination = attrs.side_air_rebound_motion
    state.enter_at_speed(destination, 0, 0, 1)
    side_post_end()

func side_air_jump():
    let float speed = attrs.side_jump_horizontal_speed
    if state.side_smash:
        speed = attrs.side_smash_horizontal_speed
    velocity.x = speed * facing.direction
    velocity.y = attrs.side_jump_vertical_speed
    state.enter_at_speed(attrs.side_air_jump_motion, 0, 0, 1)
    callbacks.reflect(side_face_velocity)
    callbacks.track_hurtbox_detect()

func side_rebound():
    if not collision.contact_rebound_allowed():
        return
    velocity.x = 0
    if velocity.y >= 0:
        velocity.y = 0
    command(2) = 1
    side_air_end()

func side_start_acceleration():
    # Exact common AccelToVel math; LStick-scaled ground_accel is different.
    let float acceleration = attrs.side_ground_acceleration * facing.direction
    let float target = attrs.side_ground_target_speed * facing.direction
    if target == 0:
        acceleration = -ground.velocity
    elif not (ground.velocity * acceleration < 0):
        if acceleration > 0:
            if ground.velocity + acceleration > target:
                acceleration = target - ground.velocity
        elif ground.velocity + acceleration < target:
            acceleration = target - ground.velocity
    ground.acceleration = acceleration
    physics.ground_to_self()

func side_start_wall_contact() -> bool:
    return (collision.right_wall and facing.direction == -1) or (collision.left_wall and facing.direction == 1)

move SideBPolicies:
    on special_s:
        callbacks.state_changed(side_start_reset)
        velocity.y = 0
        ground.velocity = attrs.side_ground_start_speed * facing.direction
        state.enter_at_speed(attrs.side_ground_start_motion, 0, 0, 1)
        animation.start()
    on special_air_s:
        callbacks.state_changed(side_start_reset)
        velocity.y = attrs.side_air_start_vertical_speed
        state.enter_at_speed(attrs.side_air_start_motion, 0, 0, 1)
        animation.start()
    on hurtbox_detect:
        side_rebound()
    on state_354_animation:
        if animation.finished:
            if command(0) != 0:
                side_ground_end()
            else:
                physics.ground_to_air()
                position.x = position.x + attrs.side_ground_launch_offset_x * facing.direction * model.instance_scale_y
                position.y = position.y + attrs.side_ground_launch_offset_y * model.instance_scale_y
                side_air_jump()
    on state_354_interrupt:
        return
    on state_354_physics:
        side_start_acceleration()
    on state_354_collision:
        if collision.special_ground_lost:
            velocity.x = 0
            physics.ground_to_air()
            state.enter_at_speed(attrs.side_air_start_motion, attrs.side_start_transition_flags, frame, 1)
        # Original continues these tests after transition.
        if side_start_wall_contact():
            ground.velocity = 0
            command(0) = 1
    on state_357_animation:
        if animation.finished:
            if command(0) != 0:
                side_air_end()
            else:
                side_air_jump()
    on state_357_interrupt:
        return
    on state_357_physics:
        physics.air_gravity_and_friction()
    on state_357_collision:
        if collision.landed:
            physics.switch_to_ground()
            state.enter_at_speed(attrs.side_ground_start_motion, attrs.side_start_transition_flags, frame, 1)
        if collision.ceiling_contact:
            velocity.y = 0
            command(0) = 1
        if side_start_wall_contact():
            velocity.x = 0
            command(0) = 1
    on state_360_animation:
        if command(3) != 0 or animation.finished:
            side_air_end()
    on state_360_interrupt:
        return
    on state_360_physics:
        if command(1) != 0:
            physics.air_decel(attrs.side_jump_deceleration)
        let float gravity = attrs.side_jump_gravity
        if command(1) != 0:
            gravity = attrs.side_jump_braking_gravity
        physics.fall(gravity, attrs.side_jump_terminal_velocity)
    on state_360_collision:
        if collision.landed:
            physics.switch_to_ground()
            side_ground_end()
        if side_start_wall_contact():
            command(2) = 1
            side_air_end()
    on state_355_animation:
        if animation.finished:
            state.wait()
    on state_355_interrupt:
        return
    on state_355_physics:
        physics.ground_friction()
    on state_355_collision:
        if collision.left_ground:
            physics.ground_to_air()
            state.enter_at_speed(attrs.side_air_end_motion, attrs.side_end_transition_flags, frame, 1)
    on state_358_animation:
        if animation.finished:
            state.fall()
    on state_358_interrupt:
        return
    on state_358_physics:
        physics.air_gravity_and_friction()
    on state_358_collision:
        if collision.landed:
            physics.switch_to_ground()
            state.enter_at_speed(attrs.side_ground_end_motion, attrs.side_end_transition_flags, frame, 1)
    on state_359_animation:
        if animation.finished:
            state.fall()
    on state_359_interrupt:
        return
    on state_359_physics:
        physics.air_gravity_and_friction()
    on state_359_collision:
        if collision.landed:
            physics.switch_to_ground()
            state.enter_at_speed(attrs.side_ground_end_motion, attrs.side_end_transition_flags, frame, 1)


func pause_parasol():
    if state.parasol_handle != -1:
        let bool paused = items.set_paused(state.parasol_handle, true)

func resume_parasol():
    if state.parasol_handle != -1:
        let bool resumed = items.set_paused(state.parasol_handle, false)

func prepare_hi_request():
    command(0) = 0
    command(1) = 0
    command(2) = 0
    cue.throw.reset()
    state.parasol_request_kind = It_Kind_Capsule
    damage.song_immune = true
    if items.held_id != -1:
        if items.held_kind == It_Kind_Parasol:
            state.parasol_request_kind = It_Kind_Parasol
            return
        if items.held_kind == It_Kind_Peach_Parasol:
            state.parasol_request_kind = It_Kind_Peach_Parasol
            return
    # Reuse accepted producer body with final two named hitlag bindings.
    callbacks.accessory(create_parasol)

func hi_start_interrupt():
    let float horizontal = abs(input.x)
    if command(0) == 0 and horizontal > attrs.parasol_hi_tilt_threshold:
        let float degrees = attrs.parasol_hi_max_tilt_degrees * ((horizontal - attrs.parasol_hi_tilt_threshold) / (1 - attrs.parasol_hi_tilt_threshold))
        let float angle = degrees * attrs.parasol_hi_degrees_to_radians
        if input.x > 0:
            angle = -angle
        if abs(angle) > abs(motion.launch_angle):
            motion.launch_angle = angle
    if cue.reverse.consume() and abs(input.x) > attrs.parasol_hi_reverse_threshold:
        if input.x >= 0:
            facing.direction = 1
        else:
            facing.direction = -1
        bones.root.rotate_y(attrs.parasol_hi_root_quarter_turn * facing.direction)

func hi_landing():
    state.landing_special(false, attrs.parasol_hi_landing_lag)

func hi_collision():
    if airborne:
        if command(0) == 0 or velocity.y >= 0:
            collision.air_standard()
        else:
            collision.air_landing_callback(hi_landing)
    else:
        collision.ground_standard()

func hi_end_animation():
    if animation.finished:
        state.freefall(0, 1, false, attrs.parasol_hi_fall_drift, attrs.parasol_hi_landing_lag)

func hi_ground_started_physics():
    if airborne:
        physics.air_motion()
    else:
        physics.ground_motion()

func hi_air_started_physics():
    if command(0) != 0:
        physics.air_motion()
        velocity.x = velocity.x * attrs.parasol_hi_animation_velocity_multiplier
        velocity.y = velocity.y * attrs.parasol_hi_animation_velocity_multiplier
        velocity.z = velocity.z * attrs.parasol_hi_animation_velocity_multiplier
    else:
        physics.fall(attrs.parasol_hi_prelaunch_gravity, air.terminal_velocity)
        physics.quick_air_decel()

func hi_ground_end_physics():
    if airborne:
        let float retained_y = velocity.y
        physics.air_motion()
        velocity.y = retained_y
        physics.fall(air.gravity, air.terminal_velocity)
    else:
        physics.ground_motion()

func hi_air_end_physics():
    let float retained_y = velocity.y
    physics.air_motion()
    velocity.x = velocity.x * attrs.parasol_hi_animation_velocity_multiplier
    velocity.y = velocity.y * attrs.parasol_hi_animation_velocity_multiplier
    velocity.z = velocity.z * attrs.parasol_hi_animation_velocity_multiplier
    velocity.y = retained_y
    physics.fall(air.gravity, air.terminal_velocity)

func hi_start_animation():
    if command(2) != 0:
        command(2) = 0
    if animation.finished:
        motion.id = Motion.fall_special
        state.held_open(10)

move ParasolTravelPolicies:
    on special_hi:
        state.enter_at_speed(attrs.parasol_hi_ground_start_motion, 0, 0, 1)
        animation.start()
        prepare_hi_request()
    on special_air_hi:
        velocity.y = 0
        velocity.x = velocity.x * attrs.parasol_hi_air_entry_horizontal_multiplier
        state.enter_at_speed(attrs.parasol_hi_air_start_motion, 0, 0, 1)
        animation.start()
        prepare_hi_request()
    on neutral_enter:
        # Native neutral entry selects the actual held instance, not the saved creator handle.
        if items.held_id != -1 and items.held_kind == It_Kind_Peach_Parasol:
            let bool notified = items.notify_held_neutral()
    on landing_action:
        state.toad_air_boost_used = false
        # Landing differs: source cleanup selects the retained owned Parasol.
        if event.interrupt_allowed:
            cleanup_parasol()
    on held_motion:
        if state.parasol_handle != -1:
            if event.motion == Motion.held_open:
                return int(369)
            if event.motion == Motion.held_fall_special:
                return int(370)
        return event.motion
    on held_timer_expired:
        if items.held_id != -1 and items.held_kind == It_Kind_Peach_Parasol:
            items.reopen_blocked = true
            state.freefall(1, 0, true, 1, movement.special_landing_lag)
            return true
        return false
    on air_resume_motion:
        if event.previous_motion == 370:
            return Motion.held_fall_special
        return event.previous_motion
    on state_361_animation:
        hi_start_animation()
    on state_361_interrupt:
        hi_start_interrupt()
    on state_361_physics:
        hi_ground_started_physics()
    on state_361_collision:
        hi_collision()
    on state_362_animation:
        hi_end_animation()
    on state_362_interrupt:
        pass
    on state_362_physics:
        hi_ground_end_physics()
    on state_362_collision:
        hi_collision()
    on state_363_animation:
        hi_start_animation()
    on state_363_interrupt:
        hi_start_interrupt()
    on state_363_physics:
        hi_air_started_physics()
    on state_363_collision:
        hi_collision()
    on state_364_animation:
        hi_end_animation()
    on state_364_interrupt:
        pass
    on state_364_physics:
        hi_air_end_physics()
    on state_364_collision:
        hi_collision()
