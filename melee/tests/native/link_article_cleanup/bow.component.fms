            item.state.shield_radius = targets.model_scale(item.state.shield_target) * item.state.shield_radius
            position.x = item.state.shield_radius * cos(item.state.shield_angle) + item.state.shield_x
            position.y = item.state.shield_radius * sin(item.state.shield_angle) + item.state.shield_y
            position.z = 0
    on created:
            item.command0 = 0
            item.command1 = 0
            item.command2 = 0
            item.command3 = 0
