                item.use_manual_lifetime()
                item.state.speed = item.state.charge * ((item.params.maximum_speed - item.params.minimum_speed) / signal.value) + item.params.minimum_speed
                item.state.damage = int(uint(item.state.charge * ((item.params.maximum_damage - item.params.minimum_damage) / signal.value) + item.params.minimum_damage))
                facing = owner.facing
                item.joint("").rotation.y = (pi * 0.5) * facing
                item.signal("held_positions", 0)
                velocity.x = facing * (item.state.speed * cos(item.state.angle))
                velocity.y = item.state.speed * sin(item.state.angle)
