# UNREGISTERED constructor composition; no Peach clone/runtime acceptance.
# This action-only source needs no stock base in the source-fixture generator.
# Full Float/Parasol/Toad/global cleanup and Turnip motion lifecycle remain out
# of scope. The damage/death helper below owns only the Turnip resource.
parameter int rare_roll_bound = 128
parameter int rare_count = 3
parameter int rare_weight_0 = 2
parameter int rare_kind_0 = 6
parameter int rare_weight_1 = 3
parameter int rare_kind_1 = 7
parameter int rare_weight_2 = 1
parameter int rare_kind_2 = 12
parameter int spawn_position_joint = 109
parameter int held_attachment_joint = 109
state int vegetable_handle
state int vegetable_kind
state float spawn_x
state float spawn_y
state float spawn_z

export func forget_vegetable():
    state.vegetable_handle = -1

func interrupt_vegetable():
    if articles.ref(state.vegetable_handle, It_Kind_Peach_Turnip).exists:
        if items.held_id == state.vegetable_handle and items.held_kind == It_Kind_Peach_Turnip:
            articles.remove_owned(state.vegetable_handle)
            forget_vegetable()

func choose_vegetable():
    state.vegetable_kind = It_Kind_Peach_Turnip
    if random.int(attrs.rare_roll_bound) == 0:
        let int total = attrs.rare_weight_0
        if attrs.rare_count >= 2: total = total + attrs.rare_weight_1
        if attrs.rare_count >= 3: total = total + attrs.rare_weight_2
        let int draw = random.int(total)
        state.vegetable_kind = attrs.rare_kind_0
        if attrs.rare_count >= 2 and draw >= attrs.rare_weight_0:
            state.vegetable_kind = attrs.rare_kind_1
        if attrs.rare_count >= 3 and draw >= attrs.rare_weight_0 + attrs.rare_weight_1:
            state.vegetable_kind = attrs.rare_kind_2
        # Selection and RNG order match. The unused source read of the next
        # weight after a result is selected (including entry3) is omitted.

func construct_vegetable():
    bones.world_position(attrs.spawn_position_joint, state.spawn_x, state.spawn_y, state.spawn_z)
    choose_vegetable()
    let int created_handle = -1
    if state.vegetable_kind == It_Kind_Peach_Turnip:
        # on_created performs type/lifetime/flag initialization BEFORE AB54.
        created_handle = articles.create_at_position(It_Kind_Peach_Turnip, state.spawn_x, state.spawn_y, state.spawn_z, facing.direction, false)
    else:
        # Ordinary engine callbacks/assets, not fake authored Bomb/Saturn/Sword.
        created_handle = items.create_engine(state.vegetable_kind, state.spawn_x, state.spawn_y, state.spawn_z, 0, 0, 0, facing.direction, 0, 0)
    if created_handle != -1:
        let bool attached = items.attach(created_handle, attrs.held_attachment_joint, false)
        if not attached:
            created_handle = -1
        elif state.vegetable_kind != It_Kind_Sword:
            let bool inherited = items.inherit_owner_scale(created_handle, true)
            if not inherited: created_handle = -1
    # Stock setupVeg publishes NULL on allocation failure as well as success.
    items.clear_held()
    state.vegetable_handle = created_handle
    if created_handle != -1:
        let bool bound = items.bind_held(created_handle)
        if bound:
            items.notify_pickup(false)
            effects.spawn_at_position(1234, position.x, position.y, position.z)
            callbacks.death2(interrupt_vegetable)
            callbacks.damage(interrupt_vegetable)

action ConstructorProbe:
    # Test-only entry maps the real spawnVeg accessory invocation to tick.
    on tick:
        if cue.article.consume(): construct_vegetable()

article It_Kind_Peach_Turnip states 5:
    parameter float lifetime = 140
    parameter int face_count = 8
    parameter int face_weight_0 = 35
    parameter int face_damage_0 = 2
    parameter int face_weight_1 = 6
    parameter int face_damage_1 = 2
    parameter int face_weight_2 = 5
    parameter int face_damage_2 = 2
    parameter int face_weight_3 = 3
    parameter int face_damage_3 = 2
    parameter int face_weight_4 = 3
    parameter int face_damage_4 = 2
    parameter int face_weight_5 = 4
    parameter int face_damage_5 = 6
    parameter int face_weight_6 = 1
    parameter int face_damage_6 = 12
    parameter int face_weight_7 = 1
    parameter int face_damage_7 = 30
    state int face
    state int face_damage
    state bool picked_up_once
    on created:
            item.set_lifetime(item.attr.lifetime)
            let int total = item.attr.face_weight_0
            if item.attr.face_count >= 2:
                total = total + item.attr.face_weight_1
            if item.attr.face_count >= 3:
                total = total + item.attr.face_weight_2
            if item.attr.face_count >= 4:
                total = total + item.attr.face_weight_3
            if item.attr.face_count >= 5:
                total = total + item.attr.face_weight_4
            if item.attr.face_count >= 6:
                total = total + item.attr.face_weight_5
            if item.attr.face_count >= 7:
                total = total + item.attr.face_weight_6
            if item.attr.face_count >= 8:
                total = total + item.attr.face_weight_7
            let int draw = random.int(total)
            let int cumulative = item.attr.face_weight_0
            item.state.face = 0
            item.state.face_damage = item.attr.face_damage_0
            if item.attr.face_count >= 2 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_1
                item.state.face = 1
                item.state.face_damage = item.attr.face_damage_1
            if item.attr.face_count >= 3 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_2
                item.state.face = 2
                item.state.face_damage = item.attr.face_damage_2
            if item.attr.face_count >= 4 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_3
                item.state.face = 3
                item.state.face_damage = item.attr.face_damage_3
            if item.attr.face_count >= 5 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_4
                item.state.face = 4
                item.state.face_damage = item.attr.face_damage_4
            if item.attr.face_count >= 6 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_5
                item.state.face = 5
                item.state.face_damage = item.attr.face_damage_5
            if item.attr.face_count >= 7 and draw >= cumulative:
                cumulative = cumulative + item.attr.face_weight_6
                item.state.face = 6
                item.state.face_damage = item.attr.face_damage_6
            if item.attr.face_count >= 8 and draw >= cumulative:
                item.state.face = 7
                item.state.face_damage = item.attr.face_damage_7
            item.state.picked_up_once = false
            item.subaction_sounds_muted = true
    on picked_up:
            item.set_appearance(0, float(item.state.face))
            if item.state.picked_up_once:
                item.change_state(4)
            else:
                item.change_state(0)
                item.subaction_sounds_muted = false
            item.state.picked_up_once = true
            item.advance_animation()
    on destroyed:
            creator.call(forget_vegetable)
    # Motion phases are deliberately UNAUTHORED in this unregistered
    # constructor fixture. This is not an activatable article override.

    state 0 anim 1:
    state 1 anim -1:
    state 2 anim 2:
    state 3 anim 2:
    state 4 anim -1:
