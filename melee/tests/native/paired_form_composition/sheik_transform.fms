# Unregistered complete Transform component. SDK67 generic partner transfer.
# Named per-form parameters/state persist when the dormant member activates.
# DECLARATIONS
attribute float transform_horizontal_divisor 96
attribute float transform_vertical_divisor 100
attribute float transform_gravity 104
attribute float transform_terminal 108
attribute float transform_finish_frame 112
parameter int transform_origin_joint = 0
parameter int transform_start_joint = 43
parameter int transform_finish_joint = 4
parameter int transform_start_effect = 1276
parameter int transform_finish_effect = 1277
parameter int transform_wind_frames = 120
parameter float transform_wind_strength = 0.4
parameter float transform_wind_decay = 0.003
parameter float transform_wind_frequency = 1.0471975511965976

# FUNCTIONS
func transform_start_effect():
    if not effects.active:
        effects.spawn_on_part(attrs.transform_start_effect, attrs.transform_start_joint)
        effects.active = true
    effects.pause_during_hitlag()
    callbacks.accessory(None)

func transform_finish_effect():
    if not effects.active:
        effects.spawn_on_part(attrs.transform_finish_effect, attrs.transform_finish_joint)
        effects.active = true
    effects.pause_during_hitlag()
    callbacks.accessory(None)

func transform_transfer():
    callbacks.accessory(None)
    # The destination invokes its own form_activated policy. Do not write the
    # source after activation: it normally survives, but is now dormant.
    forms.activate_partner()
    return

func transform_start():
    command(0) = 0
    velocity.x = velocity.x / attrs.transform_horizontal_divisor
    velocity.y = velocity.y / attrs.transform_vertical_divisor
    ground.velocity = ground.velocity / attrs.transform_horizontal_divisor
    let float x = 0
    let float y = 0
    let float z = 0
    bones.world_position(attrs.transform_origin_joint, x, y, z)
    effects.wind_at_position(x, y, z, attrs.transform_wind_frames, attrs.transform_wind_strength, attrs.transform_wind_decay, attrs.transform_wind_frequency)
    callbacks.accessory(transform_start_effect)

# CALLBACKS
move Down:
    on special_lw:
        state.enter_at_speed(361, 0, 0, 1)
        animation.start()
        transform_start()
    on special_air_lw:
        state.enter_at_speed(363, 0, 0, 1)
        animation.start()
        transform_start()
    on form_activated:
        if airborne: state.enter_at_speed(364, 0, attrs.transform_finish_frame, 1)
        else: state.enter_at_speed(362, 0, attrs.transform_finish_frame, 1)
        # Stock finish does not restart/reset the animation after this entry.
        callbacks.accessory(transform_finish_effect)
    on state_361_animation:
        if animation.finished:
            callbacks.accessory(transform_transfer)
    on state_362_animation:
        if animation.finished:
            state.wait()
    on state_363_animation:
        if animation.finished:
            callbacks.accessory(transform_transfer)
    on state_364_animation:
        if animation.finished:
            state.fall()
    on state_361_interrupt:
        pass
    on state_362_interrupt:
        pass
    on state_363_interrupt:
        pass
    on state_364_interrupt:
        pass
    on state_361_physics:
        physics.ground_friction()
    on state_362_physics:
        physics.ground_friction()
    on state_363_physics:
        physics.fall(attrs.transform_gravity, attrs.transform_terminal)
        physics.air_decel_normal()
    on state_364_physics:
        physics.fall(attrs.transform_gravity, attrs.transform_terminal)
        physics.air_decel_normal()
    on state_361_collision:
        if collision.left_ground:
            state.switch_to_air(363, 0x0c4c508e)
            callbacks.accessory(transform_start_effect)
    on state_362_collision:
        if collision.left_ground:
            state.switch_to_air(364, 0x0c4c508e)
            callbacks.accessory(transform_finish_effect)
    on state_363_collision:
        if collision.landed:
            state.switch_to_ground(361, 0x0c4c508e)
            callbacks.accessory(transform_start_effect)
    on state_364_collision:
        if collision.landed:
            state.switch_to_ground(362, 0x0c4c508e)
            callbacks.accessory(transform_finish_effect)
