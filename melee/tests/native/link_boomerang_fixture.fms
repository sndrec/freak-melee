                elif item.state.turn_timer <= 0:
                    return
                item.state.temporary_z = atan2(item.state.dy, item.state.dx)
                if item.state.temporary_z < -pi:
                    item.state.temporary_z = item.state.temporary_z + tau
                elif item.state.temporary_z > pi:
                    item.state.temporary_z = item.state.temporary_z - tau
                item.state.temporary_z = item.state.temporary_z - item.state.angle
                if item.state.temporary_z < -pi:
                    item.state.temporary_z = item.state.temporary_z + tau
                elif item.state.temporary_z > pi:
                    item.state.temporary_z = item.state.temporary_z - tau
                if item.state.temporary_z > item.state.maximum_turn:
                    item.state.temporary_z = item.state.maximum_turn
                elif item.state.temporary_z < -item.state.maximum_turn:
                    item.state.temporary_z = -item.state.maximum_turn
                item.state.angle = item.state.angle + item.state.temporary_z
                if item.state.angle > tau:
                    item.state.angle = item.state.angle - tau
                elif item.state.angle < -tau:
                    item.state.angle = item.state.angle + tau
                if facing == 1:
                    item.state.render_angle = item.state.angle
                else:
                    item.state.render_angle = item.state.angle - pi
    on signal launch:
            if creator.state.boomerang_smash:
                item.set_lifetime(float(uint(item.attr.smash_lifetime)))
            else:
                item.set_lifetime(float(uint(item.attr.lifetime)))
            item.state.angle = signal.value
            if facing == 1:
                item.state.render_angle = item.state.angle
            else:
                item.state.render_angle = item.state.angle - pi
            creator.state.boomerang_held = false
            item.change_state_flags(1, 2)
            item.read_attachment_matrix_rotation(item.state.saved_qx, item.state.saved_qy, item.state.saved_qz)
            # Stock writes only XYZ into an uninitialized Quaternion; initialize W=0.
            # Euler joints ignore W; source comparisons exclude that undefined lane.
            item.state.saved_qw = 0
            item.release_attachment(creator.state.boomerang_offset_x, creator.state.boomerang_offset_y, 0, true)
            item.use_manual_lifetime()
            item.joint("").rotation.z = item.state.render_angle
            item.set_joint_transform(0, "0", item.joint("0").translation.x, item.joint("0").translation.y, item.joint("0").translation.z, item.state.saved_qx, item.state.saved_qy, item.state.saved_qz, item.state.saved_qw, item.joint("0").scale.x, item.joint("0").scale.y, item.joint("0").scale.z, false)
            item.set_model_animation_rate(0, "0", item.attr.launch_animation_rate)
            item.set_model_animation_rate(1, "", item.attr.launch_animation_rate)
            item.set_model_animation_rate(2, "", item.attr.launch_animation_rate)
    on created:
            item.set_lifetime(float(uint(item.attr.lifetime)))
            item.command0 = 0
            item.command1 = 0
            item.command2 = 0
            item.state.bounce_cosine = -sin(0.01745329238474369 * item.attr.bounce_angle_degrees)
            item.state.mode = 0
            item.state.sound_timer = 0
            item.state.trail_timer = item.attr.first_trail_delay
            item.state.index = 0
            while item.state.index < 16:
                item.state.history_x[item.state.index] = 0
                item.state.history_y[item.state.index] = 0
                item.state.history_z[item.state.index] = 0
                item.state.history_rx[item.state.index] = 0
                item.state.history_ry[item.state.index] = 0
