# UNREGISTERED Boomerang fighter phases. Damage cleanup remains lifecycle-gated.
attribute float boomerang_stick_deadzone 20
attribute float boomerang_angle_factor 24
attribute float boomerang_angle_scale 28
attribute float boomerang_smash_launch_speed 32
attribute float boomerang_launch_speed 36
attribute float boomerang_vertical_offset 40
attribute int boomerang_kind 44
state bool boomerang_initialized
state bool boomerang_used
state bool boomerang_smash
state bool boomerang_held
state int boomerang_handle
state int boomerang_joint
state float boomerang_vertical_offset
state float boomerang_angle
state float boomerang_angle_limit
state float boomerang_offset_x
state float boomerang_offset_y

func boomerang_unset():
    state.boomerang_used = false
    state.boomerang_handle = -1

func boomerang_remove():
    if articles.owned(state.boomerang_handle):
        articles.signal_owned(state.boomerang_handle, "remove", 0)
        boomerang_unset()

func boomerang_damage():
    boomerang_remove()
    # GATE: add authored Hookshot, Arrow, Bow and milk cleanup in source order.
    # No unported native handler or raw union-reference fallback is allowed.

func boomerang_smash_input():
    if abs(input.x) >= controls.horizontal_smash_threshold and input.horizontal_smash_age < controls.horizontal_smash_window + controls.horizontal_smash_extension:
        stats.count_as_thrown_item()
        state.boomerang_smash = true
    else:
        state.boomerang_smash = false

func boomerang_angle(float speed):
    state.boomerang_angle = 0
    state.boomerang_angle_limit = attrs.boomerang_angle_factor * attrs.boomerang_angle_scale
    if abs(input.y) > attrs.boomerang_stick_deadzone:
        # atan2f is required here; ordinary atan2 retains double semantics.
        state.boomerang_angle = atan2_float(input.y, abs(input.x))
        if state.boomerang_angle > state.boomerang_angle_limit:
            state.boomerang_angle = state.boomerang_angle_limit
        elif state.boomerang_angle < -state.boomerang_angle_limit:
            state.boomerang_angle = -state.boomerang_angle_limit
    state.boomerang_offset_x = facing.direction * (speed * cos(state.boomerang_angle))
    state.boomerang_offset_y = facing.direction * (speed * sin(state.boomerang_angle))
    if facing.direction == -1:
        if state.boomerang_angle < 0:
            state.boomerang_angle = -pi - state.boomerang_angle
        else:
            state.boomerang_angle = pi - state.boomerang_angle
    if state.boomerang_angle < 0:
        state.boomerang_angle = state.boomerang_angle + (2 * pi)

func boomerang_accessory():
    if cue.article.consume():
        # The creation callback sees the original absent reference.
        state.boomerang_handle = articles.spawn_bone_attached(attrs.boomerang_kind, LeftThumb)
        if articles.owned(state.boomerang_handle):
            state.boomerang_used = true
            callbacks.death3(boomerang_remove)
            callbacks.damage(boomerang_damage)
    if command(0) != 0 and articles.owned(state.boomerang_handle) and state.boomerang_held:
        if state.boomerang_smash:
            boomerang_angle(attrs.boomerang_smash_launch_speed)
        else:
            boomerang_angle(attrs.boomerang_launch_speed)
        articles.signal_owned(state.boomerang_handle, "launch", state.boomerang_angle)
        command(0) = 0
        command(1) = 0

func boomerang_enter(bool air_started):
    if not state.boomerang_initialized:
        state.boomerang_initialized = true
        state.boomerang_handle = -1
        state.boomerang_used = false
    state.boomerang_joint = bones.index(LeftThumb)
    state.boomerang_vertical_offset = attrs.boomerang_vertical_offset
    cue.throw.reset()
    command(0) = 0
    callbacks.state_changed(boomerang_smash_input)
    if air_started:
        if state.boomerang_used:
            state.change(355, 0, 0, 1)
        else:
            state.change(353, 0, 0, 1)
    else:
        if state.boomerang_used:
            state.change(352, 0, 0, 1)
        else:
            state.change(350, 0, 0, 1)
    animation.start()
    callbacks.accessory(boomerang_accessory)

func boomerang_catch():
    if grounded:
        state.change(351, 0, 0, 1)
    else:
        state.change(354, 0, 0, 1)
    callbacks.damage(boomerang_damage)
    animation.start()

func boomerang_finish(bool air_started):
    if animation.finished:
        if air_started:
            state.fall()
        else:
            state.wait()

func boomerang_catch_animation(bool air_started):
    if command(1) != 0:
        boomerang_remove()
        command(1) = 0
    boomerang_finish(air_started)

func boomerang_ground_interrupt():
    # Stock short-circuit order, with identical individual common checks.
    if controls.try_side_special():
        boomerang_remove()
        return
    if controls.try_up_special():
        boomerang_remove()
        return
    if controls.try_neutral_special():
        boomerang_remove()
        return
    if controls.try_down_special():
        boomerang_remove()
        return
    if controls.try_guard():
        boomerang_remove()
        return
    if controls.try_ground_jump():
        boomerang_remove()
        return
    if controls.try_dash():
        boomerang_remove()

func boomerang_air_interrupt():
    if controls.try_air_special():
        boomerang_remove()
        return
    if controls.try_air_jump():
        boomerang_remove()

func boomerang_ground_collision(int air_motion, bool accessory):
    if collision.left_ground:
        physics.ground_to_air()
        state.change(air_motion, 0x0C4C5080, frame, 1)
        if accessory:
            callbacks.accessory(boomerang_accessory)

func boomerang_air_collision(int ground_motion, bool accessory):
    if collision.landed:
        physics.air_to_ground()
        state.change(ground_motion, 0x0C4C5080, frame, 1)
        if accessory:
            callbacks.accessory(boomerang_accessory)

move Boomerang:
    entry explicit
    on special_s:
        boomerang_enter(false)
    on special_air_s:
        boomerang_enter(true)
    on ground_animation:
        boomerang_finish(false)
    on air_animation:
        boomerang_finish(true)
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_gravity_and_friction()
    on ground_collision:
        boomerang_ground_collision(353, true)
    on air_collision:
        boomerang_air_collision(350, true)

action BoomerangPhases:
    on state_351_animation:
        boomerang_catch_animation(false)
    on state_351_interrupt:
        boomerang_ground_interrupt()
    on state_351_physics:
        physics.ground_friction()
    on state_351_collision:
        if collision.left_ground:
            boomerang_remove()
            state.fall()
    on state_352_animation:
        boomerang_finish(false)
    on state_352_physics:
        physics.ground_friction()
    on state_352_collision:
        boomerang_ground_collision(355, false)
    on state_354_animation:
        boomerang_catch_animation(true)
    on state_354_interrupt:
        boomerang_air_interrupt()
    on state_354_physics:
        physics.air_gravity_and_friction()
    on state_354_collision:
        if collision.landed:
            boomerang_remove()
            state.basic_landing()
    on state_355_animation:
        boomerang_finish(true)
    on state_355_physics:
        physics.air_gravity_and_friction()
    on state_355_collision:
        boomerang_air_collision(352, false)

# UNREGISTERED Boomerang source fixture; full fighter cleanup remains gated.
# The launch quaternion fourth lane is undefined in stock; activation is gated.
article It_Kind_Link_Boomerang states 4:
    attachment origin center previous bone plane off initial_collision on held on
    render standard
    attribute int lifetime 0
    attribute int smash_lifetime 4
    attribute int turn_frames 8
    attribute float acceleration 12
    attribute float launch_speed 16
    attribute float maximum_speed 20
    attribute float minimum_speed 24
    attribute float bounce_angle_degrees 28
    attribute float slow_turn_degrees 32
    attribute float fast_turn_degrees 36
    attribute float turn_duration 40
    attribute float catch_distance 44
    attribute float launch_animation_rate 48
    attribute float unused_attribute 52
    attribute float sound_interval 56
    attribute float first_trail_delay 60
    attribute float second_trail_delay 64
    model_root trail_first 68
    model_root trail_second 72
    model_animation trail_first_animation 76
    model_animation trail_second_animation 88
    state float history_x[16]
    state float history_y[16]
    state float history_z[16]
    state float history_rx[16]
    state float history_ry[16]
    state float history_rz[16]
    state int history_write
    state int trail_read[2]
    state int mode
    state int turn_frames
    state float angle
    state float render_angle
    state float bounce_cosine
    state float turn_timer
    state float maximum_turn
    state float spin_step
    state float sound_timer
    state float trail_timer
    state float saved_qx
    state float saved_qy
    state float saved_qz
    state float saved_qw
    state float temporary_x
    state float temporary_y
    state float temporary_z
    state float dx
    state float dy
    state float speed
    state float cosine
    state float distance
    state int index
    state int target
    state bool expired
    on signal remove_reference:
            if item.current_owner_is_creator and item.state.mode != 1:
                creator.call(boomerang_unset)
    on signal remove:
            item.signal("remove_reference", 0)
            item.remove()
    on signal destroy_trails:
            item.destroy_model(1)
            item.destroy_model(2)
    on signal stage_animation:
            item.state.saved_qx = item.joint("0").quaternion.x
            item.state.saved_qy = item.joint("0").quaternion.y
            item.state.saved_qz = item.joint("0").quaternion.z
            item.state.saved_qw = item.joint("0").quaternion.w
            item.change_state_flags(2, 2)
            item.joint("").rotation.z = item.state.render_angle
            item.set_joint_transform(0, "0", item.joint("0").translation.x, item.joint("0").translation.y, item.joint("0").translation.z, item.state.saved_qx, item.state.saved_qy, item.state.saved_qz, item.state.saved_qw, item.joint("0").scale.x, item.joint("0").scale.y, item.joint("0").scale.z, false)
            item.set_model_animation_rate(0, "0", item.attr.launch_animation_rate)
            item.set_model_animation_rate(1, "", item.attr.launch_animation_rate)
            item.set_model_animation_rate(2, "", item.attr.launch_animation_rate)
    on signal begin_return:
            item.state.saved_qx = item.joint("0").quaternion.x
            item.state.saved_qy = item.joint("0").quaternion.y
            item.state.saved_qz = item.joint("0").quaternion.z
            item.state.saved_qw = item.joint("0").quaternion.w
            item.state.spin_step = -(2 * item.state.saved_qz) / float(uint(item.attr.turn_frames))
            item.state.turn_frames = item.attr.turn_frames
            if item.motion_state == 1:
                item.change_state_flags(3, 0x12)
            else:
                item.change_state_flags(3, 0x110)
            item.joint("").rotation.z = item.state.render_angle
            item.set_joint_transform(0, "0", item.joint("0").translation.x, item.joint("0").translation.y, item.joint("0").translation.z, item.state.saved_qx, item.state.saved_qy, item.state.saved_qz, item.state.saved_qw, item.joint("0").scale.x, item.joint("0").scale.y, item.joint("0").scale.z, false)
            item.set_model_animation_rate(0, "0", 1)
            item.set_model_animation_rate(1, "", 1)
            item.set_model_animation_rate(2, "", 1)
    on signal turn_return:
            if item.state.angle <= 0:
                item.state.angle = item.state.angle + pi
            else:
                item.state.angle = item.state.angle - pi
            if signal.value != 0:
                item.state.maximum_turn = 0.01745329238474369 * item.attr.fast_turn_degrees
            else:
                item.state.maximum_turn = 0.01745329238474369 * item.attr.slow_turn_degrees
            item.state.turn_timer = item.attr.turn_duration
            item.signal("begin_return", 0)
    on signal animate_trails:
