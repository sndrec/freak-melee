    on signal homing:
            item.state.distance = 0
            if creator.exists:
                item.state.dx = creator.position.x - position.x
                item.state.dy = creator.position.y + creator.state.boomerang_vertical_offset - position.y
                item.state.distance = sqrt(item.state.dx * item.state.dx + item.state.dy * item.state.dy)
                if item.state.turn_timer > 0:
