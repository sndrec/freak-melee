                item.joint(1, "").translation.y = item.state.history_y[item.state.index]
                item.joint(1, "").translation.z = item.state.history_z[item.state.index]
                item.joint(1, "").rotation.x = item.state.history_rx[item.state.index]
                item.joint(1, "").rotation.y = item.state.history_ry[item.state.index]
                item.joint(1, "").rotation.z = item.state.history_rz[item.state.index]
    on signal show_trail_1:
            if item.joint(2, "").exists:
                item.joint(2, "").visible = true
                item.state.index = item.state.trail_read[1]
                item.joint(2, "").translation.x = item.state.history_x[item.state.index]
                item.joint(2, "").translation.y = item.state.history_y[item.state.index]
                item.joint(2, "").translation.z = item.state.history_z[item.state.index]
                item.joint(2, "").rotation.x = item.state.history_rx[item.state.index]
                item.joint(2, "").rotation.y = item.state.history_ry[item.state.index]
                item.joint(2, "").rotation.z = item.state.history_rz[item.state.index]
    on signal common_animation:
            item.state.expired = false
            if item.state.sound_timer <= 0:
                item.loop_sound(160091, 127, 64)
                item.state.sound_timer = item.attr.sound_interval
            item.state.sound_timer = item.state.sound_timer - 1
            if item.command0 == 1:
                item.signal("stage_animation", 0)
                item.command0 = 2
            if item.command1 == 0:
                item.state.trail_timer = item.state.trail_timer - 1
                if item.state.trail_timer <= 0:
                    item.signal("show_trail_0", 0)
                    item.command1 = 2
                    item.state.trail_timer = item.attr.second_trail_delay
            elif item.command2 == 0:
                item.state.trail_timer = item.state.trail_timer - 1
                if item.state.trail_timer <= 0:
                    item.signal("show_trail_1", 0)
                    item.command2 = 2
            if item.life <= 0:
                item.state.expired = true
                return
            item.life = item.life - 1
            if item.command0 == 2 or item.motion_state == 3:
                item.state.index = item.state.history_write
                item.state.history_x[item.state.index] = position.x
                item.state.history_y[item.state.index] = position.y
                item.state.history_z[item.state.index] = position.z
                item.read_joint_matrix_rotation(0, "0", item.state.temporary_x, item.state.temporary_y, item.state.temporary_z)
                item.state.history_rx[item.state.index] = item.state.temporary_x
                item.state.history_ry[item.state.index] = item.state.temporary_y
                item.state.history_rz[item.state.index] = item.state.temporary_z
                item.state.history_write = item.state.history_write + 1
                if item.state.history_write >= 16:
                    item.state.history_write = 0
            item.signal("animate_trails", 0)
    on signal outbound_physics:
            if item.state.mode != 1:
                item.state.speed = sqrt(velocity.x * velocity.x + velocity.y * velocity.y) - item.attr.acceleration
                if item.state.speed < item.attr.minimum_speed:
                    item.state.speed = item.attr.minimum_speed
                    item.signal("turn_return", 0)
                velocity.x = item.state.speed * cos(item.state.angle)
                velocity.y = item.state.speed * sin(item.state.angle)
    on signal collision_normal:
            # lbVector_CosAngle uses XY only, including its zero-vector behavior.
            item.state.cosine = (velocity.x * item.state.temporary_x + velocity.y * item.state.temporary_y) / (sqrt(velocity.x * velocity.x + velocity.y * velocity.y) * sqrt(item.state.temporary_x * item.state.temporary_x + item.state.temporary_y * item.state.temporary_y))
            if item.state.cosine < 0:
                if item.state.cosine > item.state.bounce_cosine:
                    item.mirror_velocity(item.state.temporary_x, item.state.temporary_y, item.state.temporary_z)
                    item.state.angle = atan2(velocity.y, velocity.x)
                    if item.state.angle > tau:
                        item.state.angle = item.state.angle - tau
                    elif item.state.angle < -tau:
                        item.state.angle = item.state.angle + tau
                    if facing == 1:
                        item.state.render_angle = item.state.angle
                    else:
                        item.state.render_angle = item.state.angle - pi
                    item.grounded = false
                else:
