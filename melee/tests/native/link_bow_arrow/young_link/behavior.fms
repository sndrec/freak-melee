# Link and Young Link: accepted Spin Attack and Bomb Pull/article translation.
# Shared specials for independent Link and Young Link copied assets.
# Import each fighter's stock attributes into its owned fmp before building.
# Stock parameter import selects the owned spin_effect_joint default:24 Link,
# 26 Young Link. Explicitly customized template values stay customized.
# Bow/arrow, boomerang, tether and remaining fighter lifecycle are still native.


# Bomb shares decisions across both fighters. Owned import selects holding
# joint 64 for Link or 68 for Young Link when the default is unchanged.
state float bomb_spawn_x
state float bomb_spawn_y
state float bomb_spawn_z
state int bomb_handle



# UNREGISTERED Bow fighter draft; generic operations and cross-article cleanup pending.
state bool bow_initialized
state bool bow_charge_enabled
state float bow_charge
state int bow_visible_timer
state int bow_handle
state int bow_arrow_handle
state float bow_left_x
state float bow_left_y
state float bow_left_z
state float bow_right_x
state float bow_right_y
state float bow_right_z
state float bow_root_x
state float bow_root_y
state float bow_root_z
state float bow_angle
state float bow_offset_x
state float bow_offset_y
state float bow_extra_angle


func spin_effect():
    if not effects.active:
        if grounded: effects.spawn_between(1211, bones.index(TransN), attrs.spin_effect_joint)
        else: effects.spawn_between(1212, bones.index(TransN), attrs.spin_effect_joint)
        effects.active = true
    effects.pause_during_hitlag()
    callbacks.accessory(None)

func spin_air_physics():
    physics.fall(air.gravity * attrs.spin_gravity_multiplier, air.terminal_velocity)
    physics.air_accel_friction(0, air.drift_stick_mul * attrs.spin_air_drift_multiplier, air.drift_max * attrs.spin_air_speed_multiplier)


func bomb_restore_parts():
    visuals.set_group(2, 0)
    visuals.set_current_group(2, 0)

func bomb_create():
    if cue.consume(0):
        bones.world_position(bones.index(LeftThumb), state.bomb_spawn_x, state.bomb_spawn_y, state.bomb_spawn_z)
        # Exact SpawnItem current position is ECB center;
        # previous position is the supplied thumb; velocity is zero, damage0,
        # parent/owner is this fighter and spawn.x44.b0=true. Initialize via on
        # created BEFORE Item_8026AB54 invokes picked_up; then attach/register.
        state.bomb_handle = articles.create_held_at_center(attrs.bomb_kind, state.bomb_spawn_x, state.bomb_spawn_y, state.bomb_spawn_z, attrs.bomb_holding_joint, facing.direction)
        visuals.set_group(2, 1)
        if articles.owned(state.bomb_handle): items.notify_pickup(true)

func bomb_enter(int throw_motion, int pull_motion):
    if items.held:
        # Preserve unsigned stock range check; no pull if another item is held.
        if items.held_kind == It_Kind_Link_Bomb or items.held_kind == It_Kind_CLink_Bomb: items.throw_held(throw_motion)
        return
    cue.throw.reset()
    state.enter_at_speed(pull_motion, 0, 0, 1)
    animation.start()
    callbacks.accessory(bomb_create)


move SpinAttack:
    entry explicit
    on special_hi:
        state.enter_at_speed(356, 0, 0, 1)
        animation.start()
        callbacks.accessory(spin_effect)
    on special_air_hi:
        state.enter_at_speed(357, 0, 0, 1)
        animation.start()
        velocity.x = velocity.x * attrs.spin_air_horizontal_multiplier
        velocity.y = attrs.spin_air_vertical_speed
        jumps.used = jumps.max
        callbacks.accessory(spin_effect)
    on ground_animation:
        if animation.finished: state.wait()
    on air_animation:
        if animation.finished: state.freefall(1, 1, false, attrs.spin_air_drift_multiplier, attrs.spin_landing_lag)
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        if grounded: physics.ground_friction()
        else: spin_air_physics()
    on air_physics:
        spin_air_physics()
    on ground_collision:
        # Exact stock continuation flags; preserve the attack and current frame.
        if collision.left_ground:
            physics.force_air_and_use_jumps()
            state.enter_at_speed(357, 0x0C4C508A, frame, 1)
    on air_collision:
        if collision.check_ground_ledge(0): state.landing_special(false, attrs.spin_landing_lag)
        else: collision.cliff_catch()

move BombPull:
    entry explicit
    on special_lw:
        bomb_enter(108, 358)
    on special_air_lw:
        bomb_enter(112, 359)
    on ground_animation:
        if animation.finished: state.wait()
    on air_animation:
        if animation.finished: state.fall()
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_gravity_and_friction()
    on ground_collision:
        if collision.left_ground:
            physics.ground_to_air()
            state.enter_at_speed(359, 0x0C4C5080, frame, 1)
            callbacks.accessory(bomb_create)
    on air_collision:
        if collision.landed:
            physics.switch_to_ground()
            state.enter_at_speed(358, 0x0C4C5080, frame, 1)
            callbacks.accessory(bomb_create)


article It_Kind_CLink_Bomb states 7:
    state bool fast_fuse
    state bool rolling
    state bool damage_hopped
    state float fuse_translation_step
    state float fuse_rotation_step
    state float roll_direction
    state int change_flags
    state bool impact_detonated
    state int stage_flags
    state float collision_velocity_x
    state float collision_velocity_y
    state float preserved_fuse_y
    state float preserved_fuse_x
    on signal change_preserving_fuse:
            # dynamic_joint uses the article's dynamic-bone table, not a
            # preorder root-model joint index. These components survive every change.
            item.state.preserved_fuse_y = item.dynamic_joint(3).translation.y
            item.state.preserved_fuse_x = item.dynamic_joint(3).rotation.x
            if item.state.fast_fuse:
                item.state.change_flags = item.state.change_flags | 256
            else:
                item.state.change_flags = item.state.change_flags | 2
            item.change_state_flags(int(signal.value), item.state.change_flags)
            item.dynamic_joint(3).translation.y = item.state.preserved_fuse_y
            item.dynamic_joint(3).rotation.x = item.state.preserved_fuse_x
    on signal explode:
            item.harm_owner = true
            item.harm_teammates = true
            item.harm_sibling_items = true
            if item.owner_bound:
                item.release_attachment(0, 0, 0)
                item.collision_mode = 2
                if item.attachment_active: owner.call(bomb_restore_parts)
            item.use_manual_lifetime()
            item.stop_motion()
            item.hide_model()
            item.physics_disabled = true
            item.begin_expiry()
            item.collision_mode = 2
            item.spawn_effect_at_position(1038, position.x, position.y, position.z)
            item.play_sound(116, 127, 64)
            item.contact_hitlag = false
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 5)
            item.wind_at_position(120, 1, 0.02, 1.0471976)
    on signal fuse_tick:
            if item.life <= 0:
                item.signal("explode", 0)
                return
            if item.life <= item.params.fast_fuse_threshold and not item.state.fast_fuse:
                # Select descriptor3, reload/advance model animation once without
                # changing logical state, commands, lifetime, velocity or attachment.
                item.set_animation_descriptor(3)
                item.advance_model_animation()
                item.state.fast_fuse = true
            item.life = item.life - 1
            if not item.state.fast_fuse:
                item.dynamic_joint(3).translation.y = item.dynamic_joint(3).translation.y + item.state.fuse_translation_step
                item.dynamic_joint(3).rotation.x = item.dynamic_joint(3).rotation.x + item.state.fuse_rotation_step
    on signal enter_falling:
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 1)
    on signal enter_held:
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 0)
            item.subaction_sounds_muted = false
    on signal enter_thrown:
            item.harm_sibling_items = true
            item.can_be_hit_by_sibling_items = true
            item.state.change_flags = 4
            if item.motion_state == 2: item.state.change_flags = 20
            item.signal("change_preserving_fuse", 2)
    on signal enter_dropped:
            item.harm_sibling_items = true
            item.can_be_hit_by_sibling_items = true
            item.state.change_flags = 4
            if item.motion_state == 3: item.state.change_flags = 20
            item.signal("change_preserving_fuse", 3)
    on signal enter_rolling:
            item.state.roll_direction = 1
            if velocity.x < 0: item.state.roll_direction = -1
            item.set_collision_facing(int(item.state.roll_direction))
            item.state.rolling = true
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 4)
    on signal check_impact_speed:
            item.state.impact_detonated = false
            if abs(item.state.collision_velocity_x) > item.params.detonation_speed_x or abs(item.state.collision_velocity_y) > item.params.detonation_speed_y:
                item.signal("explode", 0)
                item.state.impact_detonated = true
    on signal thrown_collision:
            item.state.collision_velocity_x = velocity.x
            item.state.collision_velocity_y = velocity.y
            # DAA8 sweep records current position/collision flags/floor response.
            item.state.stage_flags = item.sweep_stage_flags()
            if item.state.stage_flags & 15:
                item.signal("check_impact_speed", 0)
                if not item.state.impact_detonated and item.state.stage_flags & 1:
                    item.grounded = true
                    item.reset_default_ecb()
                    item.signal("enter_rolling", 0)
    state 0 anim 0:
        on animation:
            if item.animation_finished: item.signal("enter_held", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            return
    state 1 anim 0:
        on animation:
            if item.animation_finished: item.signal("enter_falling", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            item.gravity(false)
        on collision:
            # E15C flavor; existing no-argument E248 bounce_to_ground differs.
            item.bounce_to_ground(1)
            return false
    state 2 anim 1:
        on animation:
            if item.animation_finished: item.signal("enter_thrown", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            item.gravity()
        on collision:
            item.signal("thrown_collision", 0)
            return false
    state 3 anim 1:
        on animation:
            if item.animation_finished: item.signal("enter_dropped", 0)
            # Intentional second query after changing3, matching source.
            if item.animation_finished: item.signal("enter_falling", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            item.gravity()
        on collision:
            item.signal("thrown_collision", 0)
            return false
    state 4 anim 0:
        on animation:
            if item.animation_finished: item.signal("enter_rolling", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            if item.state.rolling:
                if velocity.x != 0: velocity.x = velocity.x + item.params.roll_acceleration * item.state.roll_direction
                if abs(velocity.x) < item.params.roll_stop_speed: velocity.x = 0
        on collision:
            item.follow_ground()
            return false
    state 5 anim 2:
        on animation:
            return item.expire_tick()
        on physics:
            return
        on collision:
            return false
    state 6 anim 0:
        on animation:
            if item.animation_finished: item.change_state_flags(6, 2)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            return
        on collision:
            item.slide_on_ground()
            return false
    on created:
            item.set_lifetime(item.params.lifetime)
            item.state.fast_fuse = false
            item.state.damage_hopped = false
            # Source subtracts unsigned attributes before conversion to float.
            item.state.fuse_translation_step = -2.8000002 / float(uint(item.params.lifetime) - uint(item.params.fast_fuse_threshold)) * item.scale
            item.state.fuse_rotation_step = -0.15707964 / float(uint(item.params.lifetime) - uint(item.params.fast_fuse_threshold)) * item.scale
            item.subaction_sounds_muted = true
    on picked_up:
            item.signal("enter_held", 0)
    on dropped:
            item.signal("enter_dropped", 0)
    on thrown:
            item.signal("enter_thrown", 0)
    on damage_dealt:
            if item.motion_state != 5:
                item.state.collision_velocity_x = velocity.x
                item.state.collision_velocity_y = velocity.y
                item.signal("check_impact_speed", 0)
                if not item.state.impact_detonated:
                    facing = -facing
                    velocity.x = item.params.contact_bounce_x * facing
                    velocity.y = item.params.contact_bounce_y
            return false
    on damage_received:
            if item.motion_state != 5:
                if item.damage_received >= item.params.detonation_damage:
                    item.signal("explode", 0)
                elif not item.state.damage_hopped:
                    # Signed x comparison and facing-scaled y are intentional.
                    if velocity.x > item.params.roll_stop_speed:
                        facing = -item.damage_direction
                        velocity.x = item.params.damage_hop_x * facing
                    else:
                        velocity.x = item.params.damage_hop_x * (2 * (random.float() - 0.5))
                        item.align_facing_to_velocity()
                    velocity.y = item.params.damage_hop_y * facing
                    item.state.damage_hopped = true
            return false
    on entered_air:
            item.change_state_flags(6, 2)
    on reflected:
            return item.reflect()
    on shield_bounced:
            return item.shield_bounce()
    on hit_shield:
            item.bounce()
            return false
    on interaction:
            if item.attachment_owner_is(other): item.clear_attachment_owner()
            item.interact(other)
    on stage_landed:
            item.signal("enter_rolling", 0)
    on stage_left:
            item.signal("enter_falling", 0)
    on out_of_bounds:
            if not item.owner_bound and item.motion_state != 5: item.signal("explode", 0)

func bow_callbacks():
    callbacks.track_damage()
    callbacks.track_death2()

func bow_unset_arrow():
    state.bow_arrow_handle = -1

export func bow_unset():
    state.bow_handle = -1

func bow_remove_owned():
    if articles.owned(state.bow_arrow_handle): articles.remove_owned(state.bow_arrow_handle)
    state.bow_arrow_handle = -1
    if articles.owned(state.bow_handle): articles.remove_owned(state.bow_handle)
    state.bow_handle = -1

func bow_air_finish():
    if attrs.bow_air_landing_lag == 0: state.fall()
    else:
        state.freefall(1, 0, true, 1, attrs.bow_air_landing_lag)

func bow_failed(bool air_started):
    # Stock only clears fighter references here; article callbacks remove later.
    bow_unset_arrow()
    bow_unset()
    if air_started: bow_air_finish()
    else:
        state.wait()

func bow_enter(bool air_started):
    if not state.bow_initialized:
        state.bow_initialized = true
        state.bow_handle = -1
        state.bow_arrow_handle = -1
    state.bow_charge_enabled = false
    state.bow_charge = 0
    state.bow_visible_timer = 0
    command(0) = 0
    command(1) = 0
    command(2) = 0
    command(3) = 0
    if not air_started:
        physics.switch_to_ground()
        velocity.y = 0
        state.enter_at_speed(344, 0, 0, 1)
    else:
        state.enter_at_speed(347, 0, 0, 1)
    bow_callbacks()
    animation.set_rate(attrs.bow_start_rate)
    animation.start()
    if articles.owned(state.bow_handle):
        bow_failed(air_started)
    else:
        # The reference remains absent during created/picked_up notifications.
        state.bow_handle = -1
        state.bow_handle = articles.spawn_bone_attached(attrs.bow_kind, RightThumb)
        if articles.owned(state.bow_handle): bow_callbacks()
        else:
            bow_failed(air_started)

func bow_positions():
    bones.world_position(bones.index(LeftThumb), state.bow_left_x, state.bow_left_y, state.bow_left_z)
    bones.world_position(bones.index(RightThumb), state.bow_right_x, state.bow_right_y, state.bow_right_z)
    bones.world_position(0, state.bow_root_x, state.bow_root_y, state.bow_root_z)
    state.bow_angle = atan2(state.bow_right_y - state.bow_left_y, state.bow_right_x - state.bow_left_x)
    state.bow_offset_x = state.bow_right_x - state.bow_root_x
    state.bow_offset_y = state.bow_right_y - state.bow_root_y
    state.bow_extra_angle = 0
    if articles.owned(state.bow_arrow_handle): articles.signal_owned(state.bow_arrow_handle, "held_positions", 0)

func bow_start_animation(bool air_started):
    if command(2) != 0 and not state.bow_charge_enabled:
        state.bow_charge_enabled = true
        command(2) = 0
    if not air_started: animation.set_rate(attrs.bow_start_rate)
    if command(0) == 1:
        command(0) = 0
        if not articles.owned(state.bow_arrow_handle):
            state.bow_arrow_handle = -1
            state.bow_arrow_handle = articles.spawn_bone_attached(attrs.bow_arrow_kind, LeftThumb)
            if articles.owned(state.bow_arrow_handle): bow_callbacks()
            else:
                bow_failed(air_started)
                return
    bow_positions()
    if animation.finished:
        if air_started: state.enter_at_speed(348, 0x40010, 0, 1)
        else:
            state.enter_at_speed(345, 0x40010, 0, 1)
        bow_callbacks()
        animation.start()

func bow_start_interrupt(bool air_started):
    if state.bow_charge_enabled:
        state.bow_charge = state.bow_charge + 1
        if state.bow_charge > attrs.bow_max_charge: state.bow_charge = attrs.bow_max_charge
        if not input.special_held:
            if air_started: state.enter_at_speed(349, 0x40010, 0, 1)
            else:
                state.enter_at_speed(346, 0x40010, 0, 1)
            bow_callbacks()

func bow_loop_interrupt(bool air_started):
    state.bow_charge = attrs.bow_max_charge
    if not input.special_held:
        if air_started: state.enter_at_speed(349, 0x40010, 0, 1)
        else:
            state.enter_at_speed(346, 0x40010, 0, 1)
        bow_callbacks()

func bow_end_parts():
    if visuals.held_item_visible and state.bow_visible_timer == 0:
        state.bow_visible_timer = state.bow_visible_timer + 1
        if items.held:
            visuals.set_group(2, 1)
            visuals.set_current_group(2, 1)
        else:
            visuals.set_group(2, 0)
            visuals.set_current_group(2, 0)

func bow_end_animation(bool air_started):
    if animation.finished:
        if air_started: bow_unset_arrow()
        bow_unset()
        bow_end_parts()
        if air_started: bow_air_finish()
        else:
            state.wait()
    else:
        bow_end_parts()

func bow_launch():
    if command(1) == 1 and articles.owned(state.bow_arrow_handle):
        command(1) = 0
        bones.world_position(bones.index(RightThumb), state.bow_right_x, state.bow_right_y, state.bow_right_z)
        bones.world_position(bones.index(LeftThumb), state.bow_left_x, state.bow_left_y, state.bow_left_z)
        state.bow_right_z = 0
        state.bow_left_z = 0
        articles.signal_owned(state.bow_arrow_handle, "launch", attrs.bow_max_charge)
        bow_unset_arrow()
        items.notify_pickup(false)

func bow_ground_collision(int air_motion, bool end_phase):
    if end_phase: bow_launch()
    if collision.left_ground:
        physics.ground_to_air()
        state.enter_at_speed(air_motion, 0x0C4C5090, frame, 1)
        bow_callbacks()
        animation.start()

func bow_air_collision(int ground_motion, bool end_phase):
    if end_phase: bow_launch()
    if collision.landed:
        physics.switch_to_ground()
        state.enter_at_speed(ground_motion, 0x0C4C5090, frame, 1)
        bow_callbacks()
        animation.start()

move Bow:
    entry explicit
    on special_n:
        bow_enter(false)
    on special_air_n:
        bow_enter(true)
    on ground_animation:
        bow_start_animation(false)
    on air_animation:
        bow_start_animation(true)
    on ground_interrupt:
        bow_start_interrupt(false)
    on air_interrupt:
        bow_start_interrupt(true)
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_gravity_and_friction()
    on ground_collision:
        bow_ground_collision(347, false)
    on air_collision:
        bow_air_collision(344, false)

action BowPhases:
    on state_345_animation:
        bow_positions()
    on state_345_interrupt:
        bow_loop_interrupt(false)
    on state_345_physics:
        physics.ground_friction()
    on state_345_collision:
        bow_ground_collision(348, false)
    on state_346_animation:
        bow_end_animation(false)
    on state_346_interrupt:
        pass
    on state_346_physics:
        physics.ground_friction()
    on state_346_collision:
        bow_ground_collision(349, true)
    on state_348_animation:
        bow_positions()
    on state_348_interrupt:
        bow_loop_interrupt(true)
    on state_348_physics:
        physics.air_gravity_and_friction()
    on state_348_collision:
        bow_air_collision(345, false)
    on state_349_animation:
        bow_end_animation(true)
    on state_349_interrupt:
        pass
    on state_349_physics:
        physics.air_gravity_and_friction()
    on state_349_collision:
        bow_air_collision(346, true)
    on damage:
        # Activation gate: complete boomerang/tether/milk cleanup first.
        bow_remove_owned()
    on death2:
        # Activation gate: same complete cross-article cleanup required.
        bow_remove_owned()

