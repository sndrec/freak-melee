# Zelda owned source template, promoted from accepted composed source.
# Fighter and article decisions are authored here; no borrowed stock handlers.
# Declarative attributes require normal import; paired play requires its owned family package.
# Component comments below retain their original source-comparison provenance.

# Independent source member; complete direct-runtime preflight remains pending.
fighter:
    behavior independent

# Zelda decisions retain their native ordering; the package owns its numeric layout.
# Full article initializer decisions are authored; allocator/model loading remain engine boundaries.
attribute int neutral_gravity_delay 4
attribute float neutral_horizontal_divisor 8
attribute float neutral_gravity 12
attribute int reflect_bone 132
attribute int reflect_damage_limit 136
attribute float reflect_x 140
attribute float reflect_y 144
attribute float reflect_z 148
attribute float reflect_radius 152
attribute float reflect_damage_multiplier 156
attribute float reflect_speed_multiplier 160
attribute bool reflect_preserve_owner 164
state int neutral_gravity_timer
state int din_handle

attribute int din_start_timer 16
attribute int din_hold_timer 20
attribute int din_gravity_delay 24
attribute int din_release_delay 28
attribute float din_spawn_offset_x 32
attribute float din_spawn_offset_y 36
attribute float din_air_gravity 44
attribute float din_landing_lag 52
attribute float teleport_start_x_divisor 56
attribute float teleport_start_y_divisor 60
attribute float teleport_start_gravity 64
attribute float teleport_start_terminal 68
attribute int teleport_travel_frames 72
attribute float teleport_platform_grace 76
attribute float teleport_stick_minimum 80
attribute float teleport_speed_multiplier 84
attribute float teleport_speed_addition 88
attribute float teleport_end_drift_multiplier 92
attribute int teleport_surface_angle 96
attribute float teleport_end_momentum 100
attribute float teleport_freefall_mobility 104
attribute float teleport_landing_lag 108
