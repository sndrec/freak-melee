parameter int cpu_recovery_stick_strength = 127
parameter int cpu_recovery_press_frames = 40
parameter int cpu_recovery_wait_frames = 1

parameter int cpu_din_motion_first = 344
parameter int cpu_din_motion_last = 348
parameter float cpu_din_release_radius = 15
