state int din_hold_remaining
state int din_gravity_remaining
state int din_release_remaining
state int teleport_remaining
state int teleport_collision_age
state float teleport_stick_x
state float teleport_stick_y
state float teleport_saved_x
state float teleport_saved_y
state float teleport_saved_ground


