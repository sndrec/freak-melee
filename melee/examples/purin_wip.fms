action RolloutStates:
    on state_347_animation:
        roll_start_anim(false)
    on state_347_interrupt:
        pass
    on state_347_physics:
        roll_ground_still()
    on state_347_collision:
        roll_start_collision(false)
    on state_355_animation:
        roll_start_anim(true)
    on state_355_interrupt:
        pass
    on state_355_physics:
        physics.fall(attrs.roll_gravity, attrs.roll_terminal_speed)
    on state_355_collision:
        roll_start_collision(true)
    on state_348_animation:
        roll_charge_anim(false, false)
    on state_348_interrupt:
        roll_release_input(false)
    on state_348_physics:
        roll_ground_still()
    on state_348_collision:
        roll_charge_collision(false, false)
    on state_349_animation:
        roll_charge_anim(false, true)
    on state_349_interrupt:
        roll_release_input(false)
    on state_349_physics:
        roll_ground_still()
    on state_349_collision:
        roll_charge_collision(false, true)
    on state_356_animation:
        roll_charge_anim(true, false)
    on state_356_interrupt:
        roll_release_input(true)
    on state_356_physics:
        physics.fall(attrs.roll_gravity, attrs.roll_terminal_speed)
    on state_356_collision:
        roll_charge_collision(true, false)
    on state_357_animation:
        roll_charge_anim(true, true)
    on state_357_interrupt:
        roll_release_input(true)
    on state_357_physics:
        physics.fall(attrs.roll_gravity, attrs.roll_terminal_speed)
    on state_357_collision:
        roll_charge_collision(true, true)
    on state_350_animation:
        roll_release_anim(false)
    on state_350_interrupt:
        if abs(input.x) > attrs.roll_turn_stick_threshold:
            let direction = 1
            if input.x < 0: direction = -1
            if state.roll_direction != direction:
                hitbox.clear_all()
                state.roll_pending_facing = direction
                state.roll_direction = -direction
                state.enter_at_speed(351, 0xc4c0292, frame, 0)
                roll_callbacks()
                state.roll_turn_start_speed = ground.velocity
                state.roll_deceleration = -float(0.05) * ground.velocity
                state.roll_trail_tick = 0
                roll_normalize()
                sound.play(250073, 127, 64)
    on state_350_physics:
        roll_ground_release()
    on state_350_collision:
        roll_release_collision(false)
    on state_358_animation:
        roll_release_anim(true)
    on state_358_interrupt:
        pass
    on state_358_physics:
        roll_air_release()
    on state_358_collision:
        roll_release_collision(true)
    on state_351_animation:
        roll_turn_anim(false)
    on state_351_interrupt:
        pass
    on state_351_physics:
        roll_ground_turn()
    on state_351_collision:
        roll_turn_collision(false)
    on state_359_animation:
        roll_turn_anim(true)
    on state_359_interrupt:
        pass
    on state_359_physics:
        roll_air_drag()
        bones.root.rotate_y(pi_half)
        roll_normalize()
    on state_359_collision:
        roll_turn_collision(true)
    on state_352_animation:
        roll_end_anim(false)
    on state_352_interrupt:
        pass
    on state_352_physics:
        physics.ground_decelerate(ground.friction)
        physics.ground_to_self()
    on state_352_collision:
        roll_end_collision(false)
    on state_353_animation:
        roll_end_anim(false)
    on state_353_interrupt:
        pass
    on state_353_physics:
        physics.ground_decelerate(ground.friction)
        physics.ground_to_self()
    on state_353_collision:
        roll_end_collision(false)
    on state_360_animation:
        roll_end_anim(true)
    on state_360_interrupt:
        pass
    on state_360_physics:
        physics.fall(attrs.roll_gravity, attrs.roll_terminal_speed)
    on state_360_collision:
        roll_end_collision(true)
    on state_361_animation:
        roll_end_anim(true)
    on state_361_interrupt:
        pass
    on state_361_physics:
        physics.fall(attrs.roll_gravity, attrs.roll_terminal_speed)
    on state_361_collision:
        roll_end_collision(true)
    on state_362_animation:
        roll_scale()
        state.roll_angle = state.roll_angle + attrs.roll_air_rotation_multiplier * float(0.2 * attrs.roll_turn_rotation * -state.roll_direction)
        roll_normalize()
        bones.root.rotate_y(pi_half)
    on state_362_interrupt:
        pass
    on state_362_physics:
        if velocity.y <= -attrs.roll_terminal_speed: physics.air_drift()
        physics.fall(attrs.roll_gravity, attrs.roll_terminal_speed)
    on state_362_collision:
        if collision.air_box(8, 0, -4, 4, 4, 4):
            roll_cleanup()
            physics.switch_to_ground()
            if attrs.roll_landing_lag == 0: state.wait()
            else: state.landing_special(false, attrs.roll_landing_lag)
    on damage:
        roll_cleanup()
    on death2:
        roll_cleanup()
    on state_change:
        stats.refresh_attack()
        stats.record_attack()
    on reflect:
        bones.root.rotate_y(pi_half * facing.direction)
        velocity.x = -velocity.x
        ground.velocity = -ground.velocity
        ground.acceleration = -ground.acceleration
        state.roll_turn_start_speed = -state.roll_turn_start_speed
        state.roll_angle = -state.roll_angle
        state.roll_speed = -state.roll_speed
        state.roll_deceleration = -state.roll_deceleration
        state.roll_pending_facing = -state.roll_pending_facing
        state.roll_direction = -state.roll_direction
        state.roll_previous_angle = -state.roll_previous_angle
    on deal_damage:
        state.roll_hit_cycle = 0
        if motion.id == 350 or motion.id == 351 or motion.id == 358 or motion.id == 359:
            state.roll_ticks = state.roll_ticks - attrs.roll_hit_duration_cost
            facing.direction = state.roll_direction
            hitbox.clear_all()
            state.enter_at_speed(362, 0xc4c0292, frame, 0)
            callbacks.track_death2()
            callbacks.track_damage()
            callbacks.deal_damage(None)
            if grounded:
                velocity.x = ground.velocity * attrs.roll_hit_horizontal_multiplier
                physics.ground_to_air()
            else: velocity.x = velocity.x * attrs.roll_hit_horizontal_multiplier
            velocity.y = attrs.roll_hit_vertical_speed
            acceleration.x = 0
            acceleration.y = 0
            ground.acceleration = 0
            ground.velocity = 0
            state.roll_pending_facing = 0
            bones.root.rotate_y(pi_half)
            sound.play(250070, 127, 64)

