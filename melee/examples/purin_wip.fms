# Costume-root names are asset references, not fighter-specific engine APIs.
# Bind the hat to the actual stock part index 6; the shared mapping's name for
# that index is misleading on Purin. Each copied costume keeps its own graph.
action FighterEvents:
    on load:
        fighter.copy_ext_attributes()
        fighter.enable_multi_jump()
        ConfigureMultiJump()
        if attachments.has_root("PlyPurinReHat_TopN_joint"):
            attachments.load(0, "PlyPurinReHat_TopN_joint", 6, 1, 1)
        elif attachments.has_root("PlyPurinBuHat_TopN_joint"):
            attachments.load(0, "PlyPurinBuHat_TopN_joint", 6, 1, 2)
            attachments.add_dynamics(0, 1, 2)
        elif attachments.has_root("PlyPurinGrHat_TopN_joint"):
            attachments.load(0, "PlyPurinGrHat_TopN_joint", 6, 1, 3)
            attachments.add_dynamics(0, 3, 2)
        elif attachments.has_root("PlyPurinYeHat_TopN_joint"):
            attachments.load(0, "PlyPurinYeHat_TopN_joint", 6, 1, 4)
    on load_special_attrs:
        fighter.reload_ext_attributes()
        ConfigureMultiJump()
    on death:
        # Restore the native default selection, not the -1 hidden selection.
        visuals.set_group(0, 0)
    on user_data_remove:
        attachments.clear_all()
    on item_pickup:
        if not items.heavy:
            if items.hold_kind == 3: visuals.set_part_animation(0, 0)
            elif items.hold_kind == 4: visuals.set_part_animation(0, 1)
            if event.flag: visuals.show_part_animation(0)
    on item_pickup_ext:
        if not items.heavy:
            if items.hold_kind == 3: visuals.set_part_animation(0, 0)
            elif items.hold_kind == 4: visuals.set_part_animation(0, 1)
            if event.flag: visuals.show_part_animation(0)
    on item_drop_ext:
        fighter.item_drop(event.flag, 0, 0)
    on shield_break:
        damage.force_top_blast_ko = true
    on item_drop:
        fighter.item_drop(event.flag, 0, 0)
    on item_visible:
        if items.held and not items.heavy: visuals.show_part_animation(0)
    on item_invisible:
        if items.held and not items.heavy: visuals.hide_part_animation(0)
    on knockback_enter:
        fighter.knockback_enter(1)
    on knockback_exit:
        fighter.knockback_exit(1)
