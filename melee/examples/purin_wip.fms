action MultiJumpEntry:
    on aerial_jump:
        command(0) = 0
        let int jump_index = jumps.used - 1
        let int next_motion = attrs.multi_first_motion + jump_index
        let float next_y = jumps.multi_vertical_speed(jump_index)
        jump.begin(next_motion, input.x * attrs.multi_horizontal_impulse, next_y, 0, false, false, true)
        if input.x * facing.direction < -attrs.multi_reverse_threshold:
            state.multi_turn_remaining = attrs.multi_turn_frames
        else:
            state.multi_turn_remaining = 0
        MultiTurnTick()

action MultiJumpPhases:
    on state_341_animation:
