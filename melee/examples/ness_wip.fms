action MagnetResponse:
    on absorb:
        damage.heal(float(int(absorber.damage * attrs.magnet_heal_multiplier)))
        facing.direction = absorber.direction
        if not ((motion.id == 369 or motion.id == 374) and frame <= attrs.magnet_rehit_frame):
            let target = 369
            if airborne: target = 374
            state.enter_at_speed(target, 2, 0, 1)
            magnet_create_absorber()

