func magnet_create_absorber():
    absorber.create(attrs.magnet_absorb_joint, attrs.magnet_absorb_x, attrs.magnet_absorb_y, attrs.magnet_absorb_z, attrs.magnet_absorb_radius)

func magnet_enter(bool air_started):
    state.magnet_release_lag = int(attrs.magnet_release_lag)
    state.magnet_release = false
    state.magnet_gravity_delay = attrs.magnet_gravity_delay
    state.magnet_sound_timer = 0
    if air_started:
        velocity.y = 0
        velocity.x = velocity.x / attrs.magnet_momentum_divisor
        state.enter_at_speed(372, 0, 0, 1)
    else:
        state.enter_at_speed(367, 0, 0, 1)
    animation.start()

func magnet_effect():
    if not effects.active:
        effects.spawn_async_attached(attrs.magnet_effect, attrs.magnet_effect_joint)
        effects.active = true
    effects.pause_during_hitlag()

func magnet_hold():
    let target = 368
    if airborne: target = 373
    state.enter_at_speed(target, 2, 0, 1)
    magnet_create_absorber()

func magnet_end():
    let target = 370
    if airborne: target = 375
    state.enter_at_speed(target, 0, 0, 1)

func magnet_start_animation():
    if not input.special_held: state.magnet_release = true
    if animation.finished:
        magnet_effect()
        state.magnet_sound_timer = 0
        magnet_hold()

func magnet_release_tick():
    if not input.special_held: state.magnet_release = true
    if state.magnet_release_lag > 0: state.magnet_release_lag = state.magnet_release_lag - 1

func magnet_sound_tick():
    state.magnet_sound_timer = state.magnet_sound_timer - 1
    if state.magnet_sound_timer <= 0:
        sound.play(attrs.magnet_hold_sound, 127, 64)
        state.magnet_sound_timer = attrs.magnet_sound_interval

func magnet_hold_animation():
    magnet_release_tick()
    if state.magnet_release_lag <= 0 and state.magnet_release:
        magnet_end()
    magnet_sound_tick()

func magnet_hit_animation():
    magnet_release_tick()
    if animation.finished:
        if state.magnet_release_lag <= 0 and state.magnet_release:
            magnet_end()
        else:
            magnet_hold()
            effects.destroy_all()
            magnet_effect()
    magnet_sound_tick()

func magnet_turn_animation():
    magnet_release_tick()
    state.magnet_turn_frames = state.magnet_turn_frames - 1
    if not command(0) and float(state.magnet_turn_frames) <= attrs.magnet_turn_duration:
        command(0) = 1
        facing.direction = -facing.direction
    bones.root.rotate_y(-(radians(180 / attrs.magnet_turn_duration) - bones.root.rotation_y))
    if state.magnet_turn_frames <= 0:
        if state.magnet_release_lag <= 0 and state.magnet_release:
            magnet_end()
        else:
            magnet_hold()

func magnet_end_animation():
    if animation.finished:
        effects.destroy_all()
        if airborne: state.fall()
        else: state.wait()

func magnet_air_physics(bool update_absorber):
    if state.magnet_gravity_delay != 0:
        state.magnet_gravity_delay = state.magnet_gravity_delay - 1
    else:
        physics.fall(attrs.magnet_fall_acceleration, air.terminal_velocity)
    physics.quick_air_decel()
    if update_absorber: absorber.skip_position_update = false

func magnet_ground_collision(int target, int flags, bool recreate_absorber):
    if collision.left_ground:
        physics.ground_to_air()
        state.enter_at_speed(target, flags, frame, 1)
        if recreate_absorber: magnet_create_absorber()

func magnet_air_collision(int target, int flags, bool recreate_absorber):
    if collision.landed:
        physics.switch_to_ground()
        state.enter_at_speed(target, flags, frame, 1)
        physics.clamp_air_drift()
        if recreate_absorber: magnet_create_absorber()

# Stock ftNs_SpecialS_ItemPKFireSpawn consumes throw_flags_b0 itself.
# Bind the ordinary accessory phase: accessory_cue would consume it twice.
func fire_spawn_when_cued():
    if cue.article.consume():
        bones.world_position(attrs.fire_spawn_joint, state.fire_x, state.fire_y, state.fire_z)
        state.fire_x = state.fire_x + attrs.fire_spawn_x * facing.direction
        state.fire_y = state.fire_y + attrs.fire_spawn_y
        state.fire_z = 0
        let angle = attrs.fire_ground_angle
        let speed = attrs.fire_ground_speed
        if airborne:
            angle = attrs.fire_air_angle
            speed = attrs.fire_air_speed
        let vx = speed * cos(angle) * facing.direction
        let vy = speed * sin(angle)
        let created = articles.create_with_velocity(It_Kind_Ness_PKFire, state.fire_x, state.fire_y, 0, vx, vy, 0, facing.direction, true, 0, angle * facing.direction, true)

func fire_enter(bool air_started):
    cue.throw.reset()
    command(0) = 0
    if air_started: state.enter_at_speed(357, 0, 0, 1)
    else: state.enter_at_speed(356, 0, 0, 1)
    animation.start()
    callbacks.accessory(fire_spawn_when_cued)

# PK Flash imports become project-owned named values; no runtime DAT reads.

func flash_clear():
    state.flash_handle = -1
    callbacks.clear_damage_death()

func flash_reset():
    state.flash_ground_loop_delay = attrs.flash_ground_loop_delay
    state.flash_air_loop_delay = attrs.flash_air_loop_delay
    state.flash_gravity_delay = attrs.flash_gravity_delay
    state.flash_release_delay = attrs.flash_release_delay
    flash_clear()

func flash_detach():
    if state.flash_handle != -1:
        articles.signal(state.flash_handle, It_Kind_Ness_PKFlush, "detach", 0)
    flash_clear()

func flash_enter(bool air_started):
    if air_started:
        state.enter_at_speed(352, 0, 0, 1)
    else:
        state.enter_at_speed(348, 0, 0, 1)
    command(3) = 0
    command(2) = 0
    command(1) = 0
    command(0) = 0
    if air_started: velocity.y = 0
    flash_reset()
    animation.start()

func flash_start_animation(bool air_started):
    if animation.finished:
        if air_started: state.enter_at_speed(353, 0, 0, 1)
        else: state.enter_at_speed(349, 0, 0, 1)
        if state.flash_handle == -1:
            bones.world_position(attrs.flash_spawn_joint, state.flash_x, state.flash_y, state.flash_z)
            state.flash_z = 0
            state.flash_y = state.flash_y + attrs.flash_spawn_height * model.instance_scale_y
            state.flash_handle = articles.create_at_position(It_Kind_Ness_PKFlush, state.flash_x, state.flash_y, state.flash_z, facing.direction, true, 0, 0)
            if state.flash_handle != -1:
                callbacks.track_death2()
                callbacks.track_damage()
        jumps.used = jumps.max

func flash_hold_animation(bool air_started):
    if state.flash_ground_loop_delay != 0: state.flash_ground_loop_delay = state.flash_ground_loop_delay - 1
    if state.flash_handle == -1 and state.flash_air_loop_delay != 0: state.flash_air_loop_delay = state.flash_air_loop_delay - 1
    let int release_motion = 350
    let int end_motion = 351
    if air_started:
        release_motion = 354
        end_motion = 355
    if state.flash_handle == -1:
        if state.flash_ground_loop_delay <= 0 and state.flash_air_loop_delay <= 0:
            state.enter_at_speed(end_motion, 0, 0, 1)
        else:
            if motion.id != release_motion: state.enter_at_speed(release_motion, 0, frame, 1)
    else:
        if not articles.owned(state.flash_handle):
            state.flash_handle = -1
        else:
            if articles.ref(state.flash_handle, It_Kind_Ness_PKFlush).state.stage_stopped and motion.id != release_motion:
                state.enter_at_speed(release_motion, 0, frame, 1)

func flash_hold_interrupt():
    state.flash_release_delay = state.flash_release_delay - 1
    if state.flash_release_delay <= 0:
        state.flash_release_delay = 0
        if not input.special_held: flash_clear()

func flash_end_animation(bool air_started):
    flash_reset()
    bones.root.rotate_x(0)
    if animation.finished:
        if air_started:
            if attrs.flash_landing_lag == 0: state.fall()
            else: state.freefall(1, 0, true, 1, attrs.flash_landing_lag)
        else:
            state.wait()

func flash_ground_start_physics():
    if state.flash_gravity_delay != 0: state.flash_gravity_delay = state.flash_gravity_delay - 1
    physics.ground_friction()

func flash_air_physics():
    if state.flash_gravity_delay != 0:
        state.flash_gravity_delay = state.flash_gravity_delay - 1
    else:
        physics.fall(attrs.flash_fall_acceleration, air.terminal_velocity)
    physics.air_decel(air.friction)

func flash_ground_collision(int target):
    if collision.left_ground:
        physics.ground_to_air()
        state.enter_at_speed(target, attrs.flash_collision_flags, frame, 1)

func flash_air_collision(int target):
    if collision.landed:
        physics.switch_to_ground()
        state.enter_at_speed(target, attrs.flash_collision_flags, frame, 1)


# PK Thunder ball/trail article lifecycle; fighter phases and shared resource cleanup are authored below.

# Constructor communication is only the requested history origin. The engine
# still owns current/previous spawn position and actual collision group.

func thunder_create_ball(float x, float y, float z, float direction):
    state.thunder_requested_x = x
    state.thunder_requested_y = y
    state.thunder_requested_z = z
    # Flatten previous.z only; origin_at_owner supplies actual current position.
    state.thunder_ball_handle = articles.create_at_position(It_Kind_Ness_PKThunder, x, y, 0, direction, true, articles.new_collision_group(), 0)

# Article cleanup counterpart of ftNs_SpecialHi_ItemPKThunderRemove only.
# ResourceDamage composes this operation in the original ordered cleanup chain.

func thunder_ball_removed():
    state.thunder_ball_handle = -1
    if motion.id >= attrs.thunder_ground_start and motion.id <= attrs.thunder_air_rebound:
        effects.destroy_all()
        state.thunder_effects_active = false
    callbacks.clear_damage_death()
    bones.root.rotate_x(0)


# Offline query coverage only; never installed in the default Ness template.
# Nine authored Thunder phases share the complete ResourceDamage lifecycle.

func thunder_stop_effects():
    if motion.id >= attrs.thunder_ground_start and motion.id <= attrs.thunder_air_rebound:
        effects.destroy_all()
        state.thunder_effects_active = false

func thunder_damage():
    if state.thunder_ball_handle != -1:
        articles.signal(state.thunder_ball_handle, It_Kind_Ness_PKThunder, "detach_damage_owner", 0)
        state.thunder_ball_handle = -1
    thunder_stop_effects()
    callbacks.clear_damage_death()
    bones.root.rotate_x(0)

func thunder_reset_movement():
    state.thunder_loop1 = attrs.thunder_loop1
    state.thunder_loop2 = attrs.thunder_loop2
    state.thunder_gravity_delay = attrs.thunder_gravity_delay
    state.thunder_fall_acceleration = 0
    state.thunder_previous_z = 0
    state.thunder_previous_y = 0
    state.thunder_previous_x = 0
    callbacks.clear_damage_death()
    bones.root.rotate_x(0)

func thunder_enter(bool air_started):
    let int target = attrs.thunder_ground_start
    if air_started: target = attrs.thunder_air_start
    state.enter_at_speed(target, 0, 0, 1)
    command(3) = 0
    command(2) = 0
    command(1) = 0
    command(0) = 0
    thunder_reset_movement()
    state.thunder_collision_mode = 1
    state.thunder_gravity_delay = attrs.thunder_gravity_delay
    state.thunder_launch_effect_frame = 0
    # Original repeats collPos1.x three times; Y is filled before its first read.
    state.thunder_collision_x = 0
    state.thunder_aerial_angle = 0
    if facing.direction != 1: state.thunder_aerial_angle = attrs.thunder_pi
    if air_started: velocity.y = 0
    animation.start()

func thunder_start_animation(bool air_started):
    if animation.finished:
        let int target = attrs.thunder_ground_hold
        if air_started: target = attrs.thunder_air_hold
        state.enter_at_speed(target, 0, 0, 1)
        if state.thunder_ball_handle == -1:
            bones.world_position(attrs.thunder_spawn_joint, state.thunder_requested_x, state.thunder_requested_y, state.thunder_requested_z)
            state.thunder_requested_z = 0
            thunder_create_ball(state.thunder_requested_x, state.thunder_requested_y, state.thunder_requested_z, facing.direction)
            if state.thunder_ball_handle != -1:
                callbacks.track_death2()
                callbacks.track_damage()
        jumps.used = jumps.max
        thunder_stop_effects()
        effects.spawn_on_part(attrs.thunder_hold_effect, attrs.thunder_effect_joint)
        state.thunder_effects_active = true

func thunder_check_self_contact():
    state.thunder_self_contact = false
    if state.thunder_ball_handle != -1:
        let x = articles.ref(state.thunder_ball_handle, It_Kind_Ness_PKThunder).state.history_x[0]
        let y = articles.ref(state.thunder_ball_handle, It_Kind_Ness_PKThunder).state.history_y[0]
        let center_y = position.y + attrs.thunder_collision_height * model.instance_scale_y
        let bool inside = abs(position.x - x) < attrs.thunder_contact_width and abs(center_y - y) < attrs.thunder_contact_height
        if state.thunder_collision_mode == 0:
            if inside:
                state.thunder_collision_mode = 2
                state.thunder_collision_x = x
                state.thunder_collision_y = y
                state.thunder_self_contact = true
        else:
            if state.thunder_collision_mode == 1 and not inside: state.thunder_collision_mode = 0

func thunder_air_launch():
    let x = position.x - state.thunder_collision_x
    let y = attrs.thunder_collision_height * model.instance_scale_y + position.y - state.thunder_collision_y
    facing.direction = -1
    if x >= 0: facing.direction = 1
    state.thunder_aerial_angle = atan2_float(y, x)
    velocity.x = attrs.thunder_launch_speed * cos(state.thunder_aerial_angle)
    velocity.y = attrs.thunder_launch_speed * sin(state.thunder_aerial_angle)
    state.enter_at_speed(attrs.thunder_air_launch, 0, 0, 1)
    bones.root.rotate_x(facing.direction * atan2_float(velocity.x, velocity.y) - attrs.thunder_pi / 2)
    callbacks.clear_damage_death()
    jumps.used = jumps.max

func thunder_ground_launch():
    if not floor.is_platform:
        let x = position.x - state.thunder_collision_x
        let y = attrs.thunder_collision_height * model.instance_scale_y + position.y - state.thunder_collision_y
        let angle = vectors.angle(floor.normal.x, floor.normal.y, floor.normal.z, x, y, 0)
        if not (angle < attrs.thunder_pi / 2):
            if not (angle > radians(90 + attrs.thunder_knockdown_degrees)):
                facing.direction = -1
                if x >= 0: facing.direction = 1
                state.thunder_aerial_angle = atan2_float(y, x)
                state.enter_at_speed(attrs.thunder_ground_launch, 0, 0, 1)
                ground.velocity = attrs.thunder_launch_speed * facing.direction
                bones.root.rotate_x(facing.direction * atan2_float(velocity.x, velocity.y) - attrs.thunder_pi / 2)
                callbacks.clear_damage_death()
                jumps.used = jumps.max
                return
            thunder_stop_effects()
            bones.root.rotate_x(0)
            state.down_bound()
            return
    jumps.used = jumps.max
    physics.force_air_and_use_jumps()
    thunder_air_launch()

func thunder_hold_animation(bool air_started):
    if state.thunder_loop1 > 0: state.thunder_loop1 = state.thunder_loop1 - 1
    if state.thunder_ball_handle == -1 and state.thunder_loop2 > 0: state.thunder_loop2 = state.thunder_loop2 - 1
    let int target = attrs.thunder_ground_end
    if air_started: target = attrs.thunder_air_end
    if state.thunder_ball_handle == -1:
        if state.thunder_loop1 <= 0 and state.thunder_loop2 <= 0:
            state.enter_at_speed(target, 0, 0, 1)
            thunder_stop_effects()
    else:
        if articles.owned(state.thunder_ball_handle):
            thunder_check_self_contact()
            if state.thunder_self_contact:
                if air_started: thunder_air_launch()
                else: thunder_ground_launch()
        else:
            state.thunder_ball_handle = -1
            state.enter_at_speed(target, 0, 0, 1)
            thunder_stop_effects()

func thunder_freefall():
    physics.force_air_and_use_jumps()
    if attrs.thunder_landing_lag == 0: state.fall()
    else: state.freefall_blend(1, 0, 1, 1, attrs.thunder_landing_lag, attrs.thunder_freefall_blend)

func thunder_launch_animation(bool air_started):
    state.thunder_launch_effect_frame = state.thunder_launch_effect_frame + 1
    if state.thunder_launch_effect_frame == 1:
        thunder_stop_effects()
        effects.spawn_on_part(attrs.thunder_launch_effect, attrs.thunder_effect_joint)
        state.thunder_effects_active = true
    if animation.finished:
        if air_started:
            velocity.y = -abs(state.thunder_fall_acceleration)
            thunder_freefall()
        else:
            state.enter_at_speed(attrs.thunder_ground_end, 0, 0, 1)
            thunder_stop_effects()

func thunder_air_physics():
    if state.thunder_gravity_delay != 0:
        state.thunder_gravity_delay = state.thunder_gravity_delay - 1
    else:
        physics.fall(attrs.thunder_fall_acceleration, air.terminal_velocity)
    physics.air_decel(air.friction)

func thunder_ground_launch_physics():
    let previous = ground.velocity
    ground.velocity = -(attrs.thunder_launch_deceleration * facing.direction - previous)
    if facing.direction == 1:
        if ground.velocity <= attrs.thunder_velocity_epsilon: ground.velocity = previous
    else:
        if ground.velocity >= -attrs.thunder_velocity_epsilon: ground.velocity = previous
    state.thunder_previous_x = velocity.x
    state.thunder_previous_y = velocity.y
    state.thunder_previous_z = velocity.z
    physics.ground_to_self()
    bones.root.rotate_x(facing.direction * atan2_float(velocity.x, velocity.y) - attrs.thunder_pi / 2)

func thunder_air_launch_physics():
    let speed = abs(sqrt(velocity.x * velocity.x + velocity.y * velocity.y))
    let next = speed - attrs.thunder_launch_deceleration
    if next <= attrs.thunder_velocity_epsilon: next = speed
    velocity.x = next * cos(state.thunder_aerial_angle)
    velocity.y = next * sin(state.thunder_aerial_angle)
    bones.root.rotate_x(facing.direction * atan2_float(velocity.x, velocity.y) - attrs.thunder_pi / 2)
    state.thunder_previous_x = velocity.x
    state.thunder_previous_y = velocity.y
    state.thunder_previous_z = velocity.z
    if command(0) == 1:
        state.thunder_fall_acceleration = state.thunder_fall_acceleration - attrs.thunder_fall_acceleration
        if state.thunder_fall_acceleration < -attrs.thunder_launch_speed: state.thunder_fall_acceleration = -attrs.thunder_launch_speed
        position.y = position.y + state.thunder_fall_acceleration

func thunder_ground_collision(int target):
    if collision.left_ground:
        physics.force_air_and_use_jumps()
        state.enter_at_speed(target, attrs.thunder_collision_flags, frame, 1)

func thunder_air_collision(int target):
    if collision.landed:
        physics.switch_to_ground()
        state.enter_at_speed(target, attrs.thunder_collision_flags, frame, 1)

func thunder_ground_launch_collision():
    if collision.left_ground:
        physics.force_air_and_use_jumps()
        if collision.wall_contact:
            thunder_reset_movement()
            state.enter_at_speed(attrs.thunder_air_end, attrs.thunder_collision_flags, frame, 1)
        else:
            state.enter_at_speed(attrs.thunder_air_launch, attrs.thunder_launch_collision_flags, frame, 1)
        return
    if collision.ceiling_contact or collision.wall_contact:
        ground.velocity = 0
        thunder_stop_effects()
        bones.root.rotate_x(0)
        state.down_bound()
        return
    let offset = attrs.thunder_pi / 2
    if floor.normal.y > 0:
        if facing.direction == 1: offset = -offset
    else:
        if facing.direction != 1: offset = -offset
    state.thunder_aerial_angle = offset + atan2_float(floor.normal.y, floor.normal.x)

func thunder_rebound(float nx, float ny, float nz):
    physics.mirror_velocity(nx, ny, nz)
    velocity.x = velocity.x * attrs.thunder_rebound_damping
    velocity.y = velocity.y * attrs.thunder_rebound_damping
    physics.clamp_horizontal_speed(air.drift_max)
    facing.direction = -1
    if velocity.x >= 0: facing.direction = 1
    thunder_stop_effects()
    state.enter_at_speed(attrs.thunder_air_rebound, 2, 0, 1)
    animation.start()
    effects.spawn_with_scalar_at_position(attrs.thunder_rebound_effect, position.x, position.y, position.z, atan2_float(-nx, ny))

func thunder_slide_wall():
    let direction = state.thunder_aerial_angle
    while direction < 0: direction = direction + attrs.thunder_tau
    while direction > attrs.thunder_tau: direction = direction - attrs.thunder_tau
    let float normal = 0
    let float opposite = 0
    if collision.left_wall:
        normal = atan2_float(wall.left.normal.y, wall.left.normal.x)
        while normal < 0: normal = normal + attrs.thunder_tau
        while normal > attrs.thunder_tau: normal = normal - attrs.thunder_tau
        opposite = attrs.thunder_pi + direction
        while opposite > attrs.thunder_tau: opposite = opposite - attrs.thunder_tau
        if opposite - normal < 0: normal = normal + attrs.thunder_pi / 2
        else: normal = normal - attrs.thunder_pi / 2
    if collision.right_wall:
        normal = atan2_float(wall.right.normal.y, wall.right.normal.x)
        opposite = attrs.thunder_pi + normal
        while opposite < 0: opposite = opposite + attrs.thunder_tau
        while opposite > attrs.thunder_tau: opposite = opposite - attrs.thunder_tau
        if direction - opposite < 0: normal = normal + attrs.thunder_pi / 2
        else: normal = normal - attrs.thunder_pi / 2
    physics.rotate_velocity_unit_axis(0, 0, 1, normal - direction)
    state.thunder_aerial_angle = atan2_float(velocity.y, velocity.x)

func thunder_air_launch_collision():
    velocity.x = state.thunder_previous_x
    velocity.y = state.thunder_previous_y
    velocity.z = state.thunder_previous_z
    let int ledge_direction = -1
    if facing.direction == 1: ledge_direction = 1
    let threshold = attrs.thunder_radians_per_degree * (90 + attrs.thunder_wallhug_degrees)
    if collision.check_ground_ledge(ledge_direction):
        if vectors.angle(floor.normal.x, floor.normal.y, floor.normal.z, velocity.x, velocity.y, velocity.z) > threshold:
            velocity.z = 0
            velocity.y = 0
            velocity.x = 0
            thunder_stop_effects()
            bones.root.rotate_x(0)
            state.down_bound()
        else:
            physics.switch_to_ground()
            state.enter_at_speed(attrs.thunder_ground_launch, attrs.thunder_launch_collision_flags, frame, 1)
        return
    if collision.cliff_catch():
        state.catch_ledge()
        return
    if collision.ceiling_contact:
        if vectors.angle(ceiling.normal.x, ceiling.normal.y, ceiling.normal.z, velocity.x, velocity.y, velocity.z) > threshold:
            thunder_rebound(ceiling.normal.x, ceiling.normal.y, ceiling.normal.z)
    else:
        if collision.left_wall:
            if vectors.angle(wall.left.normal.x, wall.left.normal.y, wall.left.normal.z, velocity.x, velocity.y, velocity.z) > threshold:
                thunder_rebound(wall.left.normal.x, wall.left.normal.y, wall.left.normal.z)
            else:
                thunder_slide_wall()
            return
        if collision.right_wall:
            if vectors.angle(wall.right.normal.x, wall.right.normal.y, wall.right.normal.z, velocity.x, velocity.y, velocity.z) > threshold:
                thunder_rebound(wall.right.normal.x, wall.right.normal.y, wall.right.normal.z)
            else:
                thunder_slide_wall()

func thunder_rebound_collision():
    if collision.check_ground_ledge(0):
        velocity.z = 0
        velocity.y = 0
        velocity.x = 0
        thunder_stop_effects()
        bones.root.rotate_x(0)
        state.down_bound()
        return
    if collision.cliff_catch(): state.catch_ledge()

export func bat_forget():
    state.bat_handle = -1

func BatRemove():
    if state.bat_handle != -1:
        articles.signal(state.bat_handle, It_Kind_Ness_Bat, "remove", 0)
        state.bat_handle = -1

func YoyoPause():
    if state.yoyo_handle != -1: articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "pause", 0)

func YoyoResume():
    if state.yoyo_handle != -1: articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "resume", 0)

export func yoyo_forget():
    YoyoResume()
    state.yoyo_handle = -1

func YoyoRemove():
    if state.yoyo_handle != -1:
        articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "remove", 0)
        YoyoResume()
        state.yoyo_handle = -1

func BatCreate():
    state.bat_handle = articles.create_with_velocity(It_Kind_Ness_Bat, position.x, position.y, 0, 0, 0, 0, facing.direction, false, 0, 0, false)
    if state.bat_handle != -1:
        callbacks.death2(ResourceDamage)
        callbacks.damage(ResourceDamage)

func YoyoCreate():
    let float x = 0
    let float y = 0
    let float z = 0
    bones.world_position(attrs.resource_attachment_joint, x, y, z)
    state.yoyo_handle = articles.create_at_position(It_Kind_Ness_Yoyo, x, y, z, facing.direction, false, 0, motion.id)
    if state.yoyo_handle == -1:
        items.clear_auxiliary()
    else:
        let bool published = articles.bind_auxiliary(state.yoyo_handle)
        if callbacks.matches(Callback.death2, None): callbacks.death2(ResourceDamage)
        if callbacks.matches(Callback.damage, None): callbacks.damage(ResourceDamage)
    callbacks.pre_hitlag(YoyoPause)
    callbacks.post_hitlag(YoyoResume)

func YoyoInitialize():
    command(1) = 0
    command(0) = 0
    state.yoyo_frame = 1
    state.yoyo_rehit_timer = 0
    state.yoyo_slope_correct = true
    state.yoyo_hitbox_z = 0
    state.yoyo_hitbox_y = 0
    state.yoyo_hitbox_x = 0
    state.yoyo_spin_rate = 0

func YoyoBindCallbacks():
    damage.song_immune = true
    callbacks.track_deal_damage()
    callbacks.accessory(YoyoUpdateHitPos)

func YoyoStartTimedRehit():
    state.yoyo_rehit_timer = int(attrs.yoyo_rehit_rate)

func YoyoCheckTimedRehit():
    if command(0) == 0 and state.yoyo_rehit_timer > 0:
        state.yoyo_rehit_timer = state.yoyo_rehit_timer - 1
        if state.yoyo_rehit_timer == 0:
            # Stock clears victims, then enables the delayed YoYo hitbox without
            # marking fighter hitbox cleanup. A later smash exit can therefore
            # leave it active, causing stray hits and the lingering YoYo jacket.
            # Generic enabling also maintains the normal motion-cleanup flag.
            hitbox.clear_victims(0)
            hitbox.set_enabled(0, true)

func YoyoUpdateHitPos():
    if hitbox.state(0) != Hitbox.disabled:
        if state.yoyo_hitbox_x != 0 or state.yoyo_hitbox_y != 0:
            hitbox.set_world_position(0, state.yoyo_hitbox_x, state.yoyo_hitbox_y, state.yoyo_hitbox_z)

func YoyoSetHitPos(float fraction, bool blend):
    let float x = 0
    let float y = 0
    let float z = 0
    bones.world_position(attrs.yoyo_hit_joint, x, y, z)
    if state.yoyo_slope_correct:
        let float root_x = 0
        let float root_y = 0
        let float root_z = 0
        bones.world_position(attrs.yoyo_slope_root_joint, root_x, root_y, root_z)
        let float dx = x - root_x
        let float dy = y - root_y
        let float dz = z - root_z
        let float rx = 0
        let float ry = 0
        let float rz = 0
        vectors.rotate(dx, dy, dz, 4, -atan2_float(floor.normal.x, floor.normal.y), rx, ry, rz)
        x = rx + root_x
        y = ry + root_y
        z = rz + root_z
    if not blend:
        state.yoyo_hitbox_x = x
        state.yoyo_hitbox_y = y
        state.yoyo_hitbox_z = z
    else:
        let float retained = 1 - fraction
        state.yoyo_hitbox_x = x * fraction + state.yoyo_hitbox_x * retained
        state.yoyo_hitbox_y = y * fraction + state.yoyo_hitbox_y * retained
        state.yoyo_hitbox_z = z * fraction + state.yoyo_hitbox_z * retained

func YoyoCheckEnv(float ax, float ay, float az, float bx, float by, float bz, float radius) -> int:
    let float size = radius * model.instance_scale_y
    let int flags = stage.sweep_box(ax, ay, az, bx, by, bz, size, -size, -size, 0, size, 0, attrs.yoyo_ecb_category)
    let int result = 0
    if flags & Collision.floor_mask: result = result | 32768
    if flags & Collision.left_wall_mask: result = result | 1
    if flags & Collision.right_wall_mask: result = result | 64
    if flags & Collision.ceiling_mask: result = result | 8192
    return result

func YoyoCheckNoObstruct() -> bool:
    let float x = position.x
    let float y = attrs.yoyo_ecb_half_height * (ecb.top.y + ecb.bottom.y)
    y = y + position.y
    let float z = position.z
    let int first = YoyoCheckEnv(x, y, z, state.yoyo_hitbox_x, state.yoyo_hitbox_y, state.yoyo_hitbox_z, attrs.yoyo_obstruction_radius)
    if first == 0:
        let float upper = state.yoyo_hitbox_y + model.instance_scale_y
        let float lower = state.yoyo_hitbox_y + -1 * model.instance_scale_y
        let int second = YoyoCheckEnv(state.yoyo_hitbox_x, upper, state.yoyo_hitbox_z, state.yoyo_hitbox_x, lower, state.yoyo_hitbox_z, attrs.yoyo_floor_check_radius)
        return (second & 32768) != 0
    return false

func YoyoApplyDamage():
    if smash.charge_frames != 0 and hitbox.state(0) == Hitbox.enabled:
        let float duration = smash.charge_frames / attrs.yoyo_charge_duration
        let float multiplier = attrs.yoyo_damage_multiplier * attrs.yoyo_damage_fraction - 1
        let float damage = hitbox.damage(0) * (multiplier * duration + 1)
        hitbox.set_damage(0, damage)

func YoyoApplySmash():
    state.yoyo_frame = 0
    if state.yoyo_handle != -1:
        articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "charge_release", facing.direction)
    smash.charge_mode = Smash.manual_charge
    smash.saved_animation_rate = animation.rate
    smash.charge_frames = 0
    smash.charge_limit = attrs.yoyo_shared_charge_limit
    smash.shake_index = 0
    smash.shake_period = smash.shake_table_count
    smash.charge_color = attrs.yoyo_charge_color
    if smash.charge_color != attrs.smash_color_skip: color.start(smash.charge_color, false)
    controller.rumble(attrs.yoyo_rumble, 0)
    sound.loop(attrs.yoyo_charge_sound, attrs.sound_volume, attrs.sound_pan)

func YoyoSetChargeDamage():
    state.yoyo_frame = attrs.yoyo_release_counter
    if state.yoyo_handle != -1:
        articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "held", 0)
        state.yoyo_spin_rate = program.entity_params.It_Kind_Ness_Yoyo.released_spin_rate
    sound.loop(attrs.yoyo_release_sound, attrs.sound_volume, attrs.sound_pan)
    YoyoApplyDamage()

func YoyoSetChargeSpin():
    if state.yoyo_handle != -1:
        let float initial = program.entity_params.It_Kind_Ness_Yoyo.initial_charge_spin_rate
        let float difference = initial - program.entity_params.It_Kind_Ness_Yoyo.charged_spin_rate
        difference = difference * (float(state.yoyo_frame) / attrs.yoyo_charge_duration)
        state.yoyo_spin_rate = initial - difference

func YoyoThink() -> bool:
    if command(0) != 0: state.yoyo_slope_correct = false
    let bool up = motion.id >= attrs.yoyo_up_start_motion and motion.id <= attrs.yoyo_up_release_motion
    let int despawn = attrs.yoyo_down_despawn_frame
    if up: despawn = attrs.yoyo_up_despawn_frame
    if state.yoyo_frame > attrs.yoyo_spawn_frame and state.yoyo_frame <= despawn:
        if command(1) == 1:
            command(1) = 0
            articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "material", 1)
            state.yoyo_spin_rate = program.entity_params.It_Kind_Ness_Yoyo.released_spin_rate
        if command(1) == 2:
            command(1) = 0
            articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "material", 0)
            state.yoyo_spin_rate = 0
            sound.loop(attrs.yoyo_material_stop_sound, attrs.sound_volume, attrs.sound_pan)
        let int rotate_frame = program.entity_params.It_Kind_Ness_Yoyo.down_smash_rotate_frame
        let int retract_frame = program.entity_params.It_Kind_Ness_Yoyo.down_smash_retract_frame
        if motion.id >= attrs.yoyo_up_start_motion and motion.id <= attrs.yoyo_up_release_motion:
            rotate_frame = program.entity_params.It_Kind_Ness_Yoyo.up_smash_rotate_frame
            retract_frame = program.entity_params.It_Kind_Ness_Yoyo.up_smash_retract_frame
        if state.yoyo_frame == rotate_frame:
            articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "held", 0)
            if motion.id >= attrs.yoyo_up_start_motion and motion.id <= attrs.yoyo_up_release_motion:
                sound.loop(attrs.yoyo_up_rotate_sound, attrs.sound_volume, attrs.sound_pan)
            else:
                sound.loop(attrs.yoyo_down_rotate_sound, attrs.sound_volume, attrs.sound_pan)
        elif state.yoyo_frame == retract_frame:
            articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "retract", 0)
        if state.yoyo_frame == despawn: articles.signal(state.yoyo_handle, It_Kind_Ness_Yoyo, "remove", 0)
    elif state.yoyo_frame == attrs.yoyo_spawn_frame:
        YoyoCreate()
        if state.yoyo_handle == -1:
            state.wait()
            return true
    return false

func BatEnter():
    controls.interrupt_allowed = false
    command(0) = 0
    state.enter_at_speed(attrs.bat_smash_motion, 0, 0, 1)
    animation.start()
    BatCreate()

func BatReflect():
    sound.play(attrs.bat_reflect_sound, attrs.sound_volume, attrs.sound_pan)

func BatAnimation():
    if not reflector.active:
        if command(0) != 0:
            reflector.create(attrs.bat_reflect_joint, attrs.bat_reflect_max_damage, attrs.bat_reflect_x, attrs.bat_reflect_y, attrs.bat_reflect_z, attrs.bat_reflect_radius, attrs.bat_reflect_damage_multiplier, attrs.bat_reflect_speed_multiplier, attrs.bat_reflect_behavior != 0)
            callbacks.track_reflect_hit()
    elif command(0) == 0:
        reflector.disable()
    if animation.finished:
        BatRemove()
        state.wait()

func BatInterrupt():
    if controls.interrupt_allowed != 0:
        BatRemove()
        controls.ground_actions()

func BatPhysics():
    physics.ground_motion()
    reflector.update()

func YoyoEnter(bool up):
    controls.interrupt_allowed = false
    state.yoyo_charge_disabled = false
    YoyoInitialize()
    let int target = attrs.yoyo_down_start_motion
    if up: target = attrs.yoyo_up_start_motion
    state.enter_at_speed(target, 0, 0, 1)
    animation.start()
    YoyoBindCallbacks()

func YoyoChargeEnter(bool up):
    let int target = attrs.yoyo_down_charge_motion
    if up: target = attrs.yoyo_up_charge_motion
    state.enter_at_speed(target, attrs.smash_skip_item_visibility, attrs.yoyo_charge_animation_frame, 1)
    animation.start()
    animation.set_rate(0)
    YoyoApplySmash()
    YoyoBindCallbacks()

func YoyoReleaseEnter(bool up):
    let int target = attrs.yoyo_down_release_motion
    if up: target = attrs.yoyo_up_release_motion
    state.enter_at_speed(target, attrs.smash_skip_item_visibility, attrs.yoyo_release_animation_frame, 1)
    animation.start()
    YoyoSetChargeDamage()
    YoyoBindCallbacks()

func YoyoAnimation(bool up, bool release):
    state.yoyo_frame = state.yoyo_frame + 1
    if not YoyoThink():
        YoyoCheckTimedRehit()
        if not release:
            if state.yoyo_frame == attrs.yoyo_obstruction_frame and not state.yoyo_charge_disabled:
                if YoyoCheckNoObstruct(): YoyoChargeEnter(up)
        if animation.finished: state.wait()

func YoyoInterrupt(bool release):
    if not release and not input.attack_held: state.yoyo_charge_disabled = true
    if controls.interrupt_allowed != 0: controls.ground_actions()

func YoyoChargeAnimation(bool up):
    state.yoyo_frame = state.yoyo_frame + 1
    YoyoSetChargeSpin()
    YoyoCheckTimedRehit()
    if float(state.yoyo_frame) >= attrs.yoyo_charge_duration: YoyoReleaseEnter(up)

func YoyoChargeInterrupt(bool up):
    if not input.attack_held: YoyoReleaseEnter(up)

func YoyoPhysics(bool release, bool up):
    physics.ground_friction()
    let float fraction = 1
    let bool blend = false
    if release:
        let int end = attrs.yoyo_down_blend_end
        let float step = attrs.yoyo_down_blend_step
        if up:
            end = attrs.yoyo_up_blend_end
            step = attrs.yoyo_up_blend_step
        if state.yoyo_frame < end:
            blend = true
            fraction = step * (float(state.yoyo_frame) - float(attrs.yoyo_release_counter))
            if fraction >= 1: fraction = 1
            elif fraction <= 0: fraction = 0
    YoyoSetHitPos(fraction, blend)

func YoyoCollision():
    collision.ground_standard()
    if airborne: YoyoRemove()

func ResourceDamage():
    YoyoRemove()
    flash_detach()
    thunder_damage()
    BatRemove()

func CpuActiveSpecial() -> bool:
    let int target = int(cpu.target_id)
    let float target_x = 0
    let float target_y = 0
    let float target_z = 0
    let bool has_target = targets.read_position(target, target_x, target_y, target_z)
    if motion.id >= attrs.cpu_flash_first_motion and motion.id <= attrs.cpu_flash_last_motion:
        if not has_target:
            cpu.clear_target()
            cpu.behavior = cpu.previous_behavior
            cpu.queue(Cpu.done)
        elif abs(target_y - position.y) < attrs.cpu_flash_release_height:
            cpu.queue(Cpu.release_b)
            cpu.queue(Cpu.done)
            cpu.clear_target()
            cpu.behavior = cpu.previous_behavior
            cpu.queue(Cpu.done)
        else:
            cpu.queue(Cpu.toward_target, attrs.cpu_stick_strength)
            cpu.queue(Cpu.done)
        return true
    if motion.id >= attrs.cpu_thunder_first_motion and motion.id <= attrs.cpu_thunder_last_motion:
        if not has_target:
            cpu.clear_target()
            cpu.behavior = cpu.previous_behavior
            cpu.queue(Cpu.done)
        else:
            cpu.queue(Cpu.toward_target, attrs.cpu_stick_strength)
            cpu.queue(Cpu.done)
        return true
    return false

func CpuAimThunder(float angle, int frames):
    cpu.queue(Cpu.stick_x, float(attrs.cpu_stick_strength) * cos(angle))
    cpu.queue(Cpu.stick_y, float(attrs.cpu_stick_strength) * sin(angle))
    cpu.queue(Cpu.wait, frames)

func JumpPhysics():
    physics.air_accel_from(state.jump_horizontal_accumulator)
    state.jump_horizontal_accumulator = state.jump_horizontal_accumulator + acceleration.x
    acceleration.x = 0
    velocity.x = animation.delta.z * facing.direction + state.jump_horizontal_accumulator
    physics.animation_vertical_velocity_adjusted()

move PKFire:
    entry explicit
    on special_s:
        fire_enter(false)
    on special_air_s:
        fire_enter(true)
    on ground_animation:
        if animation.finished: state.wait()
    on air_animation:
        if animation.finished: state.fall()
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_gravity_and_friction()
    on ground_collision:
        if collision.special_ground_lost:
            state.fall()
    on air_collision:
        if collision.landed:
            state.landing_special(false, attrs.fire_landing_lag)

move PSIMagnet:
    entry explicit
    on special_lw:
        magnet_enter(false)
    on special_air_lw:
        magnet_enter(true)
    on ground_animation:
        magnet_start_animation()
    on air_animation:
        magnet_start_animation()
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        magnet_air_physics(false)
    on ground_collision:
        magnet_ground_collision(372, attrs.magnet_collision_flags, false)
    on air_collision:
        magnet_air_collision(367, attrs.magnet_collision_flags, false)

move PKFlash:
    entry explicit
    on special_n:
        flash_enter(false)
    on special_air_n:
        flash_enter(true)
    on ground_animation:
        flash_start_animation(false)
    on air_animation:
        flash_start_animation(true)
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        flash_ground_start_physics()
    on air_physics:
        flash_air_physics()
    on ground_collision:
        flash_ground_collision(352)
    on air_collision:
        flash_air_collision(348)

move PKThunder:
    entry explicit
    on special_hi:
        thunder_enter(false)
    on special_air_hi:
        thunder_enter(true)
    on ground_animation:
        thunder_start_animation(false)
    on air_animation:
        thunder_start_animation(true)
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        if state.thunder_gravity_delay != 0: state.thunder_gravity_delay = state.thunder_gravity_delay - 1
        physics.ground_friction()
    on air_physics:
        thunder_air_physics()
    on ground_collision:
        thunder_ground_collision(attrs.thunder_air_start)
    on air_collision:
        thunder_air_collision(attrs.thunder_ground_start)

action MagnetPhases:
    on state_368_animation:
        magnet_hold_animation()
    on state_368_interrupt:
