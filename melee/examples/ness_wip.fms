        YoyoAnimation(false, true)
    on state_347_interrupt:
        YoyoInterrupt(true)
    on state_347_physics:
        YoyoPhysics(true, false)
    on state_347_collision:
        YoyoCollision()

action ResourceLifecycle:
    on load:
        fighter.copy_ext_attributes()
        # Native authored handles use -1; zero-filled union pointers are not IDs.
        state.flash_handle = -1
        state.thunder_ball_handle = -1
        state.bat_handle = -1
        state.yoyo_handle = -1
        state.thunder_effects_active = false
    on load_special_attrs:
        fighter.reload_ext_attributes()
    on death:
        # Original reset hides this group and forgets handles; damage owns removal.
        visuals.hide_group(0)
        state.flash_handle = -1
        state.thunder_ball_handle = -1
        state.bat_handle = -1
        state.yoyo_handle = -1
        state.thunder_effects_active = false
    on damage:
        ResourceDamage()
    on death2:
        ResourceDamage()
    on item_pickup_ext:
        fighter.item_pickup(event.flag, 1, 1)
    on item_drop_ext:
        fighter.item_drop(event.flag, 1, 1)
    on item_pickup:
        fighter.item_pickup(event.flag, 1, 1)
    on item_drop:
        fighter.item_drop(event.flag, 1, 1)
    on item_invisible:
        fighter.item_invisible(1)
    on item_visible:
        fighter.item_visible(1)
    on knockback_enter:
        fighter.knockback_enter(1)
    on knockback_exit:
        fighter.knockback_exit(1)
    on worn_item_jump_sound:
        return false

action CpuPolicy:
    on cpu_attack_decision:
        return CpuActiveSpecial()
    on cpu_travel_decision:
        if CpuActiveSpecial():
            # Original Ness travel caller increments after the special policy.
            cpu.travel_frames = cpu.travel_frames + 1
            return true
        return false
    on cpu_recovery:
        if position.y > cpu.destination.y - attrs.cpu_recovery_height_margin:
            cpu.queue(Cpu.done)
            return
        if cpu.level < attrs.cpu_recovery_minimum_level:
            cpu.queue(Cpu.done)
            return
        cpu.queue(Cpu.stick_y, attrs.cpu_stick_strength)
        cpu.queue(Cpu.stick_x, 0)
        cpu.queue(Cpu.press_b_for, 1)
        cpu.queue(Cpu.release_b)
        let float first = 0
        let float second = attrs.cpu_recovery_pi
        if cpu.destination.x - position.x > 0:
            first = attrs.cpu_recovery_pi
            second = 0
        CpuAimThunder(first, attrs.cpu_recovery_first_frames)
        CpuAimThunder(-attrs.cpu_recovery_half_pi, attrs.cpu_recovery_bottom_frames)
        CpuAimThunder(second, attrs.cpu_recovery_second_frames)
        CpuAimThunder(attrs.cpu_recovery_half_pi, attrs.cpu_recovery_top_frames)
        cpu.queue(Cpu.done)

action CommonPolicy:
    on aerial_jump:
        physics.ground_to_air()
        command(0) = 1
        let int target = attrs.jump_backward_motion
        if input.x * facing.direction > -controls.aerial_jump_reverse_threshold:
            target = attrs.jump_forward_motion
        jump.begin(target, 0, 0, 0, true, false, false)
        callbacks.physics(JumpPhysics)
        state.jump_horizontal_accumulator = input.x * air.jump_horizontal_multiplier
    on presentation_item:
        if motion.id != attrs.presentation_star_ice_motion and motion.id != attrs.presentation_camera_ice_motion and motion.id != attrs.presentation_sleep_motion:
            return
        # Presentation Bat is published only as the held reference. It does not
        # replace the smash Bat handle or install the resource damage callback.
        let int bat = articles.create_with_velocity(It_Kind_Ness_Bat, position.x, position.y, 0, 0, 0, 0, facing.direction, false, 0, float(attrs.presentation_bat_mode), false)
        if bat == -1:
            items.clear_held()
        else:
            let bool published = articles.bind_held(bat)
            if motion.id == attrs.presentation_star_ice_motion:
                articles.signal(bat, It_Kind_Ness_Bat, "presentation_scale", attrs.presentation_star_scale * (model.instance_scale_y * model.base_scale))
    on cpu_special_candidate:
        let int target = int(cpu.target_id)
        let float target_x = 0
        let float target_y = 0
        let float target_z = 0
        let bool has_target = targets.read_position(target, target_x, target_y, target_z)
        let float separation = target_x - position.x
        let bool facing_target = not has_target or abs(separation) < attrs.cpu_target_facing_epsilon or separation * facing.direction >= 0
        if airborne:
            if event.angle < attrs.cpu_fire_angle_high and event.angle > attrs.cpu_fire_angle_low and event.distance < attrs.cpu_fire_distance and facing_target:
                cpu.selected_command = attrs.cpu_fire_command
                return true
            return false
        if event.angle < attrs.cpu_ground_angle_high and event.angle > attrs.cpu_ground_angle_low and event.distance < attrs.cpu_fire_distance and facing_target:
            cpu.selected_command = attrs.cpu_fire_command
            return true
        if position.y >= target_y: return false
        if event.angle > attrs.cpu_flash_high_angle:
            cpu.selected_command = attrs.cpu_flash_high_command
        elif random.float() < attrs.cpu_flash_probability:
            cpu.selected_command = attrs.cpu_flash_low_command
        # Consume without assigning when the random branch fails. Preserve the
        # existing selected command (including zero), exactly as original C.
        return true
    on cpu_projectile_hit:
        if cpu.level >= attrs.cpu_absorb_minimum_level and event.prediction_frames >= attrs.cpu_unblockable_prediction_start and event.unblockable:
            return attrs.cpu_projectile_unblockable_category
        return attrs.cpu_projectile_normal_category

article It_Kind_Ness_PKFire states 1:
    attribute float lifetime 0
    attribute float flame_offset_y 4
    state int last_flame
    on created:
            item.inherit_owner_debug_display()
            item.change_state_flags(0, 2)
            item.set_lifetime(item.attr.lifetime)
            item.joint("").rotation.z = item.creation_value
    state 0 anim 0:
        on animation:
            item.life = item.life - 1
            if item.life <= 0: return true
            return false
        on collision:
            return item.hits_stage()
    on damage_dealt:
            item.state.last_flame = item.create_at_position(It_Kind_Ness_PKFire_Flame, position.x, position.y + item.attr.flame_offset_y, position.z, facing)
            return true
    on clanked:
            item.state.last_flame = item.create_at_position(It_Kind_Ness_PKFire_Flame, position.x, position.y + item.attr.flame_offset_y, position.z, facing)
            return true
    on absorbed:
            return true
    on hit_shield:
            return true
    on reflected:
            return item.reflect()
    on shield_bounced:
            item.joint("").rotation.z = -item.joint("").rotation.z
            return item.shield_bounce()
    on interaction:
            item.interact(other)

article It_Kind_Ness_PKFire_Flame states 1:
    attribute float lifetime 0
    attribute float damage_life_multiplier 4
    attribute float final_scale 8
    on created:
            item.inherit_owner_debug_display()
            item.change_state_flags(0, 2)
            item.set_lifetime(item.attr.lifetime)
    state 0 anim 0:
        on animation:
            item.set_scale((item.attr.final_scale + (item.life * (1 - item.attr.final_scale)) / item.attr.lifetime) * item.base_scale)
            # Preserve the stock pre-decrement expiry test.
            if item.life <= 0: return true
            item.life = item.life - 1
            return false
        on physics:
            # Stock assigns GA_Air unconditionally, without clearing flags.
            item.airborne = true
            item.gravity(false)
        on collision:
            item.airborne = true
            item.land_on_stage()
            return false
    on stage_landed:
            velocity.x = 0
            velocity.y = 0
            velocity.z = 0
    on damage_received:
            item.life = -((item.accumulated_damage * item.attr.damage_life_multiplier) - item.life)
            if item.life <= 0: item.life = 1
            return false
    on interaction:
            item.interact(other)

article It_Kind_Ness_PKFlush states 3:
    attribute float lifetime 0
    attribute float max_charge 4
    attribute float initial_scale 8
    attribute float final_scale 12
    attribute float launch_angle_degrees 16
    attribute float launch_speed 20
    attribute float control_acceleration 24
    attribute float gravity 28
    attribute float max_horizontal_speed 32
    attribute float terminal_speed 36
    attribute float explosion_delay 40
    parameter float input_deadzone = 0.2
    parameter float degrees_to_radians = 0.017453292
    parameter float half_pi = 1.5707963267948966
    parameter int stage_stop_sound = 134
    state float charge
    state bool reflected
    state bool controller_enabled
    state bool stage_stopped
    state int explosion_handle
    on signal scale:
            item.set_scale(item.state.charge * ((item.attr.final_scale - item.attr.initial_scale) / item.attr.max_charge) + item.attr.initial_scale)
    on signal detach:
            item.clear_current_owner()
            item.state.controller_enabled = false
            item.clear_attachment_owner()
            item.owner_bound = false
    on created:
            item.command3 = 0
            item.command2 = 0
            item.command1 = 0
            item.command0 = 0
            item.set_lifetime(item.attr.lifetime)
            item.state.charge = 0
            item.state.reflected = false
            item.state.controller_enabled = true
            item.state.stage_stopped = false
            item.use_manual_lifetime()
            item.owner_bound = false
            if item.joint(0, "0").exists: item.joint(0, "0").local_visible = true
            item.change_state_flags(0, 2)
            item.set_lifetime(item.attr.lifetime)
            item.state.charge = 0
            item.state.reflected = false
            let angle = (item.attr.degrees_to_radians * item.attr.launch_angle_degrees * facing) + item.attr.half_pi
            velocity.x = -item.attr.launch_speed * cos(angle)
            velocity.y = item.attr.launch_speed * sin(angle)
            velocity.z = 0
            item.inherit_owner_debug_display()
    state 0 anim 0:
        on animation:
            if item.animation_finished: item.change_state_flags(0, 2)
            if not item.state.reflected:
                item.state.charge = item.state.charge + 1
                if item.state.charge >= item.attr.max_charge: item.state.charge = item.attr.max_charge
                if item.state.controller_enabled and item.attachment_active:
                    if not (owner.state.flash_handle != -1 and (owner.motion == 349 or owner.motion == 353)):
                        item.change_state_flags(1, 2)
                        item.life = item.attr.explosion_delay
                        item.command0 = 0
            if item.expire_tick():
                item.change_state_flags(1, 2)
                item.life = item.attr.explosion_delay
                item.command0 = 0
            item.signal("scale", 0)
            return false
        on physics:
            if not item.state.reflected and item.state.controller_enabled and item.attachment_active:
                if owner.state.flash_handle != -1 and (owner.motion == 349 or owner.motion == 353):
                    let float stick = 0
                    if attachment_owner.exists:
                        stick = attachment_owner.input.x
                    if abs(stick) > item.attr.input_deadzone:
                        velocity.x = velocity.x + stick * item.attr.control_acceleration
                        if abs(velocity.x) > item.attr.max_horizontal_speed:
                            if velocity.x > 0:
                                velocity.x = item.attr.max_horizontal_speed
                            else:
                                velocity.x = -item.attr.max_horizontal_speed
            velocity.y = velocity.y - item.attr.gravity
            if velocity.y < -item.attr.terminal_speed: velocity.y = -item.attr.terminal_speed
            velocity.z = 0
        on collision:
            item.stage_collision(false)
            let bool stopped = false
            if velocity.y > 0:
                if collision.ceiling_contact:
                    stopped = true
            else:
                if collision.floor_contact:
                    stopped = true
            if velocity.x > 0:
                if collision.left_wall:
                    stopped = true
            else:
                if collision.right_wall:
                    stopped = true
            if stopped:
                item.change_state_flags(2, 2)
                item.state.stage_stopped = true
                item.life = item.attr.explosion_delay
                item.stop_loop_sound()
                item.play_sound(item.attr.stage_stop_sound, 127, 64)
            item.signal("scale", 0)
            return false
    state 1 anim 1:
        on animation:
            item.command0 = item.command0 + 1
            if not item.state.reflected and item.state.controller_enabled and item.attachment_active:
                if item.command0 >= int(item.attr.explosion_delay) - 2:
                    item.state.explosion_handle = item.create_child(It_Kind_Ness_PKFlush_Explode, position.x, position.y, 0, facing, item.current_owner, 0, item.state.charge, 0)
                    return true
            item.signal("scale", 0)
            return item.expire_tick()
        on physics:
            velocity.x = 0
            velocity.y = 0
            velocity.z = 0
        on collision:
            return false
    state 2 anim 2:
        on animation:
            item.signal("scale", 0)
            return item.expire_tick()
        on physics:
            velocity.x = 0
            velocity.y = 0
            velocity.z = 0
        on collision:
            return false
    on destroyed:
            hitboxes.disable_all()
            if item.state.controller_enabled and item.attachment_active: owner.helpers.flash_clear()
            item.state.controller_enabled = false
            item.clear_attachment_owner()
            item.owner_bound = false
    on reflected:
            item.state.reflected = true
            facing = -facing
            item.joint("").rotation.y = item.attr.half_pi * facing
            velocity.x = -velocity.x
            velocity.y = -velocity.y
            velocity.z = 0
            return false
    on clanked:
            return true
    on absorbed:
            return true
    on interaction:
            item.interact(other)

article It_Kind_Ness_PKFlush_Explode states 1:
    attribute float max_charge 0
    attribute float initial_scale 4
    attribute float final_scale 8
    attribute float base_damage 12
    attribute float charge_damage_multiplier 16
    parameter float medium_threshold = 0.84999996
    parameter float small_threshold = 0.65
    parameter float rumble_threshold = 0.45
    parameter int medium_quake = 3
    parameter int small_quake = 2
    parameter int medium_rumble = 14
    parameter int medium_rumble_duration = 20
    parameter int small_rumble = 13
    parameter int small_rumble_duration = 15
    parameter int light_rumble = 12
    parameter int light_rumble_duration = 10
    parameter int minimum_rumble = 11
    parameter int minimum_rumble_duration = 5
    parameter float lifetime = 1024
    state float charge
    state float initial_radius
    on signal update:
            let scale = item.state.charge * ((item.attr.final_scale - item.attr.initial_scale) / item.attr.max_charge) + item.attr.initial_scale
            item.set_scale(scale)
            if item.command2 == 0 and hitbox.enabled(0):
                hitbox.set_damage(0, item.state.charge * item.attr.charge_damage_multiplier + item.attr.base_damage)
                item.command2 = 1
            if item.state.initial_radius == 0: item.state.initial_radius = hitbox.radius(0)
            hitbox.set_radius(0, item.state.initial_radius * scale)
    on signal detach:
            hitboxes.disable_all()
            item.clear_current_owner()
    on created:
            item.command3 = 0
            item.command2 = 0
            item.command1 = 0
            item.command0 = 0
            item.state.charge = item.creation_value
            item.use_manual_lifetime()
            item.owner_bound = false
            if item.joint(0, "0").exists: item.joint(0, "0").local_visible = true
            item.change_state_flags(0, 2)
            item.set_lifetime(item.attr.lifetime)
            item.state.initial_radius = 0
            item.advance_animation()
            item.signal("update", 0)
            let ratio = item.state.charge / item.attr.max_charge
            if ratio > item.attr.medium_threshold:
                camera.quake(item.attr.medium_quake, position.x, position.y, position.z)
                item.rumble(item.attr.medium_rumble, item.attr.medium_rumble_duration)
            else:
                if ratio > item.attr.small_threshold:
                    camera.quake(item.attr.small_quake, position.x, position.y, position.z)
                    item.rumble(item.attr.small_rumble, item.attr.small_rumble_duration)
                else:
                    if ratio > item.attr.rumble_threshold:
                        item.rumble(item.attr.light_rumble, item.attr.light_rumble_duration)
                    else:
                        item.rumble(item.attr.minimum_rumble, item.attr.minimum_rumble_duration)
            item.inherit_owner_debug_display()
    state 0 anim 0:
        on animation:
            item.signal("update", 0)
            return item.animation_finished
        on physics:
            # Stock duplicates the Z assignment and intentionally leaves X.
            velocity.y = 0
            velocity.z = 0
        on collision:
            return false
    on clanked:
            return true
    on absorbed:
            return true
    on shield_bounced:
            return true
    on hit_shield:
            return true
    on interaction:
            item.interact(other)

# Source-only Thunder chain. Do not package for gameplay before fighter construction/cleanup ownership.
article It_Kind_Ness_PKThunder states 1:
    attribute float lifetime 0
    attribute float speed 4
    attribute float spawn_angle_degrees 8
    attribute float stick_threshold 12
    attribute float turn_radius_degrees 16
    state int trail_handles[6]
    state float history_x[16]
    state float history_y[16]
    state float history_z[16]
    state float angles[16]
    state float speed
    state int age
    state int next_trail
    state bool reflected
    state bool controller_enabled

    on signal normalize_positive_angle:
            while item.state.angles[0] < 0:
                item.state.angles[0] = item.state.angles[0] + program.attrs.thunder_tau
            while item.state.angles[0] > program.attrs.thunder_tau:
                item.state.angles[0] = item.state.angles[0] - program.attrs.thunder_tau
    on signal shift_angles:
            let int index = program.attrs.thunder_history_count - 2
            while index >= 0:
                item.state.angles[index + 1] = item.state.angles[index]
                index = index - 1
    on signal shift_positions:
            let int index = program.attrs.thunder_history_count - 2
            while index >= 0:
                item.state.history_x[index + 1] = item.state.history_x[index]
                item.state.history_y[index + 1] = item.state.history_y[index]
                item.state.history_z[index + 1] = item.state.history_z[index]
                index = index - 1
            item.state.history_x[0] = position.x
            item.state.history_y[0] = position.y
            item.state.history_z[0] = position.z
    on signal detach_trails:
            let int index = 0
            while index < program.attrs.thunder_trail_count:
                if item.state.trail_handles[index] != -1:
                    if index == program.attrs.thunder_near_trail_count:
                        articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder2, "detach", 0)
                    elif index == program.attrs.thunder_near_trail_count + 1:
                        articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder3, "detach", 0)
                    elif index == program.attrs.thunder_near_trail_count + 2:
                        articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder4, "detach", 0)
                    else:
                        articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder1, "detach", 0)
                    item.state.trail_handles[index] = -1
                index = index + 1
    on signal cleanup:
            hitboxes.disable_all()
            if item.state.controller_enabled:
                if not item.state.reflected and item.attachment_active:
                    creator.helpers.thunder_ball_removed()
                item.state.controller_enabled = false
            item.signal("detach_trails", 0)
            item.owner_bound = false
    on signal detach_damage_owner:
            # it_802AB9C0: reflected balls ignore this fighter damage notification.
            if not item.state.reflected:
                item.clear_current_owner()
                item.owner_bound = false
                let int index = 0
                while index < program.attrs.thunder_trail_count:
                    if item.state.trail_handles[index] != -1:
                        if index == program.attrs.thunder_near_trail_count:
                            articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder2, "detach_damage_owner", 0)
                        elif index == program.attrs.thunder_near_trail_count + 1:
                            articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder3, "detach_damage_owner", 0)
                        elif index == program.attrs.thunder_near_trail_count + 2:
                            articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder4, "detach_damage_owner", 0)
                        else:
                            articles.signal(item.state.trail_handles[index], It_Kind_Ness_PKThunder1, "detach_damage_owner", 0)
                    index = index + 1
    on signal initialize_motion:
            # it_802ABA4C, preserving the second lifetime/angle initialization.
            item.use_manual_lifetime()
            item.owner_bound = false
            item.joint("0").visible = true
            item.change_state_flags(0, program.attrs.thunder_ball_state_flags)
            item.set_lifetime(item.attr.lifetime)
            let int index = 0
            while index < program.attrs.thunder_history_count:
                item.state.angles[index] = item.attr.spawn_angle_degrees * program.attrs.thunder_radians_per_degree
                index = index + 1
            item.state.speed = item.attr.speed
            velocity.y = item.attr.speed
            velocity.z = 0
            velocity.x = 0
            item.inherit_owner_debug_display()
    on created:
            # it_802AB58C successful-constructor tail; unused pointers omitted.
            item.command3 = 0
            item.command2 = 0
            item.command1 = 0
            item.command0 = 0
            item.set_lifetime(item.attr.lifetime)
            let int index = 0
            while index < program.attrs.thunder_history_count:
                item.state.history_x[index] = creator.state.thunder_requested_x
                item.state.history_y[index] = creator.state.thunder_requested_y
                item.state.history_z[index] = creator.state.thunder_requested_z
                index = index + 1
            index = 0
            while index < program.attrs.thunder_history_count:
                item.state.angles[index] = item.attr.spawn_angle_degrees * program.attrs.thunder_radians_per_degree
                index = index + 1
            index = 0
            while index < program.attrs.thunder_trail_count:
                item.state.trail_handles[index] = -1
                index = index + 1
            item.state.next_trail = 0
            item.state.age = 0
            item.state.reflected = false
            item.state.controller_enabled = true
            item.signal("initialize_motion", 0)
            item.remove_at_bounds = false
            if stage.internal_kind == program.attrs.thunder_camera_exception_stage:
                item.release_camera()

    state 0 anim 0:
        on animation:
            if item.state.age >= 0 and item.state.age <= program.attrs.thunder_last_trail_spawn_frame and item.state.age % program.attrs.thunder_trail_spawn_stride == 0:
                if item.state.next_trail <= program.attrs.thunder_trail_count - 1:
                    let int damage_owner = 0
                    if item.state.controller_enabled and item.attachment_active:
                        damage_owner = item.current_owner
                    # Factories name authored declarations, not stock ItemKind numbers.
                    if item.state.next_trail == program.attrs.thunder_near_trail_count:
                        item.state.trail_handles[item.state.next_trail] = item.create_child(It_Kind_Ness_PKThunder2, position.x, position.y, 0, facing, damage_owner, item.collision_group, float(item.state.next_trail), 0)
                    elif item.state.next_trail == program.attrs.thunder_near_trail_count + 1:
                        item.state.trail_handles[item.state.next_trail] = item.create_child(It_Kind_Ness_PKThunder3, position.x, position.y, 0, facing, damage_owner, item.collision_group, float(item.state.next_trail), 0)
                    elif item.state.next_trail == program.attrs.thunder_near_trail_count + 2:
                        item.state.trail_handles[item.state.next_trail] = item.create_child(It_Kind_Ness_PKThunder4, position.x, position.y, 0, facing, damage_owner, item.collision_group, float(item.state.next_trail), 0)
                    else:
                        item.state.trail_handles[item.state.next_trail] = item.create_child(It_Kind_Ness_PKThunder1, position.x, position.y, 0, facing, damage_owner, item.collision_group, float(item.state.next_trail), 0)
                    item.state.next_trail = item.state.next_trail + 1
            item.state.age = item.state.age + 1
            if not item.state.reflected and item.state.controller_enabled:
                if item.attachment_active:
                    if not (creator.motion == program.attrs.thunder_ground_hold or creator.motion == program.attrs.thunder_air_hold):
                        return true
                else:
                    item.signal("cleanup", 0)
                    return true
            return item.expire_tick()
        on physics:
            # Shift all sixteen samples before steering, including inactive control.
            item.signal("shift_angles", 0)
            if not item.state.reflected and item.state.controller_enabled and item.attachment_active and (creator.motion == program.attrs.thunder_ground_hold or creator.motion == program.attrs.thunder_air_hold):
                let float stick_x = creator.input.x
                let float stick_y = creator.input.y
                if abs(stick_x) > item.attr.stick_threshold or abs(stick_y) > item.attr.stick_threshold:
                    let float angle = vectors.angle(velocity.x, velocity.y, velocity.z, stick_x, stick_y, 0)
                    let float cross_z = vectors.cross_normalized_z(velocity.x, velocity.y, velocity.z, stick_x, stick_y, 0)
                    if angle >= program.attrs.thunder_large_turn_degrees * program.attrs.thunder_radians_per_degree:
                        if cross_z > 0:
                            item.state.angles[0] = item.state.angles[0] + item.attr.turn_radius_degrees * program.attrs.thunder_radians_per_degree
                        elif cross_z < 0:
                            item.state.angles[0] = item.state.angles[0] - item.attr.turn_radius_degrees * program.attrs.thunder_radians_per_degree
                    if angle < program.attrs.thunder_large_turn_degrees * program.attrs.thunder_radians_per_degree:
                        if cross_z > 0:
                            item.state.angles[0] = item.state.angles[0] + angle / (program.attrs.thunder_large_turn_degrees / item.attr.turn_radius_degrees)
                        elif cross_z < 0:
                            item.state.angles[0] = item.state.angles[0] - angle / (program.attrs.thunder_large_turn_degrees / item.attr.turn_radius_degrees)

                    while item.state.angles[0] < -program.attrs.thunder_tau:
                        item.state.angles[0] = item.state.angles[0] + program.attrs.thunder_tau
                    while item.state.angles[0] > program.attrs.thunder_tau:
                        item.state.angles[0] = item.state.angles[0] - program.attrs.thunder_tau
                    velocity.x = item.state.speed * cos(item.state.angles[0])
                    velocity.y = item.state.speed * sin(item.state.angles[0])
                    velocity.z = 0
            item.signal("shift_positions", 0)
        on collision:
            # Exact it_8026DA08; sweep_stage_flags would add two other probes.
            item.stage_collision(false)
            let bool hit = false
            if velocity.y > 0:
                hit = collision.ceiling_contact
            else:
                hit = collision.floor_contact
            if velocity.x > 0:
                if collision.left_wall:
                    hit = true
            else:
                if collision.right_wall:
                    hit = true
            if hit:
                hitboxes.disable_all()
                return true
            return false
    on destroyed:
            item.signal("cleanup", 0)
    on damage_dealt:
            item.signal("cleanup", 0)
            return true
    on clanked:
            item.signal("cleanup", 0)
            return true
    on absorbed:
            item.signal("cleanup", 0)
            return true
    on hit_shield:
            item.signal("cleanup", 0)
            return true
    on reflected:
            if item.state.controller_enabled:
                if item.attachment_active:
                    # Match the full ID directly; no identity travels in signal.value.
                    if creator.state.thunder_ball_handle == item.creation_id:
                        creator.state.thunder_ball_handle = -1
                item.state.controller_enabled = false
            item.state.reflected = true
            item.state.angles[0] = item.state.angles[0] + program.attrs.thunder_pi
            item.signal("normalize_positive_angle", 0)
            item.signal("detach_trails", 0)
            item.state.age = 0
            item.state.next_trail = 0
            let int index = 1
            while index < program.attrs.thunder_history_count:
                item.state.history_x[index] = item.state.history_x[0]
                item.state.history_y[index] = item.state.history_y[0]
                item.state.history_z[index] = item.state.history_z[0]
                item.state.angles[index] = item.state.angles[0]
                index = index + 1
            velocity.x = item.state.speed * cos(item.state.angles[0])
            velocity.y = item.state.speed * sin(item.state.angles[0])
            velocity.z = 0
            return false
    on shield_bounced:
            item.mirror_velocity()
            velocity.z = 0
            item.state.angles[0] = atan2(velocity.y, velocity.x)
            item.signal("normalize_positive_angle", 0)
            return false
    on interaction:
            item.interact(other)

article It_Kind_Ness_PKThunder1 states 1:
    state int sample_index
    state int blink_frame
    state bool parent_enabled
    on signal detach:
            hitboxes.disable_all()
            item.state.parent_enabled = false
            item.clear_current_owner()
            item.owner_bound = false
    on signal detach_damage_owner:
            item.clear_current_owner()
            item.owner_bound = false
    on created:
            # it_802AC43C successful tail; link 0/index preexist this callback.
            item.command3 = 0
            item.command2 = 0
            item.command1 = 0
            item.command0 = 0
            item.state.parent_enabled = true
            item.state.sample_index = int(item.creation_value)
            item.state.blink_frame = 0
            item.use_manual_lifetime()
            item.owner_bound = false
            item.joint("0").visible = true
            velocity.z = 0
            velocity.x = 0
            velocity.y = 0
            item.remove_at_bounds = false
            if item.current_owner != 0:
                item.inherit_owner_debug_display()
            item.change_state_flags(0, program.attrs.thunder_trail_state_flags)
    state 0 anim 0:
        on animation:
            if (item.state.blink_frame & 1) != 0:
                item.joint("0").visible = false
            else:
                item.joint("0").visible = true
            item.state.blink_frame = item.state.blink_frame + 1
            return not item.state.parent_enabled
        on physics:
            if item.state.parent_enabled:
                let int parent = item.link_id(0)
                let int index = item.state.sample_index * program.attrs.thunder_history_stride
                position.x = articles.ref(parent, It_Kind_Ness_PKThunder).state.history_x[index]
                position.y = articles.ref(parent, It_Kind_Ness_PKThunder).state.history_y[index]
                position.z = articles.ref(parent, It_Kind_Ness_PKThunder).state.history_z[index]
                let float radius = articles.ref(parent, It_Kind_Ness_PKThunder).state.speed
                item.joint("").scale.z = program.attrs.thunder_radius_multiplier * radius / program.attrs.thunder_radius_divisor
                index = (item.state.sample_index + 1) * program.attrs.thunder_history_stride
                let float next_x = articles.ref(parent, It_Kind_Ness_PKThunder).state.history_x[index]
                let float next_y = articles.ref(parent, It_Kind_Ness_PKThunder).state.history_y[index]
                let float angle = 0
                if facing == 1:
                    angle = atan2(position.y - next_y, position.x - next_x)
                else:
                    angle = program.attrs.thunder_pi + atan2(position.y - next_y, position.x - next_x)
                item.joint("").rotation.x = angle * -facing
        on collision:
            return false

