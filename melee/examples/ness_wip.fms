# These are installed only by the owned Flash constructor-success path.
# Untranslated Yoyo/Thunder/bat dynamic callbacks keep their stock routines.

action ThunderPhases:
    on state_359_animation:
        thunder_hold_animation(false)
    on state_359_interrupt:
        pass
    on state_359_physics:
        physics.ground_friction()
    on state_359_collision:
        thunder_ground_collision(attrs.thunder_air_hold)
    on state_360_animation:
        if animation.finished: state.wait()
    on state_360_interrupt:
        pass
    on state_360_physics:
        physics.ground_friction()
    on state_360_collision:
        thunder_ground_collision(attrs.thunder_air_end)
    on state_361_animation:
        thunder_launch_animation(false)
    on state_361_interrupt:
        pass
    on state_361_physics:
        thunder_ground_launch_physics()
    on state_361_collision:
        thunder_ground_launch_collision()
    on state_363_animation:
        thunder_hold_animation(true)
    on state_363_interrupt:
        pass
    on state_363_physics:
        thunder_air_physics()
    on state_363_collision:
        thunder_air_collision(attrs.thunder_ground_hold)
    on state_364_animation:
        if animation.finished:
            jumps.used = jumps.max
            thunder_freefall()
    on state_364_interrupt:
        pass
    on state_364_physics:
        thunder_air_physics()
    on state_364_collision:
        thunder_air_collision(attrs.thunder_ground_end)
    on state_365_animation:
        thunder_launch_animation(true)
    on state_365_interrupt:
        pass
    on state_365_physics:
        thunder_air_launch_physics()
    on state_365_collision:
        thunder_air_launch_collision()
    on state_366_animation:
        if animation.finished: thunder_freefall()
    on state_366_interrupt:
        pass
    on state_366_physics:
        physics.fall(air.gravity, air.terminal_velocity)
        physics.air_decel(air.friction)
    on state_366_collision:
        thunder_rebound_collision()

action Smashes:
    on deal_damage:
        YoyoStartTimedRehit()
    on reflect_hit:
        BatReflect()
    on forward_smash_enter:
        BatEnter()
    on up_smash_enter:
        YoyoEnter(true)
    on down_smash_enter:
        YoyoEnter(false)

    on state_341_animation:
        BatAnimation()
    on state_341_interrupt:
        BatInterrupt()
    on state_341_physics:
        BatPhysics()
    on state_341_collision:
        collision.ground_standard()
    on state_342_animation:
        YoyoAnimation(true, false)
    on state_342_interrupt:
        YoyoInterrupt(false)
    on state_342_physics:
        YoyoPhysics(false, true)
    on state_342_collision:
        YoyoCollision()
    on state_343_animation:
        YoyoChargeAnimation(true)
    on state_343_interrupt:
        YoyoChargeInterrupt(true)
    on state_343_physics:
        physics.ground_friction()
    on state_343_collision:
        YoyoCollision()
    on state_344_animation:
        YoyoAnimation(true, true)
    on state_344_interrupt:
        YoyoInterrupt(true)
    on state_344_physics:
        YoyoPhysics(true, true)
    on state_344_collision:
        YoyoCollision()
    on state_345_animation:
        YoyoAnimation(false, false)
    on state_345_interrupt:
        YoyoInterrupt(false)
    on state_345_physics:
        YoyoPhysics(false, false)
    on state_345_collision:
        YoyoCollision()
    on state_346_animation:
        YoyoChargeAnimation(false)
    on state_346_interrupt:
        YoyoChargeInterrupt(false)
    on state_346_physics:
        physics.ground_friction()
    on state_346_collision:
