# Independent Link Workshop template.
# Components and original-source comparisons: tests/native/link_fighter_composition.
# Runtime startup binding: tests/native/link_fighter_activation.
# Shared template assembly keeps the separately maintained policies together.
fighter:
    behavior independent

# Fighter-specific policies are owned here; only shared engine primitives remain native.

attribute float spin_landing_lag 48

attribute float spin_air_horizontal_multiplier 52

attribute float spin_air_drift_multiplier 56

attribute float spin_air_speed_multiplier 60

attribute float spin_air_vertical_speed 64

attribute float spin_gravity_multiplier 68

parameter int spin_effect_joint = 24


# Bomb shares decisions across both fighters. Owned import selects holding
# joint 64 for Link or 68 for Young Link when the default is unchanged.


parameter int bomb_holding_joint = 64

state float bomb_spawn_x

state float bomb_spawn_y

state float bomb_spawn_z

state int bomb_handle



attribute float bow_max_charge 0

attribute float bow_start_rate 4

attribute float bow_air_landing_lag 8




state bool bow_initialized


state bool bow_charge_enabled


state float bow_charge


state int bow_visible_timer


state int bow_handle


state int bow_arrow_handle


state float bow_left_x


state float bow_left_y


state float bow_left_z


state float bow_right_x


state float bow_right_y


state float bow_right_z


state float bow_root_x


state float bow_root_y


state float bow_root_z


state float bow_angle


state float bow_offset_x


state float bow_offset_y


state float bow_extra_angle




attribute float boomerang_stick_deadzone 20


attribute float boomerang_angle_factor 24


attribute float boomerang_angle_scale 28


attribute float boomerang_smash_launch_speed 32


attribute float boomerang_launch_speed 36


attribute float boomerang_vertical_offset 40




