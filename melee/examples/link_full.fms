    func Dispose():
        item.state.solver = -1
        if attachment_owner.exists:
            attachment_owner.helpers.Tether_Unbind(int(item.creation_id))
        item.resources.release()
        item.remove()

    func Derive():
        let float scale = attachment_owner.model.instance_scale_y
        let float coefficient = item.attr.ground_coefficient
        if attachment_owner.motion == 360:
            coefficient = item.attr.air_coefficient
        item.state.length = item.attr.source_length * scale
        item.state.length_secondary = item.attr.source_length_secondary * scale
        item.state.launch_speed = coefficient * (item.attr.source_launch_speed * scale)
        item.state.gravity = item.attr.source_gravity * scale
        item.state.retract_speed = coefficient * (item.attr.source_retract_speed * scale)
        item.state.pull_speed = coefficient * (item.attr.source_pull_speed * scale)
        item.state.friction = item.attr.source_friction * scale
        if not (scale > 0 and item.state.length > 0):
            return
        let float total = item.attr.source_count * item.state.length
        if scale > 1:
            total = item.attr.count_blend * total + (1 - item.attr.count_blend) * (item.attr.source_count * item.attr.source_length)
        let float derived = (total * coefficient) / item.state.length
        # Ordered comparison rejects NaN/infinity before int conversion, no clamp.
        if not (derived >= 2 and derived < 91):
            return
        item.state.count = int(derived)
        item.state.endpoint = item.state.count - 1

    func ConstructNodes():
        let int i = int(0)
        while i < item.state.count:
            if not item.resource(i).create(attachment_owner.state.tether_attachment_part, attachment_owner.model.instance_scale_y, int(5)):
                return
            if i == item.state.endpoint:
                if not item.resource(i).load_model(Endpoint):
                    return
            else:
                if i % 2 != 0:
                    if not item.resource(i).load_model(Odd):
                        return
                else:
                    if not item.resource(i).load_model(Even):
                        return
            item.resource(i).surface_line = -1
            item.state.deployed[i] = false
            item.state.on_floor[i] = false
            if not item.resource(i).set_draw(i == item.state.endpoint):
                return
            i = i + 1
        if not item.resource(item.state.endpoint).bind_part(int(139)):
            return
        item.state.initialized = true

    func CopyHeldMatrix():
        item.resource(item.state.endpoint).read_attachment_matrix(item.state.matrix)
        # Concat attachment * identity translated by global source constant z6.
        item.state.matrix[3] = item.state.matrix[2] * 6 + item.state.matrix[3]
        item.state.matrix[7] = item.state.matrix[6] * 6 + item.state.matrix[7]
        item.state.matrix[11] = item.state.matrix[10] * 6 + item.state.matrix[11]
        item.resource(item.state.endpoint).set_world_matrix(item.state.matrix)

    func Normalize(float x, float y, float z):
        item.state.dx = x
        item.state.dy = y
        item.state.dz = z
        item.state.norm_length = sqrt(x * x + y * y + z * z)
        let float inverse = 0
        if item.state.norm_length != 0:
            inverse = 1 / item.state.norm_length
        item.state.dx = item.state.dx * inverse
        item.state.dy = item.state.dy * inverse
        item.state.dz = item.state.dz * inverse

    func CopyCollisionPosition(int i, bool reset):
        if reset:
            item.resource(i).collision.previous.x = item.resource(i).position.x
        else:
            item.resource(i).collision.previous.x = item.resource(i).collision.position.x
        item.resource(i).collision.position.x = item.resource(i).position.x
        if reset:
            item.resource(i).collision.previous.y = item.resource(i).position.y
        else:
            item.resource(i).collision.previous.y = item.resource(i).collision.position.y
        item.resource(i).collision.position.y = item.resource(i).position.y
        if reset:
            item.resource(i).collision.previous.z = item.resource(i).position.z
        else:
            item.resource(i).collision.previous.z = item.resource(i).collision.position.z
        item.resource(i).collision.position.z = item.resource(i).position.z

    func ReverseStep(int current, int next):
        if item.state.deployed[next]:
            Normalize(item.resource(next).position.x - item.resource(current).position.x, item.resource(next).position.y - item.resource(current).position.y, item.resource(next).position.z - item.resource(current).position.z)
            if item.state.norm_length > item.state.length:
                item.resource(next).position.x = item.state.dx * item.state.length + item.resource(current).position.x
                item.resource(next).position.y = item.state.dy * item.state.length + item.resource(current).position.y
                item.resource(next).position.z = item.state.dz * item.state.length + item.resource(current).position.z
            CopyCollisionPosition(next, false)
        else:
            Normalize(item.state.anchor_x - item.resource(current).position.x, item.state.anchor_y - item.resource(current).position.y, item.state.anchor_z - item.resource(current).position.z)
            if item.state.norm_length > item.state.length:
                item.resource(next).position.x = item.state.dx * item.state.length + item.resource(current).position.x
                item.resource(next).position.y = item.state.dy * item.state.length + item.resource(current).position.y
                item.resource(next).position.z = item.state.dz * item.state.length + item.resource(current).position.z
                item.state.deployed[next] = true
                item.resource(next).set_draw(true)
                CopyCollisionPosition(next, true)
            else:
                item.state.stop_reverse = true

    func SweepFloor(int i):
        item.state.prior_floor = item.state.on_floor[i]
        let int next = i - 1
        let bool previous_deployed = next >= 0 and item.state.deployed[next]
        if previous_deployed:
            item.resource(i).collision.previous.x = item.resource(next).collision.position.x
        else:
            item.resource(i).collision.previous.x = item.resource(i).collision.position.x
        item.resource(i).collision.position.x = item.resource(i).position.x
        if previous_deployed:
            item.resource(i).collision.previous.y = item.resource(next).collision.position.y
        else:
            item.resource(i).collision.previous.y = item.resource(i).collision.position.y
        item.resource(i).collision.position.y = item.resource(i).position.y
        if previous_deployed:
            item.resource(i).collision.previous.z = item.resource(next).collision.position.z
        else:
            item.resource(i).collision.previous.z = item.resource(i).collision.position.z
        item.resource(i).collision.position.z = item.resource(i).position.z
        if previous_deployed and item.state.on_floor[next] and not item.state.on_floor[i]:
            if stage.read_line_island_bounds(item.resource(next).collision.floor_line, item.state.island_x1, item.state.island_y1, item.state.island_z1, item.state.island_x2, item.state.island_y2, item.state.island_z2):
                if (item.state.island_x2 < item.resource(i).position.x and item.state.island_y2 > item.resource(i).position.y) or (item.state.island_x1 > item.resource(i).position.x and item.state.island_y1 > item.resource(i).position.y):
                    # Source tests first endpointY but always assigns second endpointY.
                    item.resource(i).position.y = item.state.island_y2
                    return
        if item.state.on_floor[i]:
            item.state.on_floor[i] = item.resource(i).follow_floor()
        else:
            item.state.on_floor[i] = item.resource(i).sweep_stage()
        if (item.resource(i).collision.environment & Collision.floor_mask) != 0:
            item.resource(i).collision.position.x = item.resource(i).position.x
        else:
            if (item.resource(i).collision.environment & Collision.wall_mask) != 0 and previous_deployed and i + 1 < item.state.count and item.resource(next).position.y < item.resource(i).position.y:
                item.resource(i).collision.position.y = item.resource(i).collision.position.y + item.state.length
        item.resource(i).position.x = item.resource(i).collision.position.x
        item.resource(i).position.y = item.resource(i).collision.position.y
        item.resource(i).position.z = item.resource(i).collision.position.z

    func AnchorAndForward():
        Normalize(item.resource(int(0)).position.x - item.state.anchor_x, item.resource(int(0)).position.y - item.state.anchor_y, item.resource(int(0)).position.z - item.state.anchor_z)
        item.resource(int(0)).position.x = item.state.dx * item.state.length + item.state.anchor_x
        item.resource(int(0)).position.y = item.state.dy * item.state.length + item.state.anchor_y
        item.resource(int(0)).position.z = item.state.dz * item.state.length + item.state.anchor_z
        let int current = int(0)
        let int i = int(1)
        while i < item.state.count:
            SweepFloor(i)
            Normalize(item.resource(i).position.x - item.resource(current).position.x, item.resource(i).position.y - item.resource(current).position.y, item.resource(i).position.z - item.resource(current).position.z)
            if item.state.norm_length > item.state.length:
                item.resource(i).position.x = item.state.dx * item.state.length + item.resource(current).position.x
                item.resource(i).position.y = item.state.dy * item.state.length + item.resource(current).position.y
                item.resource(i).position.z = item.state.dz * item.state.length + item.resource(current).position.z
            current = i
            i = i + 1

    func HitlagConstraints():
        item.state.attached_result = attachment_owner.state.tether_before_launch
        if item.state.attached_result:
            return
        item.state.stop_reverse = false
        let int current = item.state.endpoint
        let int next = current - 1
        while next >= 0:
            ReverseStep(current, next)
            if item.state.stop_reverse:
                return
            current = next
            next = next - 1
        AnchorAndForward()

    # it_802A6F80, authored basis/cross/normalization and actual SetWorldMatrix.
    func OrientModel(int i, float dx, float dy, float dz):
        Normalize(dx, dy, dz)
        let float z0 = item.state.dx
        let float z1 = item.state.dy
        let float z2 = item.state.dz
        let float rx = 0
        let float ry = 1
        if z1 > 0.9999:
            rx = -1
            ry = 0
        else:
            if z1 < -0.9999:
                rx = 1
                ry = 0
        let float rawx0 = ry * z2
        let float rawx1 = -rx * z2
        let float rawx2 = rx * z1 - ry * z0
        let float rawy0 = z1 * rawx2 - z2 * rawx1
        let float rawy1 = z2 * rawx0 - z0 * rawx2
        let float rawy2 = z0 * rawx1 - z1 * rawx0
        Normalize(rawx0, rawx1, rawx2)
        # Reuse raw locals after both cross products to stay within16locals.
        rawx0 = item.state.dx
        rawx1 = item.state.dy
        rawx2 = item.state.dz
        Normalize(rawy0, rawy1, rawy2)
        let float scale = attachment_owner.model.instance_scale_y
        item.state.matrix[0] = rawx0 * scale
        item.state.matrix[1] = item.state.dx * scale
        item.state.matrix[2] = z0 * scale
        item.state.matrix[3] = item.resource(i).position.x
        item.state.matrix[4] = rawx1 * scale
        item.state.matrix[5] = item.state.dy * scale
        item.state.matrix[6] = z1 * scale
        item.state.matrix[7] = item.resource(i).position.y
        item.state.matrix[8] = rawx2 * scale
        item.state.matrix[9] = item.state.dz * scale
        item.state.matrix[10] = z2 * scale
        item.state.matrix[11] = item.resource(i).position.z
        item.resource(i).joint("").translation.x = item.resource(i).position.x
        item.resource(i).joint("").translation.y = item.resource(i).position.y
        item.resource(i).joint("").translation.z = item.resource(i).position.z
        item.resource(i).set_world_matrix(item.state.matrix)

    func UpdateModels(bool fixed_end):
        let int i = int(0)
        while i < item.state.count and not item.state.deployed[i]:
            i = i + 1
        while i < item.state.count:
            let int next = i - 1
            let int previous = i + 1
            let float ax = item.state.anchor_x
            let float ay = item.state.anchor_y
            let float az = item.state.anchor_z
            if next >= 0 and item.state.deployed[next]:
                ax = item.resource(next).position.x
                ay = item.resource(next).position.y
                az = item.resource(next).position.z
            let float bx = item.resource(i).position.x
            let float by = item.resource(i).position.y
            let float bz = item.resource(i).position.z
            if previous < item.state.count:
                bx = item.resource(previous).position.x
                by = item.resource(previous).position.y
                bz = item.resource(previous).position.z
            if fixed_end and i == item.state.endpoint:
                OrientModel(i, attachment_owner.state.tether_facing, 0, 0)
            else:
                OrientModel(i, bx - ax, by - ay, bz - az)
            i = i + 1

    func Integrate(int i):
        item.resource(i).position.x = item.resource(i).position.x + item.resource(i).velocity.x
        item.resource(i).position.y = item.resource(i).position.y + item.resource(i).velocity.y
        item.resource(i).position.z = item.resource(i).position.z + item.resource(i).velocity.z

    func ClampToNode(int i, int previous):
        Normalize(item.resource(i).position.x - item.resource(previous).position.x, item.resource(i).position.y - item.resource(previous).position.y, item.resource(i).position.z - item.resource(previous).position.z)
        if item.state.norm_length > item.state.length:
            item.resource(i).position.x = item.state.dx * item.state.length + item.resource(previous).position.x
            item.resource(i).position.y = item.state.dy * item.state.length + item.resource(previous).position.y
            item.resource(i).position.z = item.state.dz * item.state.length + item.resource(previous).position.z

    func ClampToAnchor(int i, float radius):
        Normalize(item.resource(i).position.x - item.state.anchor_x, item.resource(i).position.y - item.state.anchor_y, item.resource(i).position.z - item.state.anchor_z)
        item.resource(i).position.x = item.state.dx * radius + item.state.anchor_x
        item.resource(i).position.y = item.state.dy * radius + item.state.anchor_y
        item.resource(i).position.z = item.state.dz * radius + item.state.anchor_z

    func MarkDeployed(int i, bool value):
        item.state.deployed[i] = value
        item.resource(i).set_draw(i == item.state.endpoint or value)

    func ForwardGravity(int first, float radius, bool probe, bool gravity):
        ClampToAnchor(first, radius)
        let int previous = first
        let int i = first + 1
        while i < item.state.count:
            if gravity:
                item.resource(i).velocity.y = item.resource(i).velocity.y - item.state.gravity
                Integrate(i)
            if probe:
                SweepFloor(i)
            else:
                CopyCollisionPosition(i, false)
            ClampToNode(i, previous)
            previous = i
            i = i + 1

    func Retract(float speed, bool gravity):
        item.state.cursor = int(0)
        while item.state.cursor + 1 < item.state.count and not item.state.deployed[item.state.cursor]:
            item.state.cursor = item.state.cursor + 1
        let int current = item.state.cursor
        Normalize(item.resource(current).position.x - item.state.anchor_x, item.resource(current).position.y - item.state.anchor_y, item.resource(current).position.z - item.state.anchor_z)
        while current + 1 < item.state.count and speed > item.state.norm_length:
            MarkDeployed(current, false)
            current = current + 1
            Normalize(item.resource(current).position.x - item.state.anchor_x, item.resource(current).position.y - item.state.anchor_y, item.resource(current).position.z - item.state.anchor_z)
        let float radius = item.state.norm_length - speed
        if radius > item.state.length:
            radius = item.state.length
        ForwardGravity(current, radius, true, gravity)
        item.state.result = int(0)
        if current + 1 == item.state.count:
            item.state.result = int(1)

    func FlightStep(bool falling):
        item.state.result = int(0)
        let int tip = item.state.endpoint
        if not falling:
            if attachment_owner.state.tether_launch_now:
                item.resource(tip).position.x = item.state.anchor_x
                item.resource(tip).position.y = item.state.anchor_y
                item.resource(tip).position.z = item.state.anchor_z
                CopyCollisionPosition(tip, true)
                MarkDeployed(tip, true)
        else:
            item.resource(tip).velocity.y = item.resource(tip).velocity.y - item.state.gravity
            let float x = item.resource(tip).velocity.x
            if x > item.state.friction:
                x = x - item.state.friction
            else:
                if x < -item.state.friction:
                    x = x + item.state.friction
                else:
                    x = 0
            item.resource(tip).velocity.x = x
        Integrate(tip)
        SweepFloor(tip)
        item.state.collision_result = item.resource(tip).collision.environment & (Collision.floor_mask | Collision.wall_mask)
        if not falling:
            if (item.state.collision_result & Collision.left_wall_mask) != 0:
                item.resource(tip).surface_line = item.resource(tip).collision.left_wall_line
            else:
                if (item.state.collision_result & Collision.right_wall_mask) != 0:
                    item.resource(tip).surface_line = item.resource(tip).collision.right_wall_line
        let int current = tip
        let int next = current - 1
        let int ordinal = int(0)
        while next >= 0:
            DeployStep(current, next, falling, ordinal)
            if item.state.stop_reverse:
                return
            current = next
            next = next - 1
            ordinal = ordinal + 1
        ForwardGravity(current, item.state.length, true, true)
        item.state.result = int(2)

    func DeployStep(int current, int next, bool falling, int ordinal):
        item.state.stop_reverse = false
        if item.state.deployed[next]:
            if falling:
                item.resource(next).velocity.y = item.resource(next).velocity.y - item.state.gravity
                Integrate(next)
                SweepFloor(next)
                FloorSound(next, ordinal)
            ClampToNode(next, current)
            CopyCollisionPosition(next, false)
            return
        Normalize(item.state.anchor_x - item.resource(current).position.x, item.state.anchor_y - item.resource(current).position.y, item.state.anchor_z - item.resource(current).position.z)
        if item.state.norm_length > item.state.length:
            item.resource(next).position.x = item.state.dx * item.state.length + item.resource(current).position.x
            item.resource(next).position.y = item.state.dy * item.state.length + item.resource(current).position.y
            item.resource(next).position.z = item.state.dz * item.state.length + item.resource(current).position.z
            MarkDeployed(next, true)
            CopyCollisionPosition(next, true)
            return
        item.resource(next).position.x = item.state.anchor_x
        item.resource(next).position.y = item.state.anchor_y
        item.resource(next).position.z = item.state.anchor_z
        MarkDeployed(next, true)
        CopyCollisionPosition(next, true)
        if (item.state.collision_result & Collision.wall_mask) != 0:
            item.state.result = int(1)
        else:
            # Original return3 is unreachable: its flag already excludes ceiling bits.
            if not falling and (item.state.collision_result & Collision.floor_mask) != 0:
                item.state.result = int(4)
        item.state.stop_reverse = true

    func FloorSound(int i, int ordinal):
        if ordinal == int(item.state.count / 2) and item.state.on_floor[i] and not item.state.prior_floor and not item.state.sound_once[i]:
            audio.play_global(item.params.floor_sound, int(127), int(64))
            item.state.sound_once[i] = true

    func SlackStep():
        item.state.cursor = int(0)
        while item.state.cursor + 1 < item.state.count and not item.state.deployed[item.state.cursor]:
            item.state.cursor = item.state.cursor + 1
        let int current = item.state.cursor
        item.resource(current).velocity.y = item.resource(current).velocity.y - item.state.gravity
        Integrate(current)
        SweepFloor(current)
        Normalize(item.resource(current).position.x - item.state.anchor_x, item.resource(current).position.y - item.state.anchor_y, item.resource(current).position.z - item.state.anchor_z)
        if item.state.norm_length > item.state.length:
            ClampToAnchor(current, item.state.length)
        let int i = current + 1
        let int ordinal = int(0)
        while i < item.state.count:
            item.resource(i).velocity.y = item.resource(i).velocity.y - item.state.gravity
            Integrate(i)
            SweepFloor(i)
            FloorSound(i, ordinal)
            ClampToNode(i, current)
            current = i
            i = i + 1
            ordinal = ordinal + 1
        let float x = item.resource(current).velocity.x
        if x > item.state.friction:
            x = x - item.state.friction
        else:
            if x < -item.state.friction:
                x = x + item.state.friction
            else:
                x = 0
        item.resource(current).velocity.x = x

    func MoveWall():
        let int tip = item.state.endpoint
        if stage.line_exists(item.resource(tip).surface_line):
            item.resource(tip).read_line_speed(item.resource(tip).surface_line, item.state.speed_x, item.state.speed_y, item.state.speed_z)
            item.resource(tip).position.x = item.resource(tip).position.x + item.state.speed_x
            item.resource(tip).position.y = item.resource(tip).position.y + item.state.speed_y
            item.resource(tip).position.z = item.resource(tip).position.z + item.state.speed_z

    func WallExtend():
        MoveWall()
        item.state.result = int(1)
        let int current = item.state.endpoint
        let int next = current - 1
        while next >= 0:
            if item.state.deployed[next]:
                item.resource(next).velocity.y = item.resource(next).velocity.y - item.state.gravity
                Integrate(next)
                SweepFloor(next)
                ClampToNode(next, current)
            else:
                Normalize(item.state.anchor_x - item.resource(current).position.x, item.state.anchor_y - item.resource(current).position.y, item.state.anchor_z - item.resource(current).position.z)
                if item.state.norm_length > item.state.length:
                    item.resource(next).position.x = item.state.dx * item.state.length + item.resource(current).position.x
                    item.resource(next).position.y = item.state.dy * item.state.length + item.resource(current).position.y
                    item.resource(next).position.z = item.state.dz * item.state.length + item.resource(current).position.z
                    MarkDeployed(next, true)
                    CopyCollisionPosition(next, true)
                else:
                    item.state.result = int(0)
                    return
            current = next
            next = next - 1

    func TailConstraint(bool stop_when_slack):
        let int current = item.state.endpoint
        let int next = current - 1
        let bool slack = false
        item.state.result = int(0)
        while next >= 0 and item.state.deployed[next]:
            item.state.result = item.state.result + 1
            if not slack:
                Normalize(item.resource(next).position.x - item.resource(current).position.x, item.resource(next).position.y - item.resource(current).position.y, item.resource(next).position.z - item.resource(current).position.z)
                if item.state.norm_length > item.state.length:
                    ClampToNode(next, current)
                else:
                    slack = stop_when_slack
            current = next
            next = next - 1
        Normalize(item.state.anchor_x - item.resource(current).position.x, item.state.anchor_y - item.resource(current).position.y, item.state.anchor_z - item.resource(current).position.z)
        if item.state.norm_length > item.state.length:
            item.state.anchor_x = item.state.dx * item.state.length + item.resource(current).position.x
            item.state.anchor_y = item.state.dy * item.state.length + item.resource(current).position.y
            item.state.anchor_z = item.state.dz * item.state.length + item.resource(current).position.z

    func PullConstraint():
        MoveWall()
        item.state.saved_x = item.resource(item.state.endpoint).position.x
        item.state.saved_y = item.resource(item.state.endpoint).position.y
        item.state.saved_z = item.resource(item.state.endpoint).position.z
        item.state.cursor = int(0)
        while item.state.cursor + 1 < item.state.count and not item.state.deployed[item.state.cursor]:
            item.state.cursor = item.state.cursor + 1
        ForwardGravity(item.state.cursor, item.state.length, true, true)
        item.resource(item.state.endpoint).position.x = item.state.saved_x
        item.resource(item.state.endpoint).position.y = item.state.saved_y
        item.resource(item.state.endpoint).position.z = item.state.saved_z
        Retract(item.state.retract_speed, false)
        item.resource(item.state.endpoint).position.x = item.state.saved_x
        item.resource(item.state.endpoint).position.y = item.state.saved_y
        item.resource(item.state.endpoint).position.z = item.state.saved_z
        TailConstraint(false)
        if item.state.result != 0:
            item.state.result = int(0)
        else:
            item.state.result = int(1)

    func HangConstraint():
        MoveWall()
        item.state.saved_x = item.resource(item.state.endpoint).position.x
        item.state.saved_y = item.resource(item.state.endpoint).position.y
        item.state.saved_z = item.resource(item.state.endpoint).position.z
        item.state.cursor = int(0)
        while item.state.cursor + 1 < item.state.count and not item.state.deployed[item.state.cursor]:
            item.state.cursor = item.state.cursor + 1
        ForwardGravity(item.state.cursor, item.state.length, false, true)
        item.resource(item.state.endpoint).position.x = item.state.saved_x
        item.resource(item.state.endpoint).position.y = item.state.saved_y
        item.resource(item.state.endpoint).position.z = item.state.saved_z
        TailConstraint(true)

    func AnimateSpool():
        let int i = item.state.endpoint
        let int active = int(0)
        while i >= 0 and item.state.deployed[i]:
            active = active + 1
            i = i - 1
        let float fraction = float(active) / float(item.state.count)
        let float full_turn = 6.2831855
        item.joint("0/0").rotation.z = full_turn * fraction
        let float scale = double(float(0.65)) * (double(1) - double(fraction)) + double(float(0.35))
        item.joint("0/0").scale.x = scale
        item.joint("0/0").scale.y = scale

    func ChangeMode(int next, bool clear_attack):
        item.change_state_flags(next, int(2))
        if clear_attack:
            if attachment_owner.exists:
                attachment_owner.helpers.Tether_ClearAttack()
        item.scale_by_attribute(attachment_owner.model.instance_scale_y)
        if next == 8:
            if attachment_owner.exists:
                attachment_owner.helpers.Tether_StartHangTimer()

    func WallStates(int mode):
        if mode == 6 or mode == 8:
            if stage.segment_blocked(item.state.anchor_x, item.state.anchor_y, item.resource(item.state.endpoint).position.x, item.resource(item.state.endpoint).position.y) or stage.segment_blocked(attachment_owner.position.x, attachment_owner.position.y, item.resource(item.state.endpoint).position.x, item.resource(item.state.endpoint).position.y):
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_DamageFall()
                Dispose()
                return
        if mode == 6:
            WallExtend()
            if item.state.result != 0:
                ChangeMode(int(8), false)
                UpdateModels(false)
                return
        else:
            if attachment_owner.exists:
                attachment_owner.helpers.Tether_ReadPosition()
            let float offset_x = attachment_owner.state.tether_position_x - item.state.anchor_x
            let float offset_y = attachment_owner.state.tether_position_y - item.state.anchor_y
            if mode == 7:
                PullConstraint()
            else:
                HangConstraint()
            if attachment_owner.exists:
                attachment_owner.state.tether_target_x = item.state.anchor_x + offset_x
            if attachment_owner.exists:
                attachment_owner.state.tether_target_y = item.state.anchor_y + offset_y
            if attachment_owner.exists:
                attachment_owner.helpers.Tether_ApplyPosition()
            if mode == 7 and item.state.result != 0:
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_PullComplete()
                Dispose()
                return
            if mode == 8:
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_AddDisplacement()
        UpdateModels(true)
        if attachment_owner.state.tether_grounded:
            ChangeMode(int(4), false)
            return
        if mode != 7 and attachment_owner.state.tether_attack_pressed:
            ChangeMode(int(7), false)
            return
        if mode == 8:
            if attachment_owner.exists:
                attachment_owner.helpers.Tether_HangCountdown()
            if attachment_owner.state.tether_hang_expired:
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_DamageFall()
                Dispose()

    func DispatchFlight(int mode):
        if mode == 1 and not attachment_owner.state.tether_allowed_motion and not item.state.deployed[item.state.endpoint - 1]:
            Dispose()
            return
        FlightStep(mode == 2)
        if item.state.result == 1:
            if mode == 1 and attachment_owner.motion == 360:
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_EnterHit()
                ChangeMode(int(6), false)
                item.spawn_effect_at_position(1052, item.resource(item.state.endpoint).position.x, item.resource(item.state.endpoint).position.y, item.resource(item.state.endpoint).position.z)
                if attachment_owner.exists:
                    attachment_owner.state.tether_hit_x = item.resource(item.state.endpoint).position.x
                if attachment_owner.exists:
                    attachment_owner.state.tether_hit_y = item.resource(item.state.endpoint).position.y
                if attachment_owner.exists:
                    attachment_owner.state.tether_hit_z = item.resource(item.state.endpoint).position.z
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_HitEffect()
                return
            item.resource(item.state.endpoint).velocity.x = -item.resource(item.state.endpoint).velocity.x * item.attr.bounce
            if mode == 1:
                ChangeMode(int(2), true)
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_ClearCaptureMask()
        else:
            if item.state.result == 2:
                ChangeMode(int(3), true)
                if mode == 1:
                    if attachment_owner.exists:
                        attachment_owner.helpers.Tether_ClearCaptureMask()
        UpdateModels(false)
        return

    func DispatchNormal():
        let int mode = item.state.solver
        if mode == 0:
            CopyHeldMatrix()
            if not attachment_owner.state.tether_allowed_motion:
                Dispose()
            return
        item.resource(item.state.endpoint).read_attachment_point(0, 0, 6, item.state.anchor_x, item.state.anchor_y, item.state.anchor_z)
        if attachment_owner.exists:
            attachment_owner.helpers.Tether_ReadInputs()
        if mode == 1 or mode == 2:
            DispatchFlight(mode)
            return
        if mode == 3:
            SlackStep()
            UpdateModels(false)
            if not attachment_owner.state.tether_allowed_motion:
                ChangeMode(int(4), false)
            return
        if mode == 4 or mode == 5:
            if mode == 5 and item.state.completed:
                Dispose()
                return
            let float speed = item.state.retract_speed
            if mode == 5:
                speed = item.state.pull_speed
            Retract(speed, true)
            if item.state.result != 0:
                if mode == 5:
                    item.state.completed = true
                    return
                if not attachment_owner.state.tether_allowed_motion:
                    Dispose()
                    return
                ChangeMode(int(0), false)
            UpdateModels(false)
            return
        if mode >= 6 and mode <= 8:
            WallStates(mode)

    on created:
            item.state.solver = -1
            item.state.count = 0
            if not attachment_owner.exists:
                Dispose()
                return
            Derive()
            if item.state.count < 2 or not item.resources.begin(item.state.count):
                Dispose()
                return
            ConstructNodes()
            if not item.state.initialized:
                Dispose()
    on picked_up:
            item.change_state_flags(int(0), int(2))
            let float owner_scale = 1
            if attachment_owner.exists:
                owner_scale = attachment_owner.model.instance_scale_y
            item.scale_by_attribute(owner_scale)
    on destroyed:
            item.state.solver = -1
            if attachment_owner.exists:
                attachment_owner.helpers.Tether_Unbind(int(item.creation_id))
            item.resources.release()
    on interaction:
            item.interact(other)
            if item.attachment_owner_is(other):
                if attachment_owner.exists:
                    attachment_owner.helpers.Tether_Unbind(int(item.creation_id))
                item.clear_attachment_owner()
    on signal constructor_post_pickup:
            let float owner_scale = 1
            if attachment_owner.exists:
                owner_scale = attachment_owner.model.instance_scale_y
            item.scale_by_attribute(owner_scale)
    on signal remove:
            Dispose()
    on signal normal_update:
            if item.state.solver < 0:
                return
            if not attachment_owner.exists:
                Dispose()
                return
            attachment_owner.helpers.Tether_ReadInputs()
            DispatchNormal()
    on signal hitlag_update:
            if not attachment_owner.exists:
                Dispose()
                return
            item.resource(item.state.endpoint).read_attachment_point(0, 0, 6, item.state.anchor_x, item.state.anchor_y, item.state.anchor_z)
            HitlagConstraints()
            if item.state.attached_result:
                CopyHeldMatrix()
            else:
                UpdateModels(false)
    state 0 anim -1:
        on physics:
            item.state.solver = 0

    on signal extend_air:
            let float control_facing = 0
            if attachment_owner.exists:
                control_facing = attachment_owner.state.tether_facing
            item.resource(item.state.endpoint).velocity.x = item.state.launch_speed * control_facing + signal.value
            item.resource(item.state.endpoint).velocity.y = 0
            item.resource(item.state.endpoint).velocity.z = 0
            ChangeMode(int(1), false)
    on signal retract:
            ChangeMode(int(4), false)
    on signal retract_capture:
            ChangeMode(int(5), true)
    on signal bind_capture:
            ChangeMode(int(5), true)
            item.state.capture_bound = item.resource(item.state.endpoint).bind_capture_anchor()
    state 1 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 1
    state 2 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 2
    state 3 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 3
    state 4 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 4
    state 5 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 5
    state 6 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 6
    state 7 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 7
    state 8 anim -1:
        on animation:
            AnimateSpool()
            return false
        on physics:
            item.state.solver = 8

move SpinAttack:
    entry explicit
    on special_hi:
        state.enter_at_speed(356, 0, 0, 1)
        animation.start()
        callbacks.accessory(spin_effect)
    on special_air_hi:
        state.enter_at_speed(357, 0, 0, 1)
        animation.start()
        velocity.x = velocity.x * attrs.spin_air_horizontal_multiplier
        velocity.y = attrs.spin_air_vertical_speed
        jumps.used = jumps.max
        callbacks.accessory(spin_effect)
    on ground_animation:
        if animation.finished: state.wait()
    on air_animation:
        if animation.finished: state.freefall(1, 1, false, attrs.spin_air_drift_multiplier, attrs.spin_landing_lag)
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        if grounded: physics.ground_friction()
        else: spin_air_physics()
    on air_physics:
        spin_air_physics()
    on ground_collision:
        # Exact stock continuation flags; preserve the attack and current frame.
        if collision.left_ground:
            physics.force_air_and_use_jumps()
            state.enter_at_speed(357, 0x0C4C508A, frame, 1)
    on air_collision:
        if collision.check_ground_ledge(0): state.landing_special(false, attrs.spin_landing_lag)
        else: collision.cliff_catch()


move BombPull:
    entry explicit
    on special_lw:
        bomb_enter(108, 358)
    on special_air_lw:
        bomb_enter(112, 359)
    on ground_animation:
        if animation.finished: state.wait()
    on air_animation:
        if animation.finished: state.fall()
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_gravity_and_friction()
    on ground_collision:
        if collision.left_ground:
            physics.ground_to_air()
            state.enter_at_speed(359, 0x0C4C5080, frame, 1)
            callbacks.accessory(bomb_create)
    on air_collision:
        if collision.landed:
            physics.switch_to_ground()
            state.enter_at_speed(358, 0x0C4C5080, frame, 1)
            callbacks.accessory(bomb_create)



move Bow:
    entry explicit
    on special_n:
        bow_enter(false)
    on special_air_n:
        bow_enter(true)
    on ground_animation:
        bow_start_animation(false)
    on air_animation:
        bow_start_animation(true)
    on ground_interrupt:
        bow_start_interrupt(false)
    on air_interrupt:
        bow_start_interrupt(true)
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_gravity_and_friction()
    on ground_collision:
        bow_ground_collision(347, false)
    on air_collision:
        bow_air_collision(344, false)


move Boomerang:
    entry explicit
    on special_s:
        boomerang_enter(false)
    on special_air_s:
        boomerang_enter(true)
    on ground_animation:
        boomerang_finish(false)
    on air_animation:
        boomerang_finish(true)
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_gravity_and_friction()
    on ground_collision:
        boomerang_ground_collision(353, true)
    on air_collision:
        boomerang_air_collision(350, true)


action GroundCatchPolicy:
    on catch_allowed:
        return not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists
    on catch_start:
        state.tether_counter = 0
    on catch_frame:
        if motion.id == 212:
            Tether_StandingFrame()
        else:
            Tether_DashFrame()
        return state.tether_ground_consumed
    on catch_exit:
        if articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
            Tether_Remove()
    on catch_wait_release:
        Tether_Remove()
    on catch_pull_anchor:
        if not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
            return false
        articles.signal(state.tether_handle, It_Kind_Link_HShot, "bind_capture", 0)
        return articles.ref(state.tether_handle, It_Kind_Link_HShot).state.capture_bound
    on catch_pull_ready:
        return not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists or articles.ref(state.tether_handle, It_Kind_Link_HShot).state.completed
    on catch_pull_follow:
        return false
    on capture_wait_enter:
        if articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
            articles.signal(state.tether_handle, It_Kind_Link_HShot, "retract_capture", 0)

action FighterLifecycle:
    on load:
        state.dair_timing[1] = animation.clip_length(72)
        fighter.copy_ext_attributes()
        state.boomerang_handle = -1
        state.tether_handle = -1
        state.bow_arrow_handle = -1
        state.bow_handle = -1
        state.boomerang_used = false
        state.boomerang_vertical_offset = attrs.boomerang_vertical_offset * model.instance_scale_y
        model_graphs.install(attrs.sword_graph, attrs.sword_omission)
    on load_special_attrs:
        fighter.reload_ext_attributes()
        state.boomerang_vertical_offset = attrs.boomerang_vertical_offset * model.instance_scale_y
    on death:
        visuals.set_group(0, 0)
        visuals.set_group(1, 0)
        visuals.set_group(2, 0)
        state.boomerang_used = false
        state.boomerang_handle = -1
        state.tether_handle = -1
        state.bow_arrow_handle = -1
        state.bow_handle = -1
    on item_pickup_ext:
        if items.heavy: visuals.set_group(1, 1)
        visuals.set_group(2, 1)
        fighter.item_pickup(event.flag, 1, 1)
    on item_drop_ext:
        if items.heavy: visuals.set_group(1, 0)
        visuals.set_group(2, 0)
        fighter.item_drop(event.flag, 1, 1)
    on item_pickup:
        fighter.item_pickup(event.flag, 1, 1)
    on item_drop:
        fighter.item_drop(event.flag, 1, 1)
    on item_visible:
        fighter.item_visible(1)
    on item_invisible:
        fighter.item_invisible(1)
    on knockback_enter:
        fighter.knockback_enter(1)
    on knockback_exit:
        fighter.knockback_exit(1)

action SwordRibbon:
    on trail:
        trail.axis = 0
        trail.inner_fade = attrs.sword_inner_fade
        trail.outer_fade = attrs.sword_outer_fade
        trail.start_alpha = attrs.sword_start_alpha
        trail.end_alpha = attrs.sword_end_alpha
        trail.inner_red = attrs.sword_inner_red
        trail.inner_green = attrs.sword_inner_green
        trail.inner_blue = attrs.sword_inner_blue
        trail.outer_red = attrs.sword_outer_red
        trail.outer_green = attrs.sword_outer_green
        trail.outer_blue = attrs.sword_outer_blue
        trail.bone = attrs.sword_bone
        trail.inner_distance = attrs.sword_inner_distance
        trail.outer_distance = attrs.sword_outer_distance

action DairBounce:
    on aerial_attack_enter:
        if motion.id == 69:
            callbacks.track_deal_damage()
            callbacks.animation(Dair_Animation)
            state.dair_timing[0] = 0
    on deal_damage:
        Dair_Hit()

func GuardHit():
    let pushback = shield.pushback_damage_scale * (int(guard.hit_damage) * (1 - (attrs.carried_shield_light_amount * (shield.pushback_light_max - shield.pushback_light_min) + shield.pushback_light_min))) + shield.pushback_base
    ground.velocity = pushback * shield.pushback_velocity_scale
    if guard.hit_facing >= 0: ground.velocity = -ground.velocity
    sound.play(attrs.carried_shield_recoil_sound, 127, 64)


action CarriedShield:
    on wait_enter:
        CarriedShield_Install()
    on crouch_wait_enter:
        CarriedShield_Install()
action SwordCombo:
    on forward_smash_start:
        callbacks.interrupt(SwordCombo_Interrupt)
    on state_341_animation:
        if animation.finished: state.wait()
    on state_341_interrupt:
        if controls.interrupt_allowed: controls.ground_actions()
    on state_341_physics:
        physics.ground_motion()
    on state_341_collision:
        collision.ground_standard()

action BowPhases:
    on state_345_animation:
        bow_positions()
    on state_345_interrupt:
        bow_loop_interrupt(false)
    on state_345_physics:
        physics.ground_friction()
    on state_345_collision:
        bow_ground_collision(348, false)
    on state_346_animation:
        bow_end_animation(false)
    on state_346_interrupt:
        pass
    on state_346_physics:
        physics.ground_friction()
    on state_346_collision:
        bow_ground_collision(349, true)
    on state_348_animation:
        bow_positions()
    on state_348_interrupt:
        bow_loop_interrupt(true)
    on state_348_physics:
        physics.air_gravity_and_friction()
    on state_348_collision:
        bow_air_collision(345, false)
    on state_349_animation:
        bow_end_animation(true)
    on state_349_interrupt:
        pass
    on state_349_physics:
        physics.air_gravity_and_friction()
    on state_349_collision:
        bow_air_collision(346, true)

action BoomerangPhases:
    on state_351_animation:
        boomerang_catch_animation(false)
    on state_351_interrupt:
        boomerang_ground_interrupt()
    on state_351_physics:
        physics.ground_friction()
    on state_351_collision:
        if collision.left_ground:
            boomerang_remove()
            state.fall()
    on state_352_animation:
        boomerang_finish(false)
    on state_352_physics:
        physics.ground_friction()
    on state_352_collision:
        boomerang_ground_collision(355, false)
    on state_354_animation:
        boomerang_catch_animation(true)
    on state_354_interrupt:
        boomerang_air_interrupt()
    on state_354_physics:
        physics.air_gravity_and_friction()
    on state_354_collision:
        if collision.landed:
            boomerang_remove()
            state.basic_landing()
    on state_355_animation:
        boomerang_finish(true)
    on state_355_physics:
        physics.air_gravity_and_friction()
    on state_355_collision:
        boomerang_air_collision(352, false)

# Owned Boomerang policy; cleanup is part of this complete fighter template.
# The launch quaternion fourth lane is undefined in stock; activation is gated.

action TetherInput:
    on air_tether_input:
        if movement.used_tether:
            return false
        if not callbacks.matches(Callback.accessory_before, None) or not callbacks.matches(Callback.death1, None) or not callbacks.matches(Callback.accessory_hitlag, None):
            return false
        if items.held:
            return false
        if input.shield_held and input.attack_pressed:
            if airborne:
                Tether_EnterAir()
            movement.used_tether = true
            return true
        return false


action TetherAirPhases:
    on state_360_animation:
        Tether_AirAnimation()
    on state_360_interrupt:
        pass
    on state_360_physics:
        Tether_AirPhysics()
    on state_360_collision:
        if collision.landed:
            state.landing(int(42), false, int(0), 0, 1)
    on state_361_animation:
        pass
    on state_361_interrupt:
        pass
    on state_361_physics:
        Tether_HitPhysics()
    on state_361_collision:
        collision.air_catch_hit()
