func spin_effect():
    if not effects.active:
        if grounded: effects.spawn_between(1211, bones.index(TransN), attrs.spin_effect_joint)
        else: effects.spawn_between(1212, bones.index(TransN), attrs.spin_effect_joint)
        effects.active = true
    effects.pause_during_hitlag()
    callbacks.accessory(None)


func spin_air_physics():
    physics.fall(air.gravity * attrs.spin_gravity_multiplier, air.terminal_velocity)
    physics.air_accel_friction(0, air.drift_stick_mul * attrs.spin_air_drift_multiplier, air.drift_max * attrs.spin_air_speed_multiplier)



func bomb_restore_parts():
    visuals.set_group(2, 0)
    visuals.set_current_group(2, 0)


func bomb_create():
    if cue.article.consume():
        bones.world_position(bones.index(LeftThumb), state.bomb_spawn_x, state.bomb_spawn_y, state.bomb_spawn_z)
        # Exact SpawnItem current position is ECB center;
        # previous position is the supplied thumb; velocity is zero, damage0,
        # parent/owner is this fighter and spawn.x44.b0=true. Initialize via on
        # created BEFORE Item_8026AB54 invokes picked_up; then attach/register.
        state.bomb_handle = articles.create_held_at_center(It_Kind_Link_Bomb, state.bomb_spawn_x, state.bomb_spawn_y, state.bomb_spawn_z, attrs.bomb_holding_joint, facing.direction)
        visuals.set_group(2, 1)
        if articles.owned(state.bomb_handle): items.notify_pickup(true)


func bomb_enter(int throw_motion, int pull_motion):
    if items.held:
        # Preserve unsigned stock range check; no pull if another item is held.
        if items.held_kind == It_Kind_Link_Bomb or items.held_kind == It_Kind_CLink_Bomb: items.throw_held(throw_motion)
        return
    cue.throw.reset()
    state.enter_at_speed(pull_motion, 0, 0, 1)
    animation.start()
    callbacks.accessory(bomb_create)



func bow_callbacks():
    callbacks.damage(Cleanup_AllArticles)
    callbacks.death2(Cleanup_AllArticles)



func bow_unset_arrow():
    state.bow_arrow_handle = -1



export func bow_unset():
    state.bow_handle = -1



func bow_air_finish():
    if attrs.bow_air_landing_lag == 0: state.fall()
    else:
        state.freefall(1, 0, true, 1, attrs.bow_air_landing_lag)



func bow_failed(bool air_started):
    # Stock only clears fighter references here; article callbacks remove later.
    bow_unset_arrow()
    bow_unset()
    if air_started: bow_air_finish()
    else:
        state.wait()



func bow_enter(bool air_started):
    if not state.bow_initialized:
        state.bow_initialized = true
        state.bow_handle = -1
        state.bow_arrow_handle = -1
    state.bow_charge_enabled = false
    state.bow_charge = 0
    state.bow_visible_timer = 0
    command(0) = 0
    command(1) = 0
    command(2) = 0
    command(3) = 0
    if not air_started:
        physics.switch_to_ground()
        velocity.y = 0
        state.enter_at_speed(344, 0, 0, 1)
    else:
        state.enter_at_speed(347, 0, 0, 1)
    bow_callbacks()
    animation.set_rate(attrs.bow_start_rate)
    animation.start()
    if articles.owned(state.bow_handle):
        bow_failed(air_started)
    else:
        # The reference remains absent during created/picked_up notifications.
        state.bow_handle = -1
        state.bow_handle = articles.spawn_bone_attached(It_Kind_Link_Bow, RightThumb)
        if articles.owned(state.bow_handle): bow_callbacks()
        else:
            bow_failed(air_started)



func bow_positions():
    bones.world_position(bones.index(LeftThumb), state.bow_left_x, state.bow_left_y, state.bow_left_z)
    bones.world_position(bones.index(RightThumb), state.bow_right_x, state.bow_right_y, state.bow_right_z)
    bones.world_position(0, state.bow_root_x, state.bow_root_y, state.bow_root_z)
    state.bow_angle = atan2(state.bow_right_y - state.bow_left_y, state.bow_right_x - state.bow_left_x)
    state.bow_offset_x = state.bow_right_x - state.bow_root_x
    state.bow_offset_y = state.bow_right_y - state.bow_root_y
    state.bow_extra_angle = 0
    if articles.owned(state.bow_arrow_handle): articles.signal_owned(state.bow_arrow_handle, It_Kind_Link_Arrow, "held_positions", 0)



func bow_start_animation(bool air_started):
    if command(2) != 0 and not state.bow_charge_enabled:
        state.bow_charge_enabled = true
        command(2) = 0
    if not air_started: animation.set_rate(attrs.bow_start_rate)
    if command(0) == 1:
        command(0) = 0
        if not articles.owned(state.bow_arrow_handle):
            state.bow_arrow_handle = -1
            state.bow_arrow_handle = articles.spawn_bone_attached(It_Kind_Link_Arrow, LeftThumb)
            if articles.owned(state.bow_arrow_handle): bow_callbacks()
            else:
                bow_failed(air_started)
                return
    bow_positions()
    if animation.finished:
        if air_started: state.enter_at_speed(348, 0x40010, 0, 1)
        else:
            state.enter_at_speed(345, 0x40010, 0, 1)
        bow_callbacks()
        animation.start()



func bow_start_interrupt(bool air_started):
    if state.bow_charge_enabled:
        state.bow_charge = state.bow_charge + 1
        if state.bow_charge > attrs.bow_max_charge: state.bow_charge = attrs.bow_max_charge
        if not input.special_held:
            if air_started: state.enter_at_speed(349, 0x40010, 0, 1)
            else:
                state.enter_at_speed(346, 0x40010, 0, 1)
            bow_callbacks()



func bow_loop_interrupt(bool air_started):
    state.bow_charge = attrs.bow_max_charge
    if not input.special_held:
        if air_started: state.enter_at_speed(349, 0x40010, 0, 1)
        else:
            state.enter_at_speed(346, 0x40010, 0, 1)
        bow_callbacks()



func bow_end_parts():
    if visuals.held_item_visible and state.bow_visible_timer == 0:
        state.bow_visible_timer = state.bow_visible_timer + 1
        if items.held:
            visuals.set_group(2, 1)
            visuals.set_current_group(2, 1)
        else:
            visuals.set_group(2, 0)
            visuals.set_current_group(2, 0)



func bow_end_animation(bool air_started):
    if animation.finished:
        if air_started: bow_unset_arrow()
        bow_unset()
        bow_end_parts()
        if air_started: bow_air_finish()
        else:
            state.wait()
    else:
        bow_end_parts()



func bow_launch():
    if command(1) == 1 and articles.owned(state.bow_arrow_handle):
        command(1) = 0
        bones.world_position(bones.index(RightThumb), state.bow_right_x, state.bow_right_y, state.bow_right_z)
        bones.world_position(bones.index(LeftThumb), state.bow_left_x, state.bow_left_y, state.bow_left_z)
        state.bow_right_z = 0
        state.bow_left_z = 0
        articles.signal_owned(state.bow_arrow_handle, It_Kind_Link_Arrow, "launch", attrs.bow_max_charge)
        bow_unset_arrow()
        items.notify_pickup(false)



func bow_ground_collision(int air_motion, bool end_phase):
    if end_phase: bow_launch()
    if collision.left_ground:
        physics.ground_to_air()
        state.enter_at_speed(air_motion, 0x0C4C5090, frame, 1)
        bow_callbacks()
        animation.start()



func bow_air_collision(int ground_motion, bool end_phase):
    if end_phase: bow_launch()
    if collision.landed:
        physics.switch_to_ground()
        state.enter_at_speed(ground_motion, 0x0C4C5090, frame, 1)
        bow_callbacks()
        animation.start()



func boomerang_unset():
    state.boomerang_used = false
    state.boomerang_handle = -1



func boomerang_remove():
    if articles.ref(state.boomerang_handle, It_Kind_Link_Boomerang).exists:
        articles.signal(state.boomerang_handle, It_Kind_Link_Boomerang, "remove", 0)
        boomerang_unset()



func boomerang_smash_input():
    if abs(input.x) >= controls.horizontal_smash_threshold and input.horizontal_smash_age < controls.horizontal_smash_window + controls.horizontal_smash_extension:
        stats.count_as_thrown_item()
        state.boomerang_smash = true
    else:
        state.boomerang_smash = false



func boomerang_angle(float speed):
    state.boomerang_angle = 0
    state.boomerang_angle_limit = attrs.boomerang_angle_factor * attrs.boomerang_angle_scale
    if abs(input.y) > attrs.boomerang_stick_deadzone:
        # atan2f is required here; ordinary atan2 retains double semantics.
        state.boomerang_angle = atan2_float(input.y, abs(input.x))
        if state.boomerang_angle > state.boomerang_angle_limit:
            state.boomerang_angle = state.boomerang_angle_limit
        elif state.boomerang_angle < -state.boomerang_angle_limit:
            state.boomerang_angle = -state.boomerang_angle_limit
    state.boomerang_offset_x = facing.direction * (speed * cos(state.boomerang_angle))
    state.boomerang_offset_y = facing.direction * (speed * sin(state.boomerang_angle))
    if facing.direction == -1:
        if state.boomerang_angle < 0:
            state.boomerang_angle = -pi - state.boomerang_angle
        else:
            state.boomerang_angle = pi - state.boomerang_angle
    if state.boomerang_angle < 0:
        state.boomerang_angle = state.boomerang_angle + (2 * pi)



func boomerang_accessory():
    if cue.article.consume():
        # The creation callback sees the original absent reference.
        state.boomerang_handle = articles.spawn_bone_attached(It_Kind_Link_Boomerang, LeftThumb)
        if articles.owned(state.boomerang_handle):
            state.boomerang_used = true
            callbacks.death3(boomerang_remove)
            callbacks.damage(Cleanup_AllArticles)
    if command(0) != 0 and articles.owned(state.boomerang_handle) and state.boomerang_held:
        if state.boomerang_smash:
            boomerang_angle(attrs.boomerang_smash_launch_speed)
        else:
            boomerang_angle(attrs.boomerang_launch_speed)
        articles.signal_owned(state.boomerang_handle, It_Kind_Link_Boomerang, "launch", state.boomerang_angle)
        command(0) = 0
        command(1) = 0



func boomerang_enter(bool air_started):
    if not state.boomerang_initialized:
        state.boomerang_initialized = true
        state.boomerang_handle = -1
        state.boomerang_used = false
    state.boomerang_joint = bones.index(LeftThumb)
    state.boomerang_vertical_offset = attrs.boomerang_vertical_offset * model.instance_scale_y
    cue.throw.reset()
    command(0) = 0
    callbacks.state_changed(boomerang_smash_input)
    if air_started:
        if state.boomerang_used:
            state.enter_at_speed(355, 0, 0, 1)
        else:
            state.enter_at_speed(353, 0, 0, 1)
    else:
        if state.boomerang_used:
            state.enter_at_speed(352, 0, 0, 1)
        else:
            state.enter_at_speed(350, 0, 0, 1)
    animation.start()
    callbacks.accessory(boomerang_accessory)



func boomerang_catch():
    if grounded:
        state.enter_at_speed(351, 0, 0, 1)
    else:
        state.enter_at_speed(354, 0, 0, 1)
    callbacks.damage(Cleanup_AllArticles)
    animation.start()



func boomerang_finish(bool air_started):
    if animation.finished:
        if air_started:
            state.fall()
        else:
            state.wait()



func boomerang_catch_animation(bool air_started):
    if command(1) != 0:
        boomerang_remove()
        command(1) = 0
    boomerang_finish(air_started)



func boomerang_ground_interrupt():
    # Stock short-circuit order, with identical individual common checks.
    if controls.try_side_special():
        boomerang_remove()
        return
    if controls.try_up_special():
        boomerang_remove()
        return
    if controls.try_neutral_special():
        boomerang_remove()
        return
    if controls.try_down_special():
        boomerang_remove()
        return
    if controls.try_guard():
        boomerang_remove()
        return
    if controls.try_ground_jump():
        boomerang_remove()
        return
    if controls.try_dash():
        boomerang_remove()



func boomerang_air_interrupt():
    if controls.try_air_special():
        boomerang_remove()
        return
    if controls.try_aerial_jump():
        boomerang_remove()



func boomerang_ground_collision(int air_motion, bool accessory):
    if collision.left_ground:
        physics.ground_to_air()
        state.enter_at_speed(air_motion, 0x0C4C5080, frame, 1)
        if accessory:
            callbacks.accessory(boomerang_accessory)



func boomerang_air_collision(int ground_motion, bool accessory):
    if collision.landed:
        physics.switch_to_ground()
        state.enter_at_speed(ground_motion, 0x0C4C5080, frame, 1)
        if accessory:
            callbacks.accessory(boomerang_accessory)



func Tether_Create():
    if motion.id != 360 and motion.id != 361 and motion.id != 212 and motion.id != 214:
        return
    Tether_ReadInputs()
    state.tether_attachment_part = bones.index(RightThumb)
    state.tether_handle = articles.spawn_bone_attached(It_Kind_Link_HShot, RightThumb)
    if not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
        return
    articles.signal(state.tether_handle, It_Kind_Link_HShot, "constructor_post_pickup", 0)
    callbacks.accessory_before(Tether_Update)
    callbacks.death1(Tether_Remove)
    callbacks.accessory_hitlag(Tether_Hitlag)



func Tether_Unbind(int expected):
    if state.tether_handle != expected:
        return
    state.tether_handle = -1
    if callbacks.matches(Callback.accessory_before, Tether_Update):
        callbacks.accessory_before(None)
    if callbacks.matches(Callback.accessory_hitlag, Tether_Hitlag):
        callbacks.accessory_hitlag(None)
    if callbacks.matches(Callback.death1, Tether_Remove):
        callbacks.death1(None)



func Tether_Remove():
    if articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
        articles.signal(state.tether_handle, It_Kind_Link_HShot, "remove", 0)
    else:
        Tether_Unbind(state.tether_handle)



func Tether_Update():
    if articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
        articles.signal(state.tether_handle, It_Kind_Link_HShot, "normal_update", 0)
    else:
        Tether_Unbind(state.tether_handle)



func Tether_Hitlag():
    if not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
        Tether_Unbind(state.tether_handle)
        return
    state.tether_before_launch = false
    if motion.id == 212 and state.tether_counter < attrs.tether_standing_launch:
        state.tether_before_launch = true
    if motion.id == 214 and state.tether_counter < attrs.tether_dash_launch:
        state.tether_before_launch = true
    if motion.id == 360 and state.tether_counter < attrs.tether_air_launch:
        state.tether_before_launch = true
    articles.signal(state.tether_handle, It_Kind_Link_HShot, "hitlag_update", 0)



func Tether_ReadInputs():
    state.tether_launch_now = (motion.id == 212 and state.tether_counter == attrs.tether_standing_launch) or (motion.id == 214 and state.tether_counter == attrs.tether_dash_launch) or (motion.id == 360 and state.tether_counter == attrs.tether_air_launch)
    state.tether_allowed_motion = motion.id == 212 or motion.id == 214 or motion.id == 360 or motion.id == 361
    state.tether_grounded = grounded
    state.tether_attack_pressed = input.attack_pressed
    state.tether_facing = facing.direction



func Tether_ReadPosition():
    state.tether_old_x = position.x
    state.tether_old_y = position.y
    state.tether_position_x = position.x
    state.tether_position_y = position.y



func Tether_ApplyPosition():
    position.x = state.tether_target_x
    position.y = state.tether_target_y



func Tether_AddDisplacement():
    velocity.x = velocity.x + position.x - state.tether_old_x
    velocity.y = velocity.y + position.y - state.tether_old_y
    position.delta.x = velocity.x
    position.delta.y = velocity.y



func Tether_HitEffect():
    effects.spawn_with_scalar_at_position(1009, state.tether_hit_x, state.tether_hit_y, state.tether_hit_z, facing.direction)



func Tether_ClearAttack():
    hitbox.clear_all()



func Tether_ClearCaptureMask():
    capture.mask(0)



func Tether_StartHangTimer():
    state.tether_hang_timer = attrs.tether_hang_frames



func Tether_HangCountdown():
    state.tether_hang_expired = state.tether_hang_timer <= 0
    state.tether_hang_timer = state.tether_hang_timer - 1



func Tether_DamageFall():
    state.damage_fall()



func Tether_PullComplete():
    let bool ledge = collision.probe_ledge(5, 5)
    if ledge:
        velocity.x = 0
        velocity.y = 0
    if ledge and collision.ledge_available():
        state.catch_ledge()
    else:
        velocity.x = 0
        state.cliff_jump_phase2(attrs.tether_pull_jump_multiplier)



func Tether_EnterAir():
    state.tether_counter = 0
    acceleration.x = 0
    acceleration.y = 0
    acceleration.z = 0
    state.enter_at(360, 0, 0)
    capture.mask(511)



func Tether_EnterHit():
    state.enter_flags(361, 1)
    physics.clamp_horizontal_speed(air.drift_max)
    state.tether_hit_timer = 20
    state.tether_hit_aux = 0
    if grounded:
        physics.ground_to_air()



func Tether_FinishAir():
    state.freefall(1, 0, true, 1, movement.special_landing_lag)



func Tether_LaunchAir():
    bones.world_position(state.tether_attachment_part, state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z)
    state.tether_launch_blocked = stage.segment_blocked(collision.position.x, state.tether_thumb_y, state.tether_thumb_x + 8 * facing.direction * model.instance_scale_y, state.tether_thumb_y)
    if state.tether_launch_blocked:
        Tether_Remove()
        Tether_FinishAir()
        return
    articles.signal(state.tether_handle, It_Kind_Link_HShot, "extend_air", position.delta.x)
    sound.play(attrs.tether_extend_sound, 127, 64)



func Tether_AirAnimation():
    state.tether_counter = state.tether_counter + 1
    if state.tether_counter == attrs.tether_air_create:
        Tether_Create()
        if not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
            Tether_FinishAir()
    elif state.tether_counter > attrs.tether_air_create and state.tether_counter <= attrs.tether_air_remove:
        if state.tether_counter == attrs.tether_air_launch:
            Tether_LaunchAir()
            if state.tether_launch_blocked:
                return
        elif state.tether_counter == attrs.tether_air_retract:
            articles.signal(state.tether_handle, It_Kind_Link_HShot, "retract", 0)
            sound.play(attrs.tether_retract_sound, 127, 64)
        elif state.tether_counter == attrs.tether_air_remove:
            Tether_Remove()
    if animation.finished:
        Tether_FinishAir()



func Tether_AirPhysics():
    physics.check_fastfall()
    if movement.fastfall:
        physics.fastfall()
    else:
        if state.tether_counter < 20 and position.delta.y < 0:
            physics.fall(air.gravity * 0.2, air.terminal_velocity)
        else:
            physics.fall(air.gravity, air.terminal_velocity)
    physics.air_accel_normal()



func Tether_HitPhysics():
    velocity.x = position.delta.x
    velocity.y = position.delta.y
    velocity.z = position.delta.z
    physics.fall(air.gravity, air.terminal_velocity)

# Proposed exact engine-policy hook, replacing stock kind gate only here.


func Tether_StandingFrame():
    state.tether_ground_consumed = false
    state.tether_counter = state.tether_counter + 1
    if state.tether_counter == attrs.tether_standing_create:
        Tether_Create()
        if not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
            state.wait()
            state.tether_ground_consumed = true
            return
    elif state.tether_counter > attrs.tether_standing_create and state.tether_counter <= attrs.tether_standing_remove:
        if state.tether_counter == attrs.tether_standing_launch:
            bones.world_position(bones.index(RightThumb), state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z)
            if stage.segment_blocked(collision.position.x, state.tether_thumb_y, state.tether_thumb_x + 8 * facing.direction * model.instance_scale_y, state.tether_thumb_y):
                Tether_Remove()
                state.wait()
                state.tether_ground_consumed = true
                return
            articles.signal(state.tether_handle, It_Kind_Link_HShot, "extend_air", 0)
            sound.play(attrs.tether_extend_sound, 127, 64)
        elif state.tether_counter == attrs.tether_standing_retract:
            articles.signal(state.tether_handle, It_Kind_Link_HShot, "retract", 0)
            sound.play(attrs.tether_retract_sound, 127, 64)
        elif state.tether_counter == attrs.tether_standing_remove:
            Tether_Remove()


func Tether_DashFrame():
    state.tether_ground_consumed = false
    state.tether_counter = state.tether_counter + 1
    if state.tether_counter == attrs.tether_dash_create:
        Tether_Create()
        if not articles.ref(state.tether_handle, It_Kind_Link_HShot).exists:
            state.wait()
            state.tether_ground_consumed = true
            return
    elif state.tether_counter > attrs.tether_dash_create and state.tether_counter <= attrs.tether_dash_remove:
        if state.tether_counter == attrs.tether_dash_launch:
            articles.signal(state.tether_handle, It_Kind_Link_HShot, "extend_air", 0)
            sound.play(attrs.tether_extend_sound, 127, 64)
        elif state.tether_counter == attrs.tether_dash_retract:
            articles.signal(state.tether_handle, It_Kind_Link_HShot, "retract", 0)
            sound.play(attrs.tether_retract_sound, 127, 64)
        elif state.tether_counter == attrs.tether_dash_remove:
            Tether_Remove()



func Cleanup_AllArticles():
    boomerang_remove()
    if state.tether_handle != -1:
        Tether_Remove()
        state.tether_handle = -1
    if state.bow_arrow_handle != -1:
        if articles.ref(state.bow_arrow_handle, It_Kind_Link_Arrow).exists:
            articles.signal(state.bow_arrow_handle, It_Kind_Link_Arrow, "remove", 0)
        state.bow_arrow_handle = -1
    if state.bow_handle != -1:
        if articles.ref(state.bow_handle, It_Kind_Link_Bow).exists:
            articles.signal(state.bow_handle, It_Kind_Link_Bow, "remove", 0)
        state.bow_handle = -1


func Dair_Hit():
    let length = state.dair_timing[1] - attrs.dair_hit_pause
    hitbox.clear_all()
    velocity.y = attrs.dair_bounce_y
    movement.fastfall = false
    state.dair_timing[0] = attrs.dair_hit_pause
    if frame > length: state.enter_at_speed(69, 0, length, 1)


func Dair_Animation():
    if state.dair_timing[0] > 0:
        state.dair_timing[0] = state.dair_timing[0] - animation.rate
        if state.dair_timing[0] <= 0 and frame < state.dair_timing[1]:
            hitbox.set_enabled(0, true)
            hitbox.clear_victims(0)
            hitbox.set_damage(0, attrs.dair_damage0)
            hitbox.set_enabled(1, true)
            hitbox.clear_victims(1)
            hitbox.set_damage(1, attrs.dair_damage1)
            hitbox.set_enabled(2, true)
            hitbox.clear_victims(2)
            hitbox.set_damage(2, attrs.dair_damage2)
    # Actual shared ftCo_AttackAir_Anim body: consume bit3 then completion.
    if cue.reverse.consume(): facing.direction = -facing.direction
    if animation.finished: state.fall()


func CarriedShield_Install():
    if visuals.previous_group(int(2)) == 0:
        guard.create(attrs.carried_shield_bone, attrs.carried_shield_x, attrs.carried_shield_y, attrs.carried_shield_z, attrs.carried_shield_radius, GuardHit)
        guard.front_only = true
        guard.filtered_attacks_only = true
        guard.skip_contact_details = true


func SwordCombo_Interrupt():
    if controls.interrupt_allowed:
        if controls.try_side_special(): return
        if controls.try_up_special(): return
        if controls.try_neutral_special(): return
        if controls.try_down_special(): return
        if controls.try_catch(): return
    if command(0) != 0 and input.attack_pressed:
        controls.interrupt_allowed = false
        state.enter_at_speed(341, 0, 0, 1)
        animation.start()
        return
    if controls.interrupt_allowed:
        if controls.try_side_smash(): return
        if controls.try_up_smash(): return
        if controls.try_down_smash(): return
        if controls.try_side_tilt(): return
        if controls.try_up_tilt(): return
        if controls.try_down_tilt(): return
        if controls.try_jab(): return
        if controls.try_guard(): return
        if controls.try_taunt(): return
        if controls.try_ground_jump(): return
        if controls.try_dash(): return
        if controls.try_crouch(): return
        if controls.try_turn(): return
        if controls.try_walk(): return


article It_Kind_Link_Bomb states 7:
    attribute int lifetime 0
    attribute int fast_fuse_threshold 12
    attribute int detonation_damage 16
    attribute float damage_hop_x 20
    attribute float damage_hop_y 24
    attribute float contact_bounce_x 28
    attribute float contact_bounce_y 32
    attribute float detonation_speed_x 36
    attribute float detonation_speed_y 40
    attribute float roll_acceleration 44
    attribute float roll_stop_speed 48
    state bool fast_fuse
    state bool rolling
    state bool damage_hopped
    state float fuse_translation_step
    state float fuse_rotation_step
    state float roll_direction
    state int change_flags
    state bool impact_detonated
    state int stage_flags
    state float collision_velocity_x
    state float collision_velocity_y
    state float preserved_fuse_y
    state float preserved_fuse_x
    on signal change_preserving_fuse:
            # dynamic_joint uses the article's dynamic-bone table, not a
            # preorder root-model joint index. These components survive every change.
            item.state.preserved_fuse_y = item.dynamic_joint(3).translation.y
            item.state.preserved_fuse_x = item.dynamic_joint(3).rotation.x
            if item.state.fast_fuse:
                item.state.change_flags = item.state.change_flags | 256
            else:
                item.state.change_flags = item.state.change_flags | 2
            item.change_state_flags(int(signal.value), item.state.change_flags)
            item.dynamic_joint(3).translation.y = item.state.preserved_fuse_y
            item.dynamic_joint(3).rotation.x = item.state.preserved_fuse_x
    on signal explode:
            item.harm_owner = true
            item.harm_teammates = true
            item.harm_sibling_items = true
            if item.owner_bound:
                item.release_attachment(0, 0, 0)
                item.collision_mode = 2
                if item.attachment_active and attachment_owner.exists: attachment_owner.helpers.bomb_restore_parts()
            item.use_manual_lifetime()
            velocity.x = 0
            velocity.y = 0
            velocity.z = 0
            item.hide_model()
            item.physics_disabled = true
            item.begin_expiry()
            item.collision_mode = 2
            item.spawn_effect_at_position(1038, position.x, position.y, position.z)
            item.play_sound(116, 127, 64)
            item.contact_hitlag = false
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 5)
            effects.wind_at_position(position.x, position.y, position.z, 120, 1, 0.02, 1.0471976)
    on signal fuse_tick:
            if item.life <= 0:
                item.signal("explode", 0)
                return
            if item.life <= item.attr.fast_fuse_threshold and not item.state.fast_fuse:
                # Select descriptor3, reload/advance model animation once without
                # changing logical state, commands, lifetime, velocity or attachment.
                item.set_animation_descriptor(3)
                item.advance_model_animation()
                item.state.fast_fuse = true
            item.life = item.life - 1
            if not item.state.fast_fuse:
                item.dynamic_joint(3).translation.y = item.dynamic_joint(3).translation.y + item.state.fuse_translation_step
                item.dynamic_joint(3).rotation.x = item.dynamic_joint(3).rotation.x + item.state.fuse_rotation_step
    on signal enter_falling:
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 1)
    on signal enter_held:
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 0)
            item.subaction_sounds_muted = false
    on signal enter_thrown:
            item.harm_sibling_items = true
            item.can_be_hit_by_sibling_items = true
            item.state.change_flags = 4
            if item.motion_state == 2: item.state.change_flags = 20
            item.signal("change_preserving_fuse", 2)
    on signal enter_dropped:
            item.harm_sibling_items = true
            item.can_be_hit_by_sibling_items = true
            item.state.change_flags = 4
            if item.motion_state == 3: item.state.change_flags = 20
            item.signal("change_preserving_fuse", 3)
    on signal enter_rolling:
            item.state.roll_direction = 1
            if velocity.x < 0: item.state.roll_direction = -1
            item.set_collision_facing(int(item.state.roll_direction))
            item.state.rolling = true
            item.state.change_flags = 0
            item.signal("change_preserving_fuse", 4)
    on signal check_impact_speed:
            item.state.impact_detonated = false
            if abs(item.state.collision_velocity_x) > item.attr.detonation_speed_x or abs(item.state.collision_velocity_y) > item.attr.detonation_speed_y:
                item.signal("explode", 0)
                item.state.impact_detonated = true
    on signal thrown_collision:
            item.state.collision_velocity_x = velocity.x
            item.state.collision_velocity_y = velocity.y
            # DAA8 sweep records current position/collision flags/floor response.
            item.state.stage_flags = item.sweep_stage_flags()
            if item.state.stage_flags & 15:
                item.signal("check_impact_speed", 0)
                if not item.state.impact_detonated and item.state.stage_flags & 1:
                    item.grounded = true
                    item.reset_default_ecb()
                    item.signal("enter_rolling", 0)
    state 0 anim 0:
        on animation:
            if item.animation_finished: item.signal("enter_held", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            return
    state 1 anim 0:
        on animation:
            if item.animation_finished: item.signal("enter_falling", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            item.gravity(false)
        on collision:
            # E15C flavor; existing no-argument E248 bounce_to_ground differs.
            item.bounce_to_ground(true)
            return false
    state 2 anim 1:
        on animation:
            if item.animation_finished: item.signal("enter_thrown", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            item.gravity()
        on collision:
            item.signal("thrown_collision", 0)
            return false
    state 3 anim 1:
        on animation:
            if item.animation_finished: item.signal("enter_dropped", 0)
            # Intentional second query after changing3, matching source.
            if item.animation_finished: item.signal("enter_falling", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            item.gravity()
        on collision:
            item.signal("thrown_collision", 0)
            return false
    state 4 anim 0:
        on animation:
            if item.animation_finished: item.signal("enter_rolling", 0)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            if item.state.rolling:
                if velocity.x != 0: velocity.x = velocity.x + item.attr.roll_acceleration * item.state.roll_direction
                if abs(velocity.x) < item.attr.roll_stop_speed: velocity.x = 0
        on collision:
            item.follow_ground()
            return false
    state 5 anim 2:
        on animation:
            return item.expire_tick()
        on physics:
            return
        on collision:
            return false
    state 6 anim 0:
        on animation:
            if item.animation_finished: item.change_state_flags(6, 2)
            item.signal("fuse_tick", 0)
            return false
        on physics:
            return
        on collision:
            item.slide_on_ground()
            return false
    on created:
            item.set_lifetime(item.attr.lifetime)
            item.state.fast_fuse = false
            item.state.damage_hopped = false
            # Source subtracts unsigned attributes before conversion to float.
            item.state.fuse_translation_step = -2.8000002 / float(uint(item.attr.lifetime) - uint(item.attr.fast_fuse_threshold)) * item.scale
            item.state.fuse_rotation_step = -0.15707964 / float(uint(item.attr.lifetime) - uint(item.attr.fast_fuse_threshold)) * item.scale
            item.subaction_sounds_muted = true
    on picked_up:
            item.signal("enter_held", 0)
    on dropped:
            item.signal("enter_dropped", 0)
    on thrown:
            item.signal("enter_thrown", 0)
    on damage_dealt:
            if item.motion_state != 5:
                item.state.collision_velocity_x = velocity.x
                item.state.collision_velocity_y = velocity.y
                item.signal("check_impact_speed", 0)
                if not item.state.impact_detonated:
                    facing = -facing
                    velocity.x = item.attr.contact_bounce_x * facing
                    velocity.y = item.attr.contact_bounce_y
            return false
    on damage_received:
            if item.motion_state != 5:
                if item.damage_received >= item.attr.detonation_damage:
                    item.signal("explode", 0)
                elif not item.state.damage_hopped:
                    # Signed x comparison and facing-scaled y are intentional.
                    if velocity.x > item.attr.roll_stop_speed:
                        facing = -item.damage_direction
                        velocity.x = item.attr.damage_hop_x * facing
                    else:
                        velocity.x = item.attr.damage_hop_x * (2 * (random.float() - 0.5))
                        item.align_facing_to_velocity()
                    velocity.y = item.attr.damage_hop_y * facing
                    item.state.damage_hopped = true
            return false
    on entered_air:
            item.change_state_flags(6, 2)
    on reflected:
            return item.reflect()
    on shield_bounced:
            return item.shield_bounce()
    on hit_shield:
            item.bounce()
            return false
    on interaction:
            if item.attachment_owner_is(other): item.clear_attachment_owner()
            item.interact(other)
    on stage_landed:
            item.signal("enter_rolling", 0)
    on stage_left:
            item.signal("enter_falling", 0)
    on out_of_bounds:
            if not item.owner_bound and item.motion_state != 5: item.signal("explode", 0)


