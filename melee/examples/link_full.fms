    on signal shield_position:
            # Native lookup cleared these outputs even when the target was missing.
            item.state.shield_x = 0
            item.state.shield_y = 0
            item.state.shield_z = 0
            item.state.shield_radius = 0
            targets.shield(item.state.shield_target, item.state.shield_x, item.state.shield_y, item.state.shield_z, item.state.shield_radius)
            item.state.shield_radius = targets.model_scale(item.state.shield_target) * item.state.shield_radius
            position.x = item.state.shield_radius * cos(item.state.shield_angle) + item.state.shield_x
            position.y = item.state.shield_radius * sin(item.state.shield_angle) + item.state.shield_y
            position.z = 0
    on created:
            item.command0 = 0
            item.command1 = 0
            item.command2 = 0
            item.command3 = 0
            item.set_lifetime(item.params.flight_lifetime)
            item.state.launched = false
            item.state.trail_age = 0
            item.state.creator_scale = 1
            if item.attachment_active and attachment_owner.exists:
                item.state.creator_scale = attachment_owner.model.scale
            item.state.line = -1
            item.state.normal_angle = 0
            item.state.previous_normal_angle = 0
    on picked_up:
            item.change_state_flags(0, 2)
    on destroyed:
            if not item.state.launched and item.attachment_active and attachment_owner.exists: attachment_owner.helpers.bow_unset_arrow()
            item.signal("destroy_trails", 0)
            item.detach_owner()
            item.owner_bound = false
    on interaction:
            item.interact(other)
    on damage_dealt:
            velocity.x = velocity.x * item.params.contact_velocity_multiplier
            item.signal("destroy_trails", 0)
            return true
    on clanked:
            item.signal("destroy_trails", 0)
            return true
    on reflected:
            item.signal("destroy_trails", 0)
            facing = -facing
            item.joint("").rotation.y = (pi * 0.5) * facing
            velocity.x = -velocity.x
            velocity.y = -velocity.y
            velocity.z = 0
            position.x = position.x + velocity.x
            position.y = position.y + velocity.y
            position.z = 0
            item.state.angle = pi + item.state.angle
            # Stored flight angle is bounded by the imported limit. Stock's
            # unusual period is pi. A general while statement is needed if
            # customized angle limits can require more than two subtractions.
            while item.state.angle > pi:
                item.state.angle = item.state.angle - pi
            while item.state.angle < -pi:
                item.state.angle = item.state.angle + pi
            item.joint("").rotation.z = item.state.angle
            item.joint("").translation.x = position.x
            item.joint("").translation.y = position.y
            item.joint("").translation.z = position.z
            return false
    on hit_shield:
            if targets.is_fighter(item.contact_fighter):
                item.set_scale(item.state.creator_scale)
                item.set_lifetime(item.params.embedded_lifetime)
                velocity.x = 0
                velocity.y = 0
                velocity.z = 0
                item.change_state_flags(2, 2)
                item.signal("destroy_trails", 0)
                item.state.shield_target = item.contact_fighter
                # Native lookup cleared these outputs even when the target was missing.
                item.state.shield_x = 0
                item.state.shield_y = 0
                item.state.shield_z = 0
                item.state.shield_radius = 0
                targets.shield(item.state.shield_target, item.state.shield_x, item.state.shield_y, item.state.shield_z, item.state.shield_radius)
                item.state.shield_radius = targets.model_scale(item.state.shield_target) * item.state.shield_radius
                item.state.shield_angle = atan2(0.5 * (position.y + item.state.previous_y) - item.state.shield_y, 0.5 * (position.x + item.state.previous_x) - item.state.shield_x)
                position.x = item.state.shield_radius * cos(item.state.shield_angle) + item.state.shield_x
                position.y = item.state.shield_radius * sin(item.state.shield_angle) + item.state.shield_y
                position.z = 0
                return false
            return true
    state 0 anim -1:
        on animation:
            item.set_scale(item.state.creator_scale)
            # Native Arrow tests its revocable attachment pointer before owner equality.
            if attachment_owner.exists:
                if item.attachment_active:
                    if attachment_owner.motion < 344 or attachment_owner.motion > 349 or attachment_owner.fighter.action_detaches_items:
                        item.clear_attachment_owner()
                        return true
            else:
                return true
            return false
        on physics:
            return
        on collision:
            return false
    state 1 anim 0:
        on animation:
            item.set_scale(item.state.creator_scale)
            if item.command2 == 0:
                hitbox.set_damage(0, uint(item.state.damage))
                item.command2 = 1
            if item.state.trail_age > 0: item.command0 = 1
            if item.state.trail_age > 1: item.command1 = 1
            if item.command0 == 1 and item.joint(1, "").exists:
                item.set_model_draw_enabled(1, true)
                item.joint(1, "").visible = true
                item.set_joint_transform(1, "", item.state.history1_x, item.state.history1_y, item.state.history1_z, item.state.history1_rx, item.state.history1_ry, item.state.history1_rz, item.state.history1_rw, item.joint("").scale.x, item.joint("").scale.y, item.joint("").scale.z, true)
            if item.command1 == 1 and item.joint(2, "").exists:
                item.set_model_draw_enabled(2, true)
                item.joint(2, "").visible = true
                item.set_joint_transform(2, "", item.state.history2_x, item.state.history2_y, item.state.history2_z, item.state.history2_rx, item.state.history2_ry, item.state.history2_rz, item.state.history2_rw, item.joint("").scale.x, item.joint("").scale.y, item.joint("").scale.z, true)
            item.state.trail_age = item.state.trail_age + 1
            if item.expire_tick():
                item.signal("destroy_trails", 0)
                return true
            return false
        on physics:
            item.state.previous_x = position.x
            item.state.previous_y = position.y
            item.state.previous_z = position.z
            if item.params.gravity < 0:
                velocity.y = velocity.y + item.params.gravity
            else:
                velocity.y = velocity.y - item.params.gravity
        on collision:
            if facing == 1:
                item.state.angle = atan2(position.y - item.state.previous_y, position.x - item.state.previous_x)
            else:
                item.state.angle = -atan2(position.y - item.state.previous_y, item.state.previous_x - position.x)
            if abs(item.state.angle) > item.params.flight_angle_limit:
                if item.state.angle < 0:
                    item.state.angle = -item.params.flight_angle_limit
                else:
                    item.state.angle = item.params.flight_angle_limit
            item.joint("").rotation.z = item.state.angle
            item.signal("sweep", 0)
            if item.state.sweep_hit and stage.line_exists(item.state.line):
                item.bind_stage_line(item.state.line)
                item.read_stage_line_speed(item.state.line)
                item.state.normal_angle = atan2(item.state.normal_y, item.state.normal_x)
                item.state.previous_normal_angle = item.state.normal_angle
                item.signal("stage_embed", 0)
            item.signal("history", 0)
            return false
    state 2 anim -1:
        on animation:
            if not targets.guard_active(item.state.shield_target): return true
            if item.expire_tick():
                item.signal("destroy_trails", 0)
                return true
            return false
        on physics:
            item.signal("shield_position", 0)
        on collision:
            return false
    state 3 anim -1:
        on animation:
            return false
        on physics:
            return
        on collision:
            return false
    state 4 anim -1:
        on animation:
            if item.state.vibration_index >= 0 and item.state.vibration_index <= 6:
                # Stock rounds the table product, degree sum, and radian product
                # separately to Float. Keep those stores instead of a Double literal.
                let float spread = float(item.state.vibration_index + 2) * random.float()
                let float degrees = spread + float(2 * (item.state.vibration_index + 1))
                item.state.vibration_offset = degrees * float(0.01745329252)
                if item.state.vibration_index & 1:
                    item.joint("").rotation.z = item.state.angle - item.state.vibration_offset
                else:
                    item.joint("").rotation.z = item.state.angle + item.state.vibration_offset
            else:
                item.joint("").rotation.z = item.state.angle
            item.state.vibration_index = int(uint(item.state.vibration_index) - 1)
            if item.expire_tick():
                item.signal("destroy_trails", 0)
                if item.state.tail_age == 0:
                    # Native zero-jitter effect creation still consumes three random samples.
                    random.float()
                    random.float()
                    random.float()
                    let float effect_x = 0
                    let float effect_y = 0
                    let float effect_z = 0
                    item.joint_world_position(0, "", effect_x, effect_y, effect_z)
                    item.spawn_effect_at_position(1057, effect_x, effect_y, effect_z)
                    item.collision_mode = 2
                item.hide_model()
                item.suppress_destruction_effects = true
                item.state.tail_age = item.state.tail_age + 1
                if item.state.tail_age > 300: return true
            return false
        on physics:
            return
        on collision:
            item.signal("history", 0)
            item.state.previous_normal_angle = item.state.normal_angle
            if item.state.line != -1:
                if stage.line_exists(item.state.line):
                    item.bind_stage_line(item.state.line)
                    item.read_stage_line_speed(item.state.line)
                    stage.line_normal(item.state.line, item.state.normal_x, item.state.normal_y, item.state.normal_z)
                    item.state.normal_angle = atan2(item.state.normal_y, item.state.normal_x)
                    if item.state.normal_angle != item.state.previous_normal_angle:
                        item.state.angle = item.state.angle + (item.state.normal_angle - item.state.previous_normal_angle)
                        item.joint("").rotation.z = item.state.angle
                    return false
            else:
                velocity.x = 0
                velocity.y = 0
                velocity.z = 0
            return true

# Complete owned Arrow policy using the shared article operations.
# Owned Bow article; lifecycle is part of this complete fighter template.


article It_Kind_Link_Bow states 7:
    attachment origin bone plane on initial_collision on held off
    state float creator_scale
    state int owner_phase
    state int paired_phase
    state float saved_frame
    state bool cleanup_supported
    on signal remove:
            item.remove()
    on signal owner_phase:
            item.state.owner_phase = 6
            if item.attachment_active and attachment_owner.exists:
                if attachment_owner.motion >= 344 and attachment_owner.motion <= 349 and attachment_owner.state.bow_handle >= 0:
                    item.state.owner_phase = attachment_owner.motion - 344
            if item.state.owner_phase < 3:
                item.state.paired_phase = item.state.owner_phase + 3
            elif item.state.owner_phase < 6:
                item.state.paired_phase = item.state.owner_phase - 3
            else:
                item.state.paired_phase = 6
    on signal synchronize:
            if item.attachment_active and attachment_owner.exists:
                item.signal("owner_phase", 0)
                if item.motion_state != item.state.owner_phase:
                    if item.motion_state == item.state.paired_phase:
                        item.state.saved_frame = item.animation_frame
                        item.change_state_flags(item.state.owner_phase, 2)
                        item.advance_animation()
                        item.set_animation_frame(item.state.saved_frame)
                    else:
                        item.change_state_flags(item.state.owner_phase, 2)
                        item.advance_animation()
    on signal cleanup:
            item.state.cleanup_supported = true
            let int recipient = item.current_owner
            if recipient != 0:
                item.state.cleanup_supported = targets.call(recipient, "bow_unset")
    on created:
            item.command0 = 0
            item.command1 = 0
            item.command2 = 0
            item.command3 = 0
            item.remove_at_bounds = false
            item.state.creator_scale = 1
            if item.attachment_active and attachment_owner.exists:
                item.state.creator_scale = attachment_owner.model.scale
    on picked_up:
            if item.attachment_active and attachment_owner.exists:
                item.signal("owner_phase", 0)
                if item.state.owner_phase == 0:
                    item.change_state_flags(0, 2)
                    item.advance_animation()
                    item.set_scale(item.state.creator_scale)
                elif item.state.owner_phase == 3 or item.state.owner_phase == 6:
                    item.change_state_flags(3, 2)
                    item.advance_animation()
                    item.set_scale(item.state.creator_scale)
    on destroyed:
            item.signal("cleanup", 0)
    on interaction:
            item.interact(other)
    state 0 anim 0:
        on animation:
            item.set_scale(item.state.creator_scale)
            if item.motion_state == 2 or item.motion_state == 5:
                if item.animation_frame == 0 or item.animation_frame >= 24:
                    item.signal("cleanup", 0)
                    # Terminal removal still occurs when the recipient has no export.
                    return true
            else:
                item.signal("synchronize", 0)
            if not item.attachment_active or not attachment_owner.exists: return true
            if attachment_owner.motion < 344 or attachment_owner.motion > 349 or attachment_owner.fighter.action_detaches_items: return true
            return false
        on physics:
            return
        on collision:
            item.set_scale(item.state.creator_scale)
            return false
    state 1 anim 1 use 0:
    state 2 anim 2 use 0:
    state 3 anim 3 use 0:
    state 4 anim 4 use 0:
    state 5 anim 5 use 0:
    state 6 anim -1:
        on animation:
            return true
        on physics:
            return
        on collision:
            return true

article It_Kind_Link_Boomerang states 4:
    attachment origin center previous bone plane off initial_collision on held on
    render standard
    attribute int lifetime 0
    attribute int smash_lifetime 4
    attribute int turn_frames 8
    attribute float acceleration 12
    attribute float launch_speed 16
    attribute float maximum_speed 20
    attribute float minimum_speed 24
    attribute float bounce_angle_degrees 28
    attribute float slow_turn_degrees 32
    attribute float fast_turn_degrees 36
    attribute float turn_duration 40
    attribute float catch_distance 44
    attribute float launch_animation_rate 48
    attribute float unused_attribute 52
    attribute float sound_interval 56
    attribute float first_trail_delay 60
    attribute float second_trail_delay 64
    model_root trail_first 68
    model_root trail_second 72
    model_animation trail_first_animation 76
    model_animation trail_second_animation 88
    state float history_x[16]
    state float history_y[16]
    state float history_z[16]
    state float history_rx[16]
    state float history_ry[16]
    state float history_rz[16]
    state int history_write
    state int trail_read[2]
    state int mode
    state int turn_frames
    state float angle
    state float render_angle
    state float bounce_cosine
    state float turn_timer
    state float maximum_turn
    state float spin_step
    state float sound_timer
    state float trail_timer
    state float saved_qx
    state float saved_qy
    state float saved_qz
    state float saved_qw
    state float temporary_x
    state float temporary_y
    state float temporary_z
    state float dx
    state float dy
    state float speed
    state float cosine
    state float distance
    state int index
    state int target
    state bool expired
    on signal remove_reference:
            if item.attachment_active and item.state.mode != 1:
                if attachment_owner.exists:
                    attachment_owner.helpers.boomerang_unset()
    on signal remove:
            item.signal("remove_reference", 0)
            item.remove()
    on signal destroy_trails:
            item.destroy_model(1)
            item.destroy_model(2)
    on signal stage_animation:
            item.state.saved_qx = item.joint("0").quaternion.x
            item.state.saved_qy = item.joint("0").quaternion.y
            item.state.saved_qz = item.joint("0").quaternion.z
            item.state.saved_qw = item.joint("0").quaternion.w
            item.change_state_flags(2, 2)
            item.joint("").rotation.z = item.state.render_angle
            item.set_joint_transform(0, "0", item.joint("0").translation.x, item.joint("0").translation.y, item.joint("0").translation.z, item.state.saved_qx, item.state.saved_qy, item.state.saved_qz, item.state.saved_qw, item.joint("0").scale.x, item.joint("0").scale.y, item.joint("0").scale.z, false)
            item.set_model_animation_rate(0, "0", item.attr.launch_animation_rate)
            item.set_model_animation_rate(1, "", item.attr.launch_animation_rate)
            item.set_model_animation_rate(2, "", item.attr.launch_animation_rate)
    on signal begin_return:
            item.state.saved_qx = item.joint("0").quaternion.x
            item.state.saved_qy = item.joint("0").quaternion.y
            item.state.saved_qz = item.joint("0").quaternion.z
            item.state.saved_qw = item.joint("0").quaternion.w
            item.state.spin_step = -(2 * item.state.saved_qz) / float(uint(item.attr.turn_frames))
            item.state.turn_frames = item.attr.turn_frames
            if item.motion_state == 1:
                item.change_state_flags(3, 0x12)
            else:
                item.change_state_flags(3, 0x110)
            item.joint("").rotation.z = item.state.render_angle
            item.set_joint_transform(0, "0", item.joint("0").translation.x, item.joint("0").translation.y, item.joint("0").translation.z, item.state.saved_qx, item.state.saved_qy, item.state.saved_qz, item.state.saved_qw, item.joint("0").scale.x, item.joint("0").scale.y, item.joint("0").scale.z, false)
            item.set_model_animation_rate(0, "0", 1)
            item.set_model_animation_rate(1, "", 1)
            item.set_model_animation_rate(2, "", 1)
    on signal turn_return:
            if item.state.angle <= 0:
                item.state.angle = item.state.angle + pi
            else:
                item.state.angle = item.state.angle - pi
            if signal.value != 0:
                item.state.maximum_turn = 0.01745329238474369 * item.attr.fast_turn_degrees
            else:
                item.state.maximum_turn = 0.01745329238474369 * item.attr.slow_turn_degrees
            item.state.turn_timer = item.attr.turn_duration
            item.signal("begin_return", 0)
    on signal animate_trails:
            if item.joint(1, "").exists and item.command1 == 2:
                item.advance_model_animation(1)
                item.state.index = item.state.trail_read[0]
                item.joint(1, "").translation.x = item.state.history_x[item.state.index]
                item.joint(1, "").translation.y = item.state.history_y[item.state.index]
                item.joint(1, "").translation.z = item.state.history_z[item.state.index]
                item.joint(1, "").rotation.x = item.state.history_rx[item.state.index]
                item.joint(1, "").rotation.y = item.state.history_ry[item.state.index]
                item.joint(1, "").rotation.z = item.state.history_rz[item.state.index]
                item.state.trail_read[0] = item.state.trail_read[0] + 1
                if item.state.trail_read[0] >= 16:
                    item.state.trail_read[0] = 0
            if item.joint(2, "").exists and item.command2 == 2:
                item.advance_model_animation(2)
                item.state.index = item.state.trail_read[1]
                item.joint(2, "").translation.x = item.state.history_x[item.state.index]
                item.joint(2, "").translation.y = item.state.history_y[item.state.index]
                item.joint(2, "").translation.z = item.state.history_z[item.state.index]
                item.joint(2, "").rotation.x = item.state.history_rx[item.state.index]
                item.joint(2, "").rotation.y = item.state.history_ry[item.state.index]
                item.joint(2, "").rotation.z = item.state.history_rz[item.state.index]
                item.state.trail_read[1] = item.state.trail_read[1] + 1
                if item.state.trail_read[1] >= 16:
                    item.state.trail_read[1] = 0
    on signal show_trail_0:
            if item.joint(1, "").exists:
                item.joint(1, "").visible = true
                item.state.index = item.state.trail_read[0]
                item.joint(1, "").translation.x = item.state.history_x[item.state.index]
                item.joint(1, "").translation.y = item.state.history_y[item.state.index]
                item.joint(1, "").translation.z = item.state.history_z[item.state.index]
                item.joint(1, "").rotation.x = item.state.history_rx[item.state.index]
                item.joint(1, "").rotation.y = item.state.history_ry[item.state.index]
                item.joint(1, "").rotation.z = item.state.history_rz[item.state.index]
    on signal show_trail_1:
            if item.joint(2, "").exists:
                item.joint(2, "").visible = true
                item.state.index = item.state.trail_read[1]
                item.joint(2, "").translation.x = item.state.history_x[item.state.index]
                item.joint(2, "").translation.y = item.state.history_y[item.state.index]
                item.joint(2, "").translation.z = item.state.history_z[item.state.index]
                item.joint(2, "").rotation.x = item.state.history_rx[item.state.index]
                item.joint(2, "").rotation.y = item.state.history_ry[item.state.index]
                item.joint(2, "").rotation.z = item.state.history_rz[item.state.index]
    on signal common_animation:
            item.state.expired = false
            if item.state.sound_timer <= 0:
                item.loop_sound(160091, 127, 64)
                item.state.sound_timer = item.attr.sound_interval
            item.state.sound_timer = item.state.sound_timer - 1
            if item.command0 == 1:
                item.signal("stage_animation", 0)
                item.command0 = 2
            if item.command1 == 0:
                item.state.trail_timer = item.state.trail_timer - 1
                if item.state.trail_timer <= 0:
                    item.signal("show_trail_0", 0)
                    item.command1 = 2
                    item.state.trail_timer = item.attr.second_trail_delay
            elif item.command2 == 0:
                item.state.trail_timer = item.state.trail_timer - 1
                if item.state.trail_timer <= 0:
                    item.signal("show_trail_1", 0)
                    item.command2 = 2
            if item.life <= 0:
                item.state.expired = true
                return
            item.life = item.life - 1
            if item.command0 == 2 or item.motion_state == 3:
                item.state.index = item.state.history_write
                item.state.history_x[item.state.index] = position.x
                item.state.history_y[item.state.index] = position.y
                item.state.history_z[item.state.index] = position.z
                item.read_joint_matrix_rotation(0, "0", item.state.temporary_x, item.state.temporary_y, item.state.temporary_z)
                item.state.history_rx[item.state.index] = item.state.temporary_x
                item.state.history_ry[item.state.index] = item.state.temporary_y
                item.state.history_rz[item.state.index] = item.state.temporary_z
                item.state.history_write = item.state.history_write + 1
                if item.state.history_write >= 16:
                    item.state.history_write = 0
            item.signal("animate_trails", 0)
    on signal outbound_physics:
            if item.state.mode != 1:
                item.state.speed = sqrt(velocity.x * velocity.x + velocity.y * velocity.y) - item.attr.acceleration
                if item.state.speed < item.attr.minimum_speed:
                    item.state.speed = item.attr.minimum_speed
                    item.signal("turn_return", 0)
                velocity.x = item.state.speed * cos(item.state.angle)
                velocity.y = item.state.speed * sin(item.state.angle)
    on signal collision_normal:
            # lbVector_CosAngle uses XY only, including its zero-vector behavior.
            item.state.cosine = (velocity.x * item.state.temporary_x + velocity.y * item.state.temporary_y) / (sqrt(velocity.x * velocity.x + velocity.y * velocity.y) * sqrt(item.state.temporary_x * item.state.temporary_x + item.state.temporary_y * item.state.temporary_y))
            if item.state.cosine < 0:
                if item.state.cosine > item.state.bounce_cosine:
                    item.mirror_velocity(item.state.temporary_x, item.state.temporary_y, item.state.temporary_z)
                    item.state.angle = atan2(velocity.y, velocity.x)
                    if item.state.angle > tau:
                        item.state.angle = item.state.angle - tau
                    elif item.state.angle < -tau:
                        item.state.angle = item.state.angle + tau
                    if facing == 1:
                        item.state.render_angle = item.state.angle
                    else:
                        item.state.render_angle = item.state.angle - pi
                    item.grounded = false
                else:
                    item.signal("turn_return", 0)
    on signal outbound_collision:
            if item.state.mode != 1:
                item.state.saved_qx = item.joint("0").quaternion.x
                item.state.saved_qy = item.joint("0").quaternion.y
                item.state.saved_qz = item.joint("0").quaternion.z
                item.state.saved_qw = item.joint("0").quaternion.w
                item.sweep_floor()
                item.joint("").rotation.z = item.state.render_angle
