state float tether_hit_y


state float tether_hit_z


state int tether_hit_timer


state int tether_hit_aux



state bool tether_ground_consumed


attribute int tether_standing_create 132

attribute int tether_standing_retract 140

attribute int tether_standing_remove 144

attribute int tether_dash_create 148

attribute int tether_dash_retract 156

attribute int tether_dash_remove 160


parameter int sword_graph = 6

parameter int sword_omission = 0


attribute float sword_inner_fade 100

attribute float sword_outer_fade 104

attribute byte sword_start_alpha 108

