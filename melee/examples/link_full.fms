            item.state.previous_y = 0
            item.state.previous_z = 0
            if item.attachment_active and attachment_owner.exists:
                position.x = attachment_owner.state.bow_right_x
                position.y = attachment_owner.state.bow_right_y
                position.z = attachment_owner.state.bow_right_z
                item.state.previous_x = attachment_owner.state.bow_left_x
                item.state.previous_y = attachment_owner.state.bow_left_y
                item.state.previous_z = attachment_owner.state.bow_left_z
    on signal sweep:
            item.sweep_segment(item.state.previous_x, item.state.previous_y, item.state.previous_z, item.state.normal_x, item.state.normal_y, item.state.normal_z, item.state.line, item.state.sweep_flags, item.state.sweep_hit)
    on signal launch:
            item.state.angle = 0.0872664601
            item.set_lifetime(item.params.flight_lifetime + item.params.embedded_lifetime)
            item.state.charge = 0
            if item.attachment_active and attachment_owner.exists:
                item.state.charge = attachment_owner.state.bow_charge
                item.set_lifetime(item.params.flight_lifetime)
                item.change_state_flags(1, 2)
                # Stock queries the attachment-bone matrix rotation here, but never uses it.
                item.release_attachment(0, 0, 0, true)
                item.throw_speed_damage = false
                item.use_manual_lifetime()
                item.state.speed = item.state.charge * ((item.params.maximum_speed - item.params.minimum_speed) / signal.value) + item.params.minimum_speed
                item.state.damage = int(uint(item.state.charge * ((item.params.maximum_damage - item.params.minimum_damage) / signal.value) + item.params.minimum_damage))
                facing = attachment_owner.facing
                item.joint("").rotation.y = (pi * 0.5) * facing
                item.signal("held_positions", 0)
                velocity.x = facing * (item.state.speed * cos(item.state.angle))
                velocity.y = item.state.speed * sin(item.state.angle)
                velocity.z = 0
                item.joint("").rotation.z = item.state.angle
                item.state.launched = true
                item.signal("initialize_history", 0)
                item.load_model(1, trail_first)
                item.load_model(2, trail_second)
                item.set_model_draw_enabled(1, false)
                item.set_model_draw_enabled(2, false)
                item.state.trail_age = 0
                item.signal("sweep", 0)
    on signal stage_embed:
            item.set_scale(item.state.creator_scale)
            item.set_lifetime(item.params.embedded_lifetime)
            item.state.vibration_index = random.int(4) + 3
            item.state.tail_age = 0
            item.change_state_flags(4, 2)
            item.joint("").rotation.z = item.state.angle
            item.signal("destroy_trails", 0)
