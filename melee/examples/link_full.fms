            item.joint(1, "").translation.x = position.x
            item.joint(1, "").translation.y = position.y
            item.joint(1, "").translation.z = position.z
            item.joint(2, "").visible = false
            item.joint(2, "").translation.x = position.x
            item.joint(2, "").translation.y = position.y
