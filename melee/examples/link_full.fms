            if item.state.angle > tau:
                item.state.angle = item.state.angle - tau
            elif item.state.angle < -tau:
                item.state.angle = item.state.angle + tau
            if facing == 1:
                item.state.render_angle = item.state.angle
            else:
                item.state.render_angle = item.state.angle - pi
            return false
    on reflected:
            if item.state.mode != 1:
                if not item.reflection_owner_transfer_disabled:
                    item.state.target = item.current_owner
                else:
                    item.state.target = item.reflector
                item.state.mode = 1
                item.life = item.half_life
                # The reusable query publishes only on success; retain the original fallback.
                item.state.temporary_x = 0
                item.state.temporary_y = 0
                item.state.temporary_z = 0
                targets.read_camera_target_position(item.state.target, item.state.temporary_x, item.state.temporary_y, item.state.temporary_z)
                item.state.dy = position.x - item.state.temporary_x
                item.state.dx = position.y - item.state.temporary_y
                item.state.angle = atan2(item.state.dx, item.state.dy)
                if item.state.angle > tau:
                    item.state.angle = item.state.angle - tau
                elif item.state.angle < -tau:
                    item.state.angle = item.state.angle + tau
                item.state.speed = sqrt(velocity.x * velocity.x + velocity.y * velocity.y)
                velocity.x = item.reflection_multiplier * (item.state.speed * cos(item.state.angle))
                velocity.y = item.reflection_multiplier * (item.state.speed * sin(item.state.angle))
                if attachment_owner.exists:
                    attachment_owner.helpers.boomerang_unset()
                if facing == 1:
                    item.state.render_angle = item.state.angle
                else:
                    item.state.render_angle = item.state.angle - pi
            return false
    on interaction:
            item.interact(other)
            if item.attachment_owner_is(other):
                item.clear_attachment_owner()
    state 0 anim -1:
        on animation:
            if attachment_owner.exists and attachment_owner.action.category >= 5 and attachment_owner.action.category <= 13:
                item.signal("remove", 0)
            return false
    state 1 anim 0:
        on animation:
            item.signal("common_animation", 0)
            return item.state.expired
        on physics:
            item.signal("outbound_physics", 0)
        on collision:
            item.signal("outbound_collision", 0)
            return false
    state 2 anim 1 use 1:
    state 3 anim 2:
        on animation:
            if item.state.turn_frames != 0:
                item.joint("0").rotation.z = item.joint("0").rotation.z + item.state.spin_step
                item.state.turn_frames = item.state.turn_frames - 1
            item.signal("common_animation", 0)
            return item.state.expired
        on physics:
            if item.state.mode != 1:
                item.state.speed = sqrt(velocity.x * velocity.x + velocity.y * velocity.y) + item.attr.acceleration
                if item.state.speed > item.attr.maximum_speed:
                    item.state.speed = item.attr.maximum_speed
                velocity.x = item.state.speed * cos(item.state.angle)
                velocity.y = item.state.speed * sin(item.state.angle)
                item.signal("homing", 0)
                if item.motion_state == 3 and item.state.distance < item.attr.catch_distance:
                    if attachment_owner.exists:
                        if (attachment_owner.action.category < 1 or attachment_owner.action.category > 13) and not attachment_owner.hitlag.active:
                            attachment_owner.helpers.boomerang_catch()
                            item.attach_to_owner(attachment_owner.state.boomerang_joint)
                        else:
                            item.signal("remove_reference", 0)
                            item.remove()
                    item.signal("destroy_trails", 0)

# Owned Boomerang policy; cleanup is part of this complete fighter template.
# The launch quaternion fourth lane is undefined in stock; activation is gated.

article It_Kind_Link_HShot states 9:
    attachment origin bone previous origin plane off initial_collision on held off
    resources capacity 90 reserve_part 139
