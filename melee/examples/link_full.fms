state float boomerang_angle_limit


state float boomerang_offset_x


state float boomerang_offset_y



attribute int tether_standing_launch 136


attribute int tether_dash_launch 152


attribute int tether_air_launch 168


state int tether_handle


state int tether_attachment_part


state float tether_counter


state bool tether_before_launch


state bool tether_create_requested



attribute int tether_air_create 164


attribute int tether_air_retract 172


attribute int tether_air_remove 176


attribute float tether_pull_jump_multiplier 180


attribute int tether_hang_frames 184


parameter int tether_extend_sound = 160073


parameter int tether_retract_sound = 160076


state bool tether_launch_blocked


state bool tether_launch_now


state bool tether_allowed_motion


state bool tether_grounded


state bool tether_attack_pressed


state bool tether_hang_expired


state float tether_hang_timer


state float tether_facing


state float tether_position_x


