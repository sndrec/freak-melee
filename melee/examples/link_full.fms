                if facing == -1 and collision.right_wall:
                    item.state.temporary_x = wall.right.normal.x
                    item.state.temporary_y = wall.right.normal.y
                    item.state.temporary_z = 0
                    item.signal("collision_normal", 0)
                elif facing != -1 and collision.left_wall:
                    item.state.temporary_x = wall.left.normal.x
                    item.state.temporary_y = wall.left.normal.y
                    item.state.temporary_z = 0
                    item.signal("collision_normal", 0)
                elif collision.ceiling_contact:
                    item.state.temporary_x = ceiling.normal.x
                    item.state.temporary_y = ceiling.normal.y
                    item.state.temporary_z = 0
                    item.signal("collision_normal", 0)
                elif collision.floor_contact:
                    item.state.temporary_x = floor.normal.x
                    item.state.temporary_y = floor.normal.y
                    item.state.temporary_z = 0
                    item.signal("collision_normal", 0)
    on signal homing:
            item.state.distance = 0
            if attachment_owner.exists:
                item.state.dx = attachment_owner.position.x - position.x
                item.state.dy = attachment_owner.position.y + attachment_owner.state.boomerang_vertical_offset - position.y
                item.state.distance = sqrt(item.state.dx * item.state.dx + item.state.dy * item.state.dy)
                if item.state.turn_timer > 0:
                    item.state.turn_timer = item.state.turn_timer - 1
                elif item.state.turn_timer <= 0:
                    return
                item.state.temporary_z = atan2(item.state.dy, item.state.dx)
                if item.state.temporary_z < -pi:
