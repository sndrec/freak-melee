            item.state.trail_read[1] = 0
            item.load_model(1, trail_first)
            item.add_model_animation(1, trail_first_animation)
            item.request_model_animation(1, 0)
            item.load_model(2, trail_second)
            item.add_model_animation(2, trail_second_animation)
            item.request_model_animation(2, 0)
            item.state.history_write = 0
