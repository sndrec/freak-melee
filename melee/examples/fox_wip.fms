            callbacks.track_reflect_hit()
    on state_367_animation:
        reflect_hold()
        if animation.finished:
            if state.reflect_release_timer <= 0 and state.reflect_released: reflect_end()
            else:
                reflect_loop()
                effects.clear_all()
                state.reflect_effect = 1160
                callbacks.accessory(reflect_accessory)
    on state_367_interrupt:
        pass
    on state_367_physics:
        reflect_air_physics()
        reflector.update()
    on state_367_collision:
        if collision.landed:
            state.switch_to_ground(362, 0x0C4C5082)
            physics.clamp_air_drift()
            reflector.retain()
            callbacks.track_reflect_hit()

action ReflectTurn:
    on state_364_animation:
        reflect_hold()
        reflect_turn_tick()
        if state.reflect_turn_timer <= 0: reflect_resume()
    on state_364_interrupt:
        pass
    on state_364_physics:
        physics.ground_friction()
        reflector.update()
    on state_364_collision:
        if collision.special_ground_lost:
            state.switch_to_air(369, 0x0C4C5082)
            reflector.retain()
            callbacks.track_reflect_hit()
    on state_369_animation:
