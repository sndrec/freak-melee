# Fox specials, owned articles, throw shots and radio taunts.
# Independent source; interpreter acceptance remains work in progress.
# Import the source defaults into fighter_parameters.fmp before editing values.
fighter:
    behavior independent

# CPU and item-use policies are editable source-owned values.
# Article identities select assets/code, never these behavioral decisions.
parameter bool cpu_capture_enabled = true
parameter int cpu_capture_attempt = 0
parameter int cpu_capture_min_level = 4
parameter float cpu_capture_chance_per_level = 0.05
parameter int cpu_capture_script = 61
parameter float cpu_blaster_range = 62
parameter int cpu_blaster_candidate = 27
parameter float cpu_ground_reflect_threshold = 0.5
parameter int cpu_reflect_level_ceiling = 9
parameter int cpu_reflect_stick_y = -80
parameter int cpu_reflect_press_frames = 1
parameter float cpu_reflect_random_span = 4
parameter int cpu_reflect_delay_base = 4
parameter int cpu_retap_frames = 1
parameter int cpu_recover_stick = 88
parameter int cpu_recover_press_frames = 1
parameter int cpu_recover_wait_frames = 40

# Common presentation entries: DeadDown, DeadRight, camera-ice, and Sleep.
# Only Fox owns a presentation gun; Falco intentionally creates none.
parameter int presentation_down_motion = 0
parameter int presentation_right_motion = 2
parameter int presentation_camera_ice_motion = 10
parameter int presentation_sleep_motion = 11

attribute float blaster_angle 16
attribute float blaster_speed 20
attribute float blaster_landing_lag 24
parameter bool allow_special_while_holding_item = true
parameter int radio_speaker = 0
parameter int blaster_shot_forward_sound = 110103
parameter int blaster_shot_backward_sound = 110106
parameter int blaster_throw_vertical_sound = 110109
parameter int blaster_close_sound = 110100
attribute float side_start_gravity_delay 36
attribute float side_start_velocity_divisor 40
attribute float side_start_air_deceleration 44
attribute float side_start_gravity 48
attribute float side_end_ground_velocity 52
attribute float side_end_ground_friction 56
attribute float side_end_air_velocity 60
attribute float side_end_air_deceleration 64
attribute float side_end_gravity_delay 68
attribute float side_end_gravity 72
attribute float side_freefall_mobility 76
attribute float side_landing_lag 80
attribute float fire_gravity_delay 84
attribute float fire_velocity_divisor 88
attribute float fire_air_deceleration 92
attribute float fire_start_gravity 96
attribute float fire_direction_threshold 100
attribute float fire_travel_frames 104
attribute int fire_platform_grace_frames 108
attribute float fire_deceleration_start 112
attribute float fire_speed 116
attribute float fire_travel_deceleration 120
attribute float fire_end_ground_deceleration 124
attribute float fire_bound_velocity_multiplier 132
attribute float fire_facing_threshold 136
attribute float fire_freefall_mobility 140
attribute float fire_landing_lag 144
attribute float fire_bound_angle 148
attribute float reflect_release_lag 152
attribute float reflect_turn_frames 156
attribute int reflect_gravity_delay 164
attribute float reflect_air_preserve 168
attribute float reflect_fall_accel 172
attribute int reflect_bone 176
attribute int reflect_max_damage 180
attribute float reflect_offset_x 184
attribute float reflect_offset_y 188
attribute float reflect_offset_z 192
attribute float reflect_radius 196
attribute float reflect_damage_mul 200
attribute float reflect_speed_mul 204
attribute bool reflect_keep_owner 208


state int conversation_phase
state int conversation_facing
state int fire_gravity_timer
state float fire_angle
state int fire_travel_remaining
state int fire_travel_age
state int fire_collision_age

state int side_gravity_timer
state int side_article_handle
state float trail_x0
state float trail_x1
state float trail_x2
state float trail_x3
state float trail_y0
state float trail_y1
state float trail_y2
state float trail_y3
state float trail_z0
state float trail_z1
state float trail_z2
state float trail_z3
state float trail_rotation0
state float trail_rotation1
state float trail_rotation2
state float trail_rotation3

state int blaster_handle
state bool blaster_loop
state int reflect_release_timer
state int reflect_turn_timer
state bool reflect_released
state int reflect_gravity_timer
state int reflect_effect

# Follow the current authored travel angle instead of stock move-union storage.
# The recipe supplies the model and attachment; this update owns its rotation.
model_effect FireTravel 0x48C:
    on update:
        let half_pi = pi_half
        let angle = half_pi - creator.state.fire_angle
        if creator.facing < 0:
            effect.joint("").rotation.y = -half_pi
            effect.joint("").rotation.z = angle
        else:
            effect.joint("").rotation.y = half_pi
            effect.joint("").rotation.z = -angle

# These effects are armed explicitly at the stock transition points. In
# particular, SideDash and Blaster startup do not install an accessory callback.
# Ordinary helpers can also be rebound after ground/air or loop transitions.
func fire_accessory():
    if not effects.active:
        if motion.id == 353 or motion.id == 354:
            effects.spawn_on_part(1163, bones.index(TransN))
        else:
            effects.spawn_on_part(FireTravel, bones.index(Hip))
        effects.active = true
    effects.pause_during_hitlag()
    callbacks.accessory(None)

func side_accessory():
    if not effects.active:
        effects.spawn_on_joint_with_scalar(1165, 0, facing.direction)
        effects.active = true
    effects.pause_during_hitlag()
    callbacks.accessory(None)

func reflect_accessory():
    if not effects.active:
        effects.spawn_on_part(state.reflect_effect, 5)
        effects.active = true
    effects.pause_during_hitlag()
    callbacks.accessory(None)

func reflect_bubble():
    reflector.create(attrs.reflect_bone, attrs.reflect_max_damage, attrs.reflect_offset_x, attrs.reflect_offset_y, attrs.reflect_offset_z, attrs.reflect_radius, attrs.reflect_damage_mul, attrs.reflect_speed_mul, attrs.reflect_keep_owner)
    callbacks.track_reflect_hit()

func reflect_hold():
    if not input.special_held: state.reflect_released = true
    if state.reflect_release_timer > 0: state.reflect_release_timer = state.reflect_release_timer - 1

func reflect_setup():
    state.reflect_release_timer = int(attrs.reflect_release_lag)
    state.reflect_released = false
    command(1) = 4
    state.reflect_gravity_timer = attrs.reflect_gravity_delay
    state.reflect_effect = 1161
    callbacks.accessory(reflect_accessory)

func reflect_end():
    if airborne: state.enter_at_speed(368, 0, 0, 1)
    else: state.enter_at_speed(363, 0, 0, 1)

func reflect_loop():
    if airborne: state.enter_at_speed(366, 2, 0, 1)
    else: state.enter_at_speed(361, 2, 0, 1)
    reflect_bubble()

func reflect_resume():
    if state.reflect_release_timer <= 0 and state.reflect_released: reflect_end()
    else: reflect_loop()

func reflect_turn_tick():
    state.reflect_turn_timer = state.reflect_turn_timer - 1
    if not command(0) and state.reflect_turn_timer <= attrs.reflect_turn_frames:
        command(0) = 1
        facing.direction = -facing.direction
    # Stock reads and writes rotation Y; its getter previously had a misleading Z name.
    bones.root.rotate_y(-(radians(180 / attrs.reflect_turn_frames) - bones.root.rotation_y))

func reflect_air_physics():
    if state.reflect_gravity_timer != 0: state.reflect_gravity_timer = state.reflect_gravity_timer - 1
    else: physics.fall(attrs.reflect_fall_accel, air.terminal_velocity)
    physics.quick_air_decel()

func side_seed_trail():
    state.trail_x0 = position.x
    state.trail_x1 = position.x
    state.trail_x2 = position.x
    state.trail_x3 = position.x
    state.trail_y0 = position.y
    state.trail_y1 = position.y
    state.trail_y2 = position.y
    state.trail_y3 = position.y
    state.trail_z0 = position.z
    state.trail_z1 = position.z
    state.trail_z2 = position.z
    state.trail_z3 = position.z
    state.trail_rotation0 = bones.root.rotation_x
    state.trail_rotation1 = bones.root.rotation_x
    state.trail_rotation2 = bones.root.rotation_x
    state.trail_rotation3 = bones.root.rotation_x
    callbacks.accessory(side_accessory)

func side_shift_trail():
    state.trail_x3 = state.trail_x2
    state.trail_x2 = state.trail_x1
    state.trail_x1 = state.trail_x0
    state.trail_x0 = position.x
    state.trail_y3 = state.trail_y2
    state.trail_y2 = state.trail_y1
    state.trail_y1 = state.trail_y0
    state.trail_y0 = position.y
    state.trail_z3 = state.trail_z2
    state.trail_z2 = state.trail_z1
    state.trail_z1 = state.trail_z0
    state.trail_z0 = position.z
    state.trail_rotation3 = state.trail_rotation2
    state.trail_rotation2 = state.trail_rotation1
    state.trail_rotation1 = state.trail_rotation0
    state.trail_rotation0 = bones.root.rotation_x

func side_dash():
    if airborne: state.enter_at_speed(351, 0x800, 0, 1)
    else: state.enter_at_speed(348, 0x800, 0, 1)
    side_seed_trail()

func side_end():
    if airborne:
        velocity.x = attrs.side_end_air_velocity * facing.direction
        velocity.y = 0
        state.enter_at_speed(352, 0x800, 0, 1)
    else:
        ground.velocity = attrs.side_end_ground_velocity * facing.direction
        state.enter_at_speed(349, 0x800, 0, 1)
    state.side_gravity_timer = int(attrs.side_end_gravity_delay)
    damage.song_immune = true

func side_create_trail():
    if command(2) == 1:
        command(2) = 0
        let initial_state = 0
        if airborne: initial_state = 1
        # Creation value carries the authored ground/air entry choice.
        state.side_article_handle = articles.create_at_position(It_Kind_Fox_Illusion, position.x, position.y, position.z, facing.direction, false, 0, float(initial_state))
        if state.side_article_handle != -1: damage.song_immune = true

# Own command reset and accessory scheduling; the trail starts at dash, not startup.
func fire_rotate():
    # Stock uses a binary32 full turn, then subtracts the launch angle.
    bones.rotate_x(XRotN, float(6.2831854820251465) - state.fire_angle)

func fire_air_launch():
    if abs(input.x) + abs(input.y) >= attrs.fire_direction_threshold:
        if abs(input.x) > attrs.fire_facing_threshold: facing.from_input()
        state.fire_angle = atan2_float(input.y, input.x * facing.direction)
    else: state.fire_angle = float(1.5707963705062866)
    state.enter_flags(356, 0)
    items.block_ground_pickup = true
    state.fire_travel_remaining = int(attrs.fire_travel_frames)
    state.fire_travel_age = 0
    state.fire_collision_age = 0
    velocity.x = facing.direction * (attrs.fire_speed * cos(state.fire_angle))
    velocity.y = attrs.fire_speed * sin(state.fire_angle)
    fire_rotate()
    callbacks.align_velocity_to_facing()
    callbacks.accessory(fire_accessory)
    jumps.used = jumps.max

func fire_choose_launch():
    if abs(input.x) + abs(input.y) >= attrs.fire_direction_threshold:
        if not (vectors.angle_xy(floor.normal.x, floor.normal.y, input.x, input.y) < float(1.5707963705062866)) and not collision.skip_soft_floor():
            facing.from_input()
            state.enter_flags(355, 0)
            items.block_ground_pickup = true
            state.fire_travel_remaining = int(attrs.fire_travel_frames)
            state.fire_travel_age = 0
            state.fire_collision_age = 0
            ground.velocity = attrs.fire_speed * facing.direction
            state.fire_angle = atan2_float(-floor.normal.x * facing.direction, floor.normal.y)
            fire_rotate()
            callbacks.accessory(fire_accessory)
            callbacks.align_velocity_to_facing()
            return
    physics.force_air_and_use_jumps()
    fire_air_launch()

func fire_end(int motion):
    effects.clear_all()
    if motion == 357 and airborne: physics.switch_to_ground()
    state.enter_at_speed(motion, 0, 0, 1)
    callbacks.align_velocity_to_facing()

func fire_travel_done():
    state.fire_travel_remaining = state.fire_travel_remaining - 1
    if state.fire_travel_remaining > 0: return
    if airborne: fire_end(358)
    else: fire_end(357)

func fire_realign():
    if velocity.x >= 0: facing.direction = 1
    else: facing.direction = -1
    state.fire_angle = atan2_float(velocity.y, velocity.x * facing.direction)
    fire_rotate()

func fire_bound():
    state.enter_flags(359, 0)
    animation.start()
    callbacks.align_velocity_to_facing()
    velocity.x = velocity.x * attrs.fire_bound_velocity_multiplier
    command(0) = 0
    let rotation = 0.0
    if collision.floor_contact: rotation = -atan2_float(floor.normal.x, floor.normal.y)
    effects.spawn_with_scalar_at_position(1030, position.x, position.y, position.z, rotation)
    effects.active = true
    effects.pause_during_hitlag()

# Stock ftCo_CpuFireBlaster actually presses down-B (Reflector).
func cpu_reflect_response():
    let int delay = attrs.cpu_reflect_level_ceiling - cpu.level
    cpu.queue(Cpu.stick_x, 0)
    cpu.queue(Cpu.stick_y, attrs.cpu_reflect_stick_y)
    cpu.queue(Cpu.press_b)
    cpu.queue(Cpu.wait, attrs.cpu_reflect_press_frames)
    cpu.queue(Cpu.stick_y, 0)
    if delay != 0:
        let int random_delay = int(attrs.cpu_reflect_random_span * random.float()) + attrs.cpu_reflect_delay_base
        cpu.queue(Cpu.wait, delay * random_delay)
    cpu.queue(Cpu.done)

func cpu_retap_guard():
    cpu.queue(Cpu.release_r)
    cpu.queue(Cpu.wait, attrs.cpu_retap_frames)
    cpu.queue(Cpu.press_r)
    cpu.queue(Cpu.wait, attrs.cpu_retap_frames)
    cpu.queue(Cpu.release_r)
    cpu.queue(Cpu.done)

move FireDash:
    entry explicit
    on special_hi:
        state.fire_gravity_timer = int(attrs.fire_gravity_delay)
        ground.velocity = ground.velocity / attrs.fire_velocity_divisor
        state.enter_flags(353, 0)
        animation.start()
        callbacks.accessory(fire_accessory)
    on special_air_hi:
        state.fire_gravity_timer = int(attrs.fire_gravity_delay)
        velocity.x = velocity.x / attrs.fire_velocity_divisor
        velocity.y = 0
        state.enter_flags(354, 0)
        animation.start()
        callbacks.accessory(fire_accessory)
    on ground_animation:
        if animation.finished:
            if airborne: fire_air_launch()
            else: fire_choose_launch()
    on air_animation:
        if animation.finished:
            if airborne: fire_air_launch()
            else: fire_choose_launch()
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        if state.fire_gravity_timer != 0: state.fire_gravity_timer = state.fire_gravity_timer - 1
        else: physics.fall(attrs.fire_start_gravity, air.terminal_velocity)
        physics.air_decel(attrs.fire_air_deceleration)
    on ground_collision:
        if collision.left_ground:
            physics.force_air_and_use_jumps()
            state.enter_at_speed(354, 0x0C4C5082, frame, 1)
            callbacks.accessory(fire_accessory)
    on air_collision:
        if collision.check_ground_ledge(1 - 2 * int(facing.direction < 0)):
            state.switch_to_ground(353, 0x0C4C5082)
            callbacks.accessory(fire_accessory)
            physics.clamp_air_drift()
            return
        collision.cliff_catch()

move SideDash:
    entry explicit
    on special_s:
        command(2) = 0
        state.side_gravity_timer = int(attrs.side_start_gravity_delay)
        state.side_article_handle = -1
        ground.velocity = ground.velocity / attrs.side_start_velocity_divisor
        state.enter_flags(347, 0)
        animation.start()
    on special_air_s:
        command(2) = 0
        state.side_gravity_timer = int(attrs.side_start_gravity_delay)
        state.side_article_handle = -1
        velocity.y = 0
        velocity.x = velocity.x / attrs.side_start_velocity_divisor
        state.enter_flags(350, 0)
        animation.start()
        jumps.used = jumps.max
    on ground_animation:
        if animation.finished: side_dash()
    on air_animation:
        if animation.finished: side_dash()
    on ground_interrupt:
        pass
    on air_interrupt:
        pass
    on ground_physics:
        if state.side_gravity_timer != 0: state.side_gravity_timer = state.side_gravity_timer - 1
        physics.ground_friction()
    on air_physics:
        if state.side_gravity_timer != 0: state.side_gravity_timer = state.side_gravity_timer - 1
        else: physics.fall(attrs.side_start_gravity, air.terminal_velocity)
        physics.air_decel(attrs.side_start_air_deceleration)
    on ground_collision:
        if collision.left_ground: state.switch_to_air(350, 0x0C4C5880)
    on air_collision:
        if collision.check_ground_ledge(1 - 2 * int(facing.direction < 0)):
            state.switch_to_ground(347, 0x0C4C5880)
            return
        collision.cliff_catch()

move Reflector:
    on special_lw:
        state.enter(DownSpecial)
        reflect_setup()
    on special_air_lw:
        velocity.y = 0
        velocity.x = velocity.x / attrs.reflect_air_preserve
        state.enter(DownSpecial)
        reflect_setup()
    on ground_animation:
        if not input.special_held: state.reflect_released = true
        if animation.finished:
            reflect_loop()
            effects.clear_all()
            state.reflect_effect = 1160
            callbacks.accessory(reflect_accessory)
    on air_animation:
        if not input.special_held: state.reflect_released = true
        if animation.finished:
            reflect_loop()
            effects.clear_all()
            state.reflect_effect = 1160
            callbacks.accessory(reflect_accessory)
    on ground_interrupt:
        if controls.platform_drop_requested():
            state.platform_drop(365, 0x0C4C5082, frame)
            reflect_bubble()
    on air_interrupt:
        pass
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        reflect_air_physics()
    on ground_collision:
        if collision.special_ground_lost: state.switch_to_air(365, 0x0C4C5082)
    on air_collision:
        if collision.landed:
            state.switch_to_ground(360, 0x0C4C5082)
            physics.clamp_air_drift()

move Blaster:
    on special_n:
        physics.switch_to_ground()
        state.enter_flags(341, 0)
        blaster_init()
        ground.velocity = 0
        velocity.z = 0
        velocity.y = 0
        velocity.x = 0
        blaster_spawn()
        articles.signal_owned(state.blaster_handle, It_Kind_Fox_Blaster, "scale", 0.85)
    on special_air_n:
        state.enter_flags(344, 0)
        blaster_init()
        blaster_spawn()
        articles.signal_owned(state.blaster_handle, It_Kind_Fox_Blaster, "scale", 0.85)
    on ground_animation:
        blaster_start()
    on air_animation:
        blaster_start()
    on ground_interrupt:
        blaster_input()
    on air_interrupt:
        blaster_input()
    on ground_physics:
        physics.ground_friction()
    on air_physics:
        physics.air_drift()
    on ground_collision:
        collision.ground_standard()
    on air_collision:
        collision.air_catch_hit()


action FireDashTravel:
    on state_355_animation:
        fire_travel_done()
    on state_356_animation:
        fire_travel_done()
    on state_355_interrupt:
        pass
    on state_356_interrupt:
        pass
    on state_355_physics:
        state.fire_travel_age = state.fire_travel_age + 1
        if state.fire_travel_age >= attrs.fire_deceleration_start: physics.ground_decelerate(attrs.fire_travel_deceleration)
        physics.ground_to_self()
    on state_356_physics:
        state.fire_travel_age = state.fire_travel_age + 1
        if state.fire_travel_age >= attrs.fire_deceleration_start:
            velocity.x = -((facing.direction * (attrs.fire_travel_deceleration * cos(state.fire_angle))) - velocity.x)
            velocity.y = -((attrs.fire_travel_deceleration * sin(state.fire_angle)) - velocity.y)
    on state_355_collision:
        state.fire_collision_age = state.fire_collision_age + 1
        if collision.left_ground:
            physics.force_air_and_use_jumps()
            state.enter_at_speed(356, 0x0C4C508A, frame, 1)
            items.block_ground_pickup = true
            callbacks.accessory(fire_accessory)
            return
        if collision.floor_contact:
            state.fire_angle = atan2_float(-floor.normal.x * facing.direction, floor.normal.y)
            fire_rotate()
    on state_356_collision:
        let bound_limit = float(0.01745329238474369) * (float(90) + attrs.fire_bound_angle)
        if collision.check_ground_ledge(0):
            let can_bound = true
            if state.fire_collision_age < attrs.fire_platform_grace_frames: can_bound = not collision.skip_soft_floor()
            if can_bound:
                if not collision.floor_contact or not (vectors.angle_xy(floor.normal.x, floor.normal.y, velocity.x, velocity.y) < bound_limit):
                    fire_bound()
                    return
                fire_realign()
                return
        if collision.cliff_catch(): return
        let impact_angle = 0.0
        if collision.ceiling_contact: impact_angle = vectors.angle_xy(ceiling.normal.x, ceiling.normal.y, velocity.x, velocity.y)
        elif collision.left_wall: impact_angle = vectors.angle_xy(wall.left.normal.x, wall.left.normal.y, velocity.x, velocity.y)
        elif collision.right_wall: impact_angle = vectors.angle_xy(wall.right.normal.x, wall.right.normal.y, velocity.x, velocity.y)
        else: return
        if impact_angle < bound_limit: fire_realign()

action FireDashRecovery:
    on state_357_animation:
        if animation.finished: state.wait()
    on state_358_animation:
        if animation.finished: state.freefall(1, 0, true, attrs.fire_freefall_mobility, attrs.fire_landing_lag)
    on state_357_interrupt:
        pass
    on state_358_interrupt:
        pass
    on state_357_physics:
        physics.ground_decelerate(attrs.fire_end_ground_deceleration)
        physics.ground_to_self()
    on state_358_physics:
        physics.air_drift()
    on state_357_collision:
        if collision.left_ground: state.freefall(1, 0, true, attrs.fire_freefall_mobility, attrs.fire_landing_lag)
    on state_358_collision:
        if collision.check_ground_ledge(0):
            physics.switch_to_ground()
            state.enter_at_speed(357, 0x5000, 13, 1)
            animation.start()
            return
        collision.cliff_catch()

action FireDashRebound:
    on state_359_animation:
        if command(0) != 0 and airborne:
            state.freefall(1, 0, true, attrs.fire_freefall_mobility, attrs.fire_landing_lag)
            jumps.used = jumps.max
            return
        if animation.finished:
            if airborne:
                state.freefall(1, 0, true, attrs.fire_freefall_mobility, attrs.fire_landing_lag)
                jumps.used = jumps.max
            else: state.wait()
    on state_359_interrupt:
        pass
    on state_359_physics:
        if airborne:
            physics.animation_vertical_velocity()
            physics.quick_air_decel()
        else: physics.ground_friction()
    on state_359_collision:
        if airborne:
            if collision.check_ground_ledge(1 - 2 * int(facing.direction < 0)):
                physics.switch_to_ground()
                return
            collision.cliff_catch()
        else: collision.ground_standard()

action SideDashTravel:
    on state_348_animation:
        if animation.finished: side_end()
        side_create_trail()
    on state_351_animation:
        if animation.finished: side_end()
        side_create_trail()
    on state_348_interrupt:
        if input.special_pressed: side_end()
    on state_351_interrupt:
        if input.special_pressed: side_end()
    on state_348_physics:
        physics.ground_animation_velocity()
        side_shift_trail()
    on state_351_physics:
        physics.animation_velocity_plain()
        side_shift_trail()
    on state_348_collision:
        if collision.left_ground:
            state.switch_to_air(351, 0x0C4C5884)
            command(2) = 0
    on state_351_collision:
        if collision.check_ground_ledge(1 - 2 * int(facing.direction < 0)):
            state.switch_to_ground(348, 0x0C4C5884)
            command(2) = 0
            return
        collision.cliff_catch()

action SideDashEnd:
    on state_349_animation:
        if animation.finished: state.wait()
    on state_352_animation:
        if animation.finished: state.freefall(1, 0, true, attrs.side_freefall_mobility, attrs.side_landing_lag)
    on state_349_interrupt:
        pass
    on state_352_interrupt:
        pass
    on state_349_physics:
        if state.side_gravity_timer != 0: state.side_gravity_timer = state.side_gravity_timer - 1
        physics.ground_decelerate(attrs.side_end_ground_friction)
        physics.ground_to_self()
        side_shift_trail()
    on state_352_physics:
        if state.side_gravity_timer != 0: state.side_gravity_timer = state.side_gravity_timer - 1
        else: physics.fall(attrs.side_end_gravity, air.terminal_velocity)
        physics.air_decel(attrs.side_end_air_deceleration)
        side_shift_trail()
    on state_349_collision:
        if collision.special_ground_lost: state.fall()
    on state_352_collision:
        if collision.check_ground_ledge(1 - 2 * int(facing.direction < 0)):
            state.landing_special(false, attrs.side_landing_lag)
            return
        collision.cliff_catch()

action ReflectLoop:
    on state_361_animation:
        reflect_hold()
        if state.reflect_release_timer <= 0 and state.reflect_released: reflect_end()
    on state_361_interrupt:
        if controls.turn_requested():
            if airborne: state.enter_at_speed(369, 2, 0, 1)
            else: state.enter_at_speed(364, 2, 0, 1)
            reflector.retain()
            callbacks.track_reflect_hit()
            state.reflect_turn_timer = int(attrs.reflect_turn_frames)
            command(0) = 0
            reflect_turn_tick()
            state.reflect_effect = 1160
            callbacks.accessory(reflect_accessory)
            return

        if controls.try_ground_jump(): return
        if controls.platform_drop_requested():
            state.platform_drop(366, 0x0C4C5082, frame)
            reflect_bubble()
    on state_361_physics:
        physics.ground_friction()
        reflector.update()
    on state_361_collision:
        if collision.special_ground_lost:
            state.switch_to_air(366, 0x0C4C5082)
            reflect_bubble()
    on state_366_animation:
        reflect_hold()
        if state.reflect_release_timer <= 0 and state.reflect_released: reflect_end()
    on state_366_interrupt:
        if controls.turn_requested():
            if airborne: state.enter_at_speed(369, 2, 0, 1)
            else: state.enter_at_speed(364, 2, 0, 1)
            reflector.retain()
            callbacks.track_reflect_hit()
            state.reflect_turn_timer = int(attrs.reflect_turn_frames)
            command(0) = 0
            reflect_turn_tick()
            state.reflect_effect = 1160
            callbacks.accessory(reflect_accessory)
            return

        let jumped = controls.try_aerial_jump()
    on state_366_physics:
        reflect_air_physics()
        reflector.update()
    on state_366_collision:
        if collision.landed:
            state.switch_to_ground(361, 0x0C4C5082)
            physics.clamp_air_drift()
            reflect_bubble()

action ReflectHit:
    on state_362_animation:
        reflect_hold()
        if animation.finished:
            if state.reflect_release_timer <= 0 and state.reflect_released: reflect_end()
            else:
                reflect_loop()
                effects.clear_all()
                state.reflect_effect = 1160
                callbacks.accessory(reflect_accessory)
    on state_362_interrupt:
        pass
    on state_362_physics:
        physics.ground_friction()
        reflector.update()
    on state_362_collision:
        if collision.special_ground_lost:
            state.switch_to_air(367, 0x0C4C5082)
