move Absorb:
    on absorb:
        state.panic_charge = state.panic_charge + absorber.hits
        # Both source fields are s32; preserve their integer sum.
        state.panic_damage = state.panic_damage + absorber.damage
        if state.panic_charge >= attrs.panic_full: color.start(5, false)
        let int motion = attrs.panic_catch_ground
        if airborne: motion = attrs.panic_catch_air
        state.enter_at_speed(motion, 0, 0, 1)
        BucketModels()
# Prop callbacks use authored state/history, with PaperArticles presentation
# deliberately excluded. Rescue's original post-remove userdata reread is not
# reproduced; synchronous removal is terminal and generation-guarded.

move Lifecycle:
    on load_special_attrs:
        fighter.reload_ext_attributes()
    on load:
        fighter.copy_ext_attributes()
        visuals.preserve_secondary_material = true
        model.instance_scale_z = attrs.model_width
        visuals.outline_color = PaperOutlineColor()
        visuals.set_diffuse_color(PaperBodyColor())
        visuals.install_outline_visibility(10)
        state.panic_charge = 0
        # Source NULL is represented by -1, not zero, for full-width handles.
        # This initialization is for a new fighter, not live resource reload.
        ClearPropHandles()
    on death:
        visuals.set_group(0, 0)
        visuals.set_group(1, -1)
        visuals.set_group(2, 0)
        visuals.set_group(3, 0)
        visuals.set_group(4, -1)
        visuals.set_group(5, -1)
        visuals.set_group(6, -1)
        visuals.set_group(7, -1)
        visuals.set_group(8, -1)
        visuals.set_group(9, -1)
        visuals.set_group(10, -1)
        OwnedReset()
    on damage:
        PropDamage()
    on color_animation_reset:
        if state.panic_charge >= attrs.panic_full: color.start(5, false)
    on item_pickup:
        fighter.item_pickup(event.flag, 1, 1)
    on item_drop:
        fighter.item_drop(event.flag, 1, 1)
    on item_invisible:
        fighter.item_invisible(1)
    on item_visible:
        fighter.item_visible(1)

article It_Kind_GameWatch_Chef states 2:
    attribute float food_wall_bounce 4
    attribute float food_active_lifetime 8
    attribute float food_inactive_lifetime 12
    attribute float food_0_horizontal 16
    attribute float food_0_vertical 20
    attribute float food_0_gravity 24
    attribute float food_0_terminal 28
    attribute float food_0_angular 32
    attribute float food_1_horizontal 36
    attribute float food_1_vertical 40
    attribute float food_1_gravity 44
    attribute float food_1_terminal 48
    attribute float food_1_angular 52
    attribute float food_2_horizontal 56
    attribute float food_2_vertical 60
    attribute float food_2_gravity 64
    attribute float food_2_terminal 68
    attribute float food_2_angular 72
    attribute float food_3_horizontal 76
    attribute float food_3_vertical 80
    attribute float food_3_gravity 84
    attribute float food_3_terminal 88
    attribute float food_3_angular 92
    attribute float food_4_horizontal 96
    attribute float food_4_vertical 100
    attribute float food_4_gravity 104
    attribute float food_4_terminal 108
    attribute float food_4_angular 112
    state int variant
    # Retain the accepted ordinary variant field and all lifecycle helpers.
    # Typed helpers execute against the retained creator and its own parameters.
    func ApplyPaperPalette():
        item.layered = true
        if not item.layered: return
        # Defined stock constructor domain requires a valid parent fighter.
        # A retired/rebound creator skips its palette; no unsafe private reads.
        if not creator.exists: return
        item.set_diffuse_color(creator.helpers.PaperBodyColor())
        item.outline_color = creator.helpers.PaperOutlineColor()
        # Source ftLib_800870BC leaves the color unchanged when no tint exists.
        if targets.controller_color_present(item.current_owner):
            item.controller_tint = targets.controller_color(item.current_owner)
            item.controller_tint_enabled = true
        else:
            item.controller_tint_enabled = false
        item.inherit_owner_scale()
    on created:
            # No pickup/held registration; previous Z=0/current ECB center is
            # supplied by create_with_velocity(..., origin_at_owner=true, ...).
            item.state.variant = int(item.creation_value)
            item.set_lifetime(item.attr.food_active_lifetime)
            item.disable_surface_response()
            # Defined source variants are 0..4. Do not execute native invalid indexing.
            velocity.x = item.attr.food_4_horizontal * facing
            velocity.y = item.attr.food_4_vertical
            if item.state.variant == 0:
                velocity.x = item.attr.food_0_horizontal * facing
                velocity.y = item.attr.food_0_vertical
            if item.state.variant == 1:
                velocity.x = item.attr.food_1_horizontal * facing
                velocity.y = item.attr.food_1_vertical
            if item.state.variant == 2:
                velocity.x = item.attr.food_2_horizontal * facing
                velocity.y = item.attr.food_2_vertical
            if item.state.variant == 3:
                velocity.x = item.attr.food_3_horizontal * facing
                velocity.y = item.attr.food_3_vertical
            item.use_manual_lifetime()
            item.change_state_flags(0, 2)
            item.inherit_owner_debug_display()
            ApplyPaperPalette()

    func Expire():
        velocity.y = 0
        velocity.x = 0
        item.set_lifetime(item.attr.food_inactive_lifetime)
        item.change_state_flags(1, 2)
    func Collide():
        if velocity.x != 0:
            let int flags = item.sweep_stage_flags()
            if flags & 12:
                velocity.x = velocity.x * -item.attr.food_wall_bounce
            if flags & 3:
                Expire()
    state 0 anim 0:
        on animation:
            let float angular = item.attr.food_4_angular
            if item.state.variant == 0:
                angular = item.attr.food_0_angular
            if item.state.variant == 1:
                angular = item.attr.food_1_angular
            if item.state.variant == 2:
                angular = item.attr.food_2_angular
            if item.state.variant == 3:
                angular = item.attr.food_3_angular
            item.joint("").rotation.x = item.joint("").rotation.x + angular
            item.life = item.life - 1
            if item.life <= 0:
                item.life = 0
                Expire()
            return false
        on physics:
            let float gravity = item.attr.food_4_gravity
            let float terminal = item.attr.food_4_terminal
            if item.state.variant == 0:
                gravity = item.attr.food_0_gravity
                terminal = item.attr.food_0_terminal
            if item.state.variant == 1:
                gravity = item.attr.food_1_gravity
                terminal = item.attr.food_1_terminal
            if item.state.variant == 2:
                gravity = item.attr.food_2_gravity
                terminal = item.attr.food_2_terminal
            if item.state.variant == 3:
                gravity = item.attr.food_3_gravity
                terminal = item.attr.food_3_terminal
            # Same sign/threshold decision as generic it_80272860. The current
            # item.gravity(false) DSL only supplies item defaults, not variant
            # tuning; keep this small scalar formula authored.
            let int gravity_sign = 1
            if gravity < 0:
                gravity_sign = -1
            let int velocity_sign = 1
            if velocity.y < 0:
                velocity_sign = -1
            if velocity_sign != gravity_sign:
                if abs(velocity.y) < terminal:
                    velocity.y = velocity.y - gravity
            else:
                velocity.y = velocity.y - gravity
        on collision:
            Collide()
            return false
    state 1 anim 1:
        on animation:
            item.life = item.life - 1
            if item.life <= 0:
                item.life = 0
                return true
            item.joint("").visible = (int(item.life) & 2) != 0
            return false
        on physics:
            pass
        on collision:
            Collide()
            return false
    on damage_dealt:
            Expire()
            return false
    on clanked:
            Expire()
            return false
    on hit_shield:
            Expire()
            return false
    on absorbed:
            Expire()
            item.life = 0
            return false
    on shield_bounced:
            return item.shield_bounce()
    on reflected:
            return item.reflect()
    on interaction:
            item.interact(other)

article It_Kind_GameWatch_Judge states 1:
    # Typed helpers execute against the retained creator and its own parameters.
    func ApplyPaperPalette():
        item.layered = true
        if not item.layered: return
        # Defined stock constructor domain requires a valid parent fighter.
        # A retired/rebound creator skips its palette; no unsafe private reads.
        if not creator.exists: return
        item.set_diffuse_color(creator.helpers.PaperBodyColor())
        item.outline_color = creator.helpers.PaperOutlineColor()
        # Source ftLib_800870BC leaves the color unchanged when no tint exists.
        if targets.controller_color_present(item.current_owner):
            item.controller_tint = targets.controller_color(item.current_owner)
            item.controller_tint_enabled = true
        else:
            item.controller_tint_enabled = false
        item.inherit_owner_scale()
    on created:
            item.attach_to_owner(program.attrs.judge_attachment_part, false)
            # Original legal Judge variants are 0..8; appearance requests 1..9.
            item.set_appearance(0, float(int(item.creation_value) + 1))
            if owner.motion >= 0:
                if owner.facing == 1:
                    item.joint("0/0").rotation.y = 3.141592653589793
                else:
                    item.joint("0/0").rotation.y = 0
            item.inherit_owner_debug_display()
            ApplyPaperPalette()

    on picked_up:
            item.command1 = 0
            item.command0 = 0
            if owner.motion >= 0:
                item.change_state_flags(0, 2)
    on destroyed:
            if owner.exists: owner.helpers.JudgeClear()
    on signal Pause:
            item.pause()
    on signal Resume:
            item.resume()
    state 0 anim 0:
        on animation:
            if owner.motion >= 0:
                if owner.facing == 1:
                    item.joint("0/0").rotation.y = 3.141592653589793
                else:
                    item.joint("0/0").rotation.y = 0
            if owner.motion < program.attrs.judge_ground or owner.motion > program.attrs.judge_air + 8:
                if owner.exists: owner.helpers.JudgeClear()
                return true
            return false
    on interaction:
            item.interact(other)

