# Full Game & Watch composition; unregistered pending closure gate.
# Import recipes derive from actual stock fields; literals name source constants.
fighter:
    behavior independent

visibility_asset 10
motion_policy 341 common 44
motion_policy 343 common 48
motion_policy 347 common 65
motion_policy 348 common 67
motion_policy 349 common 68

parameter int chef_ground_motion = 353
parameter int chef_air_motion = 354
parameter int chef_spawn_joint = 17
