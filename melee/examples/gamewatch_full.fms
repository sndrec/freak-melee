                    item.change_state_flags(1, 2)
                else:
                    item.change_state_flags(0, 2)
                item.advance_animation()
    on destroyed:
            if owner.exists: owner.helpers.PanicClear()
    on signal Pause:
            item.pause()
    on signal Resume:
            item.resume()
    state 0 anim 0:
        on animation:
            if owner.motion < program.attrs.panic_shoot_ground or owner.motion > program.attrs.panic_shoot_air:
                if owner.exists: owner.helpers.PanicClear()
                return true
            return false
    state 1 anim 1 use 0:
    on interaction:
            item.interact(other)

article It_Kind_GameWatch_Rescue states 2:
    # Typed helpers execute against the retained creator and its own parameters.
    func ApplyPaperPalette():
        item.layered = true
        if not item.layered: return
        # Defined stock constructor domain requires a valid parent fighter.
        # A retired/rebound creator skips its palette; no unsafe private reads.
        if not creator.exists: return
        item.set_diffuse_color(creator.helpers.PaperBodyColor())
        item.outline_color = creator.helpers.PaperOutlineColor()
        # Source ftLib_800870BC leaves the color unchanged when no tint exists.
        if targets.controller_color_present(item.current_owner):
            item.controller_tint = targets.controller_color(item.current_owner)
            item.controller_tint_enabled = true
        else:
            item.controller_tint_enabled = false
        item.inherit_owner_scale()
    on created:
            # Caller supplies flattened position, origin_at_owner=false,
            # collision_group=0, creation_value=0/1, initial_collision=false.
            # Generic constructor already retains the immutable creator generation.
            item.command3 = 0
            item.command2 = 0
            item.command1 = 0
            item.command0 = 0
            item.remove_at_bounds = false
            ApplyPaperPalette()
            item.change_state_flags(int(item.creation_value), 2)
            item.advance_animation()

    on signal Remove:
            if attachment_owner.exists and item.attachment_active:
                attachment_owner.helpers.RescueClear()
            item.detach_owner()
            item.remove()
    on signal Pause:
            item.pause()
    on signal Resume:
            item.resume()
    state 0 anim 0:
        on animation:
            if not attachment_owner.exists or (attachment_owner.motion != program.attrs.rescue_ground and attachment_owner.motion != program.attrs.rescue_air):
                if attachment_owner.exists and item.attachment_active:
                    attachment_owner.helpers.RescueClear()
                item.detach_owner()
                item.remove()
            return false
        on physics:
            pass
        on collision:
            return false
    state 1 anim 0 use 0:
    on interaction:
            item.interact(other)
