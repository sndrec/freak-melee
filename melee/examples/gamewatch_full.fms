        item.layered = true
        if not item.layered: return
        # Defined stock constructor domain requires a valid parent fighter.
        # A retired/rebound creator skips its palette; no unsafe private reads.
        if not creator.exists: return
        item.set_diffuse_color(creator.helpers.PaperBodyColor())
        item.outline_color = creator.helpers.PaperOutlineColor()
        # Source ftLib_800870BC leaves the color unchanged when no tint exists.
        if targets.controller_color_present(item.current_owner):
            item.controller_tint = targets.controller_color(item.current_owner)
            item.controller_tint_enabled = true
        else:
            item.controller_tint_enabled = false
        item.inherit_owner_scale()
    on created:
            item.attach_to_owner(program.attrs.normal_handnb_part, false)
            item.inherit_owner_debug_display()
            ApplyPaperPalette()

    on picked_up:
            item.command1 = 0
            item.command0 = 0
            item.joint("").visible = false
            if targets.is_fighter(item.current_owner):
                item.change_state_flags(0, 2)
                item.advance_animation()
    on destroyed:
            if owner.exists: owner.helpers.TorchClear()
    on signal Pause:
            item.pause()
    on signal Resume:
            item.resume()
    state 0 anim 0:
        on animation:
            if item.animation_frame == program.attrs.torch_visible_frame: item.joint("").visible = true
            if targets.motion(item.current_owner) != program.attrs.forward_smash_motion:
                if owner.exists: owner.helpers.TorchClear()
                return true
            if targets.is_fighter(item.current_owner):
                if targets.smash_charge_active(item.current_owner):
                    if item.animation_rate != 0:
                        item.animation_rate = 0
                        item.set_model_animation_rate(item.animation_rate)
                else:
                    if item.animation_rate != 1:
                        item.animation_rate = 1
                        item.set_model_animation_rate(item.animation_rate)
            return false
    on interaction:
            item.interact(other)
article It_Kind_GameWatch_Parachute states 2:
    # Typed helpers execute against the retained creator and its own parameters.
    func ApplyPaperPalette():
        item.layered = true
        if not item.layered: return
        # Defined stock constructor domain requires a valid parent fighter.
        # A retired/rebound creator skips its palette; no unsafe private reads.
        if not creator.exists: return
        item.set_diffuse_color(creator.helpers.PaperBodyColor())
        item.outline_color = creator.helpers.PaperOutlineColor()
        # Source ftLib_800870BC leaves the color unchanged when no tint exists.
        if targets.controller_color_present(item.current_owner):
            item.controller_tint = targets.controller_color(item.current_owner)
            item.controller_tint_enabled = true
        else:
            item.controller_tint_enabled = false
        item.inherit_owner_scale()
    on created:
            item.attach_to_owner(program.attrs.normal_trans_part, false)
            item.inherit_owner_debug_display()
            ApplyPaperPalette()

    on picked_up:
            item.command0 = 0
            if targets.is_fighter(item.current_owner):
                item.change_state_flags(0, 2)
                item.advance_animation()
    on destroyed:
            if owner.exists: owner.helpers.ParachuteClear()
    on signal Pause:
            item.pause()
    on signal Resume:
            item.resume()
    on signal Land:
            item.joint("").visible = false
            item.change_state_flags(1, 2)
    state 0 anim 0:
        on animation:
            # Source equality is deliberate: overshooting30 is not a timeout.
            if item.animation_frame == program.attrs.parachute_end_frame:
                if owner.exists: owner.helpers.ParachuteClear()
                return true
            if targets.motion(item.current_owner) < program.attrs.neutral_air_motion or targets.motion(item.current_owner) > program.attrs.neutral_landing_motion:
                if owner.exists: owner.helpers.ParachuteClear()
                return true
            return false
    state 1 anim 1 use 0:
    on interaction:
            item.interact(other)
