            item.joint("").visible = false
            if targets.is_fighter(item.current_owner):
                item.change_state_flags(0, 2)
                item.advance_animation()
    on destroyed:
            if owner.exists: owner.helpers.ManholeClear()
    on signal Pause:
            item.pause()
    on signal Resume:
            item.resume()
    state 0 anim 0:
        on animation:
            if item.command0 != 0:
                item.command0 = 0
                item.joint("").visible = true
                # Actual first child world position, using the prepared primary graph.
                let float x = 0
                let float y = 0
                let float z = 0
                item.joint_world_position(0, "0", x, y, z)
                effects.wind_at_position(x, y, z, program.attrs.manhole_wind_frames, program.attrs.manhole_wind_strength, program.attrs.manhole_wind_decay, program.attrs.manhole_wind_frequency)
            if targets.motion(item.current_owner) != program.attrs.down_tilt_motion:
                if owner.exists: owner.helpers.ManholeClear()
                return true
            return false
    on interaction:
            item.interact(other)
article It_Kind_GameWatch_Fire states 1:
    # Typed helpers execute against the retained creator and its own parameters.
