parameter float chef_spawn_offset_y = 6.5
parameter float chef_spawn_offset_z = 0.0
parameter int judge_ground = 355
parameter int judge_air = 364
parameter int rescue_ground = 373
parameter int rescue_air = 374
parameter int panic_ground = 375
