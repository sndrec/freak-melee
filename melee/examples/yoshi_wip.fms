parameter float cpu_ranged_margin = 16
parameter float cpu_travel_edge_margin = 10
parameter float cpu_travel_floor_depth = -100
parameter float cpu_threat_height = 5


# Yoshi: four specials, three articles, shield, lifecycle and CPU policies.
# Import stock declarations once to create owned parameters. The copied-base
# owns its bone/article/import metadata; no stock behavior is inherited.
fighter:
    behavior independent

attribute int aerial_turn_frames 0
attribute float aerial_reverse_threshold 4
attribute float aerial_jump_armor 8
attribute float caught_radius 288
attribute float catch_remap_start 292
attribute float catch_remap_end 296
parameter int shield_pose_start_joint = 1
attribute byte catch_frame_0 300
attribute byte catch_frame_1 301
attribute byte catch_frame_2 302
attribute byte catch_frame_3 303
attribute byte catch_frame_4 304
attribute byte catch_frame_5 305
attribute byte catch_frame_6 306
attribute byte catch_frame_7 307
attribute byte catch_frame_8 308
attribute byte catch_frame_9 309
attribute byte catch_frame_10 310
attribute byte catch_frame_11 311
state int aerial_turn_remaining
state float shield_material_end


attribute float egg_stick_scale 236
attribute float egg_angle_range 240
attribute float egg_angle_deadzone 244
attribute float egg_base_angle 248
attribute float egg_base_speed 252
attribute float egg_charge_speed 256
attribute float egg_release_offset_x 260
attribute float egg_release_offset_y 264
attribute float egg_base_spin 268
attribute float egg_charge_spin 272
attribute float pound_dive_speed 276
attribute float star_offset_x 280
attribute float star_offset_y 284
parameter int egg_hand_joint = 31
parameter int star_origin_joint = 1
state int egg_handle
state int egg_charge
state bool egg_released
state float egg_x
state float egg_y
state float egg_z
state float egg_angle
state float star_x
state float star_y
state float star_z

# Egg Roll owns all eight fighter states and needs no separate article.
attribute int roll_duration 72
attribute int roll_cancel_delay 76
attribute int roll_hit_duration_cost 80
attribute float roll_start_ground_speed 84
attribute float roll_start_air_speed 88
attribute float roll_start_vertical_speed 92
attribute float roll_initial_air_rotation 96
attribute float roll_initial_bounce_speed 100
attribute float roll_smash_speed_multiplier 104
attribute float roll_gravity 108
attribute float roll_terminal_velocity 112
attribute float roll_ground_acceleration 116
attribute float roll_ground_deceleration 120
attribute float roll_ground_target_speed 124
attribute float roll_ground_max_speed 128
attribute float roll_hit_air_min_speed 140
attribute float roll_air_max_speed 144
attribute float roll_slope_multiplier 148
attribute float roll_smash_window 152
attribute float roll_turn_stick_threshold 156
attribute float roll_turn_rotation 160
attribute int roll_dust_interval 164
attribute float roll_turn_edge_speed_threshold 168
attribute float roll_wall_horizontal_multiplier 172
attribute float roll_wall_vertical_speed 176
attribute float roll_bounce_vertical_multiplier 180
attribute float roll_bounce_ground_threshold 184
attribute float roll_landing_aim_speed 188
attribute float roll_damage_speed_offset 192
attribute float roll_damage_multiplier 196
attribute float roll_hit_speed_loss 204
attribute float roll_end_horizontal_multiplier 208
attribute float roll_end_vertical_multiplier 212
attribute float roll_travel_rotation_multiplier 216
