# Independent Samus Workshop template.
# Maintained components: tests/native/samus_grapple_constructor/compose.py.
# Fighter decisions, four articles, grapple resources and lifecycle are script-owned.
fighter:
    behavior independent

attribute float spin_ground_speed 56

attribute float spin_drift_acceleration 60

attribute float spin_horizontal_limit 64

attribute float spin_air_vertical_speed 68

attribute float spin_freefall_drift 72

attribute float spin_turn_threshold 76

attribute float spin_landing_lag 80


attribute float shot_max_charge 24

attribute float shot_air_recoil 28

attribute int shot_charge_interval 32

attribute float shot_landing_lag 36
# Saved own-rig joint indices, editable without adding a fighter-specific API.

parameter int shot_hand_joint = 50

parameter int shot_release_joint = 51

state int shot_handle

state int shot_charge

state int shot_charge_timer

state bool shot_air_started

state float shot_x

state float shot_y

state float shot_z


state bool spin_turned

state bool spin_effect


