func Samus_ScaleOwnedAttributes():
    state.scaled_morph_jump_speed = attrs.morph_jump_speed * model.instance_scale_y
    state.scaled_bomb_spawn_y = attrs.bomb_spawn_y * model.instance_scale_y
    state.scaled_bomb_hop_speed = attrs.bomb_hop_speed * model.instance_scale_y
    state.scaled_bomb_air_start_speed = attrs.bomb_air_start_speed * model.instance_scale_y
    state.scaled_morph_ecb_top = attrs.morph_ecb_top * model.instance_scale_y
    state.scaled_morph_ecb_bottom = attrs.morph_ecb_bottom * model.instance_scale_y
    state.scaled_morph_ecb_left_x = attrs.morph_ecb_left_x * model.instance_scale_y
    state.scaled_morph_ecb_left_y = attrs.morph_ecb_left_y * model.instance_scale_y
    state.scaled_morph_ecb_right_x = attrs.morph_ecb_right_x * model.instance_scale_y
    state.scaled_morph_ecb_right_y = attrs.morph_ecb_right_y * model.instance_scale_y


func spin_clear():
    effects.destroy_all()
    state.spin_effect = false


func spin_track_cleanup():
    callbacks.track_damage()
    callbacks.track_death2()


func spin_reset_commands():
    command(3) = 0
    command(2) = 0
    command(1) = 0
    command(0) = 0
    state.spin_turned = false


func spin_end():
    if animation.finished:
        spin_clear()
        physics.force_air_and_use_jumps()
        if attrs.spin_landing_lag == 0: state.fall()
        else: state.freefall(1, 1, false, attrs.spin_freefall_drift, attrs.spin_landing_lag)


func spin_turn():
    if not command(1) and not state.spin_turned:
        if abs(input.x) > attrs.spin_turn_threshold:
            if facing.direction == 1 and input.x < 0 or facing.direction == -1 and input.x > 0:
                command(1) = 1
                state.spin_turned = true
                facing.from_input()
                bones.root.rotate_y(0, pi / 2 * facing.direction)


func spin_collide():
    if not grounded:
        if velocity.y >= 0:
            if collision.landed: return
            return
        if collision.check_ground_ledge(1 - 2 * int(facing.direction < 0)):
            spin_clear()
            state.landing_special(false, attrs.spin_landing_lag)
            return
        if collision.cliff_catch():
            spin_clear()
            state.catch_ledge()
    else: collision.ground_standard()


func shot_callbacks():
    callbacks.track_damage()
    callbacks.track_death2()


export func shot_forget():
    state.shot_handle = -1


func shot_remove():
    if articles.owned(state.shot_handle): articles.remove_owned(state.shot_handle)
    shot_forget()


func shot_create():
    if command(0) == 1 and not articles.owned(state.shot_handle):
        command(0) = 0
        bones.world_position(attrs.shot_hand_joint, state.shot_x, state.shot_y, state.shot_z, 0, 0, 4)
        state.shot_handle = articles.create_at_position(It_Kind_Samus_Charge, state.shot_x, state.shot_y, 0, facing.direction, true)
        if articles.owned(state.shot_handle): shot_callbacks()


func shot_enter(bool air_started):
    let target = 343
    if air_started: target = 347
    state.enter_at_speed(target, 0, 0, 1)
    command(0) = 0
    command(1) = 0
    command(2) = 0
    command(3) = 0
    if not air_started:
        physics.switch_to_ground()
        velocity.y = 0
    shot_callbacks()
    state.shot_air_started = air_started
    state.shot_charge_timer = 0
    animation.start()


func shot_start_animation(bool air):
    shot_create()
    if air: state.shot_air_started = true
    if animation.finished:
        if air: state.enter_at_speed(348, 0, 0, 1)
        elif state.shot_air_started or state.shot_charge == attrs.shot_max_charge: state.enter_at_speed(346, 0, 0, 1)
        else: state.enter_at_speed(344, 0, 0, 1)
        shot_callbacks()


func shot_fire():
    if command(1) == 1 and articles.owned(state.shot_handle):
        command(1) = 2
        bones.world_position(attrs.shot_release_joint, state.shot_x, state.shot_y, state.shot_z)
        let angle = float(0)
        if facing.direction != 1: angle = pi
        articles.signal_owned(state.shot_handle, It_Kind_Samus_Charge, "release", angle)
        if motion.id == 348 or airborne: velocity.x = facing.direction * (attrs.shot_air_recoil * state.shot_charge)
        state.shot_charge = 0
        shot_forget()
        effects.spawn_with_scalar_at_position(1158, state.shot_x, state.shot_y, 0, facing.direction)


func shot_hold_animation():
    if command(2):
        command(2) = 0
        let fraction = float(0)
        if state.shot_charge: fraction = float(state.shot_charge / attrs.shot_max_charge)
        let index = int(5 * fraction)
        let sound_id = 260006
        if index == 1: sound_id = 260009
        elif index == 2: sound_id = 260012
        elif index == 3: sound_id = 260015
        elif index == 4: sound_id = 260018
        sound.loop(sound_id, 127, 64)
    state.shot_charge_timer = state.shot_charge_timer + 1
    if state.shot_charge_timer > attrs.shot_charge_interval:
        state.shot_charge_timer = 0
        state.shot_charge = state.shot_charge + 1
        if state.shot_charge >= attrs.shot_max_charge:
            color.start(53, false)
            state.shot_charge = int(attrs.shot_max_charge)
            state.enter_at_speed(345, 0, 0, 1)
            shot_remove()
            shot_callbacks()


func shot_hold_interrupt():
    if controls.try_roll(): shot_remove()
    elif input.special_pressed:
        state.enter_at_speed(346, 0, 0, 1)
        shot_callbacks()
    elif input.shield_pressed:
        state.enter_at_speed(345, 0, 0, 1)
        shot_remove()
        shot_callbacks()


func shot_ground_collision(int destination, bool force_release):
    if collision.left_ground:
        physics.ground_to_air()
        state.enter_at_speed(destination, 0x0c4c5080, frame, 1)
        shot_callbacks()
        if force_release:
            sound.play(260021, 127, 64)
            command(1) = 1


func shot_air_collision(int destination):
    if collision.landed:
        physics.switch_to_ground()
        state.enter_at_speed(destination, 0x0c4c5080, frame, 1)
        shot_callbacks()


func missile_begin(bool air_started):
    let target = 349
    if input.horizontal_smash_age < attrs.missile_smash_window: target = 350
    if air_started:
        velocity.x = velocity.x / attrs.missile_start_deceleration
        target = target + 2
    else:
        ground.velocity = ground.velocity / attrs.missile_start_deceleration
        velocity.y = 0
    state.enter_at_speed(target, 0, 0, 1)
    animation.start()
    cue.throw.reset()


func missile_accessory():
    if cue.article.consume():
        state.missile_serial = uint(state.missile_serial) + 1
        bones.world_position(attrs.missile_joint, state.missile_x, state.missile_y, state.missile_z)
        state.missile_x = state.missile_x + attrs.missile_spawn_offset * facing.direction
        let smash = motion.id != 349 and motion.id != 351
        articles.create_at_position(It_Kind_Samus_Missile, state.missile_x, state.missile_y, 0, facing.direction, true, 0, smash)
        if not effects.active:
            effects.spawn_at_position(1155, state.missile_x, state.missile_y, state.missile_z)
            effects.active = true
        effects.pause_during_hitlag()
        articles.stop_cue()


func morph_shape():
    if command(0) and not state.morph_hurtbox:
        hurtboxes.set_all(Hurt.intangible)
        hurtboxes.define(0, bones.index(XRotN), Hurt.height_mid, false, 0, 0, 0, 0, 0, 0, 3)
        state.morph_hurtbox = true
    if not command(0) and state.morph_hurtbox:
        hurtboxes.set_all(Hurt.normal)
        state.morph_hurtbox = false


func bomb_transition(bool air_started, bool hop):
    if hop: velocity.y = state.scaled_bomb_hop_speed
    if air_started: physics.ground_to_air()
    else: physics.switch_to_ground()
    let target = 355
    if air_started: target = 356
    state.enter_at_speed(target, Transition.common_ground_air | Transition.keep_hurt_status | Transition.skip_hitboxes | Transition.skip_model, frame, 1)
    if not hop:
        command(1) = 2
        state.morph_hurtbox = false


export func bomb_jump(float center, float radius):
    let ratio = (position.x - center) / radius
    if ratio >= 1: ratio = 1
    if ratio <= -1: ratio = -1
    let angle = -attrs.morph_jump_angle * ratio + float(1.5707963705062866)
    if hurtboxes.status == 0:
        if action.category == 0 or action.category == 2 or action.category == 3 or action.category == 4:
            # Current semantic metadata: move ID in the low byte, original
            # motion flag x2071_b5 at canonical bit 18, independent of host packing.
            if action.move_id(action.current_metadata) == 20 or (action.current_metadata & 262144) == 0:
                let float start = 0
                if animation.id == 2: start = attrs.morph_jump_frame
                damage.interrupt_cleanup()
                velocity.x = state.scaled_morph_jump_speed * cos(angle)
                velocity.y = state.scaled_morph_jump_speed * sin(angle)
                physics.clamp_horizontal_speed(air.drift_max * attrs.morph_air_mobility)
                command(0) = 0
                command(1) = 0
                state.morph_hurtbox = false
                if grounded: physics.ground_to_air()
                state.enter_at_speed(342, 0, start, 1)
                animation.start()


func bomb_accessory():
    if cue.article.consume():
        bones.world_position(bones.index(Top), state.bomb_x, state.bomb_y, state.bomb_z)
        state.bomb_x = state.bomb_x + attrs.bomb_spawn_x * facing.direction
        state.bomb_y = state.bomb_y + state.scaled_bomb_spawn_y
        state.bomb_z = state.bomb_z + attrs.bomb_spawn_z
        articles.create_at_position(It_Kind_Samus_Bomb, state.bomb_x, state.bomb_y, 0, facing.direction, true)
        articles.stop_cue()


func morph_roll_animation():
    morph_shape()
    if cue.reverse.consume(): facing.direction = -facing.direction
    if animation.finished:
        ground.velocity = 0
        state.wait()


func morph_roll_collision():
    if command(0): collision.ground_standard_box(state.scaled_morph_ecb_top, state.scaled_morph_ecb_bottom, state.scaled_morph_ecb_left_x, state.scaled_morph_ecb_left_y, state.scaled_morph_ecb_right_x, state.scaled_morph_ecb_right_y)
    else: collision.ground_standard()


func cpu_tap_shield():
    cpu.queue(Cpu.press_r)
    cpu.queue(Cpu.wait, 1)
    cpu.queue(Cpu.release_r)

func Tether_Unbind(int expected):
    if state.tether_handle != expected:
        return
    state.tether_handle = -1
    if callbacks.matches(Callback.accessory_before, Tether_Update):
        callbacks.accessory_before(None)
    if callbacks.matches(Callback.accessory_hitlag, Tether_Hitlag):
        callbacks.accessory_hitlag(None)
    if callbacks.matches(Callback.death1, Tether_Remove):
        callbacks.death1(None)


func Tether_Remove():
    if articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
        articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "remove", 0)
    else:
        Tether_Unbind(state.tether_handle)


func Tether_Update():
    if articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
        articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "normal_update", 0)
    else:
        Tether_Unbind(state.tether_handle)


func Tether_Hitlag():
    if not articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
        Tether_Unbind(state.tether_handle)
        return
    state.tether_before_launch = false
    if motion.id == 212 and state.tether_counter < attrs.tether_standing_launch:
        state.tether_before_launch = true
    if motion.id == 214 and state.tether_counter < attrs.tether_dash_launch:
        state.tether_before_launch = true
    if motion.id == 357 and state.tether_counter < attrs.tether_air_launch:
        state.tether_before_launch = true
    articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "hitlag_update", 0)


func Tether_ReadInputs():
    state.tether_launch_now = (motion.id == 212 and state.tether_counter == attrs.tether_standing_launch) or (motion.id == 214 and state.tether_counter == attrs.tether_dash_launch) or (motion.id == 357 and state.tether_counter == attrs.tether_air_launch)
    state.tether_allowed_motion = motion.id == 212 or motion.id == 214 or motion.id == 357 or motion.id == 358
    state.tether_grounded = grounded
    state.tether_attack_pressed = input.attack_pressed
    state.tether_facing = facing.direction


func Tether_ReadPosition():
    state.tether_old_x = position.x
    state.tether_old_y = position.y
    state.tether_position_x = position.x
    state.tether_position_y = position.y


func Tether_ApplyPosition():
    position.x = state.tether_target_x
    position.y = state.tether_target_y


func Tether_AddDisplacement():
    # fn_802B8D38 adds the completed displacement, not (velocity + position)
    # followed by subtraction. Preserve its F32 evaluation order while hanging.
    velocity.x = velocity.x + (position.x - state.tether_old_x)
    velocity.y = velocity.y + (position.y - state.tether_old_y)
    position.delta.x = velocity.x
    position.delta.y = velocity.y


func Tether_HitEffect():
    effects.spawn_with_scalar_at_position(1009, state.tether_hit_x, state.tether_hit_y, state.tether_hit_z, facing.direction)


func Tether_ClearAttack():
    hitbox.clear_all()


func Tether_ClearCaptureMask():
    capture.mask(0)


func Tether_StartHangTimer():
    state.tether_hang_timer = attrs.tether_hang_frames


func Tether_HangCountdown():
    state.tether_hang_expired = state.tether_hang_timer <= 0
    state.tether_hang_timer = state.tether_hang_timer - 1


func Tether_DamageFall():
    state.damage_fall()


func Tether_PullComplete():
    let bool ledge = collision.probe_ledge(5, 5)
    if ledge:
        velocity.x = 0
        velocity.y = 0
    if ledge and collision.ledge_available():
        state.catch_ledge()
    else:
        velocity.x = 0
        state.cliff_jump_phase2(attrs.tether_pull_jump_multiplier)


func Tether_EnterAir():
    state.tether_counter = 0
    acceleration.x = 0
    acceleration.y = 0
    acceleration.z = 0
    state.enter_at(357, 0, 0)
    capture.mask(511)


func Tether_EnterHit():
    state.enter_flags(358, 1)
    physics.clamp_horizontal_speed(air.drift_max)
    state.tether_hit_timer = 20
    state.tether_hit_aux = 0
    if grounded:
        physics.ground_to_air()


func Tether_FinishAir():
    state.freefall(1, 0, true, 1, movement.special_landing_lag)


func Tether_LaunchAir():
    bones.world_position(state.tether_attachment_part, state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z)
    state.tether_launch_blocked = stage.segment_blocked(collision.position.x, state.tether_thumb_y, state.tether_thumb_x + 1.8 * facing.direction * model.instance_scale_y, state.tether_thumb_y)
    if state.tether_launch_blocked:
        Tether_Remove()
        Tether_FinishAir()
        return
    articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "extend_air", position.delta.x)



func Tether_AirAnimation():
    state.tether_counter = state.tether_counter + 1
    if state.tether_counter == attrs.tether_air_create:
        Tether_Create()
        if not articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
            Tether_FinishAir()
    elif state.tether_counter > attrs.tether_air_create and state.tether_counter <= attrs.tether_air_remove:
        if state.tether_counter == attrs.tether_air_launch:
            Tether_LaunchAir()
            if state.tether_launch_blocked:
                return
        elif state.tether_counter == attrs.tether_air_retract:
            articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "retract", 0)

        elif state.tether_counter == attrs.tether_air_remove:
            Tether_Remove()
    if animation.finished:
        Tether_FinishAir()


func Tether_AirPhysics():
    physics.check_fastfall()
    if movement.fastfall:
        physics.fastfall()
    else:
        if state.tether_counter < 20 and position.delta.y < 0:
            physics.fall(air.gravity * 0.2, air.terminal_velocity)
        else:
            physics.fall(air.gravity, air.terminal_velocity)
    physics.air_accel_normal()


func Tether_HitPhysics():
    velocity.x = position.delta.x
    velocity.y = position.delta.y
    velocity.z = position.delta.z
    physics.fall(air.gravity, air.terminal_velocity)

# Proposed exact engine-policy hook, replacing stock kind gate only here.

func Tether_AdvanceCodeSequence():
    # Stock samples one switch case per normal update, including held inputs.
    # Completing Up/Down/Up/A persists until death or an incomplete creation.
    if state.tether_code_sequence == 0:
        if input.up_held:
            state.tether_code_sequence = 1
    elif state.tether_code_sequence == 1:
        if input.down_held:
            state.tether_code_sequence = 2
    elif state.tether_code_sequence == 2:
        if input.up_held:
            state.tether_code_sequence = 3
    elif state.tether_code_sequence == 3:
        if input.attack_pressed:
            state.tether_code_sequence = 4


func Tether_HoldHangTimer(int modified_mode):
    # fn_802B8D38 tests physical L, before its ground/attack exits and decrement.
    if modified_mode != 0 and input.l_held:
        state.tether_hang_timer = state.tether_hang_timer + 1

hitbox_definition tether_tip:
    bone 139
    damage 0
    radius 1200 * 0.003906
    angle 361
    growth 100
    item_interaction true
    element 8
    sound_severity 1
    sound_kind 2
    aerial false
    # Retail's trailing victim-only bit was undefined; choose false explicitly.
    victim_only false


func Tether_UpdateModifiedGroundAttack(int mode) -> bool:
    if not grounded or mode != 1:
        return false
    hitbox.clear_all()
    if not input.attack_pressed:
        return false
    return hitbox.create(0, tether_tip)


func Tether_ReadHomingTarget() -> bool:
    let int target = targets.nearest_available_fighter()
    return targets.read_position(target, state.tether_target_x, state.tether_target_y, state.tether_target_z)


func Tether_Create():
    if motion.id != 357 and motion.id != 358 and motion.id != 212 and motion.id != 214:
        return
    Tether_ReadInputs()
    state.tether_attachment_part = attrs.tether_attachment_joint
    bones.world_position(state.tether_attachment_part, state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z)
    # Stock passes the supplied position/facing, no center offset, zero velocity,
    # and collision flag true. Collision-group0 replaces uninitialized Spawn.x40.
    state.tether_handle = articles.create_with_velocity(It_Kind_Samus_GBeam, state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z, 0, 0, 0, facing.direction, false, 0, 0, true)
    if not articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
        state.tether_handle = -1
        return
    # Retail Samus uses raw joint51 (FtPart_ThrowN), not semantic bone slot4.
    # The owned parameter also supplies the resource links' borrowed joint.
    let bool attached = items.attach(state.tether_handle, attrs.tether_attachment_joint, false)
    if not attached:
        articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "remove", 0)
        state.tether_handle = -1
        return
    articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "scale_after_attach", 0)
    if not articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
        state.tether_handle = -1
        return
    callbacks.accessory_before(Tether_Update)
    callbacks.death1(Tether_Remove)
    callbacks.accessory_hitlag(Tether_Hitlag)



func Tether_CreateThrowAccessory(int motion, float rate):
    # Common ThrowF..ThrowLw are 219..222. This selection owns no stock handler.
    if accessory.create(4):
        accessory.set_scale(model.instance_scale_y, model.instance_scale_y, model.instance_scale_y)
        accessory.add_animation(4, -1)
        accessory.add_animation(4, motion - 219)
        # Preserve looping geometry and all material/texture clocks.
        accessory.set_geometry_animation_rate(rate, false)
        accessory.request_frame(0.0)
        accessory.evaluate()
        accessory.follow_bone(51)

func Tether_GroundSpark():
    articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "ground_spark", 0)


func Tether_BlockGroundLaunch():
    bones.world_position(attrs.tether_attachment_joint, state.tether_thumb_x, state.tether_thumb_y, state.tether_thumb_z)
    if stage.segment_blocked(collision.position.x, state.tether_thumb_y, state.tether_thumb_x + 2 * facing.direction * model.instance_scale_y, state.tether_thumb_y):
        Tether_Remove()
        state.wait()
        state.tether_ground_consumed = true


func Tether_GroundFrame(int create_frame, int launch_frame, int retract_frame, int remove_frame, bool standing):
    state.tether_ground_consumed = false
    state.tether_counter = state.tether_counter + 1
    if state.tether_counter == create_frame:
        Tether_Create()
        if not articles.ref(state.tether_handle, It_Kind_Samus_GBeam).exists:
            state.wait()
            state.tether_ground_consumed = true
            return
    elif state.tether_counter > create_frame and state.tether_counter <= remove_frame:
        if state.tether_counter == 20 or state.tether_counter == 23 or state.tether_counter == 26 or state.tether_counter == 29:
            Tether_GroundSpark()
        if standing and (state.tether_counter == 32 or state.tether_counter == 35):
            Tether_GroundSpark()
        if state.tether_counter == launch_frame:
            if standing:
                Tether_BlockGroundLaunch()
            if state.tether_ground_consumed:
                return
            articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "extend_ground", 0)
        elif state.tether_counter == retract_frame:
            articles.signal(state.tether_handle, It_Kind_Samus_GBeam, "retract", 0)
        elif state.tether_counter == remove_frame:
            Tether_Remove()


func Samus_DamageDeathCleanup():
    shot_remove()
    state.shot_charge = 0
    spin_clear()
    Tether_Remove()
    # ftCo_800D9C98 clears these after grapple removal; retain that order.
    callbacks.death2(None)
    callbacks.secondary_damage(None)
    callbacks.damage(None)

article It_Kind_Samus_Charge states 9:
    attribute float lifetime 0
    attribute float speed_min 8
    attribute float speed_max 12
    attribute float scale_min 24
    attribute float scale_max 28
    state bool fired
    state float charge
    state float maximum
    state float angle
    state float speed
    state float size
    state float release_charge
    state int effect_step
    on created:
            item.command0 = 0
            item.command1 = 0
            item.command2 = 0
            item.command3 = 0
            item.set_lifetime(item.attr.lifetime)
            item.attach_to_owner(program.attrs.shot_hand_joint)
    on picked_up:
            item.change_state(0)
            item.spawn_joint_effect(1151, "0/0")
    on destroyed:
            item.destroy_effects()
            if not item.state.fired and owner.exists:
                let bool forgotten = targets.call(item.current_owner, "shot_forget")
            item.detach_owner()
            item.owner_bound = false
    on signal release:
            item.state.angle = signal.value
            item.set_lifetime(item.attr.lifetime)
            if not owner.exists: return
            item.state.release_charge = max(0, min(float(owner.state.shot_charge), program.attrs.shot_max_charge))
            item.state.charge = item.state.release_charge
            item.state.maximum = program.attrs.shot_max_charge
            item.destroy_effects()
            # Stock clamps the stored charge for the animation and visual size,
            # but keeps the original release charge for projectile speed.
            if item.state.charge >= 8: item.state.charge = 7
            item.change_state(int(item.state.charge) + 1)
            item.track_accessory()
            item.release_attachment(0, 0, 0, true)
            item.throw_speed_damage = false
            item.use_manual_lifetime()
            item.state.speed = float(item.state.release_charge * ((item.attr.speed_max - item.attr.speed_min) / program.attrs.shot_max_charge) + item.attr.speed_min)
            item.state.size = float(item.state.charge * ((item.attr.scale_max - item.attr.scale_min) / item.state.maximum) + item.attr.scale_min)
            item.state.effect_step = 0
            facing = owner.facing
            position.x = owner.state.shot_x
            position.y = owner.state.shot_y
            position.z = 0
            velocity.x = item.state.speed * cos(item.state.angle)
            velocity.y = item.state.speed * sin(item.state.angle)
            velocity.z = 0
            item.state.fired = true
    on accessory:
            if item.state.charge == item.state.maximum and item.state.effect_step == 0:
                item.spawn_root_effect(1152)
                item.spawn_root_effect(1153)
            item.state.effect_step = (item.state.effect_step + 1) % 3
    on damage_dealt:
            return true
    on clanked:
            return true
    on absorbed:
            return true
    on hit_shield:
            return true
    on reflected:
            facing = -facing
            item.joint("").rotation.y = pi / 2 * facing
            item.state.angle = wrap_angle(item.state.angle + pi)
            return false
    on shield_bounced:
            item.mirror_velocity()
            item.state.angle = wrap_angle(atan2(velocity.y, velocity.x))
            facing = -1
            if velocity.x >= 0: facing = 1
            item.joint("").rotation.y = pi / 2 * facing
            return false
    on interaction:
            item.interact(other)
    state 0 anim 0:
        on animation:
            if owner.exists:
                if owner.motion < 343 or owner.motion > 348 or owner.fighter.action_detaches_items: return true
                # Creation ID zero is valid; -1 is the absent-handle sentinel.
                # Stock checks a pointer here, not the numeric creation ID.
                if owner.motion == 345 or owner.state.shot_handle < 0: return true
                item.state.charge = float(owner.state.shot_charge)
                item.state.maximum = float(int(program.attrs.shot_max_charge))
            item.state.size = float(item.state.charge * ((item.attr.scale_max - item.attr.scale_min) / item.state.maximum) + item.attr.scale_min)
            item.joint("0/0").scale.x = item.state.size
            item.joint("0/0").scale.y = item.state.size
            item.joint("0/0").scale.z = item.state.size
            return false
        on collision:
            return false
    state 1 anim 1:
        on animation:
            item.joint("0/0").scale.x = item.state.size
            item.joint("0/0").scale.y = item.state.size
            item.joint("0/0").scale.z = item.state.size
            item.life = item.life - 1
            return item.life <= 0
        on physics:
            velocity.x = item.state.speed * cos(item.state.angle)
            velocity.y = item.state.speed * sin(item.state.angle)
        on collision:
            item.stage_collision(false)
            if velocity.y > 0 and collision.ceiling_contact: return true
            if velocity.y <= 0 and collision.floor_contact: return true
            if velocity.x > 0 and collision.left_wall: return true
            if velocity.x <= 0 and collision.right_wall: return true
            return false
    state 2 anim 2 use 1:
    state 3 anim 3 use 1:
    state 4 anim 4 use 1:
    state 5 anim 5 use 1:
    state 6 anim 6 use 1:
    state 7 anim 7 use 1:
    state 8 anim 8 use 1:


article It_Kind_Samus_Missile states 4:
