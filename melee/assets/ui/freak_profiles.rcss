#profiles-panel {
  position: absolute; left: 0; top: 0; width: 100vw; height: 100vh;
  display: flex; flex-direction: column; padding: 32dp 40dp;
  background-color: #10111b; z-index: 10; pointer-events: none; visibility: hidden;
  transform: translateX(-100%); transition: transform 0.24s cubic-out;
}
#profiles-panel.open { transform: translateX(0%); pointer-events: auto; }
.settings-header { display: flex; align-items: center; flex-shrink: 0; padding-bottom: 28dp; border-bottom: 1dp #39303c; }
#profile-close { padding: 13dp 20dp; margin-right: 35dp; font-size: 21dp; font-weight: bold; color: #fff1e7; border: 1dp #7e5456; border-radius: 4dp; background-color: #33242e; }
#profile-close:hover, #profile-close:focus { background-color: #61353e; border-color: #fa8a75; }
.settings-heading .eyebrow { color: #e59887; }
.settings-title { margin-top: 4dp; font-size: 29dp; font-weight: bold; }
.settings-mark { margin-left: auto; font-family: Arial; font-style: italic; font-size: 26dp; font-weight: bold; }
.settings-mark span { margin-left: 8dp; color: #fa6456; font-size: 13dp; letter-spacing: 3dp; }
.settings-body { display: flex; flex: 1; min-height: 0; margin-top: 28dp; }
.profile-library { display: flex; flex-direction: column; flex: 0 0 260dp; padding-right: 28dp; border-right: 1dp #39303c; overflow-y: auto; }
.profile-library > * { flex-shrink: 0; }
.profile-library-spacer { flex: 1; min-height: 20dp; }
#profiles-panel .field-label { margin-top: 18dp; margin-bottom: 8dp; font-size: 14dp; }
#profiles-panel .room-input { height: 43dp; padding: 10dp; font-size: 15dp; }
#profiles-panel .room-button { padding: 12dp 10dp; font-size: 14dp; }
#profile-delete { margin-top: 8dp; color: #d6aaa9; }
#profile-delete-confirm { display: none; margin-top: 8dp; }
#profile-delete-confirm .room-button { flex: 1; min-width: 0; font-size: 12dp; }
#profile-delete-cancel { margin-right: 6dp; }
#profile-delete-yes { border-color: #aa5553; color: #fff1e7; }
#profiles-panel .local-counts { height: 39dp; margin-bottom: 12dp; }
#profiles-panel .local-counts button { font-size: 15dp; }
#profiles-panel .muted { font-size: 13dp; line-height: 1.6; }
.profile-status { font-size: 14dp; line-height: 1.5; color: #f0ad8b; margin-top: 12dp; word-break: break-word; }
.profile-editor { display: flex; flex-direction: column; flex: 1; min-width: 0; padding-left: 32dp; }
.profile-tabs { display: flex; flex-shrink: 0; border-bottom: 1dp #39303c; }
.profile-tabs button { padding: 10dp 22dp 16dp; margin-right: 12dp; font-size: 16dp; font-weight: bold; border: 0dp; border-bottom: 3dp transparent; color: #a99aa8; background-color: transparent; }
.profile-tabs button:hover { color: #ffdacb; }
.profile-tabs .selected { color: #fff1e7; border-bottom-color: #fa6456; }
.profile-page { flex: 1; min-height: 0; overflow-y: auto; padding: 22dp 12dp 12dp 0; }
.profile-page-title { font-size: 22dp; font-weight: bold; margin-bottom: 20dp; }
.profile-option-row { display: flex; align-items: center; padding: 20dp 0; border-bottom: 1dp #31303d; }
.profile-option-copy { flex: 1; padding-right: 20dp; }
.profile-option-title { font-size: 17dp; font-weight: bold; margin-bottom: 6dp; }
.profile-setting { display: block; flex-shrink: 0; width: 150dp; padding: 12dp; color: #ffdacb; background-color: #352831; border: 1dp #6e4b4a; border-radius: 3dp; text-align: center; font-size: 15dp; }
.profile-setting:hover, .profile-setting:focus { background-color: #50333c; border-color: #f5907b; }
.profile-note-card { margin-top: 28dp; padding: 22dp; background-color: #191923; border-left: 3dp #64505f; }
.profile-note { margin: 12dp 0 20dp; }
.profile-binding-grid { display: flex; flex-wrap: wrap; }
.profile-binding { flex: 0 0 48%; margin: 0 2% 12dp 0; padding: 14dp; background-color: #191923; border: 1dp #35303e; border-radius: 4dp; }
.profile-binding-label { font-weight: bold; font-size: 15dp; }
.profile-binding-value { color: #c4b5cb; font-size: 13dp; line-height: 1.5; margin: 6dp 0 10dp; word-break: break-word; }
.profile-binding-buttons { display: flex; }
.profile-binding-buttons button { padding: 7dp 14dp; margin-right: 6dp; background-color: #292230; color: #e0cbd6; border: 1dp #64505f; border-radius: 2dp; font-size: 13dp; }
.profile-binding-buttons button:hover { border-color: #f0ad8b; }
.calibration-grid { display: flex; }
.profile-live-title { margin-bottom: 10dp; color: #e59887; }
.calibration-live-grid { display: flex; flex-wrap: wrap; margin-bottom: 16dp; }
.calibration-live-axis { display: flex; flex: 0 0 32%; align-items: center; margin: 0 1% 8dp 0; padding: 8dp 10dp; background-color: #191923; border: 1dp #35303e; border-radius: 3dp; font-size: 12dp; }
.calibration-live-axis .live-label { width: 68dp; flex-shrink: 0; }
.calibration-live-axis .live-value { width: 44dp; flex-shrink: 0; text-align: right; color: #f0ad8b; }
.calibration-meter { position: relative; flex: 1; height: 8dp; background-color: #363440; border-radius: 4dp; overflow: hidden; }
.calibration-meter .calibration-needle { position: absolute; top: 0; left: 50%; width: 4dp; height: 8dp; background-color: #fa6456; }
.calibration-meter .calibration-fill { position: absolute; top: 0; left: 0; width: 0%; height: 8dp; background-color: #fa6456; }
.calibration-card { flex: 1; min-width: 0; padding: 22dp; margin-right: 16dp; background-color: #191923; border: 1dp #35303e; border-radius: 4dp; }
.calibration-card .profile-option-row { padding: 12dp 0; }
.calibration-card .profile-option-row .field-label { flex: 1; margin: 0 8dp 0 0; }
.calibration-card .profile-setting { width: 130dp; }
.profile-editor-footer { display: flex; align-items: center; flex-shrink: 0; padding-top: 14dp; border-top: 1dp #39303c; }
#profiles-panel .profile-editor-footer .room-button { width: auto; margin: 0 16dp 0 0; }
.profile-editor-footer .muted { margin-left: auto; }
#profile-bind-panel, #profile-tune-panel, #profile-cancel { display: none; }
#profiles-panel #profile-list { padding: 0; }
#profile-list selectvalue { padding: 10dp; }
#profile-list selectarrow { width: 20dp; background-color: #64505f; }
#profile-list selectbox { background-color: #1d1b28; border: 1dp #64505f; max-height: 240dp; overflow-y: auto; }
#profile-list option { display: block; padding: 12dp 10dp; font-size: 15dp; }
#profile-list option:hover, #profile-list option:checked { background-color: #50333c; }
