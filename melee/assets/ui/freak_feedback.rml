<rml>
<head><title>Feedback</title><link type="text/rcss" href="freak_feedback.rcss"/></head>
<body id="feedback-document">
  <div id="feedback-image"><div id="feedback-pins"></div></div>
  <div id="feedback-header">
    <div id="feedback-title">FEEDBACK</div>
    <div id="feedback-instructions">Click anywhere on the screen to indicate feedback. Press ENTER to send.</div>
    <button id="feedback-exit">Cancel</button>
  </div>
  <div id="feedback-bubble">
    <div class="bubble-title">Note <span id="feedback-note-number"></span></div>
    <textarea id="feedback-note" maxlength="2048" rows="4" style="overflow-y: auto; overflow-x: hidden;"/>
    <div class="bubble-buttons"><button id="feedback-remove">Remove</button><button id="feedback-done">Done · Enter</button></div>
    <div class="bubble-tail"/>
  </div>
  <div id="feedback-hover"/>
  <div id="feedback-status"/>
  <div id="feedback-modal">
    <div id="feedback-dialog">
      <div id="feedback-dialog-title">Send feedback?</div>
      <div id="feedback-dialog-text">Send this screenshot, your notes, and gameplay diagnostics?</div>
      <div class="dialog-buttons"><button id="feedback-keep">Keep editing</button><button id="feedback-send">Send feedback</button></div>
      <button id="feedback-retry">Retry</button><button id="feedback-close">Return to game</button>
    </div>
  </div>
</body>
</rml>
