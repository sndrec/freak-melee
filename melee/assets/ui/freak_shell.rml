<rml>
<head>
  <title>Freak Melee</title>
  <link type="text/rcss" href="freak_shell.rcss" />
  <link type="text/rcss" href="freak_profiles.rcss" />
  <link type="text/rcss" href="freak_rules.rcss" />
  <link type="text/rcss" href="freak_css_original.rcss" />
  <link type="text/rcss" href="freak_costumes.rcss" />
  <link type="text/rcss" href="freak_collection.rcss" />
  <link type="text/rcss" href="freak_workshop.rcss" />
  <link type="text/rcss" href="freak_workshop_model.rcss" />
</head>
<body>
  <div id="shell">
    <aside id="left-rail" class="rail left-rail">
      <div id="css-original-sidebar-normal">
      <header class="brand">
        <div class="eyebrow brand-kicker">SUPER SMASH BROS.</div>
        <div class="brand-name">FREAK</div>
        <div class="brand-subtitle">MELEE<span class="brand-slashes">///</span></div>
      </header>
      <nav class="navigation">
        <div class="eyebrow nav-heading">MENU</div>
        <button id="room-tab" class="nav-item active"><span class="nav-index">01</span><span>Room</span></button>
        <button id="workshop-tab" class="nav-item"><span class="nav-index">02</span><span>Workshop</span></button>
        <button id="collection-tab" class="nav-item"><span class="nav-index">03</span><span>Collection</span></button>
        <button id="profiles-tab" class="nav-item"><span class="nav-index">04</span><span>Options</span></button>
        <button id="rules-tab" class="nav-item"><span class="nav-index">05</span><span>Match rules</span></button>
        <button id="css-original-edit" class="nav-item"><span class="nav-index">06</span><span>Edit CSS</span></button>
      </nav>
      <section id="local-section" class="local-section">
        <div class="section-heading"><span class="eyebrow">ON THIS PC</span><span id="controller-count" class="small-count">0 / 4</span></div>
        <div id="local-controllers"></div>
      </section>
      </div>
      <header id="css-original-editor-header">
        <button id="css-original-back">‹ BACK</button>
        <div class="eyebrow">CHARACTER SELECT</div>
        <div class="css-editor-title">Edit portraits</div>
      </header>
      <section id="css-original-tools">
        <p>Drag a portrait to move it, or drag its corner to resize.</p>
        <button id="css-original-remove" class="room-button">Remove selected</button>
        <button id="css-original-collection" class="room-button">Add fighter</button>
        <div id="css-original-stock"></div>
        <button id="css-original-reset" class="room-button quiet">Restore default</button>
        <p id="css-original-status"></p>
      </section>

      <div class="rail-spacer"></div>
    </aside>
    <aside id="right-rail" class="rail right-rail">
      <header class="room-header">
        <div class="eyebrow">ROOM</div>
        <div class="room-status"><span id="room-dot" class="status-dot"></span><span id="room-state">Offline</span></div>
      </header>
      <section class="identity">
        <label for="local-name" class="field-label">Name</label>
        <input id="local-name" class="room-input" type="text" maxlength="32" placeholder="Player" />
      </section>
      <section id="offline-room" class="offline-room">
        <div class="field-label">Players on this PC</div>
        <div class="local-counts"><button id="local-1" class="selected">1</button><button id="local-2">2</button><button id="local-3">3</button><button id="local-4">4</button></div>
        <button id="create-room" class="room-button primary">Create room</button>
        <div class="join-divider">or join</div>
        <label for="join-code" class="field-label">Room code</label>
        <input id="join-code" class="room-input code-input" type="text" maxlength="12" placeholder="XXXXXXXX" />
        <button id="join-room" class="room-button">Join room</button>
        <p id="room-unavailable" class="muted">Available at home or in practice.</p>
      </section>
      <section id="connected-room" class="connected-room">
        <div class="eyebrow">INVITE CODE</div>
        <div id="room-code" class="room-code">--------</div>
        <button id="copy-code" class="copy-button">Copy room code</button>
        <div class="section-heading roster-heading"><span class="eyebrow">IN THE ROOM</span><span id="room-count" class="small-count">0</span></div>
        <div id="room-players"></div>
        <div class="rotation-heading eyebrow">1V1 ROTATION</div>
        <button id="rotation-policy" class="room-button quiet">Manual</button>
        <button id="leave-room" class="room-button quiet">Leave room</button>
      </section>
      <button id="start-match" class="room-button primary">Start match</button>
      <div id="start-hint" class="muted">START to practice and ready up</div>
      <p id="content-progress"></p>
      <div id="gift-incoming"></div>
      <p id="room-failure" class="failure"></p>
      <section id="costume-section">
        <div class="eyebrow">COSTUMES</div>
        <div id="costume-players"></div>
        <div id="costume-choices"></div>
        <p id="costume-status"></p>
      </section>
      <section id="global-chat" class="global-chat">
        <header class="chat-heading"><span class="eyebrow">GLOBAL CHAT</span><button id="chat-toggle">−</button></header>
        <div id="chat-state" class="chat-state">Connecting...</div>
        <div id="chat-history" class="chat-history"></div>
        <div class="chat-compose"><input id="chat-message" type="text" maxlength="512" placeholder="Message everyone" /></div>
        <div class="chat-footer"><span id="chat-delivery"></span><button id="chat-send">Send</button></div>
      </section>
    </aside>
    <div id="css-original-overlay"><div id="css-original-handles"></div></div>
    <section id="collection-panel">
      <header class="settings-header">
        <button id="collection-close">‹ BACK</button>
        <div class="settings-heading"><div class="eyebrow">ON THIS PC</div><div class="settings-title">Collection</div></div>
        <div class="settings-mark">FREAK<span>MELEE</span></div>
      </header>
      <div class="collection-body">
        <div class="collection-main">
          <button id="workshop-open" class="room-button workshop-entry">Open character workshop</button>
          <div class="collection-heading"><div class="eyebrow">INSTALLED PACKAGES</div><span id="collection-count">0 installed</span></div>
          <div id="collection-items"></div>
          <div class="collection-heading"><div class="eyebrow">LOCAL DRAFTS</div></div>
          <div id="collection-drafts"></div>
        </div>
        <aside class="collection-sharing">
          <div class="eyebrow">SHARE WITH A FRIEND</div>
          <p>Pick a room member, then send an installed fighter or costume. They choose whether to keep it.</p>
          <label for="collection-recipient" class="field-label">Recipient</label>
          <select id="collection-recipient" class="room-input"></select>
          <p id="collection-status"></p>
          <div id="collection-transfer"></div>
        </aside>
      </div>
    </section>
    <section id="workshop-panel">
      <button id="workshop-return-editor" class="room-button">‹ Return to editor</button>
      <div id="workshop-test-note"></div>
      <header id="workshop-editor-header">
        <button id="workshop-back-drafts" class="workshop-back" title="Fighter drafts">‹</button>
        <div class="workshop-mark">F</div>
        <div class="workshop-document"><div id="workshop-editor-title">Mario</div><small>FREAK MELEE WORKSHOP</small></div>
        <select id="workshop-family-member" class="room-input" title="Edit family member" style="display:none; width:120px"></select>
        <nav id="workshop-mode-tabs">
          <button id="workshop-mode-action">ACTION EDITOR</button>
          <button id="workshop-mode-script">SCRIPTING</button>
          <button id="workshop-mode-animation">ANIMATION</button>
          <button id="workshop-mode-model">MODEL</button>
        </nav>
        <button id="workshop-undo" class="workshop-header-tool" disabled="disabled" title="Undo workshop edit">Undo</button>
        <button id="workshop-redo" class="workshop-header-tool" disabled="disabled" title="Redo workshop edit">Redo</button>
        <button id="workshop-package-toggle" class="workshop-header-tool" title="Edit common fighter attributes and package settings">Attributes</button>
        <button id="workshop-save-top" class="room-button">Save</button>
        <button id="workshop-test-character" class="room-button primary">Test Character</button>
      </header>
      <div id="workshop-editor-context">
        <div id="workshop-context-action">Select an action</div><span>/</span>
        <div id="workshop-context-phase">Main</div><span>/</span>
        <div id="workshop-context-clip"></div>
        <button id="workshop-context-animation">Edit animation ↗</button>
      </div>
      <aside id="workshop-library" class="workshop-rail">
        <button id="workshop-close" class="workshop-back">‹ BACK TO COLLECTION</button>
        <div class="eyebrow">CHARACTER WORKSHOP</div>
        <div class="workshop-library-create">
        <div class="workshop-heading">Fighter drafts</div>
        <label for="workshop-new-base" class="field-label">Clone fighter</label>
        <select id="workshop-new-base" class="room-input"></select>
        <input id="workshop-new-name" class="room-input" type="text" maxlength="63" placeholder="Fighter name" />
        <button id="workshop-create" class="room-button primary">Create clone</button>
        </div><section class="workshop-library-drafts"><div class="workshop-divider"></div>
        <div class="eyebrow">ON THIS PC</div>
        <div id="workshop-drafts"></div>
        <p id="workshop-library-status" class="workshop-status"></p></section>
      </aside>
      <aside id="workshop-editor-browser" class="workshop-rail">
        <div id="workshop-action-browser"><div class="eyebrow">ACTIONS</div>
          <input id="workshop-action-search" class="room-input" type="text" placeholder="Find a move or state" />
          <div id="workshop-action-list"></div>
          <div id="workshop-linked-resources">
            <div class="workshop-divider"></div>
            <div class="eyebrow">ACTION RESOURCES</div>
            <button id="workshop-jump-animation" class="workshop-resource-link" title="Open this action's animation in the Animation workspace"><span>Animation</span><span>Open</span></button>
            <button id="workshop-jump-script" class="workshop-resource-link" title="Open the fighter's special-move script in the Scripting workspace"><span>Behavior script</span><span>Open</span></button>
          </div>
        </div>
        <div id="workshop-animation-browser"><div class="eyebrow">CLIPS</div>
          <input id="workshop-animation-search" class="room-input" type="text" placeholder="Find a clip or action" />
          <div id="workshop-animation-clips"></div>
          <div class="workshop-divider"></div>
          <div class="eyebrow">BONE OUTLINER</div>
          <div id="workshop-animation-browser-summary"></div>
          <div id="workshop-animation-tracks"></div>
        </div>
      </aside>
      <aside id="workshop-editor-inspector" class="workshop-rail">
        <div id="workshop-inspector-heading" class="eyebrow">EVENT INSPECTOR</div>
        <div id="workshop-action-title" class="workshop-heading"></div>
        <div id="workshop-action-detail" class="workshop-muted"></div>
        <div id="workshop-action-playback">
          <div class="workshop-divider"></div>
          <div class="eyebrow">ACTION PLAYBACK</div>
          <label class="workshop-hitbox-check"><input id="workshop-action-loop" type="checkbox" /> Loop animation in this action</label>
          <label class="workshop-hitbox-check" title="Extract TransN translation for action physics. Vertical travel also requires an airborne transition."><input id="workshop-action-root-motion" type="checkbox" /> Use TransN root motion</label>
          <button id="workshop-action-loop-apply" class="room-button">Apply playback</button>
        </div>
        <div id="workshop-frame-stack">
          <div class="workshop-divider"></div>
          <div id="workshop-frame-stack-title" class="eyebrow">FRAME 0 COMMANDS</div>
          <div class="workshop-inspector-hint">Execution order at the playhead. Click a command to inspect it.</div>
          <div id="workshop-frame-stack-rows"></div>
        </div>
        <div id="workshop-event-timing">
          <div class="workshop-divider"></div>
          <div class="eyebrow">EDIT SOURCE TIMER</div>
          <div class="workshop-inspector-hint">This command's first execution and later commands governed by the same timer move together, including loop repeats.</div>
          <div class="workshop-inspector-row"><label for="workshop-event-frame" class="field-label">First execution frame</label><input id="workshop-event-frame" class="room-input" type="text" /></div>
          <button id="workshop-event-frame-apply" class="room-button">Apply timer change</button>
        </div>
        <button id="workshop-delete-event" class="room-button" title="Remove this source command from the action, including every loop repeat">Delete selected command</button>
        <div id="workshop-value-fields">
          <div class="workshop-divider"></div>
          <div id="workshop-value-kind" class="eyebrow"></div>
          <div id="workshop-value-target" class="workshop-muted"></div>
          <div id="workshop-value-number" class="workshop-inspector-row"><label id="workshop-event-value-label" for="workshop-event-value" class="field-label">Command value</label><input id="workshop-event-value" class="room-input" type="text" /></div>
          <select id="workshop-air-state" class="room-input"><option value="0">Grounded</option><option value="1">Airborne (one jump used)</option><option value="2">Airborne (no jumps left)</option></select>
          <button id="workshop-value-apply" class="room-button primary">Apply event edit</button>
        </div>
        <div id="workshop-sound-fields">
          <div class="workshop-divider"></div><div class="eyebrow">SOUND EFFECT</div>
          <div id="workshop-sound-behavior" class="workshop-muted"></div>
          <div class="workshop-inspector-row"><label for="workshop-sound-id" class="field-label">Sound ID</label><input id="workshop-sound-id" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-sound-volume" class="field-label">Volume</label><input id="workshop-sound-volume" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-sound-pan" class="field-label">Panning</label><input id="workshop-sound-pan" class="room-input" type="text" /></div>
          <button id="workshop-sound-apply" class="room-button primary">Apply sound edit</button>
        </div>
        <div id="workshop-effect-fields">
          <div class="workshop-divider"></div><div class="eyebrow">VISUAL EFFECT</div>
          <div class="workshop-inspector-row"><label for="workshop-effect-id" class="field-label">Effect ID</label><input id="workshop-effect-id" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-effect-bone" class="field-label">Attachment bone</label><input id="workshop-effect-bone" class="room-input" type="text" /></div>
          <div class="workshop-bone-axis"><span>Offset</span><span>X</span><span>Y</span><span>Z</span></div>
          <div class="workshop-bone-row"><span></span><input id="workshop-effect-x" type="text" /><input id="workshop-effect-y" type="text" /><input id="workshop-effect-z" type="text" /></div>
          <button id="workshop-effect-apply" class="room-button primary">Apply effect edit</button>
        </div>
        <div id="workshop-event-fields">
          <div class="workshop-divider"></div>
          <div class="eyebrow">HITBOX</div>
          <div id="workshop-hitbox-id" class="workshop-muted"></div>
          <div class="workshop-inspector-row"><label for="workshop-hitbox-damage" class="field-label">Damage</label><input id="workshop-hitbox-damage" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-hitbox-angle" class="field-label">Angle</label><input id="workshop-hitbox-angle" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-hitbox-kbg" class="field-label">Knockback growth</label><input id="workshop-hitbox-kbg" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-hitbox-bkb" class="field-label">Base knockback</label><input id="workshop-hitbox-bkb" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-hitbox-bone" class="field-label">Attachment bone</label><input id="workshop-hitbox-bone" class="room-input" type="text" /></div>
          <div class="workshop-inspector-row"><label for="workshop-hitbox-radius" class="field-label">Radius</label><input id="workshop-hitbox-radius" class="room-input" type="text" /></div>
          <div class="workshop-hitbox-offsets">
            <div><label for="workshop-hitbox-offset-x" class="field-label">Offset X</label><input id="workshop-hitbox-offset-x" class="room-input" type="text" /></div>
            <div><label for="workshop-hitbox-offset-y" class="field-label">Offset Y</label><input id="workshop-hitbox-offset-y" class="room-input" type="text" /></div>
            <div><label for="workshop-hitbox-offset-z" class="field-label">Offset Z</label><input id="workshop-hitbox-offset-z" class="room-input" type="text" /></div>
          </div>
          <div class="workshop-unit-note">Offsets and radius are source integers (1/256 units).</div>
          <label class="workshop-hitbox-check"><input id="workshop-hitbox-grounded" type="checkbox" /> Hits grounded fighters</label>
          <label class="workshop-hitbox-check"><input id="workshop-hitbox-aerial" type="checkbox" /> Hits airborne fighters</label>
          <button id="workshop-hitbox-apply" class="room-button primary">Apply hitbox edit</button>
        </div>
        <div id="workshop-bone-fields">
          <div class="workshop-divider"></div><div class="eyebrow">SELECTED BONE</div>
          <div id="workshop-bone-name" class="workshop-heading"></div>
          <div id="workshop-bone-parent" class="workshop-muted"></div>
          <div id="workshop-bone-frame" class="workshop-muted"></div>
          <div class="eyebrow">LOCAL TRANSFORM</div>
          <div class="workshop-bone-axis"><span></span><span>X</span><span>Y</span><span>Z</span></div>
          <div class="workshop-bone-row"><span>Position</span><input id="workshop-bone-px" type="text" /><input id="workshop-bone-py" type="text" /><input id="workshop-bone-pz" type="text" /></div>
          <div class="workshop-bone-row"><span>Rotation</span><input id="workshop-bone-rx" type="text" /><input id="workshop-bone-ry" type="text" /><input id="workshop-bone-rz" type="text" /></div>
          <div class="workshop-bone-row"><span>Scale</span><input id="workshop-bone-sx" type="text" /><input id="workshop-bone-sy" type="text" /><input id="workshop-bone-sz" type="text" /></div>
          <button id="workshop-bone-apply" class="room-button primary">Apply pose</button>
          <button id="workshop-bone-key" class="room-button">Insert Key</button>
          <div class="workshop-unit-note">Auto Key is off by default. Insert Key saves the selected pose into this animation.</div>
        </div>
        <div id="workshop-clip-fields">
          <div class="workshop-divider"></div>
          <div class="eyebrow">CLIP SETTINGS</div>
          <div class="workshop-inspector-row"><label for="workshop-clip-end" class="field-label">End frame</label><input id="workshop-clip-end" class="room-input" type="text" /></div>
          <button id="workshop-clip-end-apply" class="room-button">Apply clip length</button>
          <div class="workshop-unit-note">Looping belongs to the fighter action, not the animation clip.</div>
        </div>
        <div id="workshop-pose-fields">
          <div class="workshop-divider"></div>
          <div class="eyebrow">POSE TRANSFER</div>
          <div id="workshop-pose-source" class="workshop-muted">No pose copied yet.</div>
          <button id="workshop-pose-copy" class="room-button">Copy pose at current frame</button>
          <label class="workshop-hitbox-check"><input id="workshop-pose-selected-only" type="checkbox" /> Selected bones only</label>
          <label class="workshop-hitbox-check"><input id="workshop-pose-root-translation" type="checkbox" /> Include root translation</label>
          <div class="workshop-pose-destinations">
            <button id="workshop-pose-paste-current" class="room-button primary">Paste here</button>
            <button id="workshop-pose-paste-start" class="room-button">At start</button>
            <button id="workshop-pose-paste-end" class="room-button">At end</button>
          </div>
        </div>
        <div id="workshop-animation-fields">
          <div class="workshop-divider"></div>
          <div class="eyebrow">SELECTED KEY</div>
          <div id="workshop-key-description" class="workshop-muted"></div>
          <label for="workshop-key-frame" class="field-label">Frame</label>
          <input id="workshop-key-frame" class="room-input" type="text" />
          <label for="workshop-key-value" class="field-label">Value</label>
          <input id="workshop-key-value" class="room-input" type="text" />
          <label for="workshop-key-tangent" class="field-label">Hermite tangent</label>
          <input id="workshop-key-tangent" class="room-input" type="text" />
          <button id="workshop-key-apply" class="room-button primary">Apply key edit</button>
          <button id="workshop-key-insert" class="room-button">+ Key at current frame</button>
          <button id="workshop-key-delete" class="room-button">Delete selected key</button>
          <div class="workshop-divider"></div>
          <div class="eyebrow">CHANNEL KEYS</div>
          <div id="workshop-animation-keys"></div>
        </div>
      </aside>
      <section id="workshop-action-viewport" title="Middle drag: rotate · Shift + middle drag: pan · Wheel: zoom">
        <div class="workshop-viewport-toolbar">
          <button id="workshop-view-hitboxes" title="Show live fighter hitboxes">Hitboxes</button>
          <button id="workshop-view-hurtboxes" title="Show live fighter hurtboxes">Hurtboxes</button>
          <button id="workshop-view-bones" title="Show animation joints in the practice viewport">Bones</button>
          <button id="workshop-viewport-reset" title="Return the selected action to frame zero">Reset action</button>
        </div>
        <div class="workshop-viewport-label">Preview · <span id="workshop-preview-state">choose a fighter to preview</span></div>
        <div class="workshop-viewport-ratio">4:3 game viewport</div>
        <div id="workshop-action-hitboxes" class="workshop-hitbox-overlay">
          <div id="workshop-hitbox-arrow-0" class="workshop-hitbox-arrow"><span class="workshop-hitbox-arrow-tip"></span></div>
          <div id="workshop-hitbox-arrow-1" class="workshop-hitbox-arrow"><span class="workshop-hitbox-arrow-tip"></span></div>
          <div id="workshop-hitbox-arrow-2" class="workshop-hitbox-arrow"><span class="workshop-hitbox-arrow-tip"></span></div>
          <div id="workshop-hitbox-arrow-3" class="workshop-hitbox-arrow"><span class="workshop-hitbox-arrow-tip"></span></div>
          <button id="workshop-viewport-hitbox-0" class="workshop-hitbox-marker">0<span id="workshop-hitbox-damage-0" class="workshop-hitbox-damage"></span><span id="workshop-hitbox-special-0" class="workshop-hitbox-special"></span></button>
          <button id="workshop-viewport-hitbox-1" class="workshop-hitbox-marker">1<span id="workshop-hitbox-damage-1" class="workshop-hitbox-damage"></span><span id="workshop-hitbox-special-1" class="workshop-hitbox-special"></span></button>
          <button id="workshop-viewport-hitbox-2" class="workshop-hitbox-marker">2<span id="workshop-hitbox-damage-2" class="workshop-hitbox-damage"></span><span id="workshop-hitbox-special-2" class="workshop-hitbox-special"></span></button>
          <button id="workshop-viewport-hitbox-3" class="workshop-hitbox-marker">3<span id="workshop-hitbox-damage-3" class="workshop-hitbox-damage"></span><span id="workshop-hitbox-special-3" class="workshop-hitbox-special"></span></button>
        </div>
        <div id="workshop-action-bones" class="workshop-bone-overlay"></div>
      </section>
      <section id="workshop-animation-viewport" title="Middle drag: rotate · Shift + middle drag: pan · Wheel: zoom">
        <div class="workshop-viewport-toolbar">
          <button id="workshop-animation-show-bones" title="Show animation joints and select one in the practice viewport">Bones</button>
          <button id="workshop-animation-ghost" disabled="disabled" title="Ghost pose is not connected yet">Ghost pose</button>
        </div>
        <div class="workshop-viewport-label">Preview · animation</div>
        <div class="workshop-viewport-ratio">Live game viewport</div>
        <div id="workshop-animation-bones" class="workshop-bone-overlay"></div>
      </section>
      <section id="workshop-model-pane">
        <nav id="workshop-model-context-tabs">
          <button id="workshop-model-context-meshes">Meshes</button>
          <button id="workshop-model-context-materials">Materials</button>
          <button id="workshop-model-context-skeleton">Skeleton</button>
          <button id="workshop-model-context-skinning">Skinning</button>
          <button id="workshop-model-import">Import model</button>
        </nav>
        <aside id="workshop-model-outliner">
          <div class="workshop-model-section"><div class="eyebrow">COSTUME</div><select id="workshop-model-costume" class="room-input"><option value="0">Default</option></select></div>
          <div id="workshop-model-tree-actions"></div>
          <div id="workshop-model-tree"></div>
        </aside>
        <div id="workshop-model-center">
          <div id="workshop-model-view-tools">
            <span id="workshop-model-context-hint"></span>
            <button id="workshop-model-wireframe">Wireframe</button>
            <button id="workshop-model-bones">Bones</button>
          </div>
          <div id="workshop-model-viewport" title="Middle drag: rotate · Shift + middle drag: pan · Wheel: zoom">
            <div class="workshop-model-view-label"><strong id="workshop-model-view-title">Model</strong><small id="workshop-model-view-subtitle">Edit Mode · rest rig</small></div>
            <div class="workshop-model-view-corner"><button id="workshop-model-front">Front</button><button id="workshop-model-frame-all">Frame all</button></div>
            <div id="workshop-model-bone-overlay" class="workshop-bone-overlay"></div>
            <div id="workshop-model-view-footer">MMB orbit · Shift MMB pan · wheel zoom</div>
          </div>
          <div id="workshop-model-rig-strip">
            <div id="workshop-model-rig-modes">
              <button id="workshop-model-rig-edit">Edit Mode</button>
              <button id="workshop-model-rig-pose">Pose Mode</button>
              <button id="workshop-model-rig-animation">Animation Mode</button>
            </div>
            <button id="workshop-model-edit-animation">Edit animation ↗</button>
            <div id="workshop-model-mode-note"></div>
            <button id="workshop-model-reset-pose">Reset pose</button>
            <div id="workshop-model-clip-controls">
              <label for="workshop-model-clip">Clip</label><select id="workshop-model-clip" class="room-input"></select>
              <button id="workshop-model-play">Play</button>
              <span id="workshop-model-frame-label">0 / 0</span>
              <input id="workshop-model-frame" type="range" min="0" max="1" value="0" />
            </div>
          </div>
        </div>
        <aside id="workshop-model-inspector"></aside>
        <div id="workshop-model-summary"><span id="workshop-model-rig-summary">Compatible Melee rig</span><span id="workshop-model-mesh-summary"></span></div>
        <div id="workshop-model-import-overlay">
          <div id="workshop-model-import-dialog">
            <header><strong id="workshop-model-import-title">Import model</strong><button id="workshop-model-import-close">×</button></header>
            <div id="workshop-model-import-steps"><span id="workshop-model-step-0">1 Meshes</span><span id="workshop-model-step-1">2 Placement</span><span id="workshop-model-step-2">3 Binding</span></div>
            <div id="workshop-model-import-body"></div>
            <footer><span id="workshop-model-import-note"></span><button id="workshop-model-import-back">Back</button><button id="workshop-model-import-next" class="room-button primary">Continue</button></footer>
          </div>
        </div>
      </section>
      <section id="workshop-editor-timeline">
        <div id="workshop-action-splitter" class="workshop-pane-splitter" title="Drag to resize the preview and timeline"></div>
        <div id="workshop-action-timeline-toolbar">
          <button id="workshop-timeline-graph" class="selected">Event timeline</button>
          <button id="workshop-timeline-list">Event list</button>
          <span class="workshop-divider-vertical"></span>
          <button id="workshop-frame-start" title="First frame">|‹</button>
          <button id="workshop-frame-back" title="Previous frame">‹</button>
          <button id="workshop-frame-play" title="Play selected action">Play</button>
          <button id="workshop-frame-next" title="Next frame">›</button>
          <input id="workshop-current-frame" type="text" value="0" />
          <span id="workshop-frame-total">/ 0</span>
          <button id="workshop-add-event" title="Add an event after the selected command">+ Add event</button>
          <div id="workshop-add-event-menu"></div>
        </div>
        <div id="workshop-event-timeline">
          <div id="workshop-event-timeline-labels"></div>
          <div id="workshop-event-timeline-tracks"><div id="workshop-event-timeline-ruler"></div><div id="workshop-event-timeline-lanes"></div><div id="workshop-timeline-playhead"></div></div>
        </div>
        <div id="workshop-command-list"></div>
        <div id="workshop-timeline-footer"><span id="workshop-timeline-selection">Select an event</span><span>60 fps</span></div>
      </section>
      <section id="workshop-script-pane">
        <aside id="workshop-script-sidebar">
          <div class="eyebrow">SCRIPTS</div>
          <div id="workshop-script-files"></div>
          <div class="workshop-divider"></div>
          <div class="eyebrow">FIGHTER VARIABLES</div>
          <div id="workshop-script-variables"></div>
          <select id="workshop-script-variable-type" class="room-input"><option value="float">float</option><option value="bool">bool</option></select>
          <input id="workshop-script-variable-name" class="room-input" type="text" maxlength="48" placeholder="Variable name" />
          <button id="workshop-script-variable-add" class="room-button">+ Add variable</button>
          <div class="workshop-divider"></div>
          <div class="eyebrow">PARAMETERS</div>
          <p class="workshop-muted">Editable move values shared by this fighter. Scripts read them as attrs.Name.</p>
          <div id="workshop-parameters-list"></div>
          <button id="workshop-parameters-save" class="room-button">Save parameters</button>
          <p id="workshop-parameters-status" class="workshop-muted"></p>
          <div class="workshop-divider"></div>
          <div class="eyebrow">OUTLINE</div>
          <div id="workshop-script-outline"></div>
        </aside>
        <div id="workshop-script-editor">
          <div id="workshop-script-file">Fighter state</div>
          <div id="workshop-script-context">Special behavior · original commands and hitboxes are edited in Action Editor</div>
          <div id="workshop-script-codearea">
            <pre id="workshop-script-lines">1</pre>
            <div id="workshop-script-code-layer">
              <textarea id="workshop-script-source" rows="28" cols="88" spellcheck="false"></textarea>
              <script-colours id="workshop-script-colours"></script-colours>
            </div>
          </div>
          <div id="workshop-script-footer">
            <div id="workshop-script-actions">
              <button id="workshop-script-validate" class="room-button primary">Check script</button>
              <button id="workshop-script-build" class="room-button">Build behavior</button>
            </div>
            <button id="workshop-jump-action" class="workshop-script-jump">View selected action</button>
            <div id="workshop-script-problems-heading" class="eyebrow">PROBLEMS</div>
            <div id="workshop-script-problems" class="workshop-muted">No check run yet.</div>
            <p id="workshop-script-status" class="workshop-status"></p>
          </div>
        </div>
      </section>
      <aside id="workshop-script-inspector">
        <div class="workshop-script-preview-title">Practice <span id="workshop-script-preview-frame">Live preview</span></div>
        <div id="workshop-script-preview-space"></div>
        <div class="workshop-inspector-section"><div class="eyebrow">WATCH</div><div id="workshop-script-watch">Open practice to watch live fighter values.</div></div>
        <div class="workshop-inspector-section"><div class="eyebrow">SCRIPT REFERENCE</div><button id="workshop-doc-open" class="room-button">Open reference</button><p class="workshop-muted">Right-click a symbol in the script to look it up.</p></div>
      </aside>
      <div id="workshop-doc-menu"></div>
      <section id="workshop-doc-panel"><header><span id="workshop-doc-title">Script reference</span><button id="workshop-doc-close">Close</button></header><aside><input id="workshop-doc-search" type="text" class="room-input" placeholder="Search symbols or topics"/><div id="workshop-doc-results"></div></aside><article id="workshop-doc-content"></article></section>
      <section id="workshop-animation-pane">
        <div id="workshop-animation-splitter" class="workshop-pane-splitter" title="Drag to resize the preview and timeline"></div>
        <div id="workshop-animation-timeline-toolbar">
          <button id="workshop-animation-curves" class="selected">Curves</button>
          <button id="workshop-animation-dope">Dope sheet</button>
          <span class="workshop-divider-vertical"></span>
          <button id="workshop-animation-frame-start" title="First frame">|‹</button>
          <button id="workshop-animation-frame-back" title="Previous frame">‹</button>
          <button id="workshop-animation-frame-play" title="Play selected animation">Play</button>
          <button id="workshop-animation-frame-next" title="Next frame">›</button>
          <input id="workshop-animation-current-frame" type="text" value="0" />
          <span id="workshop-animation-frame-total">/ 0</span>
          <button id="workshop-animation-autokey" title="Insert keys when editing unkeyed channels">Auto key</button>
          <span id="workshop-animation-summary" class="workshop-muted"></span>
        </div>
        <div id="workshop-animation-dopesheet">
          <div id="workshop-dope-labels"></div>
          <div id="workshop-dope-content"><div id="workshop-dope-ruler"></div><div id="workshop-dope-rows"></div><div id="workshop-dope-playhead"></div></div>
        </div>
        <div id="workshop-graph-toolbar">
          <button id="workshop-graph-pivot" class="room-button">Pivot: selection</button>
          <button id="workshop-graph-select-all" class="room-button">Select visible</button>
          <button id="workshop-graph-clear-selection" class="room-button">Clear</button>
          <button id="workshop-graph-pan-left" class="room-button" title="Pan graph left">←</button>
          <button id="workshop-graph-zoom-in" class="room-button" title="Zoom graph in">+</button>
          <button id="workshop-graph-frame-all" class="room-button">Frame all</button>
          <button id="workshop-graph-focus" class="room-button">Focus graph</button>
          <button id="workshop-graph-zoom-out" class="room-button" title="Zoom graph out">−</button>
          <button id="workshop-graph-pan-right" class="room-button" title="Pan graph right">→</button>
          <button id="workshop-graph-animated-only" class="room-button">Animated only</button>
          <button id="workshop-graph-normalize" class="room-button">Normalize values: on</button>
        </div>
        <div id="workshop-graph-content">
          <div id="workshop-graph-channels"></div>
          <div id="workshop-animation-graph"></div>
        </div>
        <div id="workshop-graph-readout"><strong id="workshop-graph-selection-count">No keys selected</strong><span id="workshop-graph-active-channel"></span><span id="workshop-graph-note" class="workshop-graph-note">Tangent handles edit slope; time weights are fixed.</span></div>
        <div id="workshop-graph-help">Click empty space: set frame · Shift-click: add keys · B: box select · G / R / S: move, rotate, scale selected keys · Middle drag: pan · Ctrl+middle drag: zoom · Wheel: zoom</div>
      </section>
      <aside id="workshop-inspector" class="workshop-rail">
        <div class="eyebrow">FIGHTER</div>
        <div id="workshop-title" class="workshop-heading">Select a draft</div>
        <div id="workshop-empty" class="workshop-muted">Clone a fighter or choose a saved draft.</div>
        <div id="workshop-attributes">
          <div class="eyebrow">COMMON ATTRIBUTES</div>
          <div id="workshop-common-attributes"></div>
          <button id="workshop-save" class="room-button primary">Save draft</button>
          <p id="workshop-save-status" class="workshop-status"></p>
          <div class="workshop-divider"></div>
          <div class="eyebrow">INSTALL</div>
          <label for="workshop-portrait-path" class="field-label">Portrait PNG</label>
          <input id="workshop-portrait-path" class="room-input" type="text" maxlength="511" placeholder="Choose a PNG, or use the saved one" />
          <button id="workshop-portrait-browse" class="room-button">Browse</button>
          <button id="workshop-preview" class="room-button">Preview in practice</button>
          <button id="workshop-install" class="room-button primary">Build &amp; install</button>
          <p id="workshop-install-status" class="workshop-status"></p>
          <p class="workshop-muted">Preview uses your current edits without saving or installing. Add installed fighters through Edit CSS.</p>
        </div>
      </aside>
      <footer id="workshop-editor-footer"><span class="workshop-footer-dot"></span><span id="workshop-editor-status"></span><span class="workshop-footer-label">FREAK MELEE WORKSHOP</span></footer>
    </section>
    <section id="profiles-panel">
      <header class="settings-header">
        <button id="profile-close">‹ BACK</button>
        <div class="settings-heading"><div class="eyebrow">OPTIONS</div><div class="settings-title">Player profiles</div></div>
        <div class="settings-mark">FREAK<span>MELEE</span></div>
      </header>
      <div class="settings-body">
        <aside class="profile-library">
          <div class="eyebrow">LOCAL PROFILES</div>
          <label for="profile-list" class="field-label">Saved profiles</label>
          <select id="profile-list" class="room-input"></select>
          <button id="profile-new" class="room-button">+ New profile</button>
          <label for="profile-name" class="field-label">Name</label>
          <input id="profile-name" class="room-input" type="text" maxlength="32" placeholder="Your name" />
          <div class="field-label">Controller port</div>
          <div class="local-counts profile-ports"><button id="profile-port-0" class="selected">1</button><button id="profile-port-1">2</button><button id="profile-port-2">3</button><button id="profile-port-3">4</button></div>
          <p id="profile-controller" class="muted"></p>
          <div class="profile-library-spacer"></div>
          <p id="profile-status" class="profile-status"></p>
          <button id="profile-save" class="room-button primary">Save &amp; use</button>
          <button id="profile-unassign" class="room-button quiet">Use default controls</button>
          <button id="profile-delete" class="room-button quiet" disabled>Delete saved profile</button>
          <div id="profile-delete-confirm">
            <button id="profile-delete-cancel" class="room-button quiet">Cancel</button>
            <button id="profile-delete-yes" class="room-button">Confirm delete</button>
          </div>
        </aside>
        <section class="profile-editor">
          <nav class="profile-tabs"><button id="profile-play" class="selected">Gameplay</button><button id="profile-bind">Bindings</button><button id="profile-tune">Calibration</button></nav>
          <div id="profile-play-panel" class="profile-page">
            <div class="profile-page-title">Gameplay</div>
            <div class="profile-option-row"><div class="profile-option-copy"><div class="profile-option-title">Tap jump</div><p class="muted">Jump by pushing the main stick up.</p></div><button id="profile-tap" class="profile-setting">On</button></div>
            <div class="profile-option-row"><div class="profile-option-copy"><div class="profile-option-title">Attack stick</div><p class="muted">Choose smash attacks or tilts on the ground.</p></div><button id="profile-cstick" class="profile-setting">Smash</button></div>
            <div class="profile-note-card"><div class="profile-option-title">Short hop</div><p class="muted">Assign a dedicated button in Bindings. Jump keeps its normal hold-and-release behavior.</p></div>
          </div>
          <div id="profile-bind-panel" class="profile-page">
            <div class="profile-page-title">Bindings</div>
            <p class="muted profile-note">Choose Bind, then press a button or move an axis. + keeps the existing binding and adds another.</p>
            <div id="profile-actions" class="profile-binding-grid"></div>
            <div class="eyebrow profile-note">ANALOG AXES</div>
            <div id="profile-axes" class="profile-binding-grid"></div>
          </div>
          <div id="profile-tune-panel" class="profile-page">
            <div class="profile-page-title">Calibration</div>
            <div class="eyebrow profile-live-title">LIVE INPUT</div>
            <div class="calibration-live-grid">
              <div class="calibration-live-axis"><span class="live-label">Main X</span><div class="calibration-meter"><i id="profile-live-0" class="calibration-needle"></i></div><span id="profile-live-value-0" class="live-value">—</span></div>
              <div class="calibration-live-axis"><span class="live-label">Main Y</span><div class="calibration-meter"><i id="profile-live-1" class="calibration-needle"></i></div><span id="profile-live-value-1" class="live-value">—</span></div>
              <div class="calibration-live-axis"><span class="live-label">Attack X</span><div class="calibration-meter"><i id="profile-live-2" class="calibration-needle"></i></div><span id="profile-live-value-2" class="live-value">—</span></div>
              <div class="calibration-live-axis"><span class="live-label">Attack Y</span><div class="calibration-meter"><i id="profile-live-3" class="calibration-needle"></i></div><span id="profile-live-value-3" class="live-value">—</span></div>
              <div class="calibration-live-axis"><span class="live-label">Left trigger</span><div class="calibration-meter"><i id="profile-live-4" class="calibration-fill"></i></div><span id="profile-live-value-4" class="live-value">—</span></div>
              <div class="calibration-live-axis"><span class="live-label">Right trigger</span><div class="calibration-meter"><i id="profile-live-5" class="calibration-fill"></i></div><span id="profile-live-value-5" class="live-value">—</span></div>
            </div>
            <div class="calibration-grid">
              <section class="calibration-card">
                <div class="profile-option-title">Sticks</div>
                <div class="profile-option-row"><div class="field-label">Dead zones</div><button id="profile-deadzones" class="profile-setting">On</button></div>
                <label for="profile-main-zone" class="field-label">Main stick dead zone (%)</label><input id="profile-main-zone" class="room-input" type="text" maxlength="5" />
                <label for="profile-c-zone" class="field-label">Attack stick dead zone (%)</label><input id="profile-c-zone" class="room-input" type="text" maxlength="5" />
                <p class="muted profile-note">Increase only as needed to stop stick drift.</p>
              </section>
              <section class="calibration-card">
                <div class="profile-option-title">Triggers</div>
                <div class="profile-option-row"><div class="field-label">Digital click</div><button id="profile-digital" class="profile-setting">Emulated</button></div>
                <label for="profile-l-zone" class="field-label">Left trigger activation (%)</label><input id="profile-l-zone" class="room-input" type="text" maxlength="5" />
                <label for="profile-r-zone" class="field-label">Right trigger activation (%)</label><input id="profile-r-zone" class="room-input" type="text" maxlength="5" />
                <p class="muted profile-note">0–100% of analog travel. The default Shield binding preserves analog shield strength.</p>
              </section>
            </div>
          </div>
          <footer class="profile-editor-footer"><button id="profile-reset" class="room-button quiet">Reset draft controls</button><button id="profile-cancel" class="room-button">Cancel binding</button><span class="muted">Changes apply when you save.</span></footer>
        </section>
      </div>
    </section>
    <section id="rules-panel">
      <header class="settings-header">
        <button id="rules-close">‹ BACK</button>
        <div class="settings-heading"><div class="eyebrow">VERSUS</div><div class="settings-title">Match rules</div></div>
        <div class="settings-mark">FREAK<span>MELEE</span></div>
      </header>
      <div class="rules-content">
        <aside class="rules-mode-column">
          <div class="eyebrow">GAME TYPE</div>
          <button id="rules-mode-time" class="rules-mode selected"><strong>Time</strong><span>Highest score wins.</span></button>
          <button id="rules-mode-stock" class="rules-mode"><strong>Stock</strong><span>Last fighter standing wins.</span></button>
          <button id="rules-mode-coin" class="rules-mode"><strong>Coin</strong><span>Collect the most coins.</span></button>
          <div class="rules-mode-note">The host's rules apply to everyone in a room.</div>
        </aside>
        <div class="rules-fields">
          <div class="eyebrow">MATCH SETUP</div>
          <div class="rules-field-grid">
            <div class="rules-field"><label for="rules-time">Time limit</label><div class="rules-input-row"><input id="rules-time" type="text" maxlength="2" /><span>min</span></div><p>1–99 for Time or Coin.</p></div>
            <div class="rules-field"><label for="rules-stocks">Stocks</label><div class="rules-input-row"><input id="rules-stocks" type="text" maxlength="2" /><span>lives</span></div><p>1–99 for Stock.</p></div>
            <div class="rules-field"><label for="rules-stock-time">Stock timer</label><div class="rules-input-row"><input id="rules-stock-time" type="text" maxlength="2" /><span>min</span></div><p>0 means no timer.</p></div>
            <div class="rules-field"><label for="rules-damage">Damage ratio</label><div class="rules-input-row"><input id="rules-damage" type="text" maxlength="3" /><span>%</span></div><p>50–200 in steps of 10.</p></div>
          </div>
          <div class="eyebrow rules-secondary-heading">ITEMS &amp; PLAY</div>
          <div class="rules-toggle-row"><div><strong>Items</strong><p>Spawn frequency for enabled items.</p></div><button id="rules-items">Medium</button></div>
          <div class="rules-item-heading"><div><strong>Item switch</strong><span id="rules-item-count">0 selected</span></div><div class="rules-item-actions"><button id="rules-item-all">All</button><button id="rules-item-none">None</button></div></div>
          <div id="rules-item-grid" class="rules-item-grid">
            <button id="rules-item-0">Bob-omb</button><button id="rules-item-1">Home-Run Bat</button><button id="rules-item-2">Mr. Saturn</button><button id="rules-item-3">Fire Flower</button>
            <button id="rules-item-4">Flipper</button><button id="rules-item-5">Food</button><button id="rules-item-6">Freezie</button><button id="rules-item-7">Green Shell</button>
            <button id="rules-item-8">Hammer</button><button id="rules-item-9">Fan</button><button id="rules-item-10">Heart Container</button><button id="rules-item-11">Super Mushroom</button>
            <button id="rules-item-12">Party Ball</button><button id="rules-item-13">Ray Gun</button><button id="rules-item-14">Lip's Stick</button><button id="rules-item-15">Poké Ball</button>
            <button id="rules-item-16">Metal Box</button><button id="rules-item-17">Proximity Mine</button><button id="rules-item-18">Maxim Tomato</button><button id="rules-item-19">Cloaking Device</button>
            <button id="rules-item-20">Parasol</button><button id="rules-item-21">Red Shell</button><button id="rules-item-22">Bunny Hood</button><button id="rules-item-23">Star Rod</button>
            <button id="rules-item-24">Super Scope</button><button id="rules-item-25">Screw Attack</button><button id="rules-item-26">Starman</button><button id="rules-item-27">Beam Sword</button>
            <button id="rules-item-29">Barrel Cannon</button><button id="rules-item-30">Warp Star</button><button id="rules-item-31">Poison Mushroom</button>
          </div>
          <div class="rules-toggle-row"><div><strong>Friendly fire</strong><p>Teammates can damage each other.</p></div><button id="rules-friendly">Off</button></div>
          <div class="rules-toggle-row"><div><strong>Pause</strong><p>Allow players to pause a match.</p></div><button id="rules-pause">On</button></div>
          <div class="rules-toggle-row"><div><strong>Score display</strong><p>Show live score in timed matches.</p></div><button id="rules-score">Off</button></div>
        </div>
      </div>
      <footer class="rules-footer"><span id="rules-status"></span><button id="rules-save">Save rules</button></footer>
    </section>
  </div>
</body>
</rml>
