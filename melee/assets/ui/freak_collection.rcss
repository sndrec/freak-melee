#collection-panel {
  position: absolute; left: 0; top: 0; width: 100vw; height: 100vh;
  display: flex; flex-direction: column; padding: 32dp 40dp;
  background-color: #10111b; z-index: 11; pointer-events: none;
  visibility: hidden; transform: translateX(-100%);
  transition: transform 0.24s cubic-out;
}
#collection-panel.open { transform: translateX(0%); pointer-events: auto; }
#collection-close {
  padding: 13dp 20dp; margin-right: 35dp; font-size: 21dp;
  font-weight: bold; color: #fff1e7; border: 1dp #7e5456;
  border-radius: 4dp; background-color: #33242e;
}
#collection-close:hover, #collection-close:focus {
  background-color: #61353e; border-color: #fa8a75;
}
.collection-body { display: flex; flex: 1; min-height: 0; margin-top: 22dp; }
.collection-main { flex: 1; min-width: 0; overflow-y: auto; padding-right: 24dp; }
.collection-heading { display: flex; align-items: baseline; justify-content: space-between; padding: 0 0 12dp; border-bottom: 1dp #443743; }
#collection-count { color: #aa9dad; font-size: 13dp; }
.collection-item { display: flex; align-items: center; justify-content: space-between; min-height: 70dp; padding: 11dp 15dp; margin-top: 9dp; background-color: #1d1b28; border: 1dp #403544; border-left: 3dp #93616b; border-radius: 4dp; }
.collection-item > div { display: flex; flex-direction: column; min-width: 0; }
.collection-kind { color: #ea8f78; font-size: 10dp; letter-spacing: 2dp; }
.collection-item strong { margin: 3dp 0; color: #fff1e7; font-size: 19dp; }
.collection-id { color: #8c8795; font-size: 11dp; letter-spacing: 1dp; }
.collection-item button, .gift-buttons button { padding: 9dp 18dp; color: #ffe2d5; background-color: #45303a; border: 1dp #ad6b67; border-radius: 3dp; }
.collection-item button:hover, .collection-item button:focus, .gift-buttons button:hover, .gift-buttons button:focus { background-color: #71414a; border-color: #f3947b; }
.collection-empty { padding: 35dp; margin-top: 10dp; color: #aea2b0; text-align: center; border: 1dp #423746; }
.collection-sharing { flex: 0 0 310dp; padding: 0 0 0 26dp; border-left: 1dp #443743; }
.collection-sharing > p { color: #b5a8b5; font-size: 14dp; line-height: 1.5; margin: 13dp 0 24dp; }
.collection-sharing .field-label { margin-bottom: 8dp; }
#collection-recipient { width: 100%; }
#collection-status { min-height: 35dp; margin-top: 36dp; color: #efaa90; }
#collection-transfer { margin-top: 8dp; padding-top: 16dp; border-top: 1dp #443743; color: #dfc4bd; font-size: 14dp; }
#gift-incoming { display: none; padding: 13dp; margin-top: 12dp; color: #fce6d8; background-color: #342630; border: 1dp #d87966; border-radius: 4dp; font-size: 13dp; line-height: 1.45; }
#gift-incoming strong { display: block; margin-bottom: 11dp; }
.gift-buttons { display: flex; }
.gift-buttons button { flex: 1; padding: 7dp 4dp; margin-right: 5dp; font-size: 11dp; }
