* { box-sizing: border-box; }
body { margin: 0; color: #f2eee7; font-family: Segoe UI; font-size: 13dp; }
div, aside, header, section, nav, p { display: block; }
p { margin: 0; }
#shell { position: absolute; left: 0; top: 0; width: 100vw; height: 100vh; pointer-events: none; }
.rail {
  position: absolute; top: 0; height: 100vh; width: 180dp;
  display: flex; flex-direction: column; padding: 20dp 8dp 12dp;
  background-color: #10111b; pointer-events: auto; overflow: auto;
}
.left-rail { left: 0; border-right: 1dp #665258; }
scrollbarvertical { width: 7dp; margin-left: 3dp; }
scrollbarvertical slidertrack { background-color: #191823; }
scrollbarvertical sliderbar { width: 7dp; min-height: 20dp; background-color: #64505f; border-radius: 3dp; }
scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active { background-color: #bf7c75; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { display: none; }
.eyebrow { color: #9a98aa; font-size: 10dp; font-weight: bold; letter-spacing: 1.2dp; }
.section-heading { display: flex; align-items: center; margin-bottom: 11dp; }
.small-count { margin-left: auto; font-size: 10dp; color: #9994a7; }
.port { display: block; width: 29dp; height: 29dp; flex: 0 0 29dp; margin-right: 9dp; padding-top: 6dp; text-align: center; font-size: 11dp; font-weight: bold; color: #827c8f; border: 1dp #393542; border-radius: 3dp; }
.muted { color: #918a9e; font-size: 10dp; line-height: 1.65; }
.failure { display: none; margin-top: 15dp; font-size: 11dp; line-height: 1.6; color: #ffa397; }


.soon { margin-left: auto; color: #75697c; font-size: 8dp; }

button { font-family: Segoe UI; cursor: pointer; }
button[disabled] { cursor: default; }
.field-label { display: block; margin: 12dp 0 6dp; color: #aca2b6; font-size: 11dp; }
.room-input { display: block; width: 100%; height: 33dp; padding: 8dp; color: #f2e6ee; background-color: #1d1b28; border: 1dp #423746; border-radius: 3dp; font-size: 12dp; }
.room-input:focus { border-color: #ef8a77; background-color: #25202e; }
.code-input { letter-spacing: 1dp; font-weight: bold; }
.local-counts { display: flex; height: 29dp; margin-bottom: 15dp; }
.local-counts button { flex: 1 1 0; padding: 5dp 0; margin-right: 3dp; text-align: center; color: #aa9bb3; background-color: #211c29; border: 1dp #423444; border-radius: 2dp; font-size: 11dp; }
.local-counts button.selected { color: #ffdacb; background-color: #4b2d36; border-color: #bb725f; }
.local-counts button:hover, .local-counts button:focus { border-color: #f4ad85; }
.room-button { display: block; width: 100%; min-height: 33dp; margin-top: 10dp; padding: 8dp 3dp; background-color: #292230; color: #e0cbd6; border: 1dp #64505f; border-radius: 3dp; font-size: 11dp; font-weight: bold; text-align: center; }
.room-button.primary { background-color: #a4473e; color: #fff4e7; border-color: #d87860; }
.room-button:hover, .room-button:focus { background-color: #53343e; border-color: #f0ad8b; color: #ffffff; }
.room-button.primary:hover, .room-button.primary:focus { background-color: #c15c4b; }
.room-button[disabled] { color: #716776; background-color: #211c29; border-color: #39303c; }
.room-button.quiet { background-color: transparent; color: #a99aa8; border-color: #41353f; font-weight: normal; }
.room-button.quiet:hover, .room-button.quiet:focus { border-color: #e0aa92; color: #f7d5c9; }


button { tab-index: auto; }
button[disabled] { focus: none; pointer-events: none; tab-index: none; }
.room-button[disabled] { color: #716776; background-color: #211c29; border-color: #39303c; }
