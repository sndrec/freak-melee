{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freak-melee-community",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "ADMIN_EMAIL": "sndrec32exe@gmail.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUDIENCE": ""
  },
  "d1_databases": [
    { "binding": "COMMUNITY", "database_name": "freak-melee-community", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "freak-melee-feedback" }],
  "ratelimits": [
    { "name": "SUBMISSION_LIMIT", "namespace_id": "710021", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } }
}
