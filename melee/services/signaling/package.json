{
  "name": "@freak-melee/signaling",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types && npm run typecheck && vitest run",
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "types": "wrangler types --env-interface CloudflareBindings src/worker-configuration.d.ts",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.1"
  }
}
