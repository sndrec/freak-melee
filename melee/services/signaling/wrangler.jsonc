{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freak-melee-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "AUTH_ORIGIN": "https://freak-melee-signaling.sndrec32exe.workers.dev"
  },
  "ratelimits": [{ "name": "ACCOUNT_LIMIT", "namespace_id": "710019", "simple": { "limit": 60, "period": 60 } }],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "QUICK_PLAY",
        "class_name": "QuickPlayQueue"
      },
      {
        "name": "GLOBAL_CHAT",
        "class_name": "GlobalChat"
      },
      {
        "name": "LOBBY_DIRECTORY",
        "class_name": "LobbyDirectory"
      },
      {
        "name": "ACCOUNTS",
        "class_name": "Account"
      },
      {
        "name": "SOCIAL",
        "class_name": "SocialMailbox"
      },
      {
        "name": "FRIENDSHIPS",
        "class_name": "SocialFriendship"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "chat",
      "new_sqlite_classes": [
        "GlobalChat"
      ]
    },
    {
      "tag": "quick-play",
      "new_sqlite_classes": [
        "QuickPlayQueue"
      ]
    },
    {
      "tag": "lobby-directory",
      "new_sqlite_classes": ["LobbyDirectory"]
    },
    {
      "tag": "accounts",
      "new_sqlite_classes": ["Account"]
    },
    {
      "tag": "social-mailboxes",
      "new_sqlite_classes": ["SocialMailbox", "SocialFriendship"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
