{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freak-melee-signaling",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "QUICK_PLAY",
        "class_name": "QuickPlayQueue"
      },
      {
        "name": "GLOBAL_CHAT",
        "class_name": "GlobalChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "chat",
      "new_sqlite_classes": [
        "GlobalChat"
      ]
    },
    {
      "tag": "quick-play",
      "new_sqlite_classes": [
        "QuickPlayQueue"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
